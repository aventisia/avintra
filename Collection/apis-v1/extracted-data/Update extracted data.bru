meta {
  name: Update extracted data
  type: http
  seq: 3
}

put {
  url: {{MLMODELBUILDER_APIS_BASE_URL}}/extracted-data/
  body: none
  auth: none
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    Id: bru.getGlobalEnvVar("EDATA_ID"),
    MLModelId: bru.getGlobalEnvVar("MLMODEL_ID"),
    docId: "01954c52-e2b3-7816-a9d2-0aed2c644419",
    accuracy: 99.575648,
    DataObject: faker.lorem.sentence()
  })
}

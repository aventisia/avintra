meta {
  name: Insert extracted data
  type: http
  seq: 2
}

post {
  url: {{MLMODELBUILDER_APIS_BASE_URL}}/extracted-data/
  body: none
  auth: none
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    MLModelId: bru.getGlobalEnvVar("MLMODEL_ID"),
    docId: "01954c52-e2b3-7816-a9d2-0aed2c644419",
    accuracy: 99.5,
    DataObject: faker.lorem.sentence()
  })
}

script:post-response {
  if(res.getStatus() == 200){
    bru.setGlobalEnvVar(
    "EDATA_ID",
    res.getBody().data.id
    );
  }
}

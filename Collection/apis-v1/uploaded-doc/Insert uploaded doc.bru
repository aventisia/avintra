meta {
  name: Insert uploaded doc
  type: http
  seq: 3
}

post {
  url: {{MLMODELBUILDER_APIS_BASE_URL}}/upload-doc/insert-file
  body: none
  auth: none
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody(
    [{
      mLModelId: "01955fbe-a5f0-7be6-add4-9a1ce445d0b6",
      name: faker.person.jobType(),
      extension: "PDF",
      size: 304889,
      type:"Testing",
      path: "/files/4bb3f813-4444-429e-badd-890b7b2b6503.pdf"
    }
    ])
}

meta {
  name: Insert annotation data
  type: http
  seq: 3
}

post {
  url: {{MLMODELBUILDER_APIS_BASE_URL}}/annotation-data/
  body: none
  auth: none
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    mlModelId: bru.getGlobalEnvVar("MLMODEL_ID"),
    uploadedDocId: "01953be3-43e6-77ab-a4bb-2431853302a9",
    annotationData: faker.lorem.sentence(),
  })
}

script:post-response {
  if(res.getStatus() == 200){
    bru.setGlobalEnvVar(
    "DATA_ID",
    res.getBody().data.id
    );
  }
}

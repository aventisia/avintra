meta {
  name: Update annotation data
  type: http
  seq: 4
}

put {
  url: {{MLMODELBUILDER_APIS_BASE_URL}}/annotation-data/
  body: none
  auth: none
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    id: bru.getGlobalEnvVar("DATA_ID"),
    mlModelId: bru.getGlobalEnvVar("MLMODEL_ID"),
    uploadedDocId: "01953be3-43e6-77ab-a4bb-2431853302a9",
    annotationData: faker.lorem.sentence(),
  })
}

meta {
  name: Update ml model
  type: http
  seq: 3
}

put {
  url: {{MLMODELBUILDER_APIS_BASE_URL}}/ml-model/
  body: none
  auth: none
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    Id: bru.getGlobalEnvVar("MLMODEL_ID"),
    Name: faker.person.jobType(),
    Type: "Extraction",
    LLM: "LLM1",
    Description: faker.lorem.sentence(),
    Status:"Active",
    TrainedOn: faker.date.anytime(),
    projectId:"ae254c81-4c1f-4ac3-a1b9-737bada9cb0e"
  })
}

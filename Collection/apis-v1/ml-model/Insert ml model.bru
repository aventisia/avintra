meta {
  name: Insert ml model
  type: http
  seq: 1
}

post {
  url: {{MLMODELBUILDER_APIS_BASE_URL}}/ml-model/
  body: none
  auth: none
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    Name: faker.person.jobType(),
    Type: "Extraction",
    Description: faker.lorem.sentence(),
    Status:"Active",
    TrainedOn: faker.date.anytime()
  })
}

script:post-response {
  if(res.getStatus() == 200){
    bru.setGlobalEnvVar(
    "MLMODEL_ID",
    res.getBody().data.id
    );
  }
}

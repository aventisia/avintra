meta {
  name: bank-statements
  type: http
  seq: 4
}

post {
  url: {{MLMODELBUILDER_APIS_BASE_URL}}/ml-model/
  body: none
  auth: none
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    name: "Bank statements",
    type: "Extraction",
    lLM: "gemma",
    description: "Bank statements",
    status:"Annotation",
    trainedOn: faker.date.anytime(),
    projectId:bru.getGlobalEnvVar("PROJECT_ID")
  })
}

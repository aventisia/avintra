meta {
  name: Update data field
  type: http
  seq: 4
}

put {
  url: {{MLMODELBUILDER_APIS_BASE_URL}}/data-field/
  body: none
  auth: none
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    Id: bru.getGlobalEnvVar("DATA_FIELD_ID"),
    MLModelId: bru.getGlobalEnvVar("MLMODEL_ID"),
    Name: "Liaison",
    Type: "Text",
    Color: faker.color.human(),
    Description: faker.lorem.sentence(),
  })
}

{
  "Project": "MLModelBuilderAPIs",
  "GeneralConfig": {
    "AppName": "AVENTISIA",
    "AppDomain": "www.aventisia.com",
    "Company": "AVENTISIA Technologies Private Limited"
  },
  "ConnectionStringConfig": {
    "AppDb": {
      "Credentials": "env_var",
      "Host": "env_var",
      "Database": "Database=AIModelBuilderDb;",
      "Other": "Include Error Detail=true"
    },
    "TenantDb": {
      "Credentials": "env_var",
      "Host": "env_var",
      "Database": "Database=AccountsDb;",
      "Other": "Include Error Detail=true"
    }
  },
  "TenantResolverConfig": {
    "TenantlessEndpoints": [],
    "TenantIdInHeaderEndpoints": ["post:/ai-models/execute"]
  },
  "CookiePolicyConfig": {
    "SameSiteMode": "None",
    "Domain": ".aventisia.com"
  },
  "JwtConfig": {
    "Issuer": "https://aventisia.com",
    "Audience": "https://aventisia.com",
    "SecretKey": "env_var"
  },
  "FileUploadConfig": {
    "UploadDirectory": "/var/www/aventisia.com/files",
    "AllowedFileTypes": {
      "Documents": {
        "AllowedFileExtensions": [
          ".pdf",
          ".docx",
          ".xlsx",
          ".csv",
          ".rtf",
          ".odt",
          ".md",
          ".txt"
        ],
        "MaxSizeMB": 20
      },
      "Audio": {
        "AllowedFileExtensions": [
          ".mp3",
          ".aac",
          ".wav",
          ".ogg",
          ".oga",
          ".opus"
        ],
        "MaxSizeMB": 50
      },
      "Pictures": {
        "AllowedFileExtensions": [
          ".jpg",
          ".jpeg",
          ".png",
          ".bmp",
          ".tiff",
          ".tif"
        ],
        "MaxSizeMB": 50
      },
      "Videos": {
        "AllowedFileExtensions": [".avi", ".mp4", ".mpeg", ".webm"],
        "MaxSizeMB": 100
      }
    }
  },
  "SmtpConfig": {
    "Host": "smtp.sendgrid.net",
    "Port": 465,
    "Username": "apikey",
    "ApiKey": "env_var",
    "MailFromName": "Aventisia Technologies",
    "MailFromAddress": "accounts@aventisia.com"
  },
  "ExtractViaLLMConfig": {
    "LLMPipelineAPI": "https://llmpipeline.aventisia.com/api",
    "LLMPipelineAPIKey": "",
    "OllamaAPI": "https://llm.aventisia.com:8443/api",
    "OllamaAPIKey": ""
  },
  "OpenAIConfig": {
    "OpenAIApiUrl": "https://api.openai.com/v1/chat/completions",
    "OpenAIApiKey": ""
  },
  "RateLimiterConfig": {
    "Endpoints": [],
    "Default": {
      "PermitLimit": 50,
      "WindowInMinutes": 1,
      "QueueLimit": 5
    }
  },  
  "CorsOrigins": [
    "https://aventisia.com",
    "https://www.aventisia.com",
    "https://accounts.aventisia.com",
    "https://worc.aventisia.com",
    "https://agentbuilder.aventisia.com",
    "https://aistudio.aventisia.com"

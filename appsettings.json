{
  "Project": "WorkspaceAPIs",
  "GeneralConfig": {
    "AppName": "AVENTISIA",
    "AppDomain": "aventisia.com",
    "Company": "AVENTISIA Technologies Private Limited"
  },
  "ConnectionStringConfig": {
    "AppDb": {
      "Credentials": "env_var",
      "Host": "env_var",
      "Database": "Database=WorkspaceDb;",
      "Other": "Include Error Detail=true"
    },
    "TenantDb": {
      "Credentials": "env_var",
      "Host": "env_var",
      "Database": "Database=AccountsDb;",
      "Other": "Include Error Detail=true"
    }
  },
  "TenantResolverConfig": {
    "TenantlessEndpoints": [
      "get:/template/trending",
      "get:/template/search",
      "get:/template",
      "post:/machine/validate",
      "get:/project/usage"
    ],
    "TenantIdInHeaderEndpoints": [
      "post:/queue-transaction/data-items"
    ]
  },
  "CookiePolicyConfig": {
    "SameSiteMode": "None",
    "Domain": ".aventisia.com"
  },
  "JwtConfig": {
    "Issuer": "https://aventisia.com",
    "Audience": "https://aventisia.com",
    "SecretKey": "env_var"
  },
  "SmtpConfig": {
    "Host": "smtp.sendgrid.net",
    "Port": 465,
    "Username": "apikey",
    "ApiKey": "env_var",
    "MailFromName": "Aventisia Technologies",
    "MailFromAddress": "accounts@aventisia.com"
  },
  "FileUploadConfig": {
    "UploadDirectory": "/var/www/aventisia.com/files",
    "TempUploadDirectory": "/var/www/aventisia.com/temp-files",
    "AllowedFileTypes": {
      "Pictures": {
        "AllowedFileExtensions": [".jpg", ".jpeg", ".png", ".webp"],
        "MaxSizeMB": 5
      },
      "Documents": {
        "AllowedFileExtensions": [".csv", ".doc", ".docx", ".pdf", ".ppt", ".pptx", ".txt", ".xls", ".xlsx", ".zip", ".json"],
        "MaxSizeMB": 10
      },
      "Videos": {
        "AllowedFileExtensions": [".avi", ".mp4", ".mpeg", ".webm"],
        "MaxSizeMB": 15
      }
    }
  },
  "RateLimiterConfig": {
    "Endpoints": [],
    "Default": {
      "PermitLimit": 50,
      "WindowInMinutes": 1,
      "QueueLimit": 5
    }
  },  
  "CorsOrigins": [
    "https://aventisia.com",
    "https://www.aventisia.com",
    "https://accounts.aventisia.com",
    "https://worc.aventisia.com",
    "https://agentbuilder.aventisia.com",

{
  "Project": "MLModelBuilderAPIs",
  "GeneralConfig": {
    "AppName": "AVENTISIA",
    "AppDomain": "www.aventisia.com",
    "Company": "AVENTISIA Technologies Private Limited"
  },
  "ConnectionStringConfig": {
    "AppDb": {
      "Credentials": "env_var",
      "Host": "env_var",
      "Database": "Database=MLModelBuilderDb;",
      "Other": "Include Error Detail=true"
    },
    "TenantDb": {
      "Credentials": "env_var",
      "Host": "env_var",
      "Database": "Database=AccountsDb;",
      "Other": "Include Error Detail=true"
    }
  },
  "TenantResolverConfig": {
    "TenantlessEndpoints": [],
    "TenantIdInHeaderEndpoints": []
  },
  "CookiePolicyConfig": {
    "SameSiteMode": "None",
    "Domain": ".aventisia.com"
  },
  "JwtConfig": {
    "Issuer": "https://aventisia.com",
    "Audience": "https://aventisia.com",
    "SecretKey": "env_var"
  },
  "FileUploadConfig": {
    "UploadDirectory": "/var/www/aventisia.com/files",
    "AllowedFileTypes": {
      "Pictures": {
        "AllowedFileExtensions": [".jpg", ".jpeg", ".png", ".webp", ".gif"],
        "MaxSizeMB": 5
      },
      "Documents": {
        "AllowedFileExtensions": [".csv", ".doc", ".docx", ".pdf", ".ppt", ".pptx", ".txt", ".xls", ".xlsx", ".zip "],
        "MaxSizeMB": 10
      },
      "Videos": {
        "AllowedFileExtensions": [".avi", ".mp4", ".mpeg", ".webm"],
        "MaxSizeMB": 15
      },
      "Audio": {
      "AllowedFileExtensions": [".mp3", ".wav", ".aac", ".ogg", ".oga", ".flac", ".m4a", ".opus"],
      "MaxSizeMB": 10
      }
    }
  },
  "SmtpConfig": {
    "Host": "smtp.sendgrid.net",
    "Port": 465,
    "Username": "apikey",
    "ApiKey": "env_var",
    "MailFromName": "Aventisia Technologies",
    "MailFromAddress": "accounts@aventisia.com"
  },
  "ExtractViaLLMConfig": {
    "LLMPipelineAPI": "https://llmpipeline.aventisia.com/api/extract-pdf-text",
    "LLMPipelineAPIKey": "",
    "OllamaAPI": "https://llm.aventisia.com:8443/api",
    "OllamaAPIKey": ""
  },
  "RateLimiterConfig": { "TODO": "Add rate limiter config" },
  "CorsOrigins": [
    "https://aventisia.com",
    "https://www.aventisia.com",
    "https://accounts.aventisia.com",
    "https://workspace.aventisia.com",
    "https://flowbuilder.aventisia.com",
    "https://mlmodelbuilder.aventisia.com"
  ],
  "AllowedHosts": "localhost;aventisia.com;www.aventisia.com;accounts.aventisia.com;workspace.aventisia.com;flowbuilder.aventisia.com;mlmodelbuilder.aventisia.com"
}

  "AllowedHosts": "localhost;aventisia.com;www.aventisia.com;accounts.aventisia.com;worc.aventisia.com;agentbuilder.aventisia.com;aistudio.aventisia.com",
  "HttpClientUrlConfig": {
    "ModelStudioApisBaseUrl": "https://modelstudio.aventisia.com/api",
    "WorkspaceApisBaseUrl": "https://worc.aventisia.com/api",
    "AccountsApisBaseUrl": "https://accounts.aventisia.com/api",
    "LlmPipelineApisBaseUrl": "https://llmpipeline.aventisia.com/api",
    "GlobalAdminApisBaseUrl": "https://globaladmin.aventisia.com/api"

{
  "Project": "AccountsAPIs",
  "GeneralConfig": {
    "AppName": "Accounts",
    "AppDomain": "https://accounts.aventisia.com",
    "Company": "Aventisia Technologies Private Limited",
    "SalesEmails": "contact@aventisia.com"
  },
  "ConnectionStringConfig": {
    "AppDb": {
      "Credentials": "env_var",
      "Host": "env_var",
      "Database": "Database=AccountsDb;",
      "Other": "Include Error Detail=true"
    },
    "TenantDb": {
      "Credentials": "env_var",
      "Host": "env_var",
      "Database": "Database=AccountsDb;",
      "Other": "Include Error Detail=true"
    }
  },
  "TenantDefaultConfig": {
    "InactiveDaysBeforeDataExpires": 365,
    "IdleSessionTimeoutInMinutes": 10,
    "DaysBeforePwdExpires": 730
  },
  "DefaultUsersConfig": {
    "SuperUser": {
      "Email": "super.admin@aventisia.com",
      "FirstName": "Super",
      "LastName": "Admin",
      "Roles": ["SA", "GA", "GSA", "GLBA", "IU", "TA", "TSA", "TLBA", "TU", "IU", "AE"]
    },
    "IndividualUser": {
      "Email": "test@gmail.com",
      "FirstName": "Test",
      "LastName": "User",
      "Roles": ["IU"]
    }
  },
  "TenantResolverConfig": {
    "TenantlessEndpoints": [
      "get:/desktop-app/download",
      "get:/desktop-app/download/*",
      "get:/desktop-app/update/*",
      "post:/contact-us",
      "put:/me/refresh-session",
      "post:/auth/is-email-available",
      "post:/auth/create-account",
      "post:/auth/create-code",
      "post:/auth/verify-code",
      "post:/auth/tenant-info",
      "post:/auth/login",
      "post:/auth/verify-2fa-code",
      "post:/auth/tenant-sso",
      "post:/auth/siw-google",
      "post:/auth/siw-ms",
      "post:/auth/siw-github"
    ],
    "TenantIdInHeaderEndpoints": []
  },
  "ExternalAPIsConfig": {
    "WorkspaceUser": "http://localhost:4001/api/user",
    "ModelBuilderUser": "http://localhost:4002/api/user"
  },
  "CookiePolicyConfig": {
    "SameSiteMode": "None",
    "Domain": ".aventisia.com"
  },
  "VerificationCodeConfig": {
    "ValidityInMinutes": 5,
    "NumberOfCharacters": 6,
    "IsAlphaNumeric": false
  },
  "IdentityConfig": {
    "MaxActiveSessionAllowed": 50,
    "ObsoletePwdRetainLimit": 5,
    "DefaultLockoutTimeSpanInMinutes": 10,
    "LockoutMaxFailedAccessAttempts": 3,
    "SignInRequireConfirmedAccount": true,
    "SignInRequireConfirmedEmail": true,
    "SignInRequireConfirmedPhoneNo": false
  },
  "JwtConfig": {
    "Issuer": "https://aventisia.com",
    "Audience": "https://aventisia.com",
    "SecretKey": "env_var",
    "PwdResetJwtValidityInMinutes": 10,
    "AuthJwtValidityInMinutes": 60,
    "RefreshTokenValidityInDays": 30
  },
  "SmtpConfig": {
    "Host": "smtp.sendgrid.net",
    "Port": 465,
    "Username": "apikey",
    "ApiKey": "env_var",
    "MailFromName": "Aventisia Technologies",
    "MailFromAddress": "accounts@aventisia.com"
  },
  "FileUploadConfig": {
    "UploadDirectory": "/var/www/aventisia.com/files",
    "AllowedFileTypes": {
      "Pictures": {
        "AllowedFileExtensions": [".jpg", ".jpeg", ".png", ".webp"],
        "MaxSizeMB": 5
      },
      "Documents": {
        "AllowedFileExtensions": [".csv", ".doc", ".docx", ".pdf", ".ppt", ".pptx", ".txt", ".xls", ".xlsx", ".zip", ".json"],
        "MaxSizeMB": 10
      },
      "Videos": {
        "AllowedFileExtensions": [".avi", ".mp4", ".mpeg", ".webm"],
        "MaxSizeMB": 15
      }
    }
  },
  "RateLimiterConfig": { "TODO": "Add rate limiter config" },
  "CorsOrigins": [
    "https://aventisia.com",
    "https://www.aventisia.com",
    "https://accounts.aventisia.com",
    "https://worc.aventisia.com",
    "https://agentbuilder.aventisia.com",
    "https://mlmodelbuilder.aventisia.com"
  ],
  "AllowedHosts": "localhost;aventisia.com;www.aventisia.com;accounts.aventisia.com;worc.aventisia.com;agentbuilder.aventisia.com;mlmodelbuilder.aventisia.com",
  "HttpClientUrlConfig": {
    "ModelStudioApisBaseUrl": "https://modelstudio.aventisia.com/api",
    "WorkspaceApisBaseUrl": "https://worc.aventisia.com/api",
    "AccountsApisBaseUrl": "https://accounts.aventisia.com/api",
    "LlmPipelineApisBaseUrl": "https://llmpipeline.aventisia.com/api"
  }
}

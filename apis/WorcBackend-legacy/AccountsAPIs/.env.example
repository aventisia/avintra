# AccountsAPIs local settings. Copy to .env.local (gitignored); scripts/initial-setup.sh does this.
# Loaded only when ASPNETCORE_ENVIRONMENT=Localhost, with this directory as the working
# directory. Values here override the OS environment. scripts/initial-setup.sh fills each
# __GENERATED_BY_INITIAL_SETUP__ key, reusing an OS environment value when one is set.
# Full list: apis/WorcBackend-legacy/AspNetToolkit/Extensions/EnvironmentConfigurationExtension.cs

ASPNETCORE_URLS=http://localhost:4000

ACCOUNTS_API_BASE_URL=http://localhost:4000
WORKSPACE_API_BASE_URL=http://localhost:4001
LLMPIPELINE_API_BASE_URL=http://localhost:4003
CAMEL_API_BASE_URL=http://localhost:4005
CORSAIR_API_BASE_URL=http://localhost:4006

# Required; replace the admin email and PostgreSQL credentials with your own
APP_BASE_URL=local-avintra.aventisia.com
ON_PREM_ADMIN_EMAIL=admin@aventisia.com
POSTGRESQL_HOST=localhost
POSTGRESQL_PORT=5432
POSTGRESQL_USERNAME=postgres
POSTGRESQL_PASSWORD=postgres

# Required secrets, generated by initial-setup. JWT_SECRET_KEY must match WorkspaceAPIs and llmpipeline.
# To set your own: JWT_SECRET_KEY `openssl rand -base64 64 | tr -d '\n'`, AES_ENCRYPTION_KEY
# `openssl rand -base64 32`, AES_INITIALIZATION_VECTOR `openssl rand -base64 16` (both AES values stay Base64).
JWT_SECRET_KEY=__GENERATED_BY_INITIAL_SETUP__
AES_ENCRYPTION_KEY=__GENERATED_BY_INITIAL_SETUP__
AES_INITIALIZATION_VECTOR=__GENERATED_BY_INITIAL_SETUP__
# Local Azure Storage emulator (Azurite); replace with a real connection string to use Azure
AZURE_BLOB_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true

# Required for a Commercial tenant with RAZORPAY_ENABLED=true
# RAZORPAY_ENABLED=false
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Optional: leave both unset to run as a Community deployment
# ON_PREM_TENANT_ID=
# ON_PREM_INSTANCE_KEY=

# Optional
# POSTGRESQL_ACCOUNTS_DB_NAME=AccountsDb
# EXTRA_CORS_ORIGINS=
# EXTRA_ALLOWED_HOSTS=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_MAIL_FROM_NAME=
# SMTP_MAIL_FROM_ADDRESS=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# DEEPINFRA_API_KEY=
# OPENROUTER_API_KEY=
# BRANDING_*: see the "Deployment branding" section of README.md

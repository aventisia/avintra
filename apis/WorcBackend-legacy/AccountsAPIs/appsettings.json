{
  "EnvironmentConfig": {
    "AppBaseUrl": "env_var",
    "OnPremTenantId": "env_var",
    "OnPremInstanceKey": "env_var",
    "OnPremAdminEmail": "env_var",
    "OnPremTenantType": "env_var",
    "OnPremTenantName": "env_var",
    "OnPremInstanceType": "env_var",
    "OnPremContractStart": "0001-01-01T00:00:00",
    "OnPremContractEnd": "0001-01-01T00:00:00",
    "OnPremExecutionTimeAllowed": 0,
    "OnPremExecutionDisabled": true,
    "OnPremLoginDisabled": true,
    "PostgresqlHost": "env_var",
    "PostgresqlPort": 5432,
    "PostgresqlUsername": "env_var",
    "PostgresqlPassword": "env_var",
    "AzureBlobStorageConnectionString": "env_var",
    "AzureEntraIdEnabled": false,
    "AzureTenantId": "env_var",
    "AzureEntraIdClientId": "env_var",
    "AzureEntraIdClientSecret": "env_var",
    "JwtSecretKey": "env_var",
    "JwtValidityInMinutes": 60,
    "JwtRefreshTokenValidityInDays": 30,
    "SmtpHost": "env_var",
    "SmtpPort": 0,
    "SmtpUser": "env_var",
    "SmtpPassword": "env_var",
    "SmtpMailFromName": "env_var",
    "SmtpMailFromAddress": "env_var",
    "AesEncryptionKey": "env_var",
    "AesInitializationVector": "env_var",
    "RazorpayEnabled": false,
    "RazorpayKeyId": "env_var",
    "RazorpayKeySecret": "env_var",
    "RazorpayWebhookSecret": "env_var",
    "OpenAiApiKey": "env_var",
    "DeepInfraApiKey": "env_var",
    "GeminiApiKey": "env_var",
    "OpenRouterApiKey": "env_var",
    "AccountsApiBaseUrl": "http://accounts-apis:4000",
    "WorcApiBaseUrl": "http://worc-apis:4001",
    "AiStudioApiBaseUrl": "http://aistudio-apis:4002",
    "LlmPipelineApiBaseUrl": "http://llmpipeline-apis:4003",
    "SalesEmails": "contact@aventisia.com,kaushal@aventisia.com",
    "MaxActiveSessionAllowed": 50,
    "ObsoletePwdRetainLimit": 5,
    "DefaultLockoutTimeSpanInMinutes": 10,
    "LockoutMaxFailedAccessAttempts": 3,
    "OtpValidityInMinutes": 5,
    "OtpNumberOfCharacters": 6,
    "OtpIsAlphaNumeric": false
  },
  "AppDefaultConfig": {
    "ProjectName": "Accounts APIs",
    "ProjectDescription": "APIs for user authentication and management for Aventisia Applications",
    "PlatformVersion": "0.1.44",
    "GlobalAdminApiBaseUrl": "https://globaladmin.aventisia.com",
    "TenantlessEndpoints": [
      "get:/desktop-app/download",
      "get:/desktop-app/download/*",
      "get:/desktop-app/update/*",
      "post:/contact-us",
      "put:/me/refresh-session",
      "post:/auth/is-email-available",
      "post:/auth/create-account",
      "post:/auth/create-code",
      "post:/auth/verify-code",
      "post:/auth/tenant-info",
      "post:/auth/login",
      "post:/auth/verify-2fa-code",
      "post:/auth/tenant-sso",
      "post:/auth/siw-google",
      "post:/auth/siw-ms",
      "post:/auth/siw-github",
      "post:/auth/create-user-account",
      "post:/webhook",
      "get:/tenant-subscriptions/retention",
      "get:/auth/entra/login-url",
      "get:/auth/entra/token"
    ],
    "TenantIdInHeaderEndpoints": [
      "delete:/sa/tenant",
      "post:/sa/auth/tenant/token"
    ],
    // TODO: Need to Adjust FileUploadConfig in new format
    "FileUploadConfig": {
      "UploadDirectory": "/var/www/aventisia.com/files",
      "AllowedFileTypes": {
        "Pictures": {
          "AllowedFileExtensions": [
            ".jpg",
            ".jpeg",
            ".png",
            ".webp"
          ],
          "MaxSizeMB": 5
        },
        "Documents": {
          "AllowedFileExtensions": [
            ".csv",
            ".doc",
            ".docx",
            ".pdf",
            ".ppt",
            ".pptx",
            ".txt",
            ".xls",
            ".xlsx",
            ".zip",
            ".json"
          ],
          "MaxSizeMB": 10
        },
        "Videos": {
          "AllowedFileExtensions": [
            ".avi",
            ".mp4",
            ".mpeg",
            ".webm"
          ],
          "MaxSizeMB": 15
        }
      }
    },
    // TODO: Need to Adjust RateLimiterConfig in new format
    "RateLimiterConfig": {
      "Endpoints": [
        {
          "Path": "/auth/create-code",
          "PermitLimit": 2,
          "WindowInMinutes": 1
        }
      ],
      "Default": {
        "PermitLimit": 50,
        "WindowInMinutes": 1,
        "QueueLimit": 5
      }
    }
  }
}
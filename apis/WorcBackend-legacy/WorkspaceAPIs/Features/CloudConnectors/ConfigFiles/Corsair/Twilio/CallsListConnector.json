{
  "name": "Corsair/Twilio/CallsListConnector",
  "description": "List call records with optional filters",
  "version": "1.0.0",
  "author": "@aventisia",
  "supportedPlatforms": [
    "cloud"
  ],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "credentials-select",
      "name": "__CredentialName__Twilio",
      "label": "Twilio Credential",
      "description": "Select Twilio credentials used to authenticate the request.",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "To",
      "label": "To",
      "description": "",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "From",
      "label": "From",
      "description": "",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "Status",
      "label": "Status",
      "description": "",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "StartTime",
      "label": "Start Time",
      "description": "",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "EndTime",
      "label": "End Time",
      "description": "",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "number",
      "name": "PageSize",
      "label": "Page Size",
      "description": "",
      "defaultValue": 0
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "Result",
      "label": "Result",
      "description": "Returns the response data from the connector.",
      "defaultValue": {
        "value": "Result",
        "enabled": true
      }
    }
  ]
}

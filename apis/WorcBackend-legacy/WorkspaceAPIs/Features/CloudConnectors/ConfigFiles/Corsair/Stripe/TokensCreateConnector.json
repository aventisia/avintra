{
  "name": "Corsair/Stripe/TokensCreateConnector",
  "description": "Create a Stripe token",
  "version": "1.0.0",
  "author": "@aventisia",
  "supportedPlatforms": [
    "cloud"
  ],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "credentials-select",
      "name": "__CredentialName__Stripe",
      "label": "Stripe Credential",
      "description": "Select Stripe credentials used to authenticate the request.",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "json-editor",
      "name": "card",
      "label": "Card",
      "description": "",
      "defaultValue": "{}"
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "bank_account",
      "label": "Bank Account",
      "description": "",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "pii",
      "label": "Pii",
      "description": "",
      "defaultValue": ""
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "Result",
      "label": "Result",
      "description": "Returns the response data from the connector.",
      "defaultValue": {
        "value": "Result",
        "enabled": true
      }
    }
  ]
}

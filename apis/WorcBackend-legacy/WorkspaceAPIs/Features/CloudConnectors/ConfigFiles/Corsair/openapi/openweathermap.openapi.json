{
  "openapi": "3.0.1",
  "info": {
    "title": "Corsair openweathermap connector (from sidecar descriptors)",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.openweathermap.org/data/2.5"
    }
  ],
  "paths": {
    "/corsair/openweathermap/weather.oneCall": {
      "post": {
        "operationId": "openweathermap.weather.oneCall",
        "summary": "Get current weather, minutely/hourly/daily forecasts, and weather alerts for a location",
        "description": "Get current weather, minutely/hourly/daily forecasts, and weather alerts for a location",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "lat": {
                    "type": "number"
                  },
                  "lon": {
                    "type": "number"
                  },
                  "exclude": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "units": {
                    "type": "string"
                  },
                  "lang": {
                    "type": "string"
                  }
                },
                "required": [
                  "lat",
                  "lon"
                ]
              }
            }
          },
          "required": false
        }
      }
    },
    "/corsair/openweathermap/history.timeMachine": {
      "post": {
        "operationId": "openweathermap.history.timeMachine",
        "summary": "Get historical weather data for a specific timestamp (available from 1979-01-01)",
        "description": "Get historical weather data for a specific timestamp (available from 1979-01-01)",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "lat": {
                    "type": "number"
                  },
                  "lon": {
                    "type": "number"
                  },
                  "dt": {
                    "type": "number"
                  },
                  "units": {
                    "type": "string"
                  },
                  "lang": {
                    "type": "string"
                  }
                },
                "required": [
                  "lat",
                  "lon",
                  "dt"
                ]
              }
            }
          },
          "required": false
        }
      }
    },
    "/corsair/openweathermap/summary.daySummary": {
      "post": {
        "operationId": "openweathermap.summary.daySummary",
        "summary": "Get aggregated weather summary for a specific date (temperature, wind, precipitation)",
        "description": "Get aggregated weather summary for a specific date (temperature, wind, precipitation)",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "lat": {
                    "type": "number"
                  },
                  "lon": {
                    "type": "number"
                  },
                  "date": {
                    "type": "string"
                  },
                  "units": {
                    "type": "string"
                  },
                  "lang": {
                    "type": "string"
                  },
                  "tz": {
                    "type": "string"
                  }
                },
                "required": [
                  "lat",
                  "lon",
                  "date"
                ]
              }
            }
          },
          "required": false
        }
      }
    },
    "/corsair/openweathermap/summary.overview": {
      "post": {
        "operationId": "openweathermap.summary.overview",
        "summary": "Get a human-readable weather overview text for a location and date",
        "description": "Get a human-readable weather overview text for a location and date",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "lat": {
                    "type": "number"
                  },
                  "lon": {
                    "type": "number"
                  },
                  "date": {
                    "type": "string"
                  },
                  "units": {
                    "type": "string"
                  }
                },
                "required": [
                  "lat",
                  "lon"
                ]
              }
            }
          },
          "required": false
        }
      }
    }
  }
}

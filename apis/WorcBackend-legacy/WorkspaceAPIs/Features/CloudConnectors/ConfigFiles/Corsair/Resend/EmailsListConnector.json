{
  "name": "Corsair/Resend/EmailsListConnector",
  "description": "List sent emails",
  "version": "1.0.0",
  "author": "@aventisia",
  "supportedPlatforms": [
    "cloud"
  ],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "credentials-select",
      "name": "__CredentialName__Resend",
      "label": "Resend Credential",
      "description": "Select Resend credentials used to authenticate the request.",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "number",
      "name": "limit",
      "label": "Limit",
      "description": "",
      "defaultValue": 0
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "cursor",
      "label": "Cursor",
      "description": "",
      "defaultValue": ""
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "Result",
      "label": "Result",
      "description": "Returns the response data from the connector.",
      "defaultValue": {
        "value": "Result",
        "enabled": true
      }
    }
  ]
}

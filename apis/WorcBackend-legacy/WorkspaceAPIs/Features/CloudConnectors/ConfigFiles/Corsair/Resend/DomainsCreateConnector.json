{
  "name": "Corsair/Resend/DomainsCreateConnector",
  "description": "Add a new sending domain",
  "version": "1.0.0",
  "author": "@aventisia",
  "supportedPlatforms": [
    "cloud"
  ],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",

        {
          "label": "us-east-1",
          "value": "us-east-1",
          "description": "us-east-1"
        },
        {
          "label": "eu-west-1",
          "value": "eu-west-1",
          "description": "eu-west-1"
        },
        {
          "label": "sa-east-1",
          "value": "sa-east-1",
          "description": "sa-east-1"
        }
      ]
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "Result",
      "label": "Result",

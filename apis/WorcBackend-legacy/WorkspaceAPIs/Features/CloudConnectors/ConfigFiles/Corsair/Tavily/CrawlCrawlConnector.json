{
  "name": "Corsair/Tavily/CrawlCrawlConnector",
  "description": "Crawl a website starting from a root URL",
  "version": "1.0.0",
  "author": "@aventisia",
  "supportedPlatforms": [
    "cloud"
  ],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "credentials-select",
      "name": "__CredentialName__Tavily",
      "label": "Tavily Credential",
      "description": "Select Tavily credentials used to authenticate the request.",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "url",
      "label": "Url",
      "description": "",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "number",
      "name": "max_depth",
      "label": "Max Depth",
      "description": "",
      "defaultValue": 0
    },
    {
      "direction": "Input",
      "type": "number",
      "name": "max_breadth",
      "label": "Max Breadth",
      "description": "",
      "defaultValue": 0
    },
    {
      "direction": "Input",
      "type": "number",
      "name": "limit",
      "label": "Limit",
      "description": "",
      "defaultValue": 0
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "instructions",
      "label": "Instructions",
      "description": "",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "tag-input",
      "name": "select_paths",
      "label": "Select Paths",
      "description": "",
      "defaultValue": []
    },
    {
      "direction": "Input",
      "type": "tag-input",
      "name": "select_domains",
      "label": "Select Domains",
      "description": "",
      "defaultValue": []
    },
    {
      "direction": "Input",
      "type": "tag-input",
      "name": "exclude_paths",
      "label": "Exclude Paths",
      "description": "",
      "defaultValue": []
    },
    {
      "direction": "Input",
      "type": "tag-input",
      "name": "exclude_domains",
      "label": "Exclude Domains",
      "description": "",
      "defaultValue": []
    },
    {
      "direction": "Input",
      "type": "checkbox",
      "name": "allow_external",
      "label": "Allow External",
      "description": "",
      "defaultValue": false
    },
    {
      "direction": "Input",
      "type": "tag-input",
      "name": "categories",
      "label": "Categories",
      "description": "",
      "defaultValue": []
    },
    {
      "direction": "Input",
      "type": "select",
      "name": "extract_depth",
      "label": "Extract Depth",
      "description": "",
      "defaultValue": "basic",
      "selectOptions": [
        {
          "label": "basic",
          "value": "basic",
          "description": "basic"
        },
        {
          "label": "advanced",
          "value": "advanced",
          "description": "advanced"
        }
      ]
    },
    {
      "direction": "Input",
      "type": "select",
      "name": "format",
      "label": "Format",
      "description": "",
      "defaultValue": "markdown",
      "selectOptions": [
        {
          "label": "markdown",
          "value": "markdown",
          "description": "markdown"
        },
        {
          "label": "text",
          "value": "text",
          "description": "text"
        }
      ]
    },
    {
      "direction": "Input",
      "type": "checkbox",
      "name": "include_images",
      "label": "Include Images",
      "description": "",
      "defaultValue": false
    },
    {
      "direction": "Input",
      "type": "checkbox",
      "name": "include_favicon",
      "label": "Include Favicon",
      "description": "",
      "defaultValue": false
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "Result",
      "label": "Result",
      "description": "Returns the response data from the connector.",
      "defaultValue": {
        "value": "Result",
        "enabled": true
      }
    }
  ]
}

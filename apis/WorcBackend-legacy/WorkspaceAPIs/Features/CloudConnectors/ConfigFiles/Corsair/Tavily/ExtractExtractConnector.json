{
  "name": "Corsair/Tavily/ExtractExtractConnector",
  "description": "Extract content from one or more URLs",
  "version": "1.0.0",
  "author": "@aventisia",
  "supportedPlatforms": [
    "cloud"
  ],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "credentials-select",
      "name": "__CredentialName__Tavily",
      "label": "Tavily Credential",
      "description": "Select Tavily credentials used to authenticate the request.",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "urls",
      "label": "Urls",
      "description": "",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "checkbox",
      "name": "include_images",
      "label": "Include Images",
      "description": "",
      "defaultValue": false
    },
    {
      "direction": "Input",
      "type": "select",
      "name": "extract_depth",
      "label": "Extract Depth",
      "description": "",
      "defaultValue": "basic",
      "selectOptions": [
        {
          "label": "basic",
          "value": "basic",
          "description": "basic"
        },
        {
          "label": "advanced",
          "value": "advanced",
          "description": "advanced"
        }
      ]
    },
    {
      "direction": "Input",
      "type": "select",
      "name": "format",
      "label": "Format",
      "description": "",
      "defaultValue": "markdown",
      "selectOptions": [
        {
          "label": "markdown",
          "value": "markdown",
          "description": "markdown"
        },
        {
          "label": "text",
          "value": "text",
          "description": "text"
        }
      ]
    },
    {
      "direction": "Input",
      "type": "checkbox",
      "name": "include_favicon",
      "label": "Include Favicon",
      "description": "",
      "defaultValue": false
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "Result",
      "label": "Result",
      "description": "Returns the response data from the connector.",
      "defaultValue": {
        "value": "Result",
        "enabled": true
      }
    }
  ]
}

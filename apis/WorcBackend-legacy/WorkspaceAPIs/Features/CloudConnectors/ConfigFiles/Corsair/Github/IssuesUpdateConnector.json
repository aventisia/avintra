{
  "name": "Corsair/Github/IssuesUpdateConnector",
  "description": "Update an existing issue",
  "version": "1.0.0",
  "author": "@aventisia",
  "supportedPlatforms": [
    "cloud"
  ],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "credentials-select",
      "name": "__CredentialName__GitHub",
      "label": "GitHub Credential",
      "description": "Select GitHub credentials used to authenticate the request.",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "owner",
      "label": "Owner",
      "description": "",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "repo",
      "label": "Repo",
      "description": "",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "number",
      "name": "issueNumber",
      "label": "Issue Number",
      "description": "",
      "defaultValue": 0,
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "title",
      "label": "Title",
      "description": "",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "body",
      "label": "Body",
      "description": "",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "assignee",
      "label": "Assignee",
      "description": "",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "select",
      "name": "state",
      "label": "State",
      "description": "",
      "defaultValue": "open",
      "selectOptions": [
        {
          "label": "open",
          "value": "open",
          "description": "open"
        },
        {
          "label": "closed",
          "value": "closed",
          "description": "closed"
        }
      ]
    },
    {
      "direction": "Input",
      "type": "select",
      "name": "stateReason",
      "label": "State Reason",
      "description": "",
      "defaultValue": "completed",
      "selectOptions": [
        {
          "label": "completed",
          "value": "completed",
          "description": "completed"
        },
        {
          "label": "not_planned",
          "value": "not_planned",
          "description": "not_planned"
        },
        {
          "label": "duplicate",
          "value": "duplicate",
          "description": "duplicate"
        },
        {
          "label": "reopened",
          "value": "reopened",
          "description": "reopened"
        }
      ]
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "milestone",
      "label": "Milestone",
      "description": "",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "tag-input",
      "name": "labels",
      "label": "Labels",
      "description": "",
      "defaultValue": []
    },
    {
      "direction": "Input",
      "type": "tag-input",
      "name": "assignees",
      "label": "Assignees",
      "description": "",
      "defaultValue": []
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "Result",
      "label": "Result",
      "description": "Returns the response data from the connector.",
      "defaultValue": {
        "value": "Result",
        "enabled": true
      }
    }
  ]
}

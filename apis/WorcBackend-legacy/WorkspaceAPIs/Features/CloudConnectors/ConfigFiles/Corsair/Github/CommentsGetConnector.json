{
  "name": "Corsair/Github/CommentsGetConnector",
  "description": "Get a specific comment",
  "version": "1.0.0",
  "author": "@aventisia",
  "supportedPlatforms": [
    "cloud"
  ],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "credentials-select",
      "name": "__CredentialName__GitHub",
      "label": "GitHub Credential",
      "description": "Select GitHub credentials used to authenticate the request.",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "owner",
      "label": "Owner",
      "description": "",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "repo",
      "label": "Repo",
      "description": "",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "number",
      "name": "commentId",
      "label": "Comment Id",
      "description": "",
      "defaultValue": 0,
      "required": true
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "Result",
      "label": "Result",
      "description": "Returns the response data from the connector.",
      "defaultValue": {
        "value": "Result",
        "enabled": true
      }
    }
  ]
}

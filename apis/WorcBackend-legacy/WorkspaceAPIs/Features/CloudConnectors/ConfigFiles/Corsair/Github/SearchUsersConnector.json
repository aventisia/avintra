{
  "name": "Corsair/Github/SearchUsersConnector",
  "description": "Search GitHub users and organizations",
  "version": "1.0.0",
  "author": "@aventisia",
  "supportedPlatforms": [
    "cloud"
  ],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "credentials-select",
      "name": "__CredentialName__GitHub",
      "label": "GitHub Credential",
      "description": "Select GitHub credentials used to authenticate the request.",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "q",
      "label": "Q",
      "description": "",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "select",
      "name": "sort",
      "label": "Sort",
      "description": "",
      "defaultValue": "followers",
      "selectOptions": [
        {
          "label": "followers",
          "value": "followers",
          "description": "followers"
        },
        {
          "label": "repositories",
          "value": "repositories",
          "description": "repositories"
        },
        {
          "label": "joined",
          "value": "joined",
          "description": "joined"
        }
      ]
    },
    {
      "direction": "Input",
      "type": "select",
      "name": "order",
      "label": "Order",
      "description": "",
      "defaultValue": "asc",
      "selectOptions": [
        {
          "label": "asc",
          "value": "asc",
          "description": "asc"
        },
        {
          "label": "desc",
          "value": "desc",
          "description": "desc"
        }
      ]
    },
    {
      "direction": "Input",
      "type": "number",
      "name": "perPage",
      "label": "Per Page",
      "description": "",
      "defaultValue": 0
    },
    {
      "direction": "Input",
      "type": "number",
      "name": "page",
      "label": "Page",
      "description": "",
      "defaultValue": 0
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "Result",
      "label": "Result",
      "description": "Returns the response data from the connector.",
      "defaultValue": {
        "value": "Result",
        "enabled": true
      }
    }
  ]
}

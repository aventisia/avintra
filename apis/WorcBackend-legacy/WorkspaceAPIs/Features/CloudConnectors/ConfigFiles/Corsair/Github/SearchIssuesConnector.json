{
  "name": "Corsair/Github/SearchIssuesConnector",
  "description": "Search GitHub issues and pull requests",
  "version": "1.0.0",
  "author": "@aventisia",
  "supportedPlatforms": [
    "cloud"
  ],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "credentials-select",
      "name": "__CredentialName__GitHub",
      "label": "GitHub Credential",
      "description": "Select GitHub credentials used to authenticate the request.",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "q",
      "label": "Q",
      "description": "",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "select",
      "name": "sort",
      "label": "Sort",
      "description": "",
      "defaultValue": "comments",
      "selectOptions": [
        {
          "label": "comments",
          "value": "comments",
          "description": "comments"
        },
        {
          "label": "reactions",
          "value": "reactions",
          "description": "reactions"
        },
        {
          "label": "reactions-+1",
          "value": "reactions-+1",
          "description": "reactions-+1"
        },
        {
          "label": "reactions--1",
          "value": "reactions--1",
          "description": "reactions--1"
        },
        {
          "label": "reactions-smile",
          "value": "reactions-smile",
          "description": "reactions-smile"
        },
        {
          "label": "reactions-thinking_face",
          "value": "reactions-thinking_face",
          "description": "reactions-thinking_face"
        },
        {
          "label": "reactions-heart",
          "value": "reactions-heart",
          "description": "reactions-heart"
        },
        {
          "label": "reactions-tada",
          "value": "reactions-tada",
          "description": "reactions-tada"
        },
        {
          "label": "interactions",
          "value": "interactions",
          "description": "interactions"
        },
        {
          "label": "created",
          "value": "created",
          "description": "created"
        },
        {
          "label": "updated",
          "value": "updated",
          "description": "updated"
        }
      ]
    },
    {
      "direction": "Input",
      "type": "select",
      "name": "order",
      "label": "Order",
      "description": "",
      "defaultValue": "asc",
      "selectOptions": [
        {
          "label": "asc",
          "value": "asc",
          "description": "asc"
        },
        {
          "label": "desc",
          "value": "desc",
          "description": "desc"
        }
      ]
    },
    {
      "direction": "Input",
      "type": "number",
      "name": "perPage",
      "label": "Per Page",
      "description": "",
      "defaultValue": 0
    },
    {
      "direction": "Input",
      "type": "number",
      "name": "page",
      "label": "Page",
      "description": "",
      "defaultValue": 0
    },
    {
      "direction": "Input",
      "type": "checkbox",
      "name": "advancedSearch",
      "label": "Advanced Search",
      "description": "",
      "defaultValue": false
    },
    {
      "direction": "Input",
      "type": "select",
      "name": "searchType",
      "label": "Search Type",
      "description": "",
      "defaultValue": "semantic",
      "selectOptions": [
        {
          "label": "semantic",
          "value": "semantic",
          "description": "semantic"
        },
        {
          "label": "hybrid",
          "value": "hybrid",
          "description": "hybrid"
        }
      ]
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "Result",
      "label": "Result",
      "description": "Returns the response data from the connector.",
      "defaultValue": {
        "value": "Result",
        "enabled": true
      }
    }
  ]
}

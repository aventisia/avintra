{
  "name": "Corsair/Github/PullRequestsCreateReviewConnector",
  "description": "Submit a pull request review",
  "version": "1.0.0",
  "author": "@aventisia",
  "supportedPlatforms": [
    "cloud"
  ],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "credentials-select",
      "name": "__CredentialName__GitHub",
      "label": "GitHub Credential",
      "description": "Select GitHub credentials used to authenticate the request.",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "owner",
      "label": "Owner",
      "description": "",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "repo",
      "label": "Repo",
      "description": "",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "number",
      "name": "pullNumber",
      "label": "Pull Number",
      "description": "",
      "defaultValue": 0,
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "commitId",
      "label": "Commit Id",
      "description": "",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "body",
      "label": "Body",
      "description": "",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "select",
      "name": "event",
      "label": "Event",
      "description": "",
      "defaultValue": "APPROVE",
      "selectOptions": [
        {
          "label": "APPROVE",
          "value": "APPROVE",
          "description": "APPROVE"
        },
        {
          "label": "REQUEST_CHANGES",
          "value": "REQUEST_CHANGES",
          "description": "REQUEST_CHANGES"
        },
        {
          "label": "COMMENT",
          "value": "COMMENT",
          "description": "COMMENT"
        }
      ]
    },
    {
      "direction": "Input",
      "type": "tag-input",
      "name": "comments",
      "label": "Comments",
      "description": "",
      "defaultValue": []
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "Result",
      "label": "Result",
      "description": "Returns the response data from the connector.",
      "defaultValue": {
        "value": "Result",
        "enabled": true
      }
    }
  ]
}

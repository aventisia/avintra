{
  "name": "Corsair/Github/RepositoriesListConnector",
  "description": "List repositories for the authenticated user",
  "version": "1.0.0",
  "author": "@aventisia",
  "supportedPlatforms": [
    "cloud"
  ],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "credentials-select",
      "name": "__CredentialName__GitHub",
      "label": "GitHub Credential",
      "description": "Select GitHub credentials used to authenticate the request.",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "owner",
      "label": "Owner",
      "description": "",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "select",
      "name": "type",
      "label": "Type",
      "description": "",
      "defaultValue": "all",
      "selectOptions": [
        {
          "label": "all",
          "value": "all",
          "description": "all"
        },
        {
          "label": "owner",
          "value": "owner",
          "description": "owner"
        },
        {
          "label": "public",
          "value": "public",
          "description": "public"
        },
        {
          "label": "private",
          "value": "private",
          "description": "private"
        },
        {
          "label": "member",
          "value": "member",
          "description": "member"
        }
      ]
    },
    {
      "direction": "Input",
      "type": "select",
      "name": "sort",
      "label": "Sort",
      "description": "",
      "defaultValue": "created",
      "selectOptions": [
        {
          "label": "created",
          "value": "created",
          "description": "created"
        },
        {
          "label": "updated",
          "value": "updated",
          "description": "updated"
        },
        {
          "label": "pushed",
          "value": "pushed",
          "description": "pushed"
        },
        {
          "label": "full_name",
          "value": "full_name",
          "description": "full_name"
        }
      ]
    },
    {
      "direction": "Input",
      "type": "select",
      "name": "direction",
      "label": "Direction",
      "description": "",
      "defaultValue": "asc",
      "selectOptions": [
        {
          "label": "asc",
          "value": "asc",
          "description": "asc"
        },
        {
          "label": "desc",
          "value": "desc",
          "description": "desc"
        }
      ]
    },
    {
      "direction": "Input",
      "type": "number",
      "name": "perPage",
      "label": "Per Page",
      "description": "",
      "defaultValue": 0
    },
    {
      "direction": "Input",
      "type": "number",
      "name": "page",
      "label": "Page",
      "description": "",
      "defaultValue": 0
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "Result",
      "label": "Result",
      "description": "Returns the response data from the connector.",
      "defaultValue": {
        "value": "Result",
        "enabled": true
      }
    }
  ]
}

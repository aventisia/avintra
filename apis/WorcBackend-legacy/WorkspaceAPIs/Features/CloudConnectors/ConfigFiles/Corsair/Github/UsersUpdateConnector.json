{
  "name": "Corsair/Github/UsersUpdateConnector",
  "description": "Update the authenticated user profile",
  "version": "1.0.0",
  "author": "@aventisia",
  "supportedPlatforms": [
    "cloud"
  ],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "credentials-select",
      "name": "__CredentialName__GitHub",
      "label": "GitHub Credential",
      "description": "Select GitHub credentials used to authenticate the request.",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "name",
      "label": "Name",
      "description": "",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "email",
      "label": "Email",
      "description": "",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "blog",
      "label": "Blog",
      "description": "",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "twitterUsername",
      "label": "Twitter Username",
      "description": "",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "company",
      "label": "Company",
      "description": "",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "location",
      "label": "Location",
      "description": "",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "checkbox",
      "name": "hireable",
      "label": "Hireable",
      "description": "",
      "defaultValue": false
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "bio",
      "label": "Bio",
      "description": "",
      "defaultValue": ""
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "Result",
      "label": "Result",
      "description": "Returns the response data from the connector.",
      "defaultValue": {
        "value": "Result",
        "enabled": true
      }
    }
  ]
}

    {
      "direction": "Input",
      "type": "tag-input",
      "name": "bcc_emails",
      "label": "Bcc Emails",
      "description": "",
      "defaultValue": []
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "from_address",
      "label": "From Address",
      "description": "",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "checkbox",
      "name": "save_to_sent_items",
      "label": "Save To Sent Items",
      "description": "",
      "defaultValue": false
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "attachment",
      "label": "Attachment",
      "description": "",
      "defaultValue": ""
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "Result",
      "label": "Result",
      "description": "Returns the response data from the connector.",
      "defaultValue": {
        "value": "Result",
        "enabled": true
      }
    }

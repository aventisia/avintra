{
  "name": "Corsair/Outlook/MessagesSendConnector",
  "description": "Send an email message",
  "version": "1.0.0",
  "author": "@aventisia",
  "supportedPlatforms": [
    "cloud"
  ],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "credentials-select",
      "name": "__CredentialName__Microsoft",
      "label": "Microsoft Credential",
      "description": "Select Microsoft credentials used to authenticate the request.",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "to",
      "label": "To",
      "description": "",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "subject",
      "label": "Subject",
      "description": "",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "body",
      "label": "Body",
      "description": "",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "user_id",
      "label": "User Id",
      "description": "",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "to_name",
      "label": "To Name",
      "description": "",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "checkbox",
      "name": "is_html",
      "label": "Is Html",
      "description": "",
      "defaultValue": false
    },
    {
      "direction": "Input",
      "type": "tag-input",
      "name": "cc_emails",
      "label": "Cc Emails",
      "description": "",
      "defaultValue": []

{
  "name": "Corsair/Outlook/EventsGetScheduleConnector",
  "description": "Get free/busy schedule for a calendar",
  "version": "1.0.0",
  "author": "@aventisia",
  "supportedPlatforms": [
    "cloud"
  ],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "credentials-select",
      "name": "__CredentialName__Microsoft",
      "label": "Microsoft Credential",
      "description": "Select Microsoft credentials used to authenticate the request.",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "calendar_id",
      "label": "Calendar Id",
      "description": "",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "tag-input",
      "name": "schedules",
      "label": "Schedules",
      "description": "",
      "defaultValue": []
    },
    {
      "direction": "Input",
      "type": "json-editor",
      "name": "startTime",
      "label": "Start Time",
      "description": "",
      "defaultValue": "{}"
    },
    {
      "direction": "Input",
      "type": "json-editor",
      "name": "endTime",
      "label": "End Time",
      "description": "",
      "defaultValue": "{}"
    },
    {
      "direction": "Input",
      "type": "number",
      "name": "availabilityViewInterval",
      "label": "Availability View Interval",
      "description": "",
      "defaultValue": 0
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "Result",
      "label": "Result",
      "description": "Returns the response data from the connector.",
      "defaultValue": {
        "value": "Result",
        "enabled": true
      }
    }
  ]
}

{
  "name": "Corsair/Outlook/MessagesQueryConnector",
  "description": "Query email messages with OData filters",
  "version": "1.0.0",
  "author": "@aventisia",
  "supportedPlatforms": [
    "cloud"
  ],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "credentials-select",
      "name": "__CredentialName__Microsoft",
      "label": "Microsoft Credential",
      "description": "Select Microsoft credentials used to authenticate the request.",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "user_id",
      "label": "User Id",
      "description": "",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "folder",
      "label": "Folder",
      "description": "",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "filter",
      "label": "Filter",
      "description": "",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "tag-input",
      "name": "select",
      "label": "Select",
      "description": "",
      "defaultValue": []
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "orderby",
      "label": "Orderby",
      "description": "",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "number",
      "name": "top",
      "label": "Top",
      "description": "",
      "defaultValue": 0
    },
    {
      "direction": "Input",
      "type": "number",
      "name": "skip",
      "label": "Skip",
      "description": "",
      "defaultValue": 0
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "Result",
      "label": "Result",
      "description": "Returns the response data from the connector.",
      "defaultValue": {
        "value": "Result",
        "enabled": true
      }
    }
  ]
}

{
  "name": "Corsair/Outlook/MessagesUpdateConnector",
  "description": "Update an email message (e.g. mark as read)",
  "version": "1.0.0",
  "author": "@aventisia",
  "supportedPlatforms": [
    "cloud"
  ],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "credentials-select",
      "name": "__CredentialName__Microsoft",
      "label": "Microsoft Credential",
      "description": "Select Microsoft credentials used to authenticate the request.",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "message_id",
      "label": "Message Id",
      "description": "",
      "defaultValue": "",

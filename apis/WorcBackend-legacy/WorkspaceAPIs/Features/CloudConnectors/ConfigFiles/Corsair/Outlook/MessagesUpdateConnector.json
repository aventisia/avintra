    },
    {
      "direction": "Input",
      "type": "text",
      "name": "user_id",
      "label": "User Id",
      "description": "",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "checkbox",
      "name": "is_read",
      "label": "Is Read",
      "description": "",
      "defaultValue": false
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "subject",
      "label": "Subject",
      "description": "",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "importance",
      "label": "Importance",
      "description": "",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "tag-input",
      "name": "categories",
      "label": "Categories",
      "description": "",
      "defaultValue": []
    },
    {
      "direction": "Input",
      "type": "tag-input",
      "name": "to_recipients",
      "label": "To Recipients",
      "description": "",
      "defaultValue": []
    },
    {
      "direction": "Input",
      "type": "tag-input",
      "name": "cc_recipients",
      "label": "Cc Recipients",
      "description": "",
      "defaultValue": []
    },
    {
      "direction": "Input",
      "type": "tag-input",
      "name": "bcc_recipients",
      "label": "Bcc Recipients",
      "description": "",
      "defaultValue": []
    },
    {
      "direction": "Input",
      "type": "tag-input",
      "name": "reply_to",
      "label": "Reply To",
      "description": "",
      "defaultValue": []
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "flag",
      "label": "Flag",
      "description": "",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "inference_classification",
      "label": "Inference Classification",
      "description": "",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "checkbox",
      "name": "is_read_receipt_requested",
      "label": "Is Read Receipt Requested",
      "description": "",
      "defaultValue": false
    },
    {
      "direction": "Input",
      "type": "checkbox",
      "name": "is_delivery_receipt_requested",
      "label": "Is Delivery Receipt Requested",
      "description": "",
      "defaultValue": false
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "Result",
      "label": "Result",
      "description": "Returns the response data from the connector.",
      "defaultValue": {
        "value": "Result",
        "enabled": true
      }
    }
  ]
}

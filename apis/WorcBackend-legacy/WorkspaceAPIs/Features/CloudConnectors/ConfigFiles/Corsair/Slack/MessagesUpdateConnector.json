{
  "name": "Corsair/Slack/MessagesUpdateConnector",
  "description": "Update an existing message",
  "version": "1.0.0",
  "author": "@aventisia",
  "supportedPlatforms": [
    "cloud"
  ],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "credentials-select",
      "name": "__CredentialName__Slack",
      "label": "Slack Credential",
      "description": "Select Slack credentials used to authenticate the request.",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "channel",
      "label": "Channel",
      "description": "",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "ts",
      "label": "Ts",
      "description": "",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "text",
      "label": "Text",
      "description": "",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "tag-input",
      "name": "blocks",
      "label": "Blocks",
      "description": "",
      "defaultValue": []
    },
    {
      "direction": "Input",
      "type": "tag-input",
      "name": "attachments",
      "label": "Attachments",
      "description": "",
      "defaultValue": []
    },
    {
      "direction": "Input",
      "type": "select",
      "name": "parse",
      "label": "Parse",
      "description": "",
      "defaultValue": "full",
      "selectOptions": [
        {
          "label": "full",
          "value": "full",
          "description": "full"
        },
        {
          "label": "none",
          "value": "none",
          "description": "none"
        }
      ]
    },
    {
      "direction": "Input",
      "type": "checkbox",
      "name": "link_names",
      "label": "Link Names",
      "description": "",
      "defaultValue": false
    },
    {
      "direction": "Input",
      "type": "checkbox",
      "name": "as_user",
      "label": "As User",
      "description": "",
      "defaultValue": false
    },
    {
      "direction": "Input",
      "type": "tag-input",
      "name": "file_ids",
      "label": "File Ids",
      "description": "",
      "defaultValue": []
    },
    {
      "direction": "Input",
      "type": "checkbox",
      "name": "reply_broadcast",
      "label": "Reply Broadcast",
      "description": "",
      "defaultValue": false
    },
    {
      "direction": "Input",
      "type": "json-editor",
      "name": "metadata",
      "label": "Metadata",
      "description": "",
      "defaultValue": "{}"
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "Result",
      "label": "Result",
      "description": "Returns the response data from the connector.",
      "defaultValue": {
        "value": "Result",
        "enabled": true
      }
    }
  ]
}

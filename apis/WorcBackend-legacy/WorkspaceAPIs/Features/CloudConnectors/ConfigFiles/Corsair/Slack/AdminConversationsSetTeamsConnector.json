{
  "name": "Corsair/Slack/AdminConversationsSetTeamsConnector",
  "description": "Set the workspaces in an Enterprise grid org that connect to a channel",
  "version": "1.0.0",
  "author": "@aventisia",
  "supportedPlatforms": [
    "cloud"
  ],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "credentials-select",
      "name": "__CredentialName__Slack",
      "label": "Slack Credential",
      "description": "Select Slack credentials used to authenticate the request.",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "channel_id",
      "label": "Channel Id",
      "description": "",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "team_id",
      "label": "Team Id",
      "description": "",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "tag-input",
      "name": "target_team_ids",
      "label": "Target Team Ids",
      "description": "",
      "defaultValue": []
    },
    {
      "direction": "Input",
      "type": "checkbox",
      "name": "org_channel",
      "label": "Org Channel",
      "description": "",
      "defaultValue": false
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "Result",
      "label": "Result",
      "description": "Returns the response data from the connector.",
      "defaultValue": {
        "value": "Result",
        "enabled": true
      }
    }
  ]
}

{
  "name": "Corsair/Slack/ChannelsInviteConnector",
  "description": "Invite users to a channel",
  "version": "1.0.0",
  "author": "@aventisia",
  "supportedPlatforms": [
    "cloud"
  ],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "credentials-select",
      "name": "__CredentialName__Slack",
      "label": "Slack Credential",
      "description": "Select Slack credentials used to authenticate the request.",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "channel",
      "label": "Channel",
      "description": "",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "users",
      "label": "Users",
      "description": "",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "checkbox",
      "name": "force",
      "label": "Force",
      "description": "",
      "defaultValue": false
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "Result",
      "label": "Result",
      "description": "Returns the response data from the connector.",
      "defaultValue": {
        "value": "Result",
        "enabled": true
      }
    }
  ]
}

{
  "name": "Corsair/Slack/ReactionsAddConnector",
  "description": "Add a reaction emoji to a message",
  "version": "1.0.0",
  "author": "@aventisia",
  "supportedPlatforms": [
    "cloud"
  ],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "credentials-select",
      "name": "__CredentialName__Slack",
      "label": "Slack Credential",
      "description": "Select Slack credentials used to authenticate the request.",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "channel",
      "label": "Channel",
      "description": "",
      "defaultValue": "",

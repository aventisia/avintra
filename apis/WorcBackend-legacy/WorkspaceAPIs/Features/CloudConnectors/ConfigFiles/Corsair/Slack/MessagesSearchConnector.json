{
  "name": "Corsair/Slack/MessagesSearchConnector",
  "description": "Search messages in the workspace",
  "version": "1.0.0",
  "author": "@aventisia",
  "supportedPlatforms": [
    "cloud"
  ],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "credentials-select",
      "name": "__CredentialName__Slack",
      "label": "Slack Credential",
      "description": "Select Slack credentials used to authenticate the request.",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "query",
      "label": "Query",
      "description": "",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "select",
      "name": "sort",
      "label": "Sort",
      "description": "",
      "defaultValue": "score",
      "selectOptions": [
        {
          "label": "score",
          "value": "score",
          "description": "score"
        },
        {
          "label": "timestamp",
          "value": "timestamp",
          "description": "timestamp"
        }
      ]
    },
    {
      "direction": "Input",
      "type": "select",
      "name": "sort_dir",
      "label": "Sort Dir",
      "description": "",
      "defaultValue": "asc",
      "selectOptions": [
        {
          "label": "asc",
          "value": "asc",
          "description": "asc"
        },
        {
          "label": "desc",
          "value": "desc",
          "description": "desc"
        }
      ]
    },
    {
      "direction": "Input",
      "type": "checkbox",
      "name": "highlight",
      "label": "Highlight",
      "description": "",
      "defaultValue": false
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "team_id",
      "label": "Team Id",
      "description": "",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "cursor",
      "label": "Cursor",
      "description": "",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "number",
      "name": "limit",
      "label": "Limit",
      "description": "",
      "defaultValue": 0
    },
    {
      "direction": "Input",
      "type": "number",
      "name": "page",
      "label": "Page",
      "description": "",
      "defaultValue": 0
    },
    {
      "direction": "Input",
      "type": "number",
      "name": "count",
      "label": "Count",
      "description": "",
      "defaultValue": 0
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "Result",
      "label": "Result",
      "description": "Returns the response data from the connector.",
      "defaultValue": {
        "value": "Result",
        "enabled": true
      }
    }
  ]
}

{
  "name": "PullrequestList",
  "description": "GitHub REST API connector. Use operation=<service>.<action>, e.g. repository.create or pullrequest.merge. Operation: pullrequest.list.",
  "version": "1.0.0",
  "author": "@aventisia",
  "supportedPlatforms": [
    "cloud",
    "windows"
  ],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "credentials-select",
      "name": "__CredentialName__GitHub",
      "label": "GitHub Credential",
      "description": "The GitHub credential used to authenticate API requests.",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "owner",
      "label": "Owner",
      "description": "Required path parameter: owner.",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "repo",
      "label": "Repo",
      "description": "Required path parameter: repo.",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "state",
      "label": "State",
      "description": "Optional query parameter: state.",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "head",
      "label": "Head",
      "description": "Optional query parameter: head.",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "base",
      "label": "Base",
      "description": "Optional query parameter: base.",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "sort",
      "label": "Sort",
      "description": "Optional query parameter: sort.",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "direction",
      "label": "Direction",
      "description": "Optional query parameter: direction.",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "per_page",
      "label": "Per Page",
      "description": "Optional query parameter: per_page.",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "page",
      "label": "Page",
      "description": "Optional query parameter: page.",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "json-editor",
      "name": "payload",
      "label": "Payload",
      "description": "Request body as JSON (optional).",
      "defaultValue": "{}"
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "Result",
      "label": "Result",
      "description": "Returns the response data from the connector.",
      "defaultValue": {
        "value": "Result",
        "enabled": true
      }
    }
  ],
  "camel": {
    "connector": "github",
    "operation": "pullrequest.list",
    "authType": "accessToken",
    "bodyField": "payload",
    "configKeys": [
      "owner",
      "repo",
      "state",
      "head",
      "base",
      "sort",
      "direction",
      "per_page",
      "page"
    ]
  }
}

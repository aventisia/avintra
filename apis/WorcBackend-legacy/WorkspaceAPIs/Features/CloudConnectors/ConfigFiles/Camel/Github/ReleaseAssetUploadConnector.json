{
  "name": "ReleaseAssetUpload",
  "description": "GitHub REST API connector. Use operation=<service>.<action>, e.g. repository.create or pullrequest.merge. Operation: release.asset.upload.",
  "version": "1.0.0",
  "author": "@aventisia",
  "supportedPlatforms": [
    "cloud",
    "windows"
  ],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "credentials-select",
      "name": "__CredentialName__GitHub",
      "label": "GitHub Credential",
      "description": "The GitHub credential used to authenticate API requests.",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "owner",
      "label": "Owner",
      "description": "Required path parameter: owner.",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "repo",
      "label": "Repo",
      "description": "Required path parameter: repo.",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "releaseId",
      "label": "Releaseid",
      "description": "Required path parameter: releaseId.",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "name",
      "label": "Name",
      "description": "Optional query parameter: name.",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "label",
      "label": "Label",
      "description": "Optional query parameter: label.",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "json-editor",
      "name": "payload",
      "label": "Payload",
      "description": "Request body as JSON (optional).",
      "defaultValue": "{}"
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "Result",
      "label": "Result",
      "description": "Returns the response data from the connector.",
      "defaultValue": {
        "value": "Result",
        "enabled": true
      }
    }
  ],
  "camel": {
    "connector": "github",
    "operation": "release.asset.upload",
    "authType": "accessToken",
    "bodyField": "payload",
    "configKeys": [
      "owner",
      "repo",
      "releaseId",
      "name",
      "label"
    ]
  }
}

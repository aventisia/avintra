{
  "name": "CommitList",
  "description": "GitHub REST API connector. Use operation=<service>.<action>, e.g. repository.create or pullrequest.merge. Operation: commit.list.",
  "version": "1.0.0",
  "author": "@aventisia",
  "supportedPlatforms": [
    "cloud",
    "windows"
  ],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "credentials-select",
      "name": "__CredentialName__GitHub",
      "label": "GitHub Credential",
      "description": "The GitHub credential used to authenticate API requests.",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "owner",
      "label": "Owner",
      "description": "Required path parameter: owner.",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "repo",
      "label": "Repo",
      "description": "Required path parameter: repo.",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "sha",
      "label": "Sha",
      "description": "Optional query parameter: sha.",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "path",
      "label": "Path",
      "description": "Optional query parameter: path.",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "author",
      "label": "Author",
      "description": "Optional query parameter: author.",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "since",
      "label": "Since",
      "description": "Optional query parameter: since.",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "until",
      "label": "Until",
      "description": "Optional query parameter: until.",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "per_page",
      "label": "Per Page",
      "description": "Optional query parameter: per_page.",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "page",
      "label": "Page",
      "description": "Optional query parameter: page.",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "json-editor",
      "name": "payload",
      "label": "Payload",
      "description": "Request body as JSON (optional).",
      "defaultValue": "{}"
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "Result",
      "label": "Result",
      "description": "Returns the response data from the connector.",
      "defaultValue": {
        "value": "Result",
        "enabled": true
      }
    }
  ],
  "camel": {
    "connector": "github",
    "operation": "commit.list",
    "authType": "accessToken",
    "bodyField": "payload",
    "configKeys": [
      "owner",
      "repo",
      "sha",
      "path",
      "author",
      "since",
      "until",
      "per_page",
      "page"
    ]
  }
}

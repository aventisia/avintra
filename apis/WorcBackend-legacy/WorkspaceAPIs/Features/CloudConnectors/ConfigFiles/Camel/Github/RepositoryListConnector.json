{
  "name": "RepositoryList",
  "description": "GitHub REST API connector. Use operation=<service>.<action>, e.g. repository.create or pullrequest.merge. Operation: repository.list.",
  "version": "1.0.0",
  "author": "@aventisia",
  "supportedPlatforms": [
    "cloud",
    "windows"
  ],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "credentials-select",
      "name": "__CredentialName__GitHub",
      "label": "GitHub Credential",
      "description": "The GitHub credential used to authenticate API requests.",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "visibility",
      "label": "Visibility",
      "description": "Optional query parameter: visibility.",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "affiliation",
      "label": "Affiliation",
      "description": "Optional query parameter: affiliation.",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "type",
      "label": "Type",
      "description": "Optional query parameter: type.",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "sort",
      "label": "Sort",
      "description": "Optional query parameter: sort.",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "direction",
      "label": "Direction",
      "description": "Optional query parameter: direction.",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "json-editor",
      "name": "payload",
      "label": "Payload",
      "description": "Request body as JSON (optional).",
      "defaultValue": "{}"
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "Result",
      "label": "Result",
      "description": "Returns the response data from the connector.",
      "defaultValue": {
        "value": "Result",
        "enabled": true
      }
    }
  ],
  "camel": {
    "connector": "github",
    "operation": "repository.list",
    "authType": "accessToken",
    "bodyField": "payload",
    "configKeys": [
      "visibility",
      "affiliation",
      "type",
      "sort",
      "direction"
    ]
  }
}

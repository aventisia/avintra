{
  "name": "JMS — Browse",
  "description": "Browse through the JMS connector.",
  "version": "1.0.0",
  "author": "@aventisia",
  "supportedPlatforms": [
    "cloud",
    "windows"
  ],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "credentials-select",
      "name": "__CredentialName__GeneralCredentials",
      "label": "JMS Credential",
      "description": "The JMS credential used to authenticate API requests.",
      "defaultValue": "",
      "required": false
    },
    {
      "direction": "Input",
      "type": "select",
      "name": "operation",
      "label": "Operation",
      "description": "The jms operation to execute.",
      "defaultValue": "browse",
      "selectOptions": [
        {
          "label": "Send",
          "value": "send",
          "description": "send"
        },
        {
          "label": "Request",
          "value": "request",
          "description": "request"
        },
        {
          "label": "Browse",
          "value": "browse",
          "description": "browse"
        }
      ],
      "required": false
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "destinationName",
      "label": "Destination Name",
      "description": "Name of the queue or topic to use as destination",
      "defaultValue": "",
      "required": true,
      "camel": {
        "location": "property",
        "name": "destinationName"
      }
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "connectionFactory",
      "label": "Connection Factory",
      "description": "The connection factory to be use. A connection factory must be configured either on the component or endpoint.",
      "defaultValue": "",
      "required": false,
      "camel": {
        "location": "property",
        "name": "connectionFactory"
      }
    },
    {
      "direction": "Input",
      "type": "select",
      "name": "deliveryMode",
      "label": "Delivery Mode",
      "description": "Specifies the delivery mode to be used. Possible values are those defined by jakarta.jms.DeliveryMode. NON_PERSISTENT = 1 and PERSISTENT = 2.",
      "defaultValue": "PERSISTENT",
      "selectOptions": [
        {
          "label": "Persistent",
          "value": "PERSISTENT",
          "description": "PERSISTENT"
        },
        {
          "label": "Non Persistent",
          "value": "NON_PERSISTENT",
          "description": "NON_PERSISTENT"
        }
      ],
      "required": false,
      "camel": {
        "location": "property",
        "name": "deliveryMode"
      }
    },
    {
      "direction": "Input",
      "type": "number",
      "name": "timeToLive",
      "label": "Time To Live",
      "description": "When sending messages, specifies the time-to-live of the message (in milliseconds).",
      "defaultValue": "",
      "required": false,
      "camel": {
        "location": "property",
        "name": "timeToLive"
      }
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "replyTo",
      "label": "Reply To",
      "description": "Provides an explicit ReplyTo destination (overrides any incoming value of Message.getJMSReplyTo() in consumer).",
      "defaultValue": "",
      "required": false,
      "camel": {
        "location": "property",
        "name": "replyTo"
      }
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "brokerUrl",
      "label": "Brokerurl",
      "description": "Required auth: brokerUrl",
      "defaultValue": "",
      "required": true,
      "camel": {
        "location": "property",
        "name": "brokerUrl"
      }
    },
    {
      "direction": "Input",
      "type": "json-editor",
      "name": "message",
      "label": "Message",
      "description": "Request body / payload for the browse operation (JSON).",
      "defaultValue": "",
      "required": false,
      "camel": {
        "location": "property",
        "name": "message"
      }
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "Result",
      "label": "Result",
      "description": "Returns the response data from the connector.",
      "defaultValue": {
        "value": "Result",
        "enabled": true
      },
      "required": false
    }
  ],
  "connector": {
    "name": null,
    "operation": null,
    "authType": null
  },
  "credentials": {
    "required": true,
    "fieldName": "__CredentialName__GeneralCredentials",
    "type": "credentials-select"
  }
}

{
  "name": "Request",
  "description": "Executes the request operation through the Apache Camel jms connector.",
  "version": "1.0.0",
  "author": "@aventisia",
  "supportedPlatforms": [
    "cloud",
    "windows"
  ],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "credentials-select",
      "name": "__CredentialName__GeneralCredentials",
      "label": "JMS Credential",
      "description": "The JMS credential used to authenticate API requests.",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "select",
      "name": "operation",
      "label": "Operation",
      "description": "The jms operation to execute.",
      "defaultValue": "request",
      "selectOptions": [
        {
          "label": "Send",
          "value": "send",
          "description": "send"
        },
        {
          "label": "Request",
          "value": "request",
          "description": "request"
        },
        {
          "label": "Browse",
          "value": "browse",
          "description": "browse"
        }
      ]
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "destinationName",
      "label": "Destinationname",
      "description": "Required: destinationName",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "connectionFactory",
      "label": "Connectionfactory",
      "description": "Optional: connectionFactory",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "select",
      "name": "deliveryMode",
      "label": "Deliverymode",
      "description": "Optional: deliveryMode",
      "defaultValue": "PERSISTENT",
      "selectOptions": [
        {
          "label": "Persistent",
          "value": "PERSISTENT",
          "description": "PERSISTENT"
        },
        {
          "label": "Non Persistent",
          "value": "NON_PERSISTENT",
          "description": "NON_PERSISTENT"
        }
      ]
    },
    {
      "direction": "Input",
      "type": "number",
      "name": "timeToLive",
      "label": "Timetolive",
      "description": "Optional: timeToLive",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "replyTo",
      "label": "Replyto",
      "description": "Optional: replyTo",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "brokerUrl",
      "label": "Brokerurl",
      "description": "Required auth: brokerUrl",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "json-editor",
      "name": "message",
      "label": "Message",
      "description": "Request body / payload for the request operation (JSON).",
      "defaultValue": ""
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "Result",
      "label": "Result",
      "description": "Returns the response data from the connector.",
      "defaultValue": {
        "value": "Result",
        "enabled": true
      }
    }
  ],
  "camel": {
    "connector": "jms",
    "authType": "basic",
    "bodyField": "message",
    "configKeys": [
      "destinationName",
      "connectionFactory",
      "deliveryMode",
      "timeToLive",
      "replyTo",
      "brokerUrl"
    ]
  }
}

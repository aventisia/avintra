{
  "name": "Mail — Search",
  "description": "Search through the Mail connector.",
  "version": "1.0.0",
  "author": "@aventisia",
  "supportedPlatforms": [
    "cloud",
    "windows"
  ],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "credentials-select",
      "name": "__CredentialName__GeneralCredentials",
      "label": "MAIL Credential",
      "description": "The MAIL credential used to authenticate API requests.",
      "defaultValue": "",
      "required": false
    },
    {
      "direction": "Input",
      "type": "select",
      "name": "operation",
      "label": "Operation",
      "description": "The mail operation to execute.",
      "defaultValue": "search",
      "selectOptions": [
        {
          "label": "Send",
          "value": "send",
          "description": "send"
        },
        {
          "label": "Read",
          "value": "read",
          "description": "read"
        },
        {
          "label": "Search",
          "value": "search",
          "description": "search"
        },
        {
          "label": "Delete",
          "value": "delete",
          "description": "delete"
        }
      ],
      "required": false
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "host",
      "label": "Host",
      "description": "The mail server host name",
      "defaultValue": "",
      "required": true,
      "camel": {
        "location": "property",
        "name": "host"
      }
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "to",
      "label": "To",
      "description": "Sets the destination email address. Separate multiple email addresses with comma.",
      "defaultValue": "",
      "required": true,
      "camel": {
        "location": "property",
        "name": "to"
      }
    },
    {
      "direction": "Input",
      "type": "number",
      "name": "port",
      "label": "Port",
      "description": "The port number of the mail server",
      "defaultValue": "",
      "required": false,
      "camel": {
        "location": "property",
        "name": "port"
      }
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "subject",
      "label": "Subject",
      "description": "The Subject of the message being sent. Note: Setting the subject in the header takes precedence over this option.",
      "defaultValue": "",
      "required": false,
      "camel": {
        "location": "property",
        "name": "subject"
      }
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "from",
      "label": "From",
      "description": "The from email address",
      "defaultValue": "",
      "required": false,
      "camel": {
        "location": "property",
        "name": "from"
      }
    },
    {
      "direction": "Input",
      "type": "select",
      "name": "contentType",
      "label": "Content Type",
      "description": "The mail message content type. Use text/html for HTML mails.",
      "defaultValue": "text",
      "selectOptions": [
        {
          "label": "Text",
          "value": "text",
          "description": "text"
        },
        {
          "label": "Html",
          "value": "html",
          "description": "html"
        }
      ],
      "required": false,
      "camel": {
        "location": "property",
        "name": "contentType"
      }
    },
    {
      "direction": "Input",
      "type": "json-editor",
      "name": "message",
      "label": "Message",
      "description": "Request body / payload for the search operation (JSON).",
      "defaultValue": "",
      "required": false,
      "camel": {
        "location": "property",
        "name": "message"
      }
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "Result",
      "label": "Result",
      "description": "Returns the response data from the connector.",
      "defaultValue": {
        "value": "Result",
        "enabled": true
      },
      "required": false
    }
  ],
  "connector": {
    "name": null,
    "operation": null,
    "authType": null
  },
  "credentials": {
    "required": true,
    "fieldName": "__CredentialName__GeneralCredentials",
    "type": "credentials-select"
  }
}

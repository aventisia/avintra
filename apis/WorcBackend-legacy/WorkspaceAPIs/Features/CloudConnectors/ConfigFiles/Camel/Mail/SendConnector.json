{
  "name": "Send",
  "description": "Executes the send operation through the Apache Camel mail connector.",
  "version": "1.0.0",
  "author": "@aventisia",
  "supportedPlatforms": [
    "cloud",
    "windows"
  ],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "credentials-select",
      "name": "__CredentialName__GeneralCredentials",
      "label": "MAIL Credential",
      "description": "The MAIL credential used to authenticate API requests.",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "select",
      "name": "operation",
      "label": "Operation",
      "description": "The mail operation to execute.",
      "defaultValue": "send",
      "selectOptions": [
        {
          "label": "Send",
          "value": "send",
          "description": "send"
        },
        {
          "label": "Read",
          "value": "read",
          "description": "read"
        },
        {
          "label": "Search",
          "value": "search",
          "description": "search"
        },
        {
          "label": "Delete",
          "value": "delete",
          "description": "delete"
        }
      ]
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "host",
      "label": "Host",
      "description": "Required: host",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "to",
      "label": "To",
      "description": "Required: to",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "number",
      "name": "port",
      "label": "Port",
      "description": "Optional: port",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "subject",
      "label": "Subject",
      "description": "Optional: subject",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "from",
      "label": "From",
      "description": "Optional: from",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "select",
      "name": "contentType",
      "label": "Contenttype",
      "description": "Optional: contentType",
      "defaultValue": "text",
      "selectOptions": [
        {
          "label": "Text",
          "value": "text",
          "description": "text"
        },
        {
          "label": "Html",
          "value": "html",
          "description": "html"
        }
      ]
    },
    {
      "direction": "Input",
      "type": "json-editor",
      "name": "message",
      "label": "Message",
      "description": "Request body / payload for the send operation (JSON).",
      "defaultValue": ""
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "Result",
      "label": "Result",
      "description": "Returns the response data from the connector.",
      "defaultValue": {
        "value": "Result",
        "enabled": true
      }
    }
  ],
  "camel": {
    "connector": "mail",
    "authType": "basic",
    "bodyField": "message",
    "configKeys": [
      "host",
      "to",
      "port",
      "subject",
      "from",
      "contentType"
    ]
  }
}

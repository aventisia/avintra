{
  "name": "PATCH",
  "description": "Executes the PATCH operation through the Apache Camel http connector.",
  "version": "1.0.0",
  "author": "@aventisia",
  "supportedPlatforms": [
    "cloud",
    "windows"
  ],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "credentials-select",
      "name": "__CredentialName__GeneralCredentials",
      "label": "HTTP Credential",
      "description": "The HTTP credential used to authenticate API requests.",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "select",
      "name": "operation",
      "label": "Operation",
      "description": "The http operation to execute.",
      "defaultValue": "PATCH",
      "selectOptions": [
        {
          "label": "Get",
          "value": "GET",
          "description": "GET"
        },
        {
          "label": "Post",
          "value": "POST",
          "description": "POST"
        },
        {
          "label": "Put",
          "value": "PUT",
          "description": "PUT"
        },
        {
          "label": "Delete",
          "value": "DELETE",
          "description": "DELETE"
        },
        {
          "label": "Patch",
          "value": "PATCH",
          "description": "PATCH"
        },
        {
          "label": "Head",
          "value": "HEAD",
          "description": "HEAD"
        },
        {
          "label": "Options",
          "value": "OPTIONS",
          "description": "OPTIONS"
        }
      ]
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "host",
      "label": "Host",
      "description": "Required: host",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "path",
      "label": "Path",
      "description": "Optional: path",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "queryParameters",
      "label": "Queryparameters",
      "description": "Optional: queryParameters",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "select",
      "name": "httpMethod",
      "label": "Httpmethod",
      "description": "Optional: httpMethod",
      "defaultValue": "GET",
      "selectOptions": [
        {
          "label": "Get",
          "value": "GET",
          "description": "GET"
        },
        {
          "label": "Post",
          "value": "POST",
          "description": "POST"
        },
        {
          "label": "Put",
          "value": "PUT",
          "description": "PUT"
        },
        {
          "label": "Delete",
          "value": "DELETE",
          "description": "DELETE"
        },
        {
          "label": "Patch",
          "value": "PATCH",
          "description": "PATCH"
        },
        {
          "label": "Head",
          "value": "HEAD",
          "description": "HEAD"
        },
        {
          "label": "Options",
          "value": "OPTIONS",
          "description": "OPTIONS"
        }
      ]
    },
    {
      "direction": "Input",
      "type": "json-editor",
      "name": "payload",
      "label": "Payload",
      "description": "Request body / payload for the PATCH operation (JSON).",
      "defaultValue": ""
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "Result",
      "label": "Result",
      "description": "Returns the response data from the connector.",
      "defaultValue": {
        "value": "Result",
        "enabled": true
      }
    }
  ],
  "camel": {
    "connector": "http",
    "authType": "basic",
    "bodyField": "payload",
    "configKeys": [
      "host",
      "path",
      "queryParameters",
      "httpMethod"
    ]
  }

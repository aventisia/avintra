{
  "name": "Send",
  "description": "Executes the send operation through the Apache Camel kafka connector.",
  "version": "1.0.0",
  "author": "@aventisia",
  "supportedPlatforms": [
    "cloud",
    "windows"
  ],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "credentials-select",
      "name": "__CredentialName__GeneralCredentials",
      "label": "KAFKA Credential",
      "description": "The KAFKA credential used to authenticate API requests.",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "select",
      "name": "operation",
      "label": "Operation",
      "description": "The kafka operation to execute.",
      "defaultValue": "send",
      "selectOptions": [
        {
          "label": "Send",
          "value": "send",
          "description": "send"
        },
        {
          "label": "Poll",
          "value": "poll",
          "description": "poll"
        },
        {
          "label": "Fetch",
          "value": "fetch",
          "description": "fetch"
        }
      ]
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "topic",
      "label": "Topic",
      "description": "Required: topic",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "brokers",
      "label": "Brokers",
      "description": "Required: brokers",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "groupId",
      "label": "Groupid",
      "description": "Optional: groupId",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "key",
      "label": "Key",
      "description": "Optional: key",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "partitionKey",
      "label": "Partitionkey",
      "description": "Optional: partitionKey",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "number",
      "name": "offset",
      "label": "Offset",
      "description": "Optional: offset",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "switch",
      "name": "autoCommitEnable",
      "label": "Autocommitenable",
      "description": "Optional: autoCommitEnable",
      "defaultValue": false
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "saslMechanism",
      "label": "Saslmechanism",
      "description": "Required auth: saslMechanism",
      "defaultValue": ""
    },
    {
      "direction": "Input",
      "type": "json-editor",
      "name": "message",
      "label": "Message",
      "description": "Request body / payload for the send operation (JSON).",
      "defaultValue": ""
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "Result",
      "label": "Result",
      "description": "Returns the response data from the connector.",
      "defaultValue": {
        "value": "Result",
        "enabled": true
      }
    }
  ],
  "camel": {
    "connector": "kafka",
    "authType": "basic",
    "bodyField": "message",
    "configKeys": [
      "topic",
      "brokers",
      "groupId",
      "key",
      "partitionKey",
      "offset",
      "autoCommitEnable",
      "saslMechanism"
    ]
  }
}

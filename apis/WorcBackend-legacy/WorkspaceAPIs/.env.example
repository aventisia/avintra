# WorkspaceAPIs local settings. Copy to .env.local (gitignored); scripts/setup.sh does this.
# Loaded only when ASPNETCORE_ENVIRONMENT=Localhost, with this directory as the working
# directory. Values here override the OS environment, so secrets stay commented out:
# set them in the OS environment or uncomment them here.
# Full list: apis/WorcBackend-legacy/AspNetToolkit/Extensions/EnvironmentConfigurationExtension.cs

ASPNETCORE_URLS=http://localhost:4001

ACCOUNTS_API_BASE_URL=http://localhost:4000
WORKSPACE_API_BASE_URL=http://localhost:4001
LLMPIPELINE_API_BASE_URL=http://localhost:4003
CAMEL_API_BASE_URL=http://localhost:4005
CORSAIR_API_BASE_URL=http://localhost:4006

# Required
# APP_BASE_URL=local-avintra.aventisia.com
# ON_PREM_ADMIN_EMAIL=
# POSTGRESQL_HOST=localhost
# POSTGRESQL_PORT=5432
# POSTGRESQL_USERNAME=
# POSTGRESQL_PASSWORD=
# AZURE_BLOB_STORAGE_CONNECTION_STRING=
# JWT_SECRET_KEY=
# AES_ENCRYPTION_KEY=
# AES_INITIALIZATION_VECTOR=

# Optional: leave both unset to run as a Community deployment
# ON_PREM_TENANT_ID=
# ON_PREM_INSTANCE_KEY=

# Optional
# POSTGRESQL_WORKSPACE_DB_NAME=WorkspaceDb
# POSTGRESQL_ACCOUNTS_DB_NAME=AccountsDb
# EXTRA_CORS_ORIGINS=
# EXTRA_ALLOWED_HOSTS=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_MAIL_FROM_NAME=
# SMTP_MAIL_FROM_ADDRESS=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# DEEPINFRA_API_KEY=
# OPENROUTER_API_KEY=
# AZURE_ENTRA_ID_ENABLED=false
# AZURE_TENANT_ID=
# AZURE_ENTRA_ID_CLIENT_ID=
# AZURE_ENTRA_ID_CLIENT_SECRET=
# RAZORPAY_ENABLED=false
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# BRANDING_*: see the "Deployment branding" section of ../AccountsAPIs/README.md

<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- CredentialManagement, FlaUI.Core and FlaUI.UIA3 are Windows-only RPA dependencies pulled in via
         ExecutorLibrary/NodeLibrary. They intentionally have no net8.0 assets, so suppress NU1701. -->
    <NoWarn>CS8602;NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.17.1" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.27.0" />
    <PackageReference Include="HtmlAgilityPack" Version="1.11.72" />
    <PackageReference Include="Mapster" Version="7.4.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.7" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.7" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.7">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.0" />
    <PackageReference Include="Microsoft.Graph" Version="5.96.0" />
    <PackageReference Include="Newtonsoft.Json.Schema" Version="4.0.1" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.4" />
    <PackageReference Include="Pgvector" Version="0.2.0" />
    <PackageReference Include="Pgvector.EntityFrameworkCore" Version="0.2.0" />
    <PackageReference Include="Quartz" Version="3.15.1" />
    <PackageReference Include="Quartz.AspNetCore" Version="3.15.1" />
    <PackageReference Include="RestSharp" Version="113.1.0" />
    <PackageReference Include="SendGrid" Version="9.29.3" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageReference Include="twilio" Version="7.13.7" />
    <PackageReference Include="UAParser" Version="3.1.47" />
    <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="4.5.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.5.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AspNetToolkit\AspNetToolkit.csproj" />
    <ProjectReference Include="..\..\..\shared\NodeLibrary\NodeLibrary.Core\NodeLibrary.Core.csproj" />
    <ProjectReference Include="..\..\..\shared\ExecutorLibrary\ExecutorLibrary.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings.Development.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Update="appsettings.UAT.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Update="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <None Update="Features\CloudConnectors\ConfigFiles/**">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="StaticFiles\**">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    Mapping files embedded so they can be restored at runtime if deleted.
    These artifacts are not reproducible from the harness catalog at startup
    (curated selector labels/icons/hand-coded groups), so the compiled snapshot
    is the source of truth for auto-regeneration.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Features\CloudConnectors\ConfigFiles\CloudConnectorActionSelectorMappingFile.json" LogicalName="CloudConnectorActionSelectorMappingFile.json" />
    <EmbeddedResource Include="Features\CloudConnectors\CamelV2\Helpers\CamelActionMapping.json" LogicalName="CamelV2.CamelActionMapping.json" />
    <EmbeddedResource Include="Features\CloudConnectors\CamelV2\openapi\github.openapi.json" LogicalName="CamelV2.openapi.github.openapi.json" />
    <EmbeddedResource Include="Features\CloudConnectors\CamelV2\openapi\m365.openapi.json" LogicalName="CamelV2.openapi.m365.openapi.json" />
  </ItemGroup>

</Project>

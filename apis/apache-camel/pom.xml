<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.5</version>
        <relativePath/>
    </parent>

    <groupId>camel.harness</groupId>
    <artifactId>camel-connector-harness</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>camel-connector-harness</name>
    <description>REST-driven local test harness for Apache Camel components</description>

    <properties>
        <java.version>21</java.version>
        <camel.version>4.18.4</camel.version>
        <camel.connector.catalog.file>classpath:connectors.json</camel.connector.catalog.file>
        <camel.connector.loader.enabled>true</camel.connector.loader.enabled>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.apache.camel.springboot</groupId>
                <artifactId>camel-spring-boot-bom</artifactId>
                <version>${camel.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Spring Boot + Camel runtime -->

        <!-- Camel Catalog metadata -->
        <!-- Core runtime: connectors are NOT bundled here -->
        <dependency>
            <groupId>org.apache.camel.springboot</groupId>
            <artifactId>camel-spring-boot-starter</artifactId>
        </dependency>

        <!-- HTTP endpoint support for dynamically created routes -->
        <dependency>
            <groupId>org.apache.camel.springboot</groupId>
            <artifactId>camel-platform-http-starter</artifactId>
        </dependency>

        <!-- Jakarta JMS API: BackendConfiguration references jakarta.jms.ConnectionFactory -->
        <dependency>
            <groupId>jakarta.jms</groupId>
            <artifactId>jakarta.jms-api</artifactId>
            <version>3.1.0</version>
        </dependency>

        <!-- JDBC connection pool used by DynamicDatabaseRegistry -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
        </dependency>

        <!-- ActiveMQ Artemis Jakarta client used by JmsConfigurer -->
        <dependency>
            <groupId>org.apache.activemq</groupId>
            <artifactId>artemis-jakarta-client</artifactId>
            <version>2.41.0</version>
        </dependency>

        <!-- ActiveMQ Classic client used by JmsConfigurer / ActiveMQConnectionFactory -->
        <!-- 5.19.10 supports Java 11+, including this Java 21 application. -->
        <dependency>
            <groupId>org.apache.activemq</groupId>
            <artifactId>activemq-client</artifactId>
            <version>5.19.10</version>
        </dependency>



        <dependency>
            <groupId>org.apache.camel</groupId>
            <artifactId>camel-catalog</artifactId>
            <version>${camel.version}</version>
        </dependency>

        <!-- SAP + ServiceNow runtime components -->
        <dependency>
            <groupId>org.apache.camel.springboot</groupId>
            <artifactId>camel-servicenow-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.camel.springboot</groupId>
            <artifactId>camel-sap-netweaver-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.camel.springboot</groupId>
            <artifactId>camel-salesforce-starter</artifactId>
        </dependency>

        <!-- FTP runtime component used directly by consumer operations in ConnectorApiRoute -->
        <dependency>
            <groupId>org.apache.camel.springboot</groupId>
            <artifactId>camel-ftp-starter</artifactId>
        </dependency>

        <!-- SQL runtime component: SqlConfigurer/JdbcConfigurer build `sql:` URIs and
             bind per-request Hikari datasources via `dataSource=#requestDataSource_*`.
             Without this starter, any `sql:`/`jdbc:` dispatch fails with
             "No endpoint could be found for: sql://...". -->
        <dependency>
            <groupId>org.apache.camel.springboot</groupId>
            <artifactId>camel-sql-starter</artifactId>
        </dependency>

        <!-- PostgreSQL JDBC driver used by the per-request Hikari pools in
             DynamicDatabaseRegistry when connecting to Postgres databases. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- JSON/YAML serialization -->
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
        </dependency>

        <!-- Tests -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <cleanupDaemonThreads>false</cleanupDaemonThreads>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>

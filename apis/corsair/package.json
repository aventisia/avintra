{
  "name": "corsair-apis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Corsair sidecar hosting API-key plugins for Avintra.",
  "scripts": {
    "migrate": "tsx src/migrate.ts",
    "migrate:prod": "node dist/migrate.js",
    "seed:tools": "tsx --max-old-space-size=8192 src/seed-corsair-tools.ts",
    "seed:tools:prod": "node --max-old-space-size=8192 dist/seed-corsair-tools.js",
    "prestart": "npm run migrate",
    "dev": "tsx --max-old-space-size=8192 src/migrate.ts && tsx watch --max-old-space-size=8192 src/main.ts",
    "start": "tsx --max-old-space-size=8192 src/main.ts",
    "start:prod": "node --max-old-space-size=8192 dist/main.js",
    "generate:configs": "tsx --max-old-space-size=8192 src/generate-corsair-configs.ts",
    "plugins:check": "tsx src/check-new-plugins.ts check",
    "plugins:onboard": "tsx src/check-new-plugins.ts onboard",
    "test:dcp": "tsx --max-old-space-size=8192 src/dcp-generator/generator.test.ts",
    "test:validation": "tsx src/validation.test.ts",
    "test": "npm run test:dcp && npm run test:validation",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "lint": "echo 'No linter configured'",
    "format": "prettier --write ."
  },

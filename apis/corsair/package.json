    "migrate": "tsx src/migrate.ts",
    "migrate:prod": "node dist/migrate.js",
    "seed:tools": "tsx src/seed-corsair-tools.ts",
    "seed:tools:prod": "node dist/seed-corsair-tools.js",
    "prestart": "npm run migrate",
    "dev": "tsx src/migrate.ts && tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "start:prod": "node dist/main.js",
    "generate:configs": "tsx src/generate-corsair-configs.ts",
    "plugins:check": "tsx src/check-new-plugins.ts check",
    "plugins:onboard": "tsx src/check-new-plugins.ts onboard",
    "test:dcp": "tsx src/dcp-generator/generator.test.ts",
    "test:validation": "tsx src/validation.test.ts",
    "test": "npm run test:dcp && npm run test:validation",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "lint": "echo 'No linter configured'",
    "format": "prettier --write ."

{
  "name": "corsair-apis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Corsair sidecar hosting API-key plugins for the WORC Platform.",
  "scripts": {
    "migrate": "tsx src/migrate.ts",
    "migrate:prod": "node dist/migrate.js",
    "predev": "npm run migrate",
    "prestart": "npm run migrate",
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "generate:dcp": "tsx src/generate-dcp.ts",
    "test:dcp": "tsx src/dcp-generator/generator.test.ts",
    "test:validation": "tsx src/validation.test.ts",
    "test": "npm run test:dcp && npm run test:validation",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "lint": "echo 'No linter configured'",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@corsair-dev/github": "^0.1.15",
    "@corsair-dev/hubspot": "^0.1.7",
    "@corsair-dev/notion": "^0.1.5",
    "@corsair-dev/openweathermap": "^0.1.3",
    "@corsair-dev/outlook": "0.1.5",
    "@corsair-dev/resend": "^0.1.3",
    "@corsair-dev/slack": "^0.1.6",
    "@corsair-dev/stripe": "^0.1.4",
    "@corsair-dev/tavily": "^0.1.4",
    "@corsair-dev/twilio": "^0.1.0",
    "corsair": "0.1.114",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.23.0",
    "proxy-agent": "^8.0.2",
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.21.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}

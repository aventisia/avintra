# .env.example
# Copy this file to .env.local and fill in real values.
# DO NOT commit .env.local.
#
# SECURITY: This sidecar is internal-only. The browser-facing OAuth consent page
# (/connect) and provider callback (/api/oauth/callback) MUST be served through
# the Workspace API proxy using a generic path (e.g. /integration) so end users
# never see the internal "corsair" service name in URLs.

PORT=3456
# Public-facing base URL for OAuth flows. Must be proxied by the Workspace API
# using a generic path (e.g. /integration) so end users never see the internal
# "corsair" service name in browser URLs.
APP_URL=https://local-avintra.aventisia.com/integration
WORKSPACE_APP_URL=https://local-avintra.aventisia.com/workspace

CORSAIR_KEK=env_var

POSTGRESQL_HOST=localhost
POSTGRESQL_PORT=5432
POSTGRESQL_USERNAME=env_var
POSTGRESQL_PASSWORD=env_var

# .env.example
# Copy this file to .env.local and fill in real values; scripts/setup.sh does the copy.
# DO NOT commit .env.local. Variables already set in the OS environment win over this file.
#
# SECURITY: This sidecar is INTERNAL-ONLY. It must NOT be exposed to the public
# internet. All access goes through the Workspace API backend proxy, which is the
# authorization boundary (JWT + vault credential + resource-share). The browser-
# facing OAuth consent page (/connect) and provider callback (/api/integration/oauth-callback)
# are also reached via the Workspace API proxy, so end users never talk to the
# sidecar directly.

# Corsair specific ENV VARs
PORT=4006
# The sidecar's OWN internal API base URL, used for self-referenced URLs and
# consistent with the backend/llmpipeline config. When unset, falls back to
# http://localhost:PORT.
CORSAIR_API_BASE_URL=http://localhost:4006

# Public OAuth callback URI. Must match the backend's CORSAIR_REDIRECT_URI and the
# Workspace API proxy route /api/integration/oauth-callback. When unset, it is
# derived from APP_BASE_URL as https://<APP_BASE_URL>/workspace/api/integration/oauth-callback.
# CORSAIR_REDIRECT_URI=https://local-avintra.aventisia.com/workspace/api/integration/oauth-callback

# Common ENV VARs
APP_BASE_URL=local-avintra.aventisia.com
WORKSPACE_API_BASE_URL=http://localhost:4001
POSTGRESQL_HOST=localhost
POSTGRESQL_PORT=5432

# Required secrets
# CORSAIR_KEK=
# POSTGRESQL_USERNAME=
# POSTGRESQL_PASSWORD=

# Optional
# POSTGRESQL_DATABASE=CorsairDb
# POSTGRESQL_WORKSPACE_DB_NAME=WorkspaceDb

# .env.example
# Copy this file to .env.local and fill in real values.
# DO NOT commit .env.local.
#
# SECURITY: This sidecar is INTERNAL-ONLY. It must NOT be exposed to the public
# internet. All access goes through the Workspace API backend proxy, which is the
# authorization boundary (JWT + vault credential + resource-share). The browser-
# facing OAuth consent page (/connect) and provider callback (/api/oauth/callback)
# are also reached via the Workspace API proxy, so end users never talk to the
# sidecar directly.

# Corsair specific ENV VARs
PORT=4006
CORSAIR_KEK=env_var

# Common ENV VARs
APP_BASE_URL=local-avintra.aventisia.com

POSTGRESQL_HOST=localhost
POSTGRESQL_PORT=5432
POSTGRESQL_USERNAME=env_var
POSTGRESQL_PASSWORD=env_var

ACCOUNTS_API_BASE_URL=http://localhost:4000
WORKSPACE_API_BASE_URL=http://localhost:4001
LLMPIPELINE_API_BASE_URL=http://localhost:4003

# .env.example
# Copy this file to .env.local and fill in real values.
# DO NOT commit .env.local.
#
# SECURITY: This sidecar is INTERNAL-ONLY. It must NOT be exposed to the public
# internet. All access goes through the Workspace API backend proxy, which is the
# authorization boundary (JWT + vault credential + resource-share). The browser-
# facing OAuth consent page (/connect) and provider callback (/api/oauth/callback)
# are also reached via the Workspace API proxy, so end users never talk to the
# sidecar directly.

PORT=3456
# Internal base URL for OAuth flows. Must be proxied by the Workspace API under
# the generic "integration" path so end users never see the internal "corsair"
# service name in browser URLs.
APP_URL=https://local-avintra.aventisia.com/workspace/api/integration
WORKSPACE_APP_URL=https://local-avintra.aventisia.com/workspace

# Public OAuth redirect URI, proxied through the Workspace API under the generic
# "integration" path. Overrides the default derived from APP_URL.
CORSAIR_REDIRECT_URI=https://local-avintra.aventisia.com/workspace/api/integration/oauth-callback

CORSAIR_KEK=env_var

POSTGRESQL_HOST=localhost
POSTGRESQL_PORT=5432
POSTGRESQL_USERNAME=env_var
POSTGRESQL_PASSWORD=env_var

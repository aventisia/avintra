# LLM Pipeline local settings. Copy to .env.local (gitignored); scripts/initial-setup.sh does this.
# Loaded when ENV=local (the default). Values here override the OS environment, so
# secrets stay commented out: set them in the OS environment or uncomment them here.

SSL_VERIFY=false
UVICORN_PORT=4003
CORSAIR_API_BASE_URL=http://localhost:4006

# LiveKit voice: start the local server with `dekit start livekit`, then uncomment the
# dev key pair (LiveKit's documented `--dev` credentials). Production uses wss/https URLs.
LIVEKIT_WS_URL=ws://localhost:7880
LIVEKIT_HTTP_URL=http://localhost:7880
LIVEKIT_AGENT_NAME=avintra-voice-agent
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=secret

# Required
# APP_BASE_URL=local-avintra.aventisia.com
# POSTGRESQL_HOST=localhost
# POSTGRESQL_PORT=5432
# POSTGRESQL_USERNAME=
# POSTGRESQL_PASSWORD=
# JWT_SECRET_KEY=

# Optional
# WORKSPACE_API_URL=
# POSTGRESQL_WORKSPACE_DB_NAME=WorkspaceDb
# POSTGRESQL_ACCOUNTS_DB_NAME=AccountsDb
# OPENAI_API_KEY=
# DEEPINFRA_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# CLAUDE_API_KEY=
# OLLAMA_API_KEY=
# QDRANT_URL=
# QDRANT_API_KEY=
# ELEVENLABS_API_KEY=

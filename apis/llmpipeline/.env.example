# LLM Pipeline local settings. Copy to .env.local (gitignored); scripts/initial-setup.sh does this.
# Loaded when ENV=local (the default). Values here override the OS environment.
# scripts/initial-setup.sh fills each __GENERATED_BY_INITIAL_SETUP__ key, reusing an OS
# environment value when one is set.

SSL_VERIFY=false
UVICORN_PORT=4003
CORSAIR_API_BASE_URL=http://localhost:4006

# Required; replace the PostgreSQL credentials with your own
APP_BASE_URL=local-avintra.aventisia.com
POSTGRESQL_HOST=localhost
POSTGRESQL_PORT=5432
POSTGRESQL_USERNAME=postgres
POSTGRESQL_PASSWORD=postgres

# Required secret, generated by scripts/initial-setup.sh to match AccountsAPIs and WorkspaceAPIs
JWT_SECRET_KEY=__GENERATED_BY_INITIAL_SETUP__

# Optional
# WORKSPACE_API_URL=http://localhost:4001/api
# POSTGRESQL_WORKSPACE_DB_NAME=WorkspaceDb
# POSTGRESQL_ACCOUNTS_DB_NAME=AccountsDb
# OPENAI_API_KEY=
# DEEPINFRA_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# CLAUDE_API_KEY=
# OLLAMA_API_KEY=
# QDRANT_URL=
# QDRANT_API_KEY=
# ELEVENLABS_API_KEY=

# LLM Pipeline local settings. Copy to .env.local (gitignored); scripts/setup.sh does this.
# Loaded when ENV=local (the default). Values here override the OS environment, so
# secrets stay commented out: set them in the OS environment or uncomment them here.

SSL_VERIFY=false
UVICORN_PORT=4003
CORSAIR_API_BASE_URL=http://localhost:4006

# LiveKit voice: run the server independently with
# `docker compose -f deploy/livekit/docker-compose.yml up -d`, then uncomment the
# dev key pair below. The voice worker starts automatically with llmpipeline when
# LIVEKIT_API_KEY and LIVEKIT_API_SECRET are set. These are LiveKit's documented
# `--dev` credentials; never reuse them outside local development.
# Setting only one of the two URLs is enough: the other is derived from it.
LIVEKIT_WS_URL=ws://localhost:7880
LIVEKIT_HTTP_URL=http://localhost:7880
# LiveKit Cloud (production): use the project's URLs and API key pair instead.
# LIVEKIT_WS_URL=wss://<project>.livekit.cloud
# LIVEKIT_HTTP_URL=https://<project>.livekit.cloud
LIVEKIT_AGENT_NAME=avintra-voice-agent
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=secret
# The worker fetches voice settings from WorkspaceAPIs; production falls back to APP_BASE_URL.
WORKSPACE_API_URL=https://localhost:4001/api

# Required
# APP_BASE_URL=local-avintra.aventisia.com
# POSTGRESQL_HOST=localhost
# POSTGRESQL_PORT=5432
# POSTGRESQL_USERNAME=
# POSTGRESQL_PASSWORD=
# JWT_SECRET_KEY=

# Optional
# POSTGRESQL_WORKSPACE_DB_NAME=WorkspaceDb
# POSTGRESQL_ACCOUNTS_DB_NAME=AccountsDb
# OPENAI_API_KEY=
# DEEPINFRA_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# CLAUDE_API_KEY=
# OLLAMA_API_KEY=
# QDRANT_URL=
# QDRANT_API_KEY=
# ELEVENLABS_API_KEY=

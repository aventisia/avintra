# .env
# IMPORTANT NOTE: DO NOT STORE SENSITIVE INFORMATION IN THIS FILE.
# This file is intended for non-sensitive default values.
# Use .env.local (untracked) or system environment variables for sensitive data.

APP_BASE_URL=env_var

POSTGRESQL_HOST=env_var
POSTGRESQL_PORT=env_var
POSTGRESQL_USERNAME=env_var
POSTGRESQL_PASSWORD=env_var

JWT_SECRET_KEY=env_var

OPENAI_API_KEY=env_var
DEEPINFRA_API_KEY=env_var
GEMINI_API_KEY=env_var
OPENROUTER_API_KEY=env_var
CLAUDE_API_KEY=env_var

OPENAI_API_URL=https://api.openai.com/v1
DEEPINFRA_API_URL=https://api.deepinfra.com/v1/openai/chat/completions
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
OPENROUTER_API_URL=https://openrouter.ai/api/v1
CLAUDE_API_URL=https://api.anthropic.com/v1

# TODO: Need to remove it later
QDRANT_URL=env_var
QDRANT_API_KEY=env_var
OLLAMA_API_URL=https://llm.aventisia.com:8443/api/chat
OLLAMA_API_KEY=env_var
ELEVENLABS_API_URL=https://api.elevenlabs.io/v1
ELEVENLABS_API_KEY=env_var

# Corsair sidecar configuration
# URL of the Corsair sidecar (used by llmpipeline to invoke Corsair tools directly).
CORSAIR_SIDECAR_URL=env_var
# Shared secret expected by the sidecar in the X-Corsair-Api-Key header.
CORSAIR_API_KEY=env_var
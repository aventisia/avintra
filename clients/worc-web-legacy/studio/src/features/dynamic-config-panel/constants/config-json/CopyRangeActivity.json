{
  "name": "CopyRange",
  "label": "Copy Range (HTTP)",
  "description": "Copies a range of cells to another location in the workbook.",
  "version": "1.0.0",
  "auther": "@aventisia",
  "supportedPlatforms": [
    "desktop"
  ],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "text",
      "name": "TenantId",
      "label": "Tenant ID",
      "description": "Azure AD Tenant ID",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "ClientId",
      "label": "Client ID",
      "description": "Azure AD Application Client ID",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "ClientSecret",
      "label": "Client Secret",
      "description": "Azure AD Application Client Secret",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "DriveId",
      "label": "Drive ID",
      "description": "OneDrive or SharePoint Drive ID",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "ItemId",
      "label": "Item ID",
      "description": "Excel file Item ID",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "SourceRange",
      "label": "Source Range",
      "description": "The A1-style address of the range to copy from (e.g., \u0027A1:C10\u0027 or \u0027Sheet2!B5:D20\u0027). Must be a valid range in the source worksheet.",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "DestinationRange",
      "label": "Destination Range",
      "description": "The A1-style address of the top-left cell or range where data will be pasted (e.g., \u0027E1\u0027 or \u0027Sheet3!A1\u0027). The destination range must be the same size as the source or larger.",
      "defaultValue": "",
      "required": true
    }
  ]
}
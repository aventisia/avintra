{
  "name": "GetSpecialFolderPath",
  "label": "Get Special Folder Path",
  "description": "This activity retrieves the path of a Windows special folder, such as Desktop, My Pictures, Internet Cache, etc.",
  "version": "1.0.0",
  "auther": "@aventisia",
  "supportedPlatforms": ["windows"],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "select",
      "name": "SpecialFolderName",
      "label": "Special Folder Name",
      "description": "Select the name of the special folder whose path you want to retrieve.",
      "defaultValue": "Desktop",
      "required": false,
      "selectOptions": [
        {
          "label": "Desktop",
          "value": "Desktop",
          "description": ""
        },
        {
          "label": "Music",
          "value": "Music",
          "description": ""
        },
        {
          "label": "Templates",
          "value": "Templates",
          "description": ""
        },
        {
          "label": "ApplicationData",
          "value": "ApplicationData",
          "description": ""
        },
        {
          "label": "LocalApplicationData",
          "value": "LocalApplicationData",
          "description": ""
        },
        {
          "label": "InternetCache",
          "value": "InternetCache",
          "description": ""
        },
        {
          "label": "Cookies",
          "value": "Cookies",
          "description": ""
        },
        {
          "label": "History",
          "value": "History",
          "description": ""
        }
      ]
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "SpecialFolderPath",
      "label": "Special Folder Path",
      "description": "The retrieved path of the special folder.",
      "defaultValue": {
        "value": "SpecialFolderPath",
        "enabled": true
      },
      "required": false
    }
  ]
}

{
  "name": "ExecuteSqlStatement",
  "label": "Execute SQL Statement",
  "description": "Connect to a database and execute an SQL statement.",
  "version": "1.0.0",
  "auther": "@aventisia",
  "supportedPlatforms": [
    "desktop"
  ],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "select",
      "name": "ConnectionMode",
      "label": "Connection Mode",
      "description": "",
      "defaultValue": "",
      "required": true,
      "selectOptions": [
        {
          "label": "Use Connection String",
          "value": "UseConnectionString",
          "description": ""
        },
        {
          "label": "Use Existing Connection",
          "value": "UseExistingConnection",
          "description": ""
        }
      ]
    },
    {
      "direction": "Input",
      "type": "password",
      "name": "ConnectionString",
      "label": "Connection String",
      "description": "The connection string to the database.",
      "defaultValue": "",
      "required": false,
      "renderIf": {
        "conditions": [
          {
            "field": "ConnectionMode",
            "equals": "UseConnectionString"
          }
        ]
      }
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "ExistingConnection",
      "label": "Existing SQL Connection",
      "description": "The Existing connection string to the database.",
      "defaultValue": "",
      "required": false,
      "renderIf": {
        "conditions": [
          {
            "field": "ConnectionMode",
            "equals": "UseExistingConnection"
          }
        ]
      }
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "SqlStatement",
      "label": "SQL Statement",
      "description": "The SQL statement to execute.",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "select",
      "name": "OperationType",
      "label": "Operation Type",
      "description": "The type of SQL operation to perform.",
      "defaultValue": "",
      "required": true,
      "selectOptions": [
        {
          "label": "Non-Query",
          "value": "NonQuery",
          "description": "Execute INSERT, UPDATE, DELETE statements."
        },
        {
          "label": "Scalar",
          "value": "Scalar",
          "description": "Execute a SQL statement and return a single value."
        },
        {
          "label": "DataSet",
          "value": "DataSet",
          "description": "Execute a SQL statement and return a result set as DataTable."
        }
      ]
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "ResultDataTable",
      "label": "Result Data Table",
      "description": "The result data table.",
      "defaultValue": {
        "value": "ResultDataTable",
        "enabled": true
      },
      "required": false
    }
  ]
}
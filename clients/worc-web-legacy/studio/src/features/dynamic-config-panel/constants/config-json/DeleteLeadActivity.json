{
  "name": "DeleteLead",
  "label": "Delete a lead",
  "description": "Deletes a lead from Salesforce by its ID.",
  "version": "1.0.0",
  "auther": "@aventisia",
  "supportedPlatforms": [
    "desktop"
  ],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "text",
      "name": "Credential",
      "label": "Credential to connect with",
      "description": "The credential to connect with",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "LeadId",
      "label": "Lead ID",
      "description": "The ID of the lead to delete",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "Response",
      "label": "Response",
      "description": "The raw JSON response from Salesforce",
      "defaultValue": {
        "value": "Response",
        "enabled": true
      },
      "required": false
    }
  ]
}
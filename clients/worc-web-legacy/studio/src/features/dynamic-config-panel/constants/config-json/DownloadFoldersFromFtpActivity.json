{
  "name": "DownloadFoldersFromFtp",
  "label": "Download Folder from FTP",
  "description": "Downloads one or more folders from an FTP server.",
  "version": "1.0.0",
  "auther": "@aventisia",
  "supportedPlatforms": ["cloud", "windows"],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "text",
      "name": "FtpConnection",
      "label": "FTP Connection",
      "description": "The FTP connection object.",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "FolderNames",
      "label": "Folder Name",
      "description": "The folder name to download.",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "LocalDirectory",
      "label": "Local Directory",
      "description": "The local directory to save the downloaded folder.",
      "defaultValue": "",
      "required": true
    }
  ]
}

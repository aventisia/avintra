{
  "name": "ListAllRecordsSapConcur",
  "label": "List All Records in SAP Concur",
  "description": "Retrieves a list of all records from a specified endpoint.",
  "version": "1.0.0",
  "auther": "@aventisia",
  "supportedPlatforms": [
    "desktop"
  ],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "text",
      "name": "ClientId",
      "label": "Client ID",
      "description": "The Client ID from SAP Concur App Management.",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "ClientSecret",
      "label": "Client Secret",
      "description": "The Client Secret from SAP Concur App Management.",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "Scope",
      "label": "Scope",
      "description": "The scope required (e.g., expense.report.read).",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "ApiEndpoint",
      "label": "API Endpoint",
      "description": "The base API endpoint (e.g., /expense/v4.0/reports).",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "QueryParameters",
      "label": "Query Parameters",
      "description": "Optional query string (e.g., ?limit=50\u0026offset=0).",
      "defaultValue": "",
      "required": false
    },
    {
      "direction": "Input",
      "type": "switch",
      "name": "ContinueOnError",
      "label": "Continue on Error",
      "description": "If true, workflow continues even if the request fails.",
      "defaultValue": false,
      "required": false
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "Response",
      "label": "Response",
      "description": "JSON response containing list of records.",
      "defaultValue": {
        "value": "Response",
        "enabled": true
      },
      "required": false
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "StatusCode",
      "label": "Status Code",
      "description": "HTTP status code returned by the API.",
      "defaultValue": {
        "value": "StatusCode",
        "enabled": true
      },
      "required": false
    }
  ]
}
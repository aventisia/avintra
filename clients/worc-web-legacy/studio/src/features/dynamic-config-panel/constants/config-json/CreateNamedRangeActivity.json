{
  "name": "CreateNamedRange",
  "label": "Create Named Range (HTTP)",
  "description": "Creates a named range in an Excel workbook using Microsoft Graph HTTP POST.",
  "version": "1.0.0",
  "auther": "@aventisia",
  "supportedPlatforms": [
    "desktop"
  ],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "text",
      "name": "TenantId",
      "label": "Tenant ID",
      "description": "Azure AD Tenant ID (GUID or domain)",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "ClientId",
      "label": "Client ID",
      "description": "Azure AD Application (Client) ID",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "ClientSecret",
      "label": "Client Secret",
      "description": "Azure AD Application Client Secret",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "DriveId",
      "label": "Drive ID",
      "description": "OneDrive or SharePoint Drive ID",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "ItemId",
      "label": "Item ID",
      "description": "Excel file Item ID in the drive",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "Name",
      "label": "Named Range Name",
      "description": "The name to assign to the Excel named range",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "Reference",
      "label": "Reference",
      "description": "The Excel range reference (e.g., \u0027Sheet1!A1:B10\u0027)",
      "defaultValue": "",
      "required": true
    }
  ]
}
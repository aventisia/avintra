{
  "name": "DeleteServiceNowTableRecord",
  "label": "Delete ServiceNow Table Record",
  "description": "Deletes a record from a ServiceNow table using the record sys_id and credential ID (BasicAuth \u2192 Base64(username:password) or OAuth2 \u2192 Bearer token).",
  "version": "1.0.0",
  "auther": "@aventisia",
  "supportedPlatforms": [
    "desktop"
  ],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "text",
      "name": "InstanceUrl",
      "label": "Instance URL",
      "description": "Full ServiceNow instance URL (e.g., \u0027https://dev12345.service-now.com\u0027).",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "CredentialId",
      "label": "Credential ID / Token",
      "description": "For BasicAuth \u2192 provide Base64(username:password). For OAuth2 \u2192 provide Bearer token.",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "select",
      "name": "AuthMethod",
      "label": "Auth Method",
      "description": "Authentication method: BasicAuth or OAuth2.",
      "defaultValue": "",
      "required": true,
      "selectOptions": [
        {
          "label": "Basic Auth",
          "value": "BasicAuth",
          "description": "Authenticate using Basic Authentication."
        },
        {
          "label": "OAuth2",
          "value": "OAuth2",
          "description": "Authenticate using OAuth 2.0."
        }
      ]
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "TableName",
      "label": "Table Name",
      "description": "The ServiceNow table name (e.g., \u0027incident\u0027, \u0027cmdb_ci\u0027).",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "SysId",
      "label": "Record Sys_Id",
      "description": "The sys_id of the record to delete.",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "Response",
      "label": "API Response",
      "description": "Raw response returned from ServiceNow API.",
      "defaultValue": {
        "value": "Response",
        "enabled": true
      },
      "required": false
    }
  ]
}
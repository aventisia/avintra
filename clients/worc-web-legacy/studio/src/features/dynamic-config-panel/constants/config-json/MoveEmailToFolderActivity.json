{
  "name": "MoveEmailToFolder",
  "label": "Move Email To Folder",
  "description": "Moves an email to a specified folder using Microsoft Graph API.",
  "version": "1.0.0",
  "auther": "@aventisia",
  "supportedPlatforms": [
    "desktop"
  ],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "text",
      "name": "UserEmail",
      "label": "User Email",
      "description": "The email address of the mailbox owner.",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "MessageId",
      "label": "Message ID",
      "description": "The ID of the email message to move.",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "FolderId",
      "label": "Folder ID",
      "description": "The destination folder ID to move the message into.",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "TenantId",
      "label": "Tenant ID",
      "description": "Azure Active Directory tenant (directory) ID.",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "ClientId",
      "label": "Client ID",
      "description": "Azure AD application (client) ID.",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "ClientSecret",
      "label": "Client Secret",
      "description": "Azure AD application client secret.",
      "defaultValue": "",
      "required": true
    }
  ]
}
{
  "name": "SetColorInExcelWorksheet",
  "label": "Set Color in Excel Worksheet",
  "description": "Fills the background of a selected range of cells with the specified color.",
  "version": "1.0.0",
  "auther": "@aventisia",
  "supportedPlatforms": ["windows"],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "text",
      "name": "WorksheetInstance",
      "label": "Worksheet Instance (Optional)",
      "description": "The Excel Worksheet object where the color will be applied. If not provided, the active worksheet of the workbook is used.",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "select",
      "name": "SelectionMode",
      "label": "Selection Mode",
      "description": "Specifies how to select the cells to color.",
      "defaultValue": "SingleCell",
      "required": true,
      "selectOptions": [
        {
          "label": "Single Cell",
          "value": "SingleCell",
          "description": "Colors a single cell by column and row."
        },
        {
          "label": "Range of Cells",
          "value": "RangeOfCells",
          "description": "Colors a specified range (e.g., \u0027A1:B10\u0027)."
        },
        {
          "label": "Named Cells",
          "value": "NamedCells",
          "description": "Colors cells based on named ranges."
        }
      ]
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "StartColumn",
      "label": "Start Column",
      "description": "The starting column of the cell to color (e.g., \u0027A\u0027).",
      "defaultValue": "",
      "required": false,
      "renderIf": {
        "conditions": [
          {
            "field": "SelectionMode",
            "equals": "SingleCell"
          }
        ]
      }
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "StartRow",
      "label": "Start Row",
      "description": "The starting row of the cell to color (e.g., \u00271\u0027).",
      "defaultValue": "",
      "required": false,
      "renderIf": {
        "conditions": [
          {
            "field": "SelectionMode",
            "equals": "SingleCell"
          }
        ]
      }
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "StartColumnRange",
      "label": "Start Column (Range)",
      "description": "The starting column of the range to color (e.g., \u0027A\u0027).",
      "defaultValue": "",
      "required": false,
      "renderIf": {
        "conditions": [
          {
            "field": "SelectionMode",
            "equals": "RangeOfCells"
          }
        ]
      }
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "StartRowRange",
      "label": "Start Row (Range)",
      "description": "The starting row of the range to color (e.g., \u00271\u0027).",
      "defaultValue": "",
      "required": false,
      "renderIf": {
        "conditions": [
          {
            "field": "SelectionMode",
            "equals": "RangeOfCells"
          }
        ]
      }
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "EndColumnRange",
      "label": "End Column",
      "description": "The ending column of the range to color (e.g., \u0027B\u0027).",
      "defaultValue": "",
      "required": false,
      "renderIf": {
        "conditions": [
          {
            "field": "SelectionMode",
            "equals": "RangeOfCells"
          }
        ]
      }
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "EndRowRange",
      "label": "End Row",
      "description": "The ending row of the range to color (e.g., \u00275\u0027).",
      "defaultValue": "",
      "required": false,
      "renderIf": {
        "conditions": [
          {
            "field": "SelectionMode",
            "equals": "RangeOfCells"
          }
        ]
      }
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "NamedRange",
      "label": "Named Range",
      "description": "The name of the named range to color.",
      "defaultValue": "",
      "required": false,
      "renderIf": {
        "conditions": [
          {
            "field": "SelectionMode",
            "equals": "NamedCells"
          }
        ]
      }
    },
    {
      "direction": "Input",
      "type": "select",
      "name": "ColorFormat",
      "label": "Color Format",
      "description": "Specifies the format of the color input.",
      "defaultValue": "Name",
      "required": true,
      "selectOptions": [
        {
          "label": "Name",
          "value": "Name",
          "description": "Uses predefined color names."
        },
        {
          "label": "Hexadecimal Value",
          "value": "HexadecimalValue",
          "description": "Uses hexadecimal RGB values."
        }
      ]
    },
    {
      "direction": "Input",
      "type": "select",
      "name": "ColorName",
      "label": "Color Name",
      "description": "The name of the color to apply (e.g., \u0027Red\u0027, \u0027Green\u0027).",
      "defaultValue": "",
      "required": false,
      "selectOptions": [
        {
          "label": "Red",
          "value": "Red",
          "description": ""
        },
        {
          "label": "Green",
          "value": "Green",
          "description": ""
        },
        {
          "label": "Blue",
          "value": "Blue",
          "description": ""
        },
        {
          "label": "Yellow",
          "value": "Yellow",
          "description": ""
        },
        {
          "label": "Black",
          "value": "Black",
          "description": ""
        },
        {
          "label": "White",
          "value": "White",
          "description": ""
        },
        {
          "label": "Aquamarine",
          "value": "Aquamarine",
          "description": ""
        },
        {
          "label": "Azure",
          "value": "Azure",
          "description": ""
        },
        {
          "label": "Bisque",
          "value": "Bisque",
          "description": ""
        },
        {
          "label": "Coral",
          "value": "Coral",
          "description": ""
        },
        {
          "label": "DarkOrange",
          "value": "DarkOrange",
          "description": ""
        },
        {
          "label": "Gold",
          "value": "Gold",
          "description": ""
        },
        {
          "label": "Lime",
          "value": "Lime",
          "description": ""
        },
        {
          "label": "Magenta",
          "value": "Magenta",
          "description": ""
        },
        {
          "label": "Orange",
          "value": "Orange",
          "description": ""
        },
        {
          "label": "Pink",
          "value": "Pink",
          "description": ""
        },
        {
          "label": "Purple",
          "value": "Purple",
          "description": ""
        },
        {
          "label": "Teal",
          "value": "Teal",
          "description": ""
        },
        {
          "label": "Turquoise",
          "value": "Turquoise",
          "description": ""
        },
        {
          "label": "Violet",
          "value": "Violet",
          "description": ""
        }
      ],
      "renderIf": {
        "conditions": [
          {
            "field": "ColorFormat",
            "equals": "Name"
          }
        ]
      }
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "ColorHexValue",
      "label": "Color Hexadecimal Value",
      "description": "The hexadecimal value of the color to apply (e.g., \u0027#FF0000\u0027).",
      "defaultValue": "",
      "required": false,
      "renderIf": {
        "conditions": [
          {
            "field": "ColorFormat",
            "equals": "HexadecimalValue"
          }
        ]
      }
    }
  ]
}

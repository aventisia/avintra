{
  "name": "GetServiceNowUser",
  "label": "Get ServiceNow User",
  "description": "Retrieves a user from ServiceNow by sys_id or username using a stored credential.",
  "version": "1.0.0",
  "auther": "@aventisia",
  "supportedPlatforms": ["cloud", "windows"],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "text",
      "name": "CredentialId",
      "label": "Credential",
      "description": "The stored ServiceNow credential (Bearer token)",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "select",
      "name": "RetrieveIdentifier",
      "label": "Retrieve Identifier",
      "description": "How to identify the user: by sys_id (ID) or username.",
      "defaultValue": "",
      "required": true,
      "selectOptions": [
        {
          "label": "ID",
          "value": "Id",
          "description": "Retrieve user by sys_id (unique identifier)."
        },
        {
          "label": "Username",
          "value": "Username",
          "description": "Retrieve user by login name (user_name)."
        }
      ]
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "UserId",
      "label": "User ID",
      "description": "The sys_id of the user to retrieve",
      "defaultValue": "",
      "required": false,
      "renderIf": {
        "conditions": [
          {
            "field": "RetrieveIdentifier",
            "equals": "Id"
          }
        ]
      }
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "UsernameValue",
      "label": "Username",
      "description": "The login name of the user to retrieve",
      "defaultValue": "",
      "required": false,
      "renderIf": {
        "conditions": [
          {
            "field": "RetrieveIdentifier",
            "equals": "Username"
          }
        ]
      }
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "Options",
      "label": "Options",
      "description": "Additional query parameters (e.g., sysparm_fields=short_description,email)",
      "defaultValue": "",
      "required": false
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "Subdomain",
      "label": "ServiceNow Subdomain",
      "description": "Your ServiceNow instance subdomain (e.g., \u0027dev12345\u0027)",
      "defaultValue": "",
      "required": false
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "Response",
      "label": "API Response",
      "description": "Raw JSON response from ServiceNow API",
      "defaultValue": {
        "value": "Response",
        "enabled": true
      },
      "required": false
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "User",
      "label": "User",
      "description": "The retrieved user record as JObject (contains sys_id, user_name, etc.)",
      "defaultValue": {
        "value": "User",
        "enabled": true
      },
      "required": false
    }
  ]
}

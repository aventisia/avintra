{
  "name": "AddTable",
  "label": "Add Table to Worksheet",
  "description": "Adds a table to a worksheet in Excel using Microsoft Graph HTTP POST.",
  "version": "1.0.0",
  "auther": "@aventisia",
  "supportedPlatforms": [
    "desktop"
  ],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "text",
      "name": "TenantId",
      "label": "Tenant ID",
      "description": "Azure AD Tenant ID",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "ClientId",
      "label": "Client ID",
      "description": "Azure AD Client ID",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "ClientSecret",
      "label": "Client Secret",
      "description": "Azure AD Client Secret",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "DriveId",
      "label": "Drive ID",
      "description": "OneDrive or SharePoint Drive ID",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "ItemId",
      "label": "Item ID",
      "description": "Excel file Item ID",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "WorksheetName",
      "label": "Worksheet Name",
      "description": "Worksheet to add table to",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "Address",
      "label": "Address",
      "description": "Range for table, e.g., \u0027A1:C10\u0027",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "switch",
      "name": "HasHeaders",
      "label": "Has Headers",
      "description": "Whether table has headers",
      "defaultValue": "",
      "required": true
    }
  ]
}
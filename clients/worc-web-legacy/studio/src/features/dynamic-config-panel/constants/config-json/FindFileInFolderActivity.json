{
  "name": "FindFileInFolder",
  "label": "Find File in Folder",
  "description": "Finds a single file in a folder (and optionally subfolders) based on criteria like largest, smallest, newest, oldest, etc.",
  "version": "1.0.0",
  "auther": "@aventisia",
  "supportedPlatforms": ["cloud", "windows"],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "text",
      "name": "FolderPath",
      "label": "Folder Path",
      "description": "The path to the folder to search in.",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "select",
      "name": "SearchOption",
      "label": "Search Option",
      "description": "Criteria to select the file: Largest, Smallest, Newest, Oldest, etc.",
      "defaultValue": "Largest",
      "required": true,
      "selectOptions": [
        {
          "label": "Largest",
          "value": "Largest",
          "description": "Find the largest file."
        },
        {
          "label": "Smallest",
          "value": "Smallest",
          "description": "Find the smallest file."
        },
        {
          "label": "Newest Modifed",
          "value": "Newest",
          "description": "Find the newest (last modified) file."
        },
        {
          "label": "Oldest Modifed",
          "value": "Oldest",
          "description": "Find the oldest (last modified) file."
        },
        {
          "label": "Newest Created",
          "value": "NewestCreated",
          "description": "Find the newest (created) file."
        },
        {
          "label": "Oldest Created",
          "value": "OldestCreated",
          "description": "Find the oldest (created) file."
        },
        {
          "label": "First Alphabetical",
          "value": "FirstAlphabetical",
          "description": "First file alphabetically."
        },
        {
          "label": "Last Alphabetical",
          "value": "LastAlphabetical",
          "description": "Last file alphabetically."
        }
      ]
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "FileFilter",
      "label": "File Filter",
      "description": "File filter(s), e.g. \u0027*.txt\u0027 or \u0027*.jpg;*.png\u0027.",
      "defaultValue": "*",
      "required": false
    },
    {
      "direction": "Input",
      "type": "switch",
      "name": "IncludeSubfolders",
      "label": "Include Subfolders",
      "description": "If true, includes files from all subfolders.",
      "defaultValue": true,
      "required": false
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "ResultFilePath",
      "label": "Result File Path",
      "description": "The file path of the found file.",
      "defaultValue": {
        "value": "ResultFilePath",
        "enabled": true
      },
      "required": false
    }
  ]
}

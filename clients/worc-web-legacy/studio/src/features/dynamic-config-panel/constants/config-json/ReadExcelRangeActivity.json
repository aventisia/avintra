{
  "name": "ReadExcelRange",
  "label": "Read Excel Range (HTTP)",
  "description": "Reads values from an Excel range using Microsoft Graph HTTP GET.",
  "version": "1.0.0",
  "auther": "@aventisia",
  "supportedPlatforms": [
    "desktop"
  ],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "text",
      "name": "TenantId",
      "label": "Tenant ID",
      "description": "Azure AD Tenant ID",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "ClientId",
      "label": "Client ID",
      "description": "Azure AD Application Client ID",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "ClientSecret",
      "label": "Client Secret",
      "description": "Azure AD Application Client Secret",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "DriveId",
      "label": "Drive ID",
      "description": "OneDrive or SharePoint Drive ID",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "ItemId",
      "label": "Item ID",
      "description": "Excel file Item ID",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "WorksheetName",
      "label": "Worksheet Name",
      "description": "Name of the worksheet",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "RangeAddress",
      "label": "Range Address",
      "description": "Range to read (e.g., A1:D10)",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "OutputJson",
      "label": "Output JSON",
      "description": "Outputs the range values as JSON",
      "defaultValue": {
        "value": "OutputJson",
        "enabled": true
      },
      "required": false
    }
  ]
}
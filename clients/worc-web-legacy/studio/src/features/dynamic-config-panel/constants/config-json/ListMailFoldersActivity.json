{
  "name": "ListMailFolders",
  "label": "List Mail Folders",
  "description": "Lists all mail folders for a user\u0027s mailbox using Microsoft Graph API.",
  "version": "1.0.0",
  "auther": "@aventisia",
  "supportedPlatforms": [
    "desktop"
  ],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "text",
      "name": "UserEmail",
      "label": "User Email",
      "description": "The email address of the mailbox owner.",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "TenantId",
      "label": "Tenant ID",
      "description": "Azure Active Directory tenant (directory) ID.",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "ClientId",
      "label": "Client ID",
      "description": "Azure AD application (client) ID.",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "ClientSecret",
      "label": "Client Secret",
      "description": "Azure AD application client secret.",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "MailFolders",
      "label": "Mail Folders JSON",
      "description": "Returns the user\u0027s mail folders in JSON array format.",
      "defaultValue": {
        "value": "MailFolders",
        "enabled": true
      },
      "required": false
    }
  ]
}
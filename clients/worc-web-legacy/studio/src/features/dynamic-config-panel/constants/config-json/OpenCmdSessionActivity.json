{
  "name": "OpenCmdSession",
  "label": "Open CMD Session",
  "discription": "Opens a new CMD session with optional encoding settings.",
  "version": "1.0.0",
  "auther": "@aventisia",
  "supportedPlatforms": [
    "desktop"
  ],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "text",
      "name": "WorkingFolder",
      "label": "Working Folder",
      "description": "The directory where the CMD session should start.",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "switch",
      "name": "ChangeCodePage",
      "label": "Change Code Page",
      "description": "Specifies whether to change the code page in the CMD session.",
      "defaultValue": false,
      "required": false
    },
    {
      "direction": "Input",
      "type": "select",
      "name": "Encoding",
      "label": "Encoding",
      "description": "The encoding to use if \u0027Change Code Page\u0027 is enabled.",
      "defaultValue": "UTF8",
      "required": false,
      "selectOptions": [
        {
          "label": "UTF8",
          "value": "UTF8",
          "description": ""
        },
        {
          "label": "UTF7",
          "value": "UTF7",
          "description": ""
        },
        {
          "label": "ASCII",
          "value": "ASCII",
          "description": ""
        },
        {
          "label": "Windows1252",
          "value": "Windows1252",
          "description": ""
        },
        {
          "label": "ISO8859_1",
          "value": "ISO8859_1",
          "description": ""
        },
        {
          "label": "ISCIIAssamese",
          "value": "ISCIIAssamese",
          "description": ""
        },
        {
          "label": "ISCIIOriya",
          "value": "ISCIIOriya",
          "description": ""
        },
        {
          "label": "ISCIIMalayalam",
          "value": "ISCIIMalayalam",
          "description": ""
        },
        {
          "label": "ISCIIKannada",
          "value": "ISCIIKannada",
          "description": ""
        }
      ],
      "renderIf": {
        "conditions": [
          {
            "field": "ChangeCodePage",
            "equals": true
          }
        ]
      }
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "CmdSession",
      "label": "CMD Session",
      "description": "Details of the opened CMD session.",
      "defaultValue": {
        "value": "CmdSession",
        "enabled": true
      },
      "required": false
    }
  ]
}
{
  "name": "CallTransaction",
  "label": "Call Transaction",
  "description": "Calls an SAP transaction code with optional prefix (/n, /o, or none).",
  "version": "1.0.0",
  "auther": "@aventisia",
  "supportedPlatforms": ["cloud", "windows"],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "text",
      "name": "TransactionCode",
      "label": "Transaction Code",
      "description": "SAP Transaction Code (e.g., SE38, MM01)",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "select",
      "name": "Prefix",
      "label": "Prefix",
      "description": "Prefix to use: /n (same window), /o (new session), or no prefix",
      "defaultValue": "NewTransaction",
      "required": true,
      "selectOptions": [
        {
          "label": "NewTransaction",
          "value": "NewTransaction",
          "description": "/ n - New transaction in same window"
        },
        {
          "label": "NewSession ",
          "value": "NewSession",
          "description": "/ o - Open in new session"
        },
        {
          "label": "NoPrefix",
          "value": "NoPrefix",
          "description": "No prefix - Use current context"
        }
      ]
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "Timeout",
      "label": "Timeout",
      "description": "Timeout for transaction execution (in seconds)",
      "defaultValue": 30,
      "required": false
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "DelayBefore",
      "label": "Delay Before",
      "description": "Delay before execution (in seconds)",
      "defaultValue": 0.20000000000000001,
      "required": false
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "DelayAfter",
      "label": "Delay After",
      "description": "Delay after execution (in seconds)",
      "defaultValue": 0.29999999999999999,
      "required": false
    },
    {
      "direction": "Input",
      "type": "switch",
      "name": "ContinueOnError",
      "label": "Continue on Error",
      "description": "Whether to continue on error",
      "defaultValue": false,
      "required": false
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "Result",
      "label": "Result",
      "description": "Result of the operation",
      "defaultValue": {
        "value": "Result",
        "enabled": true
      },
      "required": false
    }
  ]
}

{
  "name": "ChangeFtpWorkingDirectory",
  "label": "Change Working Directory",
  "description": "Sets the current working directory for an FTP connection.",
  "version": "1.0.0",
  "auther": "@aventisia",
  "supportedPlatforms": [
    "desktop"
  ],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "text",
      "name": "FtpConnection",
      "label": "FTP Connection",
      "description": "The FTP connection object.",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "NewDirectoryPath",
      "label": "New Directory Path",
      "description": "The new working directory path.",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "ActualDirectoryPath",
      "label": "Actual Directory Path",
      "description": "Returns the actual directory path after change.",
      "defaultValue": {
        "value": "ActualDirectoryPath",
        "enabled": true
      },
      "required": false
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "Success",
      "label": "Success",
      "description": "Indicates whether the operation was successful.",
      "defaultValue": {
        "value": "Success",
        "enabled": true
      },
      "required": false
    }
  ]
}
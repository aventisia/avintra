{
  "name": "HashTextWithKey",
  "label": "Hash Text with Key",
  "description": "Hash a string with a key, using a specified algorithm",
  "version": "1.0.0",
  "auther": "@aventisia",
  "supportedPlatforms": [
    "desktop"
  ],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "text",
      "name": "Text",
      "label": "Text to Hash",
      "description": "The text you want to hash",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "Key",
      "label": "Key to Use",
      "description": "The key to use in hashing",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "select",
      "name": "Algorithm",
      "label": "Hashing Algorithm",
      "description": "The algorithm to use for hashing (SHA256, SHA512, or MD5)",
      "defaultValue": "",
      "required": true,
      "selectOptions": [
        {
          "label": "SHA256",
          "value": "SHA256",
          "description": "SHA256 algorithm"
        },
        {
          "label": "SHA512",
          "value": "SHA512",
          "description": "SHA512 algorithm"
        },
        {
          "label": "MD5",
          "value": "MD5",
          "description": "MD5 algorithm"
        }
      ]
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "HashedText",
      "label": "Hashed Text",
      "description": "The hashed text",
      "defaultValue": {
        "value": "HashedText",
        "enabled": true
      },
      "required": false
    }
  ]
}
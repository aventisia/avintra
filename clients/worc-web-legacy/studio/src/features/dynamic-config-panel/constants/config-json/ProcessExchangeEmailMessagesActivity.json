{
  "name": "ProcessExchangeEmailMessages",
  "label": "Process Exchange Email Messages",
  "description": "Move, delete, or mark as unread an email message (or a list of email messages).",
  "version": "1.0.0",
  "auther": "@aventisia",
  "supportedPlatforms": [
    "desktop"
  ],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "text",
      "name": "ExchangeConnection",
      "label": "Exchange Connection",
      "description": "The Exchange service object representing the connection to the Exchange server.",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "select",
      "name": "Operation",
      "label": "Operation",
      "description": "The action to perform (e.g., Move, Delete, MarkAsUnread).",
      "defaultValue": "",
      "required": true,
      "selectOptions": [
        {
          "label": "Delete",
          "value": "Delete",
          "description": "Deletes email messages from the server."
        },
        {
          "label": "Mark as Unread",
          "value": "MarkAsUnread",
          "description": "Marks email messages as unread."
        },
        {
          "label": "Move to Mail Folder",
          "value": "MoveToFolder",
          "description": "Moves messages to a specified mail folder."
        }
      ]
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "EmailMessageIds",
      "label": "Email Message(s) to Process",
      "description": "The IDs of the email messages to process.",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "select",
      "name": "MailboxType",
      "label": "Mailbox Type",
      "description": "Specifies whether the mailbox is personal or shared.",
      "defaultValue": "",
      "required": false,
      "selectOptions": [
        {
          "label": "Personal",
          "value": "Personal",
          "description": "Processes emails from the current user\u0027s mailbox."
        },
        {
          "label": "Shared",
          "value": "Shared",
          "description": "Processes emails from a shared mailbox."
        }
      ]
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "SharedMailboxAddress",
      "label": "Shared Mailbox Address",
      "description": "The email address of the shared mailbox (required if \u0027Mailbox Type\u0027 is \u0027Shared\u0027).",
      "defaultValue": "",
      "required": false,
      "renderIf": {
        "conditions": [
          {
            "field": "MailboxType",
            "equals": "Shared"
          }
        ]
      }
    },
    {
      "direction": "Input",
      "type": "switch",
      "name": "MoveToCustomFolder",
      "label": "Move to Custom Folder",
      "description": "If true, moves emails to a custom folder instead of predefined folders.",
      "defaultValue": "",
      "required": false
    },
    {
      "direction": "Input",
      "type": "select",
      "name": "ExchangeFolder",
      "label": "Exchange Folder",
      "description": "The folder to move emails to (if not using custom folder).",
      "defaultValue": "",
      "required": false,
      "selectOptions": [
        {
          "label": "Calendar",
          "value": "Calendar",
          "description": ""
        },
        {
          "label": "Contacts",
          "value": "Contacts",
          "description": ""
        },
        {
          "label": "DeletedItems",
          "value": "DeletedItems",
          "description": ""
        },
        {
          "label": "Drafts",
          "value": "Drafts",
          "description": ""
        },
        {
          "label": "Inbox",
          "value": "Inbox",
          "description": ""
        },
        {
          "label": "Journal",
          "value": "Journal",
          "description": ""
        },
        {
          "label": "Notes",
          "value": "Notes",
          "description": ""
        },
        {
          "label": "Outbox",
          "value": "Outbox",
          "description": ""
        },
        {
          "label": "SentItems",
          "value": "SentItems",
          "description": ""
        },
        {
          "label": "Tasks",
          "value": "Tasks",
          "description": ""
        },
        {
          "label": "MsgFolderRoot",
          "value": "MsgFolderRoot",
          "description": ""
        },
        {
          "label": "PublicFoldersRoot",
          "value": "PublicFoldersRoot",
          "description": ""
        },
        {
          "label": "Root",
          "value": "Root",
          "description": ""
        },
        {
          "label": "JunkEmail",
          "value": "JunkEmail",
          "description": ""
        },
        {
          "label": "SearchFolders",
          "value": "SearchFolders",
          "description": ""
        },
        {
          "label": "VoiceMail",
          "value": "VoiceMail",
          "description": ""
        },
        {
          "label": "RecoverableItemsRoot",
          "value": "RecoverableItemsRoot",
          "description": ""
        },
        {
          "label": "RecoverableItemsDeletions",
          "value": "RecoverableItemsDeletions",
          "description": ""
        },
        {
          "label": "RecoverableItemsVersions",
          "value": "RecoverableItemsVersions",
          "description": ""
        },
        {
          "label": "RecoverableItemsPurges",
          "value": "RecoverableItemsPurges",
          "description": ""
        },
        {
          "label": "ArchiveRoot",
          "value": "ArchiveRoot",
          "description": ""
        },
        {
          "label": "ArchiveMsgFolderRoot",
          "value": "ArchiveMsgFolderRoot",
          "description": ""
        },
        {
          "label": "ArchiveDeletedItems",
          "value": "ArchiveDeletedItems",
          "description": ""
        },
        {
          "label": "ArchiveRecoverableItemsRoot",
          "value": "ArchiveRecoverableItemsRoot",
          "description": ""
        },
        {
          "label": "ArchiveRecoverableItemsDeletions",
          "value": "ArchiveRecoverableItemsDeletions",
          "description": ""
        },
        {
          "label": "ArchiveRecoverableItemsVersions",
          "value": "ArchiveRecoverableItemsVersions",
          "description": ""
        },
        {
          "label": "ArchiveRecoverableItemsPurges",

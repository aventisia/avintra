        {
          "label": "RecipientCache",
          "value": "RecipientCache",
          "description": ""
        },
        {
          "label": "QuickContacts",
          "value": "QuickContacts",
          "description": ""
        },
        {
          "label": "ConversationHistory",
          "value": "ConversationHistory",
          "description": ""
        },
        {
          "label": "ToDoSearch",
          "value": "ToDoSearch",
          "description": ""
        }
      ],
      "renderIf": {
        "conditions": [
          {
            "field": "MoveToCustomFolder",
            "equals": false
          }
        ]
      }
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "CustomFolderName",
      "label": "Custom Folder Name",
      "description": "The name of the custom folder to move emails to (if \u0027Move to Custom Folder\u0027 is enabled).",
      "defaultValue": "",
      "required": false,
      "renderIf": {
        "conditions": [
          {
            "field": "MoveToCustomFolder",
            "equals": true
          }
        ]
      }
    }
  ]

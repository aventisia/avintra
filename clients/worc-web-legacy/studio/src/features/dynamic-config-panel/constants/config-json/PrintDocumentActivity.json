{
  "name": "PrintDocument",
  "label": "Print Document",
  "description": "Prints documents with advanced options including printer selection and print settings.",
  "version": "1.0.0",
  "auther": "@aventisia",
  "supportedPlatforms": [
    "desktop"
  ],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "text",
      "name": "DocumentPath",
      "label": "Document Path",
      "description": "Full path to the document to print",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "PrinterName",
      "label": "Printer Name",
      "description": "Name of specific printer to use (blank for default)",
      "defaultValue": "",
      "required": false
    },
    {
      "direction": "Input",
      "type": "select",
      "name": "Method",
      "label": "Print Method",
      "description": "Method to use for printing",
      "defaultValue": "Default",
      "required": false,
      "selectOptions": [
        {
          "label": "Default",
          "value": "Default",
          "description": "Uses default system printing method"
        },
        {
          "label": "Process Start",
          "value": "ProcessStart",
          "description": "Uses external process for printing"
        },
        {
          "label": "Direct",
          "value": "Direct",
          "description": "Uses direct printing when supported"
        }
      ]
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "Copies",
      "label": "Copies",
      "description": "Number of copies to print",
      "defaultValue": 1,
      "required": false
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "Success",
      "label": "Success",
      "description": "Indicates whether printing was successful",
      "defaultValue": {
        "value": "Success",
        "enabled": true
      },
      "required": false
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "JobId",
      "label": "Job ID",
      "description": "Returns the print job ID if available",
      "defaultValue": {
        "value": "JobId",
        "enabled": true
      },
      "required": false
    }
  ]
}
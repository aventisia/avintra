{
  "name": "FormatRange",
  "label": "Format Excel Range (HTTP)",
  "description": "Applies font color, fill color, and bold formatting to an Excel range using Microsoft Graph HTTP PATCH.",
  "version": "1.0.0",
  "auther": "@aventisia",
  "supportedPlatforms": [
    "desktop"
  ],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "text",
      "name": "TenantId",
      "label": "Tenant ID",
      "description": "Azure AD Tenant ID",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "ClientId",
      "label": "Client ID",
      "description": "Azure AD Application Client ID",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "ClientSecret",
      "label": "Client Secret",
      "description": "Azure AD Application Client Secret",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "DriveId",
      "label": "Drive ID",
      "description": "OneDrive or SharePoint Drive ID",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "ItemId",
      "label": "Item ID",
      "description": "Excel file Item ID",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "WorksheetName",
      "label": "Worksheet Name",
      "description": "Worksheet containing the range",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "RangeAddress",
      "label": "Range Address",
      "description": "Range to format, e.g., A1:D10",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "FontColor",
      "label": "Font Color (Hex)",
      "description": "6-digit hex without #, e.g., FF0000",
      "defaultValue": "",
      "required": false
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "FillColor",
      "label": "Fill Color (Hex)",
      "description": "6-digit hex without #, e.g., FFFF00",
      "defaultValue": "",
      "required": false
    },
    {
      "direction": "Input",
      "type": "switch",
      "name": "Bold",
      "label": "Bold",
      "description": "Apply bold formatting",
      "defaultValue": "",
      "required": false
    }
  ]
}
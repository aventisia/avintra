{
  "name": "SendEmail",
  "label": "Send Email",
  "description": "Creates and sends a new email message using MailKit.",
  "version": "1.0.0",
  "auther": "@aventisia",
  "supportedPlatforms": [
    "desktop"
  ],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "text",
      "name": "From",
      "label": "From",
      "description": "The sender\u0027s email address.",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "To",
      "label": "To",
      "description": "The recipient\u0027s email address(es) (comma-separated).",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "Cc",
      "label": "CC",
      "description": "The CC recipients\u0027 email addresses (comma-separated).",
      "defaultValue": "",
      "required": false
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "Bcc",
      "label": "BCC",
      "description": "The BCC recipients\u0027 email addresses (comma-separated).",
      "defaultValue": "",
      "required": false
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "Subject",
      "label": "Subject",
      "description": "The subject of the email.",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "Body",
      "label": "Body",
      "description": "The body of the email.",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "select",
      "name": "BodyFormat",
      "label": "Body Format",
      "description": "The format of the email body (Text or Html).",
      "defaultValue": "Text",
      "required": false,
      "selectOptions": [
        {
          "label": "Plain",
          "value": "Text",
          "description": "Plain text format"
        },
        {
          "label": "Html",
          "value": "Html",
          "description": "HTML format"
        }
      ]
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "Attachments",
      "label": "Attachments",
      "description": "Paths to files to attach to the email (comma-separated).",
      "defaultValue": "",
      "required": false
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "SmtpServer",
      "label": "SMTP Server",
      "description": "The SMTP server URL.",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "ServerPort",
      "label": "Server Port",
      "description": "The port number for the SMTP server (default is 587).",
      "defaultValue": 587,
      "required": false
    },
    {
      "direction": "Input",
      "type": "select",
      "name": "SecurityProtocol",
      "label": "Security Protocol",
      "description": "The security protocol to use for the connection.",
      "defaultValue": "Auto",
      "required": false,
      "selectOptions": [
        {
          "label": "None",
          "value": "None",
          "description": ""
        },
        {
          "label": "Auto",
          "value": "Auto",
          "description": ""
        },
        {
          "label": "SslOnConnect",
          "value": "SslOnConnect",
          "description": ""
        },
        {
          "label": "StartTls",
          "value": "StartTls",
          "description": ""
        },
        {
          "label": "StartTlsWhenAvailable",
          "value": "StartTlsWhenAvailable",
          "description": ""
        }
      ]
    },
    {
      "direction": "Input",
      "type": "switch",
      "name": "SmtpServerNeedsAuthentication",
      "label": "SMTP Server Needs Authentication",
      "description": "If true, authenticates with the SMTP server using credentials.",
      "defaultValue": true,
      "required": false
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "UserName",
      "label": "User Name",
      "description": "The username for authentication.",
      "defaultValue": "",
      "required": false
    },
    {
      "direction": "Input",
      "type": "password",
      "name": "Password",
      "label": "Password",
      "description": "The password for authentication.",
      "defaultValue": "",
      "required": false
    },
    {
      "direction": "Input",
      "type": "switch",
      "name": "EnableSsl",
      "label": "Accept Untrusted Certificates",
      "description": "If true, accepts untrusted SSL certificates.",
      "defaultValue": false,
      "required": false
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "Timeout",
      "label": "Timeout (seconds)",
      "description": "Connection timeout in seconds (default is 30).",
      "defaultValue": 30,
      "required": false
    }
  ]
}
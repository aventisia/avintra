{
  "name": "SAPLogin",
  "label": "SAP Login",
  "description": "Logs into SAP GUI using provided credentials.",
  "version": "1.0.0",
  "auther": "@aventisia",
  "supportedPlatforms": [
    "desktop"
  ],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "text",
      "name": "Client",
      "label": "Client",
      "description": "SAP Client number (e.g., 800)",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "Username",
      "label": "Username",
      "description": "SAP Username",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "password",
      "name": "Password",
      "label": "Secure Password",
      "description": "SAP Secure Password",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "Language",
      "label": "Language",
      "description": "Language code (e.g., EN, DE, FR)",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "MultipleLogonOption",
      "label": "Multiple Logon Option",
      "description": "Multiple Logon Option: Continue with this logon and end any other logons",
      "defaultValue": "Continue with this logon and end any other logons",
      "required": false
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "DelayBefore",
      "label": "Delay before",
      "description": "Delay before execution (in seconds)",
      "defaultValue": 0.20000000000000001,
      "required": false
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "DelayAfter",
      "label": "Delay after",
      "description": "Delay after execution (in seconds)",
      "defaultValue": 0.29999999999999999,
      "required": false
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "Timeout",
      "label": "Timeout",
      "description": "Timeout for login operation (in seconds)",
      "defaultValue": 30,
      "required": false
    },
    {
      "direction": "Input",
      "type": "switch",
      "name": "ContinueOnError",
      "label": "Continue on error",
      "description": "Whether to continue on error",
      "defaultValue": false,
      "required": false
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "Result",
      "label": "Result",
      "description": "Result of the operation",
      "defaultValue": {
        "value": "Result",
        "enabled": true
      },
      "required": false
    }
  ]
}
{
  "name": "RunVbScript",
  "label": "Run VBScript",
  "description": "Executes custom VBScript code and retrieves its output.",
  "version": "1.0.0",
  "auther": "@aventisia",
  "supportedPlatforms": ["windows"],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "text",
      "name": "ScriptCode",
      "label": "VBScript Code",
      "description": "The VBScript code to execute.",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "ScriptOutput",
      "label": "Script Output",
      "description": "Returns the output of the script.",
      "defaultValue": {
        "value": "ScriptOutput",
        "enabled": true
      },
      "required": false
    }
  ]
}

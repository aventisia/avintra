{
  "name": "CreateServiceNowCredential",
  "label": "Create ServiceNow Credential",
  "description": "Creates a new ServiceNow credential using either Basic Auth or OAuth2.",
  "version": "1.0.0",
  "auther": "@aventisia",
  "supportedPlatforms": ["cloud", "windows"],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "select",
      "name": "ConnectUsing",
      "label": "Connect Using",
      "description": "Authentication method to use for connecting to ServiceNow",
      "defaultValue": "",
      "required": true,
      "selectOptions": [
        {
          "label": "Basic Auth",
          "value": "BasicAuth",
          "description": "Authenticate using Basic Authentication."
        },
        {
          "label": "OAuth2",
          "value": "OAuth2",
          "description": "Authenticate using OAuth 2.0."
        }
      ]
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "User",
      "label": "User",
      "description": "Username for Basic Auth",
      "defaultValue": "",
      "required": true,
      "renderIf": {
        "conditions": [
          {
            "field": "ConnectUsing",
            "equals": "BasicAuth"
          }
        ]
      }
    },
    {
      "direction": "Input",
      "type": "password",
      "name": "Password",
      "label": "Password",
      "description": "Password for Basic Auth",
      "defaultValue": "",
      "required": true,
      "renderIf": {
        "conditions": [
          {
            "field": "ConnectUsing",
            "equals": "BasicAuth"
          }
        ]
      }
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "OAuthRedirectUrl",
      "label": "OAuth Redirect URL",
      "description": "Redirect URL for OAuth2 flow (usually provided by the platform)",
      "defaultValue": "",
      "required": true,
      "renderIf": {
        "conditions": [
          {
            "field": "ConnectUsing",
            "equals": "OAuth2"
          }
        ]
      }
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "ClientId",
      "label": "Client ID",
      "description": "Client ID from ServiceNow OAuth2 application",
      "defaultValue": "",
      "required": true,
      "renderIf": {
        "conditions": [
          {
            "field": "ConnectUsing",
            "equals": "OAuth2"
          }
        ]
      }
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "ClientSecret",
      "label": "Client Secret",
      "description": "Client Secret from ServiceNow OAuth2 application",
      "defaultValue": "",
      "required": true,
      "renderIf": {
        "conditions": [
          {
            "field": "ConnectUsing",
            "equals": "OAuth2"
          }
        ]
      }
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "Subdomain",
      "label": "Subdomain",
      "description": "Subdomain of your ServiceNow instance (e.g., dev99890 from https://dev99890.service-now.com)",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "CredentialId",
      "label": "Credential ID",
      "description": "Unique identifier for the created credential",
      "defaultValue": {
        "value": "CredentialId",
        "enabled": true
      },
      "required": false
    }
  ]
}

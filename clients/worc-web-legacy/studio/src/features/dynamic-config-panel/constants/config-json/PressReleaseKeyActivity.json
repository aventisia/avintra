{
  "name": "PressReleaseKey",
  "label": "Press or Release Key",
  "description": "Presses (and holds) or releases one or more modifier keys (Alt, Control, Shift, Win). Supports combinations like Ctrl\u002BAlt.",
  "version": "1.0.0",
  "auther": "@aventisia",
  "supportedPlatforms": [
    "desktop"
  ],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "select",
      "name": "ActionToPerform",
      "label": "Action To Perform",
      "description": "Select whether to press or release the keys.",
      "defaultValue": "",
      "required": true,
      "selectOptions": [
        {
          "label": "Press",
          "value": "Press",
          "description": "Presses and holds the selected key(s)."
        },
        {
          "label": "Release",
          "value": "Release",
          "description": "Releases the selected key(s)."
        }
      ]
    },
    {
      "direction": "Input",
      "type": "switch",
      "name": "UseControl",
      "label": "Control",
      "description": "Toggle to include the Control key in the action.",
      "defaultValue": "",
      "required": false
    },
    {

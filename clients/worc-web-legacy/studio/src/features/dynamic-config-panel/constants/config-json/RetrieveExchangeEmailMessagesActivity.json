{
  "name": "RetrieveExchangeEmailMessages",
  "label": "Retrieve Exchange Email Messages",
  "description": "Retrieves email messages from the specified Exchange server.",
  "version": "1.0.0",
  "auther": "@aventisia",
  "supportedPlatforms": [
    "desktop"
  ],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "text",
      "name": "ExchangeConnection",
      "label": "Exchange Connection",
      "description": "The Exchange service object representing the connection to the Exchange server.",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "select",
      "name": "MailboxType",
      "label": "Mailbox Type",
      "description": "Specifies whether the mailbox is personal or shared.",
      "defaultValue": "",
      "required": true,
      "selectOptions": [
        {
          "label": "Personal",
          "value": "Personal",
          "description": "Processes emails from the current user\u0027s mailbox."
        },
        {
          "label": "Shared",
          "value": "Shared",
          "description": "Processes emails from a shared mailbox."
        }
      ]
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "SharedMailboxAddress",
      "label": "Shared Mailbox Address",
      "description": "The email address of the shared mailbox (required if \u0027Mailbox Type\u0027 is \u0027Shared\u0027).",
      "defaultValue": "",
      "required": false,
      "renderIf": {
        "conditions": [
          {
            "field": "MailboxType",
            "equals": "Shared"
          }
        ]
      }
    },
    {
      "direction": "Input",
      "type": "switch",
      "name": "RetrieveFromCustomFolder",
      "label": "Retrieve Email Messages from Custom Folder",
      "description": "If true, retrieves emails from a custom folder instead of predefined folders.",
      "defaultValue": "",
      "required": false
    },
    {
      "direction": "Input",
      "type": "select",
      "name": "ExchangeFolder",
      "label": "Exchange Folder",
      "description": "The folder to retrieve emails from (e.g., Inbox, Sent Items).",
      "defaultValue": "",
      "required": false,
      "selectOptions": [
        {
          "label": "Calendar",
          "value": "Calendar",
          "description": ""
        },
        {
          "label": "Contacts",
          "value": "Contacts",
          "description": ""
        },
        {
          "label": "DeletedItems",
          "value": "DeletedItems",
          "description": ""
        },
        {
          "label": "Drafts",
          "value": "Drafts",
          "description": ""
        },
        {
          "label": "Inbox",
          "value": "Inbox",
          "description": ""
        },
        {
          "label": "Journal",
          "value": "Journal",
          "description": ""
        },
        {
          "label": "Notes",
          "value": "Notes",
          "description": ""
        },
        {
          "label": "Outbox",
          "value": "Outbox",
          "description": ""
        },
        {
          "label": "SentItems",
          "value": "SentItems",
          "description": ""
        },
        {
          "label": "Tasks",
          "value": "Tasks",
          "description": ""
        },
        {
          "label": "MsgFolderRoot",
          "value": "MsgFolderRoot",
          "description": ""
        },
        {
          "label": "PublicFoldersRoot",
          "value": "PublicFoldersRoot",
          "description": ""
        },
        {
          "label": "Root",
          "value": "Root",
          "description": ""
        },
        {
          "label": "JunkEmail",
          "value": "JunkEmail",
          "description": ""
        },
        {
          "label": "SearchFolders",
          "value": "SearchFolders",
          "description": ""
        },
        {
          "label": "VoiceMail",
          "value": "VoiceMail",
          "description": ""
        },
        {
          "label": "RecoverableItemsRoot",
          "value": "RecoverableItemsRoot",
          "description": ""
        },
        {
          "label": "RecoverableItemsDeletions",
          "value": "RecoverableItemsDeletions",
          "description": ""
        },
        {
          "label": "RecoverableItemsVersions",
          "value": "RecoverableItemsVersions",
          "description": ""
        },
        {
          "label": "RecoverableItemsPurges",
          "value": "RecoverableItemsPurges",
          "description": ""
        },
        {
          "label": "ArchiveRoot",
          "value": "ArchiveRoot",
          "description": ""
        },
        {
          "label": "ArchiveMsgFolderRoot",
          "value": "ArchiveMsgFolderRoot",
          "description": ""
        },
        {
          "label": "ArchiveDeletedItems",
          "value": "ArchiveDeletedItems",
          "description": ""
        },
        {
          "label": "ArchiveRecoverableItemsRoot",
          "value": "ArchiveRecoverableItemsRoot",
          "description": ""
        },
        {
          "label": "ArchiveRecoverableItemsDeletions",
          "value": "ArchiveRecoverableItemsDeletions",
          "description": ""
        },
        {
          "label": "ArchiveRecoverableItemsVersions",
          "value": "ArchiveRecoverableItemsVersions",
          "description": ""
        },
        {
          "label": "ArchiveRecoverableItemsPurges",
          "value": "ArchiveRecoverableItemsPurges",
          "description": ""
        },
        {
          "label": "SyncIssues",
          "value": "SyncIssues",
          "description": ""
        },
        {
          "label": "Conflicts",
          "value": "Conflicts",
          "description": ""
        },
        {
          "label": "LocalFailures",
          "value": "LocalFailures",
          "description": ""
        },
        {
          "label": "ServerFailures",
          "value": "ServerFailures",
          "description": ""
        },
        {
          "label": "RecipientCache",
          "value": "RecipientCache",
          "description": ""
        },
        {
          "label": "QuickContacts",
          "value": "QuickContacts",
          "description": ""
        },
        {
          "label": "ConversationHistory",
          "value": "ConversationHistory",
          "description": ""
        },
        {
          "label": "ToDoSearch",
          "value": "ToDoSearch",
          "description": ""
        }
      ],
      "renderIf": {
        "conditions": [
          {
            "field": "RetrieveFromCustomFolder",
            "equals": false
          }
        ]
      }
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "CustomFolderName",
      "label": "Mail Folder",
      "description": "The name of the custom folder to retrieve emails from (if \u0027Retrieve Email Messages from Custom Folder\u0027 is enabled).",
      "defaultValue": "",
      "required": false,
      "renderIf": {
        "conditions": [
          {
            "field": "RetrieveFromCustomFolder",
            "equals": true
          }
        ]
      }
    },
    {
      "direction": "Input",
      "type": "select",
      "name": "RetrieveMode",
      "label": "Retrieve",
      "description": "Specifies which emails to retrieve (e.g., All email messages, Unread email messages only).",
      "defaultValue": "",
      "required": false,
      "selectOptions": [
        {
          "label": "All email messages",
          "value": "AllEmails",
          "description": "Retrieves all email messages."
        },
        {
          "label": "Unread email messages only",
          "value": "UnreadEmailsOnly",
          "description": "Retrieves only unread email messages."
        },
        {
          "label": "Read email messages only",
          "value": "ReadEmailsOnly",
          "description": "Retrieves only read email messages."
        }
      ]
    },
    {
      "direction": "Input",
      "type": "switch",
      "name": "MarkAsRead",
      "label": "Mark as Read",
      "description": "If true, marks retrieved emails as read.",
      "defaultValue": "",
      "required": false
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "FromContains",
      "label": "From Contains",
      "description": "Filters emails where the sender\u0027s address contains this text.",
      "defaultValue": "",
      "required": false
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "ToContains",
      "label": "To Contains",
      "description": "Filters emails where the recipient\u0027s address contains this text.",
      "defaultValue": "",
      "required": false
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "SubjectContains",
      "label": "Subject Contains",
      "description": "Filters emails where the subject contains this text.",
      "defaultValue": "",
      "required": false
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "BodyContains",
      "label": "Body Contains",
      "description": "Filters emails where the body contains this text.",
      "defaultValue": "",
      "required": false
    },
    {
      "direction": "Input",
      "type": "select",
      "name": "AttachmentHandling",
      "label": "Attachments",
      "description": "Specifies how to handle attachments.",
      "defaultValue": "",
      "required": false,
      "selectOptions": [
        {
          "label": "Do not save attachments",
          "value": "DoNotSaveAttachments",
          "description": "Does not save any attachments."
        },
        {
          "label": "Save attachments",
          "value": "SaveAttachments",
          "description": "Saves attachments to the specified directory."
        }
      ]
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "SaveAttachmentsDirectory",
      "label": "Save Attachments Into",
      "description": "The directory to save attachments (required if \u0027Attachments\u0027 is \u0027Save Attachments\u0027).",
      "defaultValue": "",
      "required": false,
      "renderIf": {
        "conditions": [
          {
            "field": "AttachmentHandling",
            "equals": "SaveAttachments"
          }
        ]
      }
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "RetrievedEmails",
      "label": "Retrieved Emails",
      "description": "The list of retrieved email messages.",
      "defaultValue": {
        "value": "RetrievedEmails",
        "enabled": true
      },
      "required": false
    }
  ]
}
{
  "name": "RunJavaScript",
  "label": "Run JavaScript",
  "description": "Executes some custom JavaScript code and retrieves its output into a variable.",
  "version": "1.0.0",
  "auther": "@aventisia",
  "supportedPlatforms": ["cloud", "windows"],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "text",
      "name": "ScriptCode",
      "label": "JavaScript Code",
      "description": "The JavaScript code to execute.",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "ScriptOutput",
      "label": "Script Output",
      "description": "Returns the output of the script.",
      "defaultValue": {
        "value": "ScriptOutput",
        "enabled": true
      },
      "required": false
    }
  ]
}

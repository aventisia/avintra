{
  "name": "CreateDraftEmail",
  "label": "Create Draft Email",
  "description": "Creates a draft email message in the user\u0027s mailbox using Microsoft Graph API.",
  "version": "1.0.0",
  "auther": "@aventisia",
  "supportedPlatforms": [
    "desktop"
  ],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "text",
      "name": "UserEmail",
      "label": "User Email",
      "description": "The email address of the mailbox owner.",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "TenantId",
      "label": "Tenant ID",
      "description": "Azure Active Directory tenant (directory) ID.",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "ClientId",
      "label": "Client ID",
      "description": "Azure AD application (client) ID.",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "ClientSecret",
      "label": "Client Secret",
      "description": "Azure AD application client secret.",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "EmailJson",
      "label": "Email Message JSON",
      "description": "JSON string representing the draft email content (subject, body, recipients, etc.).",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "DraftId",
      "label": "Draft ID",
      "description": "The ID of the created draft email.",
      "defaultValue": {
        "value": "DraftId",
        "enabled": true
      },
      "required": false
    }
  ]
}
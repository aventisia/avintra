{
  "name": "CreateVisionAIAgent",
  "label": "Vision Model",
  "description": "Vision Model.",
  "version": "1.0.0",
  "auther": "@aventisia",
  "supportedPlatforms": ["cloud", "desktop"],
  "errorHandling": "standard",
  "testScreenType": "llmGenerateRequest",
  "fields": [
    {
      "direction": "Input",
      "type": "model-config-select",
      "name": "__ModelConfig__Vision",
      "defaultValue": {
        "is_byok_enabled": false,
        "provider": "openai",
        "credential_id": "00000000-0000-0000-0000-000000000000",
        "model": "gpt-4o-mini",
        "temperature": 1,
        "top_p": 1,
        "is_json_output": true,
        "max_output_tokens": null
      },
      "required": false,
      "category": "Models"
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "files",
      "label": "Files",
      "defaultValue": "",
      "required": false,
      "category": "Models"
    },
    {
      "direction": "Input",
      "type": "prompt-input",
      "name": "__Prompt__Vision",
      "required": false,
      "min": 22,
      "defaultValue": "",
      "category": "Prompt"
    },

    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "Result",
      "label": "Result",
      "description": "Result",
      "defaultValue": {
        "value": "Result",
        "enabled": true
      },
      "required": false,
      "category": "Models"
    }
  ]
}

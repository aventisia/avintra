{
  "name": "CreateConversationAIAgent",
  "label": "Chat AI",
  "description": "Chat AI.",
  "version": "1.0.0",
  "auther": "@aventisia",
  "supportedPlatforms": ["cloud", "desktop"],
  "errorHandling": "standard",
  "testScreenType": "llmGenerateRequest",
  "fields": [
    {
      "direction": "Input",
      "type": "prompt-input",
      "name": "__Prompt__Conversation",
      "required": false,
      "min": 16,
      "defaultValue": "",
      "category": "Prompt"
    },
    {
      "direction": "Input",
      "type": "model-config-select",
      "name": "__ModelConfig__Conversation",
      "defaultValue": {
        "is_byok_enabled": false,
        "provider": "openai",
        "credential_id": "00000000-0000-0000-0000-000000000000",
        "model": "gpt-4o-mini",
        "temperature": 1,
        "top_p": 1,
        "is_json_output": false,
        "max_output_tokens": null
      },
      "required": false,
      "category": "Models"
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "Files",
      "label": "Files",
      "defaultValue": "",
      "required": false,
      "category": "Models"
    },
    {
      "direction": "Input",
      "type": "knowledge-base-config",
      "name": "__KbConfig__Conversation",
      "label": "Knowledge Base(s)",
      "defaultValue": {
        "knowledgeBase": [],
        "retrievalType": "Basic",
        "sourceThreshold": 0.1,
        "numberOfChunks": 5
      },
      "required": false,
      "category": "Context"
    },
    {
      "direction": "Input",
      "type": "memory-config",
      "name": "__MemoryConfig__Conversation",
      "defaultValue": {
        "memoryProvider": "Memory Provider 1",
        "maxDataStored": 4
      },
      "required": false,
      "category": "Context"
    },
    {
      "direction": "Input",
      "type": "tools-config-select",
      "name": "__ToolsConfig__Conversation",
      "defaultValue": [],
      "category": "Tools"
    },
    {
      "direction": "Input",
      "type": "suggestions",
      "name": "__RecommendedActionsConfig__Conversation",
      "description": "Add suggestions for the initial chat start",
      "defaultValue": { "defaultActions": [], "enableDynamicActions": false },
      "required": false,
      "category": "Other"
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "Result",
      "label": "Result",
      "description": "Result",
      "defaultValue": {
        "value": "Result",
        "enabled": true
      },
      "required": false,
      "category": "Prompt"
    }
  ]
}

{
  "name": "CreateSTTAIAgent",
  "label": "Speech To Text",
  "description": "Convert spoken language into written text using AI.",
  "version": "1.0.0",
  "auther": "@aventisia",
  "supportedPlatforms": ["cloud", "desktop"],
  "errorHandling": "standard",
  "testScreenType": "llmGenerateRequest",
  "fields": [
    {
      "direction": "Input",
      "type": "model-config-select",
      "name": "__ModelConfig__SpeechToText",
      "defaultValue": {
        "is_byok_enabled": true,
        "provider": "elevenlabs",
        "credential_id": "",
        "model": "scribe_v2"
      },
      "required": false,
      "category": "Models"
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "files",
      "label": "File Path/Url",
      "required": false,
      "category": "Inputs"
    },

    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "STTResponse",
      "label": "Button Clicked Successfully",
      "description": "STT Response.",
      "defaultValue": {
        "value": "STTResponse",
        "enabled": true
      },
      "required": false,
      "category": "Models"
    }
  ]
}

{
  "name": "CreateInferencingAIAgent",
  "label": "Inferencing Model",
  "description": "Inferencing Model.",
  "version": "1.0.0",
  "auther": "@aventisia",
  "supportedPlatforms": ["cloud", "desktop"],
  "errorHandling": "standard",
  "testScreenType": "llmGenerateRequest",
  "fields": [
    {
      "direction": "Input",
      "type": "prompt-input",
      "name": "__Prompt__Inferencing",
      "required": false,
      "min": 16,
      "defaultValue": "",
      "category": "Prompt"
    },
    {
      "direction": "Input",
      "type": "model-config-select",
      "name": "__ModelConfig__Inferencing",
      "defaultValue": {
        "is_byok_enabled": false,
        "provider": "openai",
        "credential_id": "00000000-0000-0000-0000-000000000000",
        "model": "gpt-4o-mini",
        "temperature": 1,
        "top_p": 1,
        "is_json_output": true,
        "max_output_tokens": null
      },
      "required": false,
      "category": "Models"
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "Files",
      "label": "Files",
      "defaultValue": "",
      "required": false,
      "category": "Models"
    },
    {
      "direction": "Input",
      "type": "knowledge-base-config",
      "name": "__KbConfig__Inferencing",
      "label": "Knowledge Base",
      "defaultValue": {
        "knowledgeBase": "",
        "retrievalType": "Basic",
        "sourceThreshold": 1,
        "numberOfChunks": 10
      },
      "required": false,
      "category": "Memory"
    },
    {
      "direction": "Input",
      "type": "memory-config",
      "name": "__MemoryConfig__Inferencing",
      "defaultValue": {
        "memoryProvider": "Memory Provider 1",
        "maxDataStored": 4
      },
      "required": false,
      "category": "Memory"
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "__ToolsConfig__Inferencing",
      "label": "Tools",
      "defaultValue": "",
      "required": false,
      "category": "Tools"
    },
    {
      "direction": "Input",
      "type": "switch",
      "name": "useJSONSchema",
      "label": "Use JSON Schema",
      "description": "",
      "defaultValue": false,
      "required": false,
      "category": "StructuredOutput"
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "SchemaName",
      "label": "Schema Name",
      "defaultValue": "",
      "required": false,
      "category": "StructuredOutput",
      "renderIf": {
        "conditions": [
          {
            "field": "useJSONSchema",
            "equals": true
          }
        ]
      }
    },
    {
      "direction": "Input",
      "type": "json-editor",
      "name": "JSONSchema",
      "label": "JSON Schema",
      "defaultValue": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"steps\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"explanation\": {\n            \"type\": \"string\"\n          },\n          \"output\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"explanation\",\n          \"output\"\n        ],\n        \"additionalProperties\": false\n      }\n    },\n    \"final_answer\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"steps\",\n    \"final_answer\"\n  ],\n  \"additionalProperties\": false\n}",
      "required": false,
      "category": "StructuredOutput",
      "renderIf": {
        "conditions": [
          {
            "field": "useJSONSchema",
            "equals": true
          }
        ]
      }
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "Result",
      "label": "Result",
      "description": "AI Model Result.",
      "defaultValue": {
        "value": "Result",
        "enabled": true
      },
      "required": false,
      "category": "Prompt"
    }
  ]
}

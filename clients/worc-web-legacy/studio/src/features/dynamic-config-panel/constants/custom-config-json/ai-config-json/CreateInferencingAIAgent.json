{
  "name": "CreateInferencingAIAgent",
  "label": "Text AI",
  "description": "Text AI.",
  "version": "1.0.0",
  "auther": "@aventisia",
  "supportedPlatforms": ["cloud", "desktop"],
  "errorHandling": "standard",
  "testScreenType": "llmGenerateRequest",
  "fields": [
    {
      "direction": "Input",
      "type": "prompt-input",
      "name": "__Prompt__Inferencing",
      "required": false,
      "min": 16,
      "defaultValue": "",
      "category": "Prompt"
    },
    {
      "direction": "Input",
      "type": "model-config-select",
      "name": "__ModelConfig__Inferencing",
      "defaultValue": {
        "is_byok_enabled": false,
        "provider": "openai",
        "credential_id": "00000000-0000-0000-0000-000000000000",
        "model": "gpt-4o-mini",
        "temperature": 1,
        "top_p": 1,
        "is_json_output": true,
        "max_output_tokens": null
      },
      "required": false,
      "category": "Models"
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "Files",
      "label": "Files",
      "defaultValue": "",
      "required": false,
      "category": "Models"
    },
    {
      "direction": "Input",
      "type": "knowledge-base-config",
      "name": "__KbConfig__Inferencing",
      "label": "Knowledge Base(s)",
      "defaultValue": {
        "knowledgeBase": [],
        "retrievalType": "Basic",
        "sourceThreshold": 0.1,
        "numberOfChunks": 5
      },
      "required": false,
      "category": "Memory"
    },
    {
      "direction": "Input",
      "type": "memory-config",
      "name": "__MemoryConfig__Inferencing",
      "defaultValue": {
        "memoryProvider": "Memory Provider 1",
        "maxDataStored": 4
      },
      "required": false,
      "category": "Memory"
    },
    {
      "direction": "Input",
      "type": "tools-config-select",
      "name": "__ToolsConfig__Inferencing",
      "defaultValue": [],
      "category": "Tools"
    },
    {
      "direction": "Input",
      "type": "switch",
      "name": "useJSONSchema",
      "label": "Enable Structured Output",
      "description": "Turn this on to force the model to return responses in a predefined JSON structure. This is useful when you need predictable, machine-readable output.",
      "defaultValue": false,
      "category": "Schema"
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "SchemaName",
      "label": "Schema Name",
      "defaultValue": "",
      "renderIf": {
        "conditions": [{ "field": "useJSONSchema", "equals": true }]
      },
      "category": "Schema"
    },

    {
      "direction": "Input",
      "type": "json-editor",
      "name": "json_schema",
      "label": "Output Schema (JSON)",
      "description": "Define the expected response structure using valid JSON Schema. The model will strictly follow this format when generating output. Make sure the schema is valid to avoid request failures.",
      "defaultValue": "",
      "required": false,
      "renderIf": {
        "conditions": [{ "field": "useJSONSchema", "equals": true }]
      },
      "category": "Schema"
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "Result",
      "label": "Result",
      "description": "Result",
      "defaultValue": {
        "value": "Result",
        "enabled": true
      },
      "required": false,
      "category": "Prompt"
    }
  ]
}

// Define a function to get the build mode based on the branch name
def getBuildMode(branchName) {
    switch(branchName) {
        case 'dev':
            return 'testing'
        case 'uat':
            return 'staging'
        case 'main':
            return 'production'
        default:
            error "Unsupported branch: ${branchName}"
    }
}

// Define a function to get the target servers based on the branch name
def getTargetServers(branchName) {
    switch(branchName) {
        case 'dev':
            return ['avdev.aventisia.com']
        case 'uat':
            return ['avuat.aventisia.com']
        case 'main':
            return ['avweb1.aventisia.com', 'avweb2.aventisia.com']
        default:
            error "Unsupported branch: ${branchName}"
    }
}

pipeline {
    agent any
    tools {
        nodejs 'NodeJS 20.18.1'
    }
    stages {
        stage('Update Gitea npm registry') {
            steps {
                echo 'Updating Gitea npm registry...'

                // Note: if we wrap below sh lines in double quotes, it will throw an error
                sh 'npm config set @aventisia:registry=https://gitea.aventisia.com/api/packages/aventisia-public/npm/'
            }
        }
        stage('Install Dependencies') {
            steps {
                echo 'Installing dependencies...'
                sh 'rm -rf node_modules'
                sh 'npm ci --force'
            }
        }
        stage('Build') {
            steps {
                echo 'Building...'
                script {
                    sh "npm run build -- --mode=${getBuildMode(env.BRANCH_NAME)}"
                }
            }
        }
        stage('Deploy') {
            steps {
                script {
                    sshagent(credentials: ['aventisia_vps_ssh']) {
                        // Get target servers based on branch
                        def targetServers = getTargetServers(env.BRANCH_NAME)

                        echo "Deploying to ${targetServers.size()} server(s): ${targetServers.join(', ')}..."
                        
                        // Deploy to each target server
                        targetServers.each { server ->
                            echo "Deploying to ${server}..."
                            sh "rsync -avz --delete ${WORKSPACE}/dist/* admin@${server}:/var/www/aventisia.com/clients/studio/"
                            echo "Successfully deployed to ${server}"
                        }
                    }
                }
            }
        }
    }
    post {
        always {
            echo 'Cleaning up...'
            deleteDir()
        }
        success {
            echo 'Build succeeded!'
        }
        failure {
            echo 'Build failed!'
        }
    }
}
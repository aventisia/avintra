<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>RunnerApp</AssemblyName>
        <RootNamespace>RunnerApp</RootNamespace>
        <Version>0.2.37</Version>
        <InformationalVersion>0.2.37</InformationalVersion>

        <!--
      Linux shell: portable framework-dependent executable for now.
      Self-contained publish can be enabled once a Linux-specific runtime
      identifier and trimming settings have been validated.
    -->
        <SelfContained>false</SelfContained>
        <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
        <PublishSingleFile>true</PublishSingleFile>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\RunnerApp.Core\RunnerApp.Core.csproj" />
        <ProjectReference Include="..\..\..\shared\NodeLibrary\NodeLibrary.Core\NodeLibrary.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\RunnerApp.Windows\Program.cs" />
    </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>RunnerApp</AssemblyName>
    <RootNamespace>RunnerApp</RootNamespace>
    <Version>0.2.20</Version>
    <InformationalVersion>0.2.20</InformationalVersion>

    <!--
      Self-contained publish.
      The .NET 8 runtime and dependencies are bundled into the publish directory,
      so the target machine does not need .NET 8 installed.

      Single-file publish remains disabled to keep deployment consistent with
      prior releases and to simplify COM/Office late-binding diagnostics.
    -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.0" />
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />

    <!--
      Force-download the Windows Desktop runtime pack so that the win-x64 publish
      can include its UIAutomation/Accessibility/PresentationCore assemblies even
      when the build runs on a Linux/macOS CI agent. The generic net8.0 TFM keeps
      the project buildable cross-platform; this runtime-only package provides the
      Windows-specific reference assemblies at publish time.

      The condition avoids a duplicate PackageDownload warning on Windows, where
      the SDK already downloads the runtime pack for a win-x64 self-contained app.
    -->
    <PackageDownload Include="Microsoft.WindowsDesktop.App.Runtime.win-x64" Version="[8.0.30]" Condition="!$([MSBuild]::IsOSPlatform('Windows'))" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RunnerApp.Core\RunnerApp.Core.csproj" />
    <ProjectReference Include="..\..\..\shared\NodeLibrary\NodeLibrary.Windows\NodeLibrary.Windows.csproj" />
  </ItemGroup>

  <!--
    Self-contained win-x64 publish needs several Windows Desktop runtime assemblies
    (Accessibility, UIAutomationClient, UIAutomationTypes, etc.) for UI Automation
    nodes via FlaUI. These are part of the Windows Desktop runtime pack rather than
    the base .NET 8 runtime, so they are not copied by default when the project
    targets the generic net8.0 TFM. Keeping the generic TFM allows the project to
    build on Linux/macOS CI agents; this target runs during any win-x64 publish once
    the runtime pack above has been restored.
  -->
  <Target Name="CopyWindowsDesktopAssembliesForWinX64Publish" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <PropertyGroup>
      <_WindowsDesktopRuntimeVersion>8.0.30</_WindowsDesktopRuntimeVersion>
      <_NuGetGlobalPackagesDir>$(NuGetPackageRoot)</_NuGetGlobalPackagesDir>
      <_WindowsDesktopRuntimeDir Condition="'$(_NuGetGlobalPackagesDir)' != ''">$(_NuGetGlobalPackagesDir)microsoft.windowsdesktop.app.runtime.win-x64\$(_WindowsDesktopRuntimeVersion)\runtimes\win-x64\lib\net8.0</_WindowsDesktopRuntimeDir>
    </PropertyGroup>

    <Error Text="Could not locate the Microsoft.WindowsDesktop.App.Runtime.win-x64 $(_WindowsDesktopRuntimeVersion) package. Ensure it is restored before publishing." Condition="!Exists('$(_WindowsDesktopRuntimeDir)')" />

    <ItemGroup>
      <_WindowsDesktopAssembly Include="$(_WindowsDesktopRuntimeDir)\Accessibility.dll" />
      <_WindowsDesktopAssembly Include="$(_WindowsDesktopRuntimeDir)\UIAutomationClient.dll" />
      <_WindowsDesktopAssembly Include="$(_WindowsDesktopRuntimeDir)\UIAutomationClientSideProviders.dll" />
      <_WindowsDesktopAssembly Include="$(_WindowsDesktopRuntimeDir)\UIAutomationProvider.dll" />
      <_WindowsDesktopAssembly Include="$(_WindowsDesktopRuntimeDir)\UIAutomationTypes.dll" />
      <_WindowsDesktopAssembly Include="$(_WindowsDesktopRuntimeDir)\PresentationCore.dll" />
    </ItemGroup>

    <Copy SourceFiles="@(_WindowsDesktopAssembly)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>

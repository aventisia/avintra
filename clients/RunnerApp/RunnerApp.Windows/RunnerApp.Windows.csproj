<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>RunnerApp</AssemblyName>
    <RootNamespace>RunnerApp</RootNamespace>
    <Version>0.2.34</Version>
    <InformationalVersion>0.2.34</InformationalVersion>

    <!--
      Self-contained publish.
      The .NET 8 runtime and dependencies are bundled into the publish directory,
      so the target machine does not need .NET 8 installed.

      Single-file publish remains disabled to keep deployment consistent with
      prior releases and to simplify COM/Office late-binding diagnostics.
    -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.0" />
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RunnerApp.Core\RunnerApp.Core.csproj" />
    <ProjectReference Include="..\..\..\shared\NodeLibrary\NodeLibrary.Windows\NodeLibrary.Windows.csproj" />
  </ItemGroup>
</Project>

<Window x:Class="NodeExecutor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NodeExecutor"
        mc:Ignorable="d"
        d:DesignHeight="110" d:DesignWidth="410"
        Height="100" Width="400"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Title="Node Executor - Aventisia"
        ShowInTaskbar="False"
        Topmost="true">

    <Border MouseLeftButtonDown="Border_MouseLeftButtonDown" Style="{StaticResource WindowBorderStyle}">
        <Grid Margin="15">
            <!-- Rows -->
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Columns -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Agent Icon and Timer -->
            <Grid Grid.Column="0">
                <!--Agent Icon-->
                <Border Height="60" Width="60" CornerRadius="8" Background="{StaticResource AccentBrush}">
                    <Image Width="36" Height="36" Source="{StaticResource AgentIcon}"/>
                </Border>
                
                <!--Timer-->
                <Border Margin="0 0 0 -5" Style="{StaticResource TimerBorderStyle}">
                    <TextBlock x:Name="lbl_Timer" Text="00:00" Style="{StaticResource TimerTextBlockStyle}" />    
                </Border>
            </Grid>

            <!-- Agent and Current Node Name -->
            <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center" Margin="20 0">
                <TextBlock x:Name="lbl_AgentName" Text="Agent Name" ToolTip="Agent name" FontWeight="Medium" Margin="0 0 0 2" Style="{StaticResource TextBlockStyle}" />
                <TextBlock x:Name="lbl_NodeName" Text="Node Name" ToolTip="Node name" Style="{StaticResource TextBlockStyle}" />
            </StackPanel>

            <!-- Pause and Abort Buttons -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="btn_Pause" Click="btn_Pause_ClickAsync" ToolTip="Pause" Style="{StaticResource PauseButtonStyle}" />
                <Button x:Name="btn_Resume" Click="btn_Resume_ClickAsync" ToolTip="Resume" Style="{StaticResource ResumeButtonStyle}" />
                <Button x:Name="btn_Abort" Click="btn_Abort_ClickAsync" ToolTip="Abort" Style="{StaticResource AbortButtonStyle}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>

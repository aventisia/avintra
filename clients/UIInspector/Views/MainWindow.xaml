<Window x:Class="UIInspector.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        xmlns:models="clr-namespace:UIInspector.Models"
        xmlns:flauidef="clr-namespace:FlaUI.Core.Definitions;assembly=FlaUI.Core"
        xmlns:viewModels="clr-namespace:UIInspector.ViewModels"
        xmlns:converters="clr-namespace:UIInspector.Converters"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        d:DesignHeight="350"
        d:DesignWidth="900"
        Width="1000"
        d:LayoutOverrides="Width, Height"
        ResizeMode="CanResizeWithGrip"
        Topmost="{Binding KeepWindowOnTop}"
        Icon="../ui_inspector_logo.ico"
        Title="Agent Builder - UI Inspecter">

    <Window.Resources>
        <Style x:Key="SelectableLabel"
               TargetType="{x:Type TextBox}">
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="IsReadOnly"
                    Value="True"/>
        </Style>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:AutomationTypeToDisplayConverter x:Key="AutomationTypeToDisplayConverter"/>
        <converters:StringNullOrEmptyToVisibilityConverter x:Key="StringNullOrEmptyToVisibilityConverter"/>
        <ObjectDataProvider x:Key="NameMatchModes"
                            MethodName="GetValues"
                            ObjectType="{x:Type system:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:NameMatchModeEnum"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="F5"
                    Command="{Binding RefreshCommand}"/>
    </Window.InputBindings>
    <Grid>
        <DockPanel>
            <ToolBarTray DockPanel.Dock="Top"
                         IsLocked="True"
                         Background="{StaticResource SecondaryBrush}">
                <ToolBar ClipToBounds="False"
                         Height="46"
                         BorderBrush="{StaticResource BorderBrush}"
                         BorderThickness="0 0 0 0"
                         Background="{StaticResource SecondaryBrush}"
                         Style="{StaticResource MaterialDesignToolBar}">
                    <!--Select: Automation Type-->
                    <ComboBox Width="140"
                              Height="30"
                              Margin="10 0"
                              FontWeight="Medium"
                              ToolTip="Choose how the tool looks at the app’s screen"
                              ItemsSource="{Binding AutomationTypes}"
                              Foreground="{StaticResource SecondaryForegroundBrush}"
                              Background="{StaticResource SecondaryBrush}"
                              SelectedItem="{Binding SelectedAutomationType, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource AutomationTypeToDisplayConverter}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem"
                                   BasedOn="{StaticResource MaterialDesignComboBoxItemStyle}">
                                <Setter Property="Foreground"
                                        Value="{StaticResource ForegroundBrush}"/>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>

                    <!--Button: Reload Tree-->
                    <Button Visibility="Collapsed"
                            ToolTip="Reload the UI Tree to load the latest UI elements"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource GhostButtonStyle}">
                        <StackPanel Margin="5 0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <md:PackIcon Height="18"
                                         Kind="Refresh"/>
                            <TextBlock Text="Reload"
                                       Margin="3 0"
                                       Style="{StaticResource TextBlockStyle}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!--Button: Capture Screenshot of selected element-->
                    <Button ToolTip="Grab a screenshot of the selected UI element"
                            Visibility="Collapsed"
                            Command="{Binding CaptureSelectedItemCommand}"
                            Style="{StaticResource GhostButtonStyle}">
                        <StackPanel Margin="5 0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <md:PackIcon Height="18"
                                         Kind="ImageOutline"/>
                            <TextBlock Text="Capture"
                                       Margin="3 0"
                                       Style="{StaticResource TextBlockStyle}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!--Toggle: Hover Tracking-->
                    <ToggleButton ToolTip="Move the mouse over an UI element (hold Ctrl key)"
                                  IsChecked="{Binding EnableHoverMode}"
                                  BorderBrush="#FFC7C6D4"
                                  Style="{StaticResource GhostToggleStyle}">
                        <StackPanel Margin="5 0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <md:PackIcon Height="18"
                                         Kind="CursorDefaultOutline"/>
                            <TextBlock Text="Hover"
                                       Margin="3 0"
                                       Style="{StaticResource TextBlockStyle}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <!--Toggle: Focus Tracking-->
                    <ToggleButton ToolTip="Follow what you're clicking or selecting"
                                  Visibility="Collapsed"
                                  IsChecked="{Binding EnableFocusTrackingMode}"
                                  Style="{StaticResource GhostToggleStyle}">
                        <StackPanel Margin="5 0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <md:PackIcon Height="18"
                                         Kind="FocusFieldHorizontal"/>
                            <TextBlock Text="Focus"
                                       Margin="3 0"
                                       Style="{StaticResource TextBlockStyle}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <!--Toggle: Keep App Top most-->
                    <ToggleButton ToolTip="Keep this window visible above all others"
                                  IsChecked="{Binding KeepWindowOnTop}"
                                  Style="{StaticResource GhostToggleStyle}">
                        <StackPanel Margin="5 0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <md:PackIcon Height="18"
                                         Kind="DockWindow"/>
                            <TextBlock Text="Keep on Top"
                                       Margin="3 0"
                                       Style="{StaticResource TextBlockStyle}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>
                </ToolBar>
            </ToolBarTray>
            <StatusBar DockPanel.Dock="Bottom">
                <StatusBarItem>
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding EnableXPath, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Label>XPath:</Label>
                        <TextBox VerticalAlignment="Center">
                            <TextBox.Style>
                                <Style BasedOn="{StaticResource SelectableLabel}"
                                       TargetType="{x:Type TextBox}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EnableXPath}"
                                                     Value="True">
                                            <Setter Property="Text"
                                                    Value="{Binding SelectedItemInTree.XPath, FallbackValue=None, Mode=OneWay}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </StackPanel>
                </StatusBarItem>
            </StatusBar>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <GroupBox Margin="6"
                          Padding="0"
                          Grid.Column="0"
                          FontSize="13"
                          FontWeight="Medium"
                          md:ColorZoneAssist.Background="{StaticResource PrimaryBrush}"
                          md:ColorZoneAssist.Foreground="{StaticResource SecondaryForegroundBrush}"
                          md:ColorZoneAssist.Mode="Custom"
                          Style="{StaticResource MaterialDesignCardGroupBox}">
                    <GroupBox.Header>
                        <Grid Margin="6 0 0 0"
                              Height="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="UI Elements Tree"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource SecondaryForegroundBrush}"/>
                            <Button Grid.Column="1"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTip="Reload the UI Tree to load the latest UI elements"
                                    Command="{Binding RefreshCommand}">
                                <md:PackIcon Kind="Refresh"
                                             Width="18"
                                             Height="18"
                                             Foreground="{StaticResource SecondaryForegroundBrush}"/>
                            </Button>
                        </Grid>
                    </GroupBox.Header>
                    <TreeView x:Name="UIElementsTree"
                              ItemsSource="{Binding Elements}"
                              BorderThickness="1"
                              BorderBrush="{StaticResource RingBrush}">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="{x:Type TreeViewItem}">
                                <Setter Property="IsExpanded"
                                        Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="IsSelected"
                                        Value="{Binding IsSelected, Mode=TwoWay}"/>
                                <Setter Property="FontWeight"
                                        Value="Normal"/>
                                <EventSetter Event="Selected"
                                             Handler="TreeViewSelectedHandler"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected"
                                             Value="True">
                                        <Setter Property="FontWeight"
                                                Value="Bold"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}"
                                                      DataType="{x:Type models:Element}">
                                <StackPanel Orientation="Horizontal">
                                    <Image Width="16"
                                           Height="16"
                                           Margin="0,0,5,0">
                                        <Image.Style>
                                            <Style TargetType="{x:Type Image}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ControlType}"
                                                                 Value="{x:Static flauidef:ControlType.Button}">
                                                        <Setter Property="Source"
                                                                Value="/Resources/Button.png"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ControlType}"
                                                                 Value="{x:Static flauidef:ControlType.Calendar}">
                                                        <Setter Property="Source"
                                                                Value="/Resources/Calendar.png"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ControlType}"
                                                                 Value="{x:Static flauidef:ControlType.CheckBox}">
                                                        <Setter Property="Source"
                                                                Value="/Resources/CheckBox.png"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ControlType}"
                                                                 Value="{x:Static flauidef:ControlType.ComboBox}">
                                                        <Setter Property="Source"
                                                                Value="/Resources/ComboBox.png"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ControlType}"
                                                                 Value="{x:Static flauidef:ControlType.Custom}">
                                                        <Setter Property="Source"
                                                                Value="/Resources/Custom.png"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ControlType}"
                                                                 Value="{x:Static flauidef:ControlType.DataGrid}">
                                                        <Setter Property="Source"
                                                                Value="/Resources/DataGrid.png"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ControlType}"
                                                                 Value="{x:Static flauidef:ControlType.DataItem}">
                                                        <Setter Property="Source"
                                                                Value="/Resources/Item.png"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ControlType}"
                                                                 Value="{x:Static flauidef:ControlType.Document}">
                                                        <Setter Property="Source"
                                                                Value="/Resources/Document.png"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ControlType}"
                                                                 Value="{x:Static flauidef:ControlType.Edit}">
                                                        <Setter Property="Source"
                                                                Value="/Resources/Edit.png"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ControlType}"
                                                                 Value="{x:Static flauidef:ControlType.Group}">
                                                        <Setter Property="Source"
                                                                Value="/Resources/Group.png"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ControlType}"
                                                                 Value="{x:Static flauidef:ControlType.Header}">
                                                        <Setter Property="Source"
                                                                Value="/Resources/Header.png"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ControlType}"
                                                                 Value="{x:Static flauidef:ControlType.HeaderItem}">
                                                        <Setter Property="Source"
                                                                Value="/Resources/HeaderItem.png"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ControlType}"
                                                                 Value="{x:Static flauidef:ControlType.Hyperlink}">
                                                        <Setter Property="Source"
                                                                Value="/Resources/Hyperlink.png"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ControlType}"
                                                                 Value="{x:Static flauidef:ControlType.Image}">
                                                        <Setter Property="Source"
                                                                Value="/Resources/Image.png"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ControlType}"
                                                                 Value="{x:Static flauidef:ControlType.List}">
                                                        <Setter Property="Source"
                                                                Value="/Resources/List.png"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ControlType}"
                                                                 Value="{x:Static flauidef:ControlType.ListItem}">
                                                        <Setter Property="Source"
                                                                Value="/Resources/Item.png"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ControlType}"
                                                                 Value="{x:Static flauidef:ControlType.Menu}">
                                                        <Setter Property="Source"
                                                                Value="/Resources/Menu.png"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ControlType}"
                                                                 Value="{x:Static flauidef:ControlType.MenuBar}">
                                                        <Setter Property="Source"
                                                                Value="/Resources/Menu.png"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ControlType}"
                                                                 Value="{x:Static flauidef:ControlType.MenuItem}">
                                                        <Setter Property="Source"
                                                                Value="/Resources/MenuItem.png"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ControlType}"
                                                                 Value="{x:Static flauidef:ControlType.Pane}">
                                                        <Setter Property="Source"
                                                                Value="/Resources/Pane.png"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ControlType}"
                                                                 Value="{x:Static flauidef:ControlType.ProgressBar}">
                                                        <Setter Property="Source"
                                                                Value="/Resources/ProgressBar.png"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ControlType}"
                                                                 Value="{x:Static flauidef:ControlType.RadioButton}">
                                                        <Setter Property="Source"
                                                                Value="/Resources/RadioButton.png"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ControlType}"
                                                                 Value="{x:Static flauidef:ControlType.ScrollBar}">
                                                        <Setter Property="Source"
                                                                Value="/Resources/ScrollBar.png"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ControlType}"
                                                                 Value="{x:Static flauidef:ControlType.Slider}">
                                                        <Setter Property="Source"
                                                                Value="/Resources/Slider.png"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ControlType}"
                                                                 Value="{x:Static flauidef:ControlType.Spinner}">
                                                        <Setter Property="Source"
                                                                Value="/Resources/Spinner.png"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ControlType}"
                                                                 Value="{x:Static flauidef:ControlType.SplitButton}">
                                                        <Setter Property="Source"
                                                                Value="/Resources/SplitButton.png"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ControlType}"
                                                                 Value="{x:Static flauidef:ControlType.StatusBar}">
                                                        <Setter Property="Source"
                                                                Value="/Resources/StatusBar.png"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ControlType}"
                                                                 Value="{x:Static flauidef:ControlType.Tab}">
                                                        <Setter Property="Source"
                                                                Value="/Resources/Tab.png"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ControlType}"
                                                                 Value="{x:Static flauidef:ControlType.TabItem}">
                                                        <Setter Property="Source"
                                                                Value="/Resources/Item.png"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ControlType}"
                                                                 Value="{x:Static flauidef:ControlType.Text}">
                                                        <Setter Property="Source"
                                                                Value="/Resources/Text.png"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ControlType}"
                                                                 Value="{x:Static flauidef:ControlType.Thumb}">
                                                        <Setter Property="Source"
                                                                Value="/Resources/Thumb.png"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ControlType}"
                                                                 Value="{x:Static flauidef:ControlType.TitleBar}">
                                                        <Setter Property="Source"
                                                                Value="/Resources/TitleBar.png"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ControlType}"
                                                                 Value="{x:Static flauidef:ControlType.ToolBar}">
                                                        <Setter Property="Source"
                                                                Value="/Resources/ToolBar.png"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ControlType}"
                                                                 Value="{x:Static flauidef:ControlType.ToolTip}">
                                                        <Setter Property="Source"
                                                                Value="/Resources/ToolTip.png"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ControlType}"
                                                                 Value="{x:Static flauidef:ControlType.Tree}">
                                                        <Setter Property="Source"
                                                                Value="/Resources/Tree.png"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ControlType}"
                                                                 Value="{x:Static flauidef:ControlType.TreeItem}">
                                                        <Setter Property="Source"
                                                                Value="/Resources/Item.png"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ControlType}"
                                                                 Value="{x:Static flauidef:ControlType.Window}">
                                                        <Setter Property="Source"
                                                                Value="/Resources/Window.png"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                    <TextBlock FontSize="13"
                                               Margin="2"
                                               Foreground="{StaticResource ForegroundBrush}">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} &quot;{1}&quot; &quot;{2}&quot;">
                                                <Binding Path="ControlType"/>
                                                <Binding Path="Name"/>
                                                <Binding Path="AutomationId"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                </GroupBox>
                <GridSplitter Grid.Column="1"
                              HorizontalAlignment="Stretch"/>
                <GroupBox Margin="6"
                          Padding="0"
                          Grid.Column="2"
                          md:ColorZoneAssist.Background="{StaticResource PrimaryBrush}"
                          md:ColorZoneAssist.Foreground="{StaticResource SecondaryForegroundBrush}"
                          md:ColorZoneAssist.Mode="Custom">
                    <GroupBox.Header>
                        <Grid Margin="6 0 0 0"
                              Height="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="UI Element"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource SecondaryForegroundBrush}"/>
                            <Button Grid.Column="1"
                                    Foreground="{StaticResource SecondaryForegroundBrush}"
                                    Margin="10 0 0 0"
                                    Command="{Binding CopyIdentificationPathJsonCommand}"
                                    Style="{StaticResource IconButtonStyle}">
                                <md:PackIcon Kind="ContentCopy"/>
                            </Button>
                        </Grid>
                    </GroupBox.Header>
                    <GroupBox.Style>
                        <Style TargetType="GroupBox"
                               BasedOn="{StaticResource MaterialDesignCardGroupBox}">
                            <Setter Property="Visibility"
                                    Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedItemInTree}"
                                             Value="{x:Null}">
                                    <Setter Property="Visibility"
                                            Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </GroupBox.Style>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto"
                                  BorderThickness="1"
                                  BorderBrush="{StaticResource RingBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility"
                                            Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IdentificationPath.Count}"
                                                     Value="0">
                                            <Setter Property="Visibility"
                                                    Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <StackPanel Grid.Row="0"
                                        Background="{StaticResource AccentBrush}">

                                <Grid Margin="24 16 24 10"
                                      VerticalAlignment="Center">
                                    <!-- Separator Line -->
                                    <Separator Height="1"
                                               VerticalAlignment="Center"
                                               Background="{DynamicResource MaterialDesignDivider}"/>

                                    <!-- Text Block Over the Separator -->
                                    <TextBlock Text="Identification Path"
                                               FontSize="13"
                                               FontWeight="Medium"
                                               Background="{DynamicResource AccentBrush}"
                                               Padding="0 0 10 0"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center"/>
                                </Grid>
                                <!-- Bind to IdentificationPath -->
                                <ItemsControl ItemsSource="{Binding IdentificationPath}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Expander Margin="2 0 0 0"
                                                      HorizontalAlignment="Stretch"
                                                      Background="{StaticResource AccentBrush}"
                                                      md:ExpanderAssist.HorizontalHeaderPadding="20 0 5 0"
                                                      md:ExpanderAssist.ExpanderButtonContent="{md:PackIcon Kind=ChevronRight, Size=0}">
                                                <Expander.Header>
                                                    <StackPanel Orientation="Horizontal">
                                                        <ToggleButton Style="{StaticResource CustomExpanderToggleButton}"
                                                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}"/>
                                                        <TextBlock Margin="2,0,0,0"
                                                                   FontSize="12"
                                                                   FontWeight="Medium"
                                                                   Text="{Binding PathHeading}"/>
                                                    </StackPanel>
                                                </Expander.Header>
                                                <StackPanel Margin="55 2 0 5"
                                                            Orientation="Vertical">
                                                    <StackPanel Orientation="Horizontal"
                                                                Visibility="{Binding Index, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">
                                                        <CheckBox Margin="0 0 5 0"
                                                                  IsChecked="{Binding IsIndexSelected}"/>
                                                        <TextBlock Text="Index"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Margin="1 0 1 0"
                                                                   Text="="/>
                                                        <TextBlock Text="{Binding Index}"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal"
                                                                Visibility="{Binding Name, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">
                                                        <CheckBox Margin="0 0 5 0"
                                                                  IsChecked="{Binding IsNameSelected}"/>
                                                        <TextBlock Text="Name"
                                                                   VerticalAlignment="Center"/>
                                                        <ComboBox Margin="6 0 6 0"
                                                                  Padding="0"
                                                                  md:ComboBoxAssist.ShowSelectedItem="False"
                                                                  SelectedItem="{Binding NameMatchMode, Mode=TwoWay}"
                                                                  ItemsSource="{Binding Source={StaticResource NameMatchModes}}">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding}"/>
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=Explicit}"
                                                                 BorderThickness="0"
                                                                 VerticalAlignment="Center"
                                                                 LostFocus="NameTextBox_LostFocus"
                                                                 KeyDown="NameTextBox_KeyDown"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal"
                                                                Visibility="{Binding ClassName, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">
                                                        <CheckBox Margin="0 0 5 0"
                                                                  IsChecked="{Binding IsClassNameSelected}"/>
                                                        <TextBlock Text="ClassName"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Margin="1 0 1 0"
                                                                   Text="="/>
                                                        <TextBlock Text="{Binding ClassName}"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal"
                                                                Visibility="{Binding ControlType, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">
                                                        <CheckBox Margin="0 0 5 0"
                                                                  IsChecked="{Binding IsControlTypeSelected}"/>
                                                        <TextBlock Text="ControlType"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Margin="1 0 1 0"
                                                                   Text="="/>
                                                        <TextBlock Text="{Binding ControlType}"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal"
                                                                Visibility="{Binding FrameworkId, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">
                                                        <CheckBox Margin="0 0 5 0"
                                                                  IsChecked="{Binding IsFrameworkIdSelected}"/>
                                                        <TextBlock Text="FrameworkId"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Margin="1 0 1 0"
                                                                   Text="="/>
                                                        <TextBlock Text="{Binding FrameworkId}"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal"
                                                                Visibility="{Binding AutomationId, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">
                                                        <CheckBox Margin="0 0 5 0"
                                                                  IsChecked="{Binding IsAutomationIdSelected}"/>
                                                        <TextBlock Text="AutomationId"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Margin="1 0 1 0"
                                                                   Text="="/>
                                                        <TextBlock Text="{Binding AutomationId}"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Expander>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border Margin="10"/>
                            </StackPanel>

                            <StackPanel Visibility="Visible"
                                        Grid.Row="1"
                                        Background="{StaticResource AccentBrush}">

                                <Grid Margin="24 10 24 10"
                                      VerticalAlignment="Center">
                                    <!-- Separator Line -->
                                    <Separator Height="1"
                                               VerticalAlignment="Center"
                                               Background="{DynamicResource MaterialDesignDivider}"/>

                                    <!-- Text Block Over the Separator -->
                                    <TextBlock Text="Supported Actions"
                                               FontSize="13"
                                               FontWeight="Medium"
                                               Padding="0 0 10 0"
                                               Background="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center"/>
                                </Grid>
                                <!-- Actions Section -->
                                <ItemsControl ItemsSource="{Binding SupportedPatterns}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="24 0 24 10"
                                                    Padding="10 4 4 5"
                                                    BorderThickness="2"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    CornerRadius="6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                        <TextBlock
                                                            FontSize="12"
                                                            FontWeight="Medium"
                                                            VerticalAlignment="Center"
                                                            Foreground="{StaticResource ForegroundBrush}"
                                                            Text="{Binding ActionName}"/>
                                                        <TextBox Text="{Binding ValueToSet, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Width="100"
                                                                 Margin="10 0 0 0"
                                                                 Padding="0"
                                                                 Visibility="{Binding ValueToSet, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"/>
                                                    </StackPanel>
                                                    <Button
                                                        Grid.Column="1"
                                                        HorizontalAlignment="Right"
                                                        Height="24"
                                                        Padding="9 0"
                                                        md:ButtonAssist.CornerRadius="4"
                                                        Content="Test"
                                                        FontSize="12"
                                                        Command="{Binding TestCommand}"
                                                        Style="{StaticResource MaterialDesignFlatLightButton}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border Margin="10"/>
                            </StackPanel>
                            <ItemsControl Grid.Row="2"
                                          ItemsSource="{Binding SelectedItemDetails}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="viewModels:DetailGroupViewModel">
                                        <Expander
                                            IsExpanded="True"
                                            Margin="0 0 0 0"
                                            Background="{StaticResource BackgroundBrush}"
                                            md:ExpanderAssist.ExpanderButtonPosition="Start">
                                            <Expander.Header>
                                                <TextBlock
                                                    Margin="10,0,0,0"
                                                    FontSize="13"
                                                    FontWeight="Medium"
                                                    Text="{Binding Name}"/>
                                            </Expander.Header>
                                            <ItemsControl ItemsSource="{Binding Details}"
                                                          Margin="24 0 0 0"
                                                          Grid.IsSharedSizeScope="True">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"
                                                                                  SharedSizeGroup="DetailColumnKey"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBox Grid.Column="0"
                                                                     IsReadOnly="True"
                                                                     FontSize="12"
                                                                     Margin="0,2,0,0"
                                                                     Text="{Binding Key}">
                                                                <TextBox.Style>
                                                                    <Style BasedOn="{StaticResource SelectableLabel}"
                                                                           TargetType="{x:Type TextBox}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Important}"
                                                                                         Value="True">
                                                                                <Setter Property="FontWeight"
                                                                                        Value="Bold"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBox.Style>
                                                            </TextBox>
                                                            <TextBox Grid.Column="1"
                                                                     IsReadOnly="True"
                                                                     FontSize="12"
                                                                     FontWeight="Medium"
                                                                     Text="{Binding Value}"
                                                                     Margin="10,2,0,0">
                                                                <TextBox.Style>
                                                                    <Style BasedOn="{StaticResource SelectableLabel}"
                                                                           TargetType="{x:Type TextBox}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Value}"
                                                                                         Value="No">
                                                                                <Setter Property="TextBox.Foreground"
                                                                                        Value="Red"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Value}"
                                                                                         Value="Yes">
                                                                                <Setter Property="TextBox.Foreground"
                                                                                        Value="Green"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBox.Style>
                                                            </TextBox>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>
                </GroupBox>

                <GroupBox Grid.Column="2"
                          Margin="6"
                          Padding="40"
                          md:ColorZoneAssist.Mode="Custom">
                    <GroupBox.Style>
                        <Style TargetType="GroupBox"
                               BasedOn="{StaticResource MaterialDesignCardGroupBox}">
                            <Setter Property="Visibility"
                                    Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedItemInTree}"
                                             Value="{x:Null}">
                                    <Setter Property="Visibility"
                                            Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </GroupBox.Style>
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <md:PackIcon Kind="CursorDefaultOutline"
                                     HorizontalAlignment="Center"
                                     Width="28"
                                     Height="28"
                                     Foreground="{StaticResource MutedForegroundBrush}"
                                     Margin="0 0 0 10"/>
                        <TextBlock Text="No UI element selected."
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0 0 0 10"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Enable the Hover option above and move your mouse over an application to start inspecting UI elements (use Ctrl)."
                                   FontSize="13"
                                   Foreground="{StaticResource MutedForegroundBrush}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </GroupBox>
            </Grid>
        </DockPanel>
    </Grid>
</Window>

{
  "name": "avplatform-web",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,md,css,json}\"",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "pregit": "prettier --write . && eslint --fix . && tsc -b"
  },
  "devDependencies": {
    "@assistant-ui/tap": "^0.9.21",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/node": "^24.3.0",
    "eslint": "^9.0.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^3.4.17",
    "turbo": "^2.5.6"
  },
  "optionalDependencies": {
    "@tauri-apps/cli-win32-x64-msvc": "^2.9.6"
  },
  "packageManager": "npm@10.9.3",
  "overrides": {
    "tailwindcss": "^3.4.17",
    "react-hook-form": "7.52.1",
    "zustand": "5.0.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "dependencies": {
    "docx-preview": "^0.4.0"
  }
}

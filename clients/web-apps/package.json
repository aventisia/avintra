{
  "name": "avplatform-web",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,md,css,json}\"",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "pregit": "prettier --write . && eslint --fix . && tsc -b"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/node": "^24.3.0",
    "eslint": "^9.0.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "turbo": "^2.5.6",
    "tailwindcss": "^3.4.17"
  },
  "packageManager": "npm@10.9.3",
  "overrides": {
    "tailwindcss": "^3.4.17"
  }
}

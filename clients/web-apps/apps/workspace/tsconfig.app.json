{
  "extends": "@avplatform/typescript-config/vite.json",
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "verbatimModuleSyntax": false,
    "baseUrl": ".",
    "paths": {
      "@/react-toolkit/*": ["./react-toolkit/*"],
      "@/ui/*": ["../../packages/ui/src/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src",
    "react-toolkit",
    "../../packages/assistant-chat/src/**/*",
    "../../packages/chat/src/**/*",
    "../../packages/ui/src/**/*",
    "../../packages/layout/src/**/*",
    "../../packages/tauri-utils/src/**/*"
  ]
}

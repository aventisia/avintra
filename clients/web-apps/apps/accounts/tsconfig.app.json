{
  "extends": "@avplatform/typescript-config/vite.json",
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "baseUrl": ".",
    "paths": {
      "@/react-toolkit/*": ["./react-toolkit/*"], // SHOULD BE FIRST
      "@/ui/*": ["../../packages/ui/src/*"],
      "@/*": ["./src/*"] // SHOULD BE SECOND
    }
  },
  "include": ["src", "react-toolkit"]
}

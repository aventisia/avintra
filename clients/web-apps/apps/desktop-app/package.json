{
  "name": "desktop-app",
  "private": true,
  "version": "0.2.39",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "pregit": "tsc -b && prettier --write .",
    "build": "tsc -b && vite build",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,md,css,json}\"",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@avplatform/layout": "*",
    "@avplatform/tauri-utils": "*",
    "@avplatform/ui": "*",
    "@tauri-apps/api": "^2.9.1",
    "@tauri-apps/plugin-fs": "^2.4.5",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-store": "^2.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@avplatform/eslint-config": "*",
    "@avplatform/tailwind-config": "*",
    "@avplatform/typescript-config": "*",
    "@avplatform/vite-config": "*",
    "@tauri-apps/cli": "^2.9.6",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react-swc": "^4.0.0",
    "typescript": "^5.5.3",
    "vite": "^7.1.2"

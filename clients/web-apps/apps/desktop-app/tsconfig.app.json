{
  "extends": "@avplatform/typescript-config/vite.json",
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "verbatimModuleSyntax": false,
    "baseUrl": ".",
    "paths": {
      "@/ui/*": ["../../packages/ui/src/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src",
    "../../packages/ui/src/**/*",
    "../../packages/layout/src/**/*",
    "../../packages/tauri-utils/src/**/*"
  ]
}

# Desktop-app build/publish secrets template.
# Copy to scripts/.env.local (gitignored, never commit) and fill in the values.
# TAURI_SIGNING_PRIVATE_KEY and password come from the old 01-tauri-build.bat.

TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# Windows-only EV code-signing config (prod flow)
# Values are quoted so bash `source` in the .sh scripts parses them correctly;
# the PowerShell script strips the quotes when loading.
WINDOWS_SIGNTOOL_PATH=
WINDOWS_CERT_PATH=
WINDOWS_KMS_KEYRING=
{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "updater:default",
    "store:default",
    "os:default",
    "os:allow-hostname",
    "fs:default",
    {
      "identifier": "fs:allow-app-read-recursive",
      "allow": [{ "path": "$RESOURCE/**" }]
    },
    "core:window:allow-destroy",
    "core:window:allow-close",
    {
      "identifier": "store:allow-get",
      "allow": [{ "key": "*" }]
    },
    {
      "identifier": "store:allow-set",
      "allow": [{ "key": "*" }]
    },
    {
      "identifier": "store:allow-delete",
      "allow": [{ "key": "*" }]
    },
    {
      "identifier": "store:allow-save",
      "allow": [{ "key": "*" }]
    },
    "allow-launch-runner-app",
    "allow-launch-ui-inspector",
    "allow-get-user-metadata",
    "allow-check-runner-app",
    "allow-download-runner-app",
    "allow-get-websocket-port",
    "allow-check-update-for-domain",
    "allow-download-update",
    "allow-install-update",
    "allow-cancel-download",
    "allow-get-app-version",
    "allow-has-pending-update"
  ],
  "local": true,
  "remote": {
    "urls": ["http://localhost:*/**", "https://localhost:*/**", "https://*.aventisia.com/**"]
  }
}

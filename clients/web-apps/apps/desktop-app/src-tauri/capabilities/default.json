{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "updater:default",
    "store:default",
    "fs:default",
    {
      "identifier": "fs:allow-app-read-recursive",
      "allow": [{ "path": "$RESOURCE/**" }]
    },
    "core:window:allow-destroy",
    "core:window:allow-close",
    {
      "identifier": "store:allow-get",
      "allow": [{ "key": "*" }]
    },
    {
      "identifier": "store:allow-set",
      "allow": [{ "key": "*" }]
    },
    {
      "identifier": "store:allow-delete",
      "allow": [{ "key": "*" }]
    },
    {
      "identifier": "store:allow-save",
      "allow": [{ "key": "*" }]
    }
  ],
  "local": true,
  "remote": {
    "urls": ["http://localhost:*/**", "https://localhost:*/**", "https://*.aventisia.com/**"]
  }
}

{
  "name": "atlas",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3007",
    "typecheck": "tsc -b",
    "pregit": "tsc -b && prettier --write .",
    "build": "tsc -b && vite build",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,md,css,json}\"",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "@avplatform/layout": "*",
    "@avplatform/ui": "*",
    "@heroicons/react": "^2.1.5",
    "@tanstack/react-query": "^5.51.1",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^0.428.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.24.1",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@avplatform/eslint-config": "*",
    "@avplatform/tailwind-config": "*",
    "@avplatform/typescript-config": "*",
    "@avplatform/vite-config": "*",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react-swc": "^4.0.0",
    "globals": "^16.3.0",
    "typescript": "~5.8.3",
    "vite": "^7.1.2"

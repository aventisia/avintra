{
  "name": "CloseWindowNode",
  "label": "Close Window",
  "description": "Closes the selected application window.",
  "version": "1.0.0",
  "author": "@aventisia",
  "supportedPlatforms": ["windows"],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "text",
      "name": "WindowElement",
      "label": "Window",
      "description": "Select the window you want to close.",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "IsWindowClosed",
      "label": "Is Window Closed Successfully",
      "description": "Indicates whether the window was closed successfully.",
      "defaultValue": {
        "value": "IsWindowClosed",
        "enabled": true
      },
      "required": false
    }
  ]
}

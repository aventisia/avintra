{
  "name": "DeleteFtpFile",
  "label": "Delete FTP File",
  "description": "Deletes a single file from an FTP server.",
  "version": "1.0.0",
  "auther": "@aventisia",
  "supportedPlatforms": ["cloud", "windows"],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "text",
      "name": "FtpConnection",
      "label": "FTP Connection",
      "description": "The FTP connection object.",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "FileName",
      "label": "File Name",
      "description": "The name of the file to delete.",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "DeletedFile",
      "label": "Deleted Files",
      "description": "The file that was successfully deleted.",
      "defaultValue": {
        "value": "DeletedFile",
        "enabled": true
      },
      "required": false
    }
  ]
}

{
  "name": "ConvertTextToBase64Node",
  "label": "Convert Text to Base64",
  "description": "Encodes a plain text string into a Base64 string using the specified text encoding.",
  "version": "1.0.0",
  "author": "@aventisia",
  "supportedPlatforms": ["cloud", "windows"],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "text",
      "name": "Text",
      "label": "Text",
      "description": "The plain text to encode as Base64.",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "select",
      "name": "TextEncoding",
      "label": "Encoding",
      "description": "The character encoding used to convert the text to bytes before Base64 encoding.",
      "defaultValue": "Utf8",
      "required": false,
      "selectOptions": [
        {
          "label": "UTF-8",
          "value": "Utf8",
          "description": "Unicode UTF-8 encoding."
        },
        {
          "label": "UTF-16",
          "value": "Utf16",
          "description": "Unicode UTF-16 encoding, little-endian."
        },
        {
          "label": "UTF-16 (Big Endian)",
          "value": "Utf16BE",
          "description": "Unicode UTF-16 encoding, big-endian."
        },
        {
          "label": "UTF-32",
          "value": "Utf32",
          "description": "Unicode UTF-32 encoding, little-endian."
        },
        {
          "label": "ASCII",
          "value": "Ascii",
          "description": "7-bit ASCII encoding."
        }
      ]
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "Base64String",
      "label": "Base64 String",
      "description": "The resulting Base64-encoded string.",
      "defaultValue": {
        "value": "Base64String",
        "enabled": true
      },
      "required": false
    }
  ]
}

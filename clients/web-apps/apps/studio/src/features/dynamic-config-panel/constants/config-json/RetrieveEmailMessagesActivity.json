{
  "name": "RetrieveEmailMessages",
  "label": "Retrieve Email Messages",
  "description": "Retrieves email messages from an IMAP server.",
  "version": "1.0.0",
  "auther": "@aventisia",
  "supportedPlatforms": ["cloud", "windows"],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "text",
      "name": "ImapServer",
      "label": "IMAP Server",
      "description": "The IMAP server URL.",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "Username",
      "label": "Username",
      "description": "The username for authentication.",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "password",
      "name": "Password",
      "label": "Password",
      "description": "The password for authentication.",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "Port",
      "label": "Port",
      "description": "The port number for the IMAP server (default is 993).",
      "defaultValue": 993,
      "required": false
    },
    {
      "direction": "Input",
      "type": "switch",
      "name": "EnableSSL",
      "label": "Enable SSL",
      "description": "If true, uses SSL encryption for the connection.",
      "defaultValue": true,
      "required": false
    },
    {
      "direction": "Input",
      "type": "switch",
      "name": "AcceptUntrustedCertificates",
      "label": "Accept Untrusted Certificates",
      "description": "If true, accepts untrusted SSL certificates.",
      "defaultValue": false,
      "required": false
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "MailFolder",
      "label": "Mail Folder",
      "description": "The folder to retrieve emails from (e.g., Inbox).",
      "defaultValue": "Inbox",
      "required": false
    },
    {
      "direction": "Input",
      "type": "select",
      "name": "RetrieveMode",
      "label": "Retrieve Mode",
      "description": "Specifies which emails to retrieve.",
      "defaultValue": "AllEmails",
      "required": false,
      "selectOptions": [
        {
          "label": "All email messages",
          "value": "AllEmails",
          "description": "Retrieves all email messages."
        },
        {
          "label": "Unread email messages only",
          "value": "UnreadOnly",
          "description": "Retrieves only unread email messages."
        },
        {
          "label": "Read email messages only",
          "value": "ReadOnly",
          "description": "Retrieves only read email messages."
        }
      ]
    },
    {
      "direction": "Input",
      "type": "switch",
      "name": "MarkAsRead",
      "label": "Mark as Read",
      "description": "If true, marks retrieved emails as read.",
      "defaultValue": false,
      "required": false
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "FromContains",
      "label": "From Field Contains",
      "description": "Filters emails where the \u0027From\u0027 field contains this text.",
      "defaultValue": "",
      "required": false
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "ToContains",
      "label": "To Field Contains",
      "description": "Filters emails where the \u0027To\u0027 field contains this text.",
      "defaultValue": "",
      "required": false
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "SubjectContains",
      "label": "Subject Contains",
      "description": "Filters emails where the subject contains this text.",
      "defaultValue": "",
      "required": false
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "BodyContains",
      "label": "Body Contains",
      "description": "Filters emails where the body contains this text.",
      "defaultValue": "",
      "required": false
    },
    {
      "direction": "Input",
      "type": "select",
      "name": "SaveAttachments",
      "label": "Save Attachments",
      "description": "Specifies whether to save attachments.",
      "defaultValue": "DoNotSaveAttachments",
      "required": false,
      "selectOptions": [
        {
          "label": "Do not save attachments",
          "value": "DoNotSaveAttachments",
          "description": "Does not save any attachments."
        },
        {
          "label": "Save attachments",
          "value": "SaveAttachments",
          "description": "Saves all attachments."
        }
      ]
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "SaveDirectory",
      "label": "Save Attachments Into",
      "description": "The directory where attachments will be saved (required if \u0027Save Attachments\u0027 is enabled).",
      "defaultValue": "",
      "required": false
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "RetrievedEmails",
      "label": "Retrieved Emails",
      "description": "Returns the retrieved email messages.",
      "defaultValue": {
        "value": "RetrievedEmails",
        "enabled": true
      },
      "required": false
    }
  ]
}

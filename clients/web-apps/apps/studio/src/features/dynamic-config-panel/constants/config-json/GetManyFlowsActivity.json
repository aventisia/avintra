{
  "name": "GetManyFlows",
  "label": "Get Many Flows",
  "description": "Retrieves multiple Salesforce flows. Use \u0027Return All\u0027 to get all records without limit.",
  "version": "1.0.0",
  "auther": "@aventisia",
  "supportedPlatforms": ["cloud", "windows"],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "text",
      "name": "Credential",
      "label": "Credential to connect with",
      "description": "The credential to connect with",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "Resource",
      "label": "Resource",
      "description": "The resource type",
      "defaultValue": "Flow",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "Operation",
      "label": "Operation",
      "description": "The operation to perform",
      "defaultValue": "Get Many",
      "required": true
    },
    {
      "direction": "Input",
      "type": "switch",
      "name": "ReturnAll",
      "label": "Return All",
      "description": "If enabled, retrieves all flows. If disabled, uses the Limit value.",
      "defaultValue": false,
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "Limit",
      "label": "Limit",
      "description": "Maximum number of flows to retrieve. Only visible when \u0027Return All\u0027 is disabled.",
      "defaultValue": 50,
      "required": false,
      "renderIf": {
        "conditions": [
          {
            "field": "ReturnAll",
            "equals": false
          }
        ]
      }
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "Flows",
      "label": "Flows",
      "description": "The list of flows returned as JSON",
      "defaultValue": {
        "value": "Flows",
        "enabled": true
      },
      "required": false
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "Response",
      "label": "Response",
      "description": "The raw JSON response from Salesforce",
      "defaultValue": {
        "value": "Response",
        "enabled": true
      },
      "required": false
    }
  ]
}

{
  "name": "IfProcessNode",
  "label": "If process",
  "description": "Marks the beginning of a conditional block of actions depending on whether a process is running or not.",
  "version": "1.0.0",
  "author": "@aventisia",
  "supportedPlatforms": ["windows"],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "select",
      "name": "Condition",
      "label": "If process",
      "description": "Specifies the condition to check (e.g., IsRunning, Isn\u0027t Running).",
      "defaultValue": "",
      "required": true,
      "selectOptions": [
        {
          "label": "Is Running",
          "value": "IsRunning",
          "description": "Checks if the process is currently running."
        },
        {
          "label": "Is Not Running",
          "value": "IsntRunning",
          "description": "Checks if the process is not currently running."
        }
      ]
    },
    {
      "direction": "Input",
      "type": "select",
      "name": "ProcessName",
      "label": "Process name",
      "description": "The name of the process to check.",
      "defaultValue": "",
      "required": true,
      "selectOptions": [
        {
          "label": "Aggregator Host",
          "value": "AggregatorHost",
          "description": "Aggregator Host service."
        },
        {
          "label": "Application Message Forwarder",
          "value": "ApMsgFwd",
          "description": "Forwards application messages."
        },
        {
          "label": "AP Notification Executor",
          "value": "ApntEx",
          "description": "Executes AP notifications."
        },
        {
          "label": "Apoint Service",
          "value": "Apoint",
          "description": "Apoint background service."
        },
        {
          "label": "Generic Application",
          "value": "App",
          "description": "Standard application process."
        },
        {
          "label": "Remote AP Service",
          "value": "ApRemote",
          "description": "Remote access AP service."
        },
        {
          "label": "Windows Audio Device Graph Isolation",
          "value": "Audiodg",
          "description": "Manages audio isolation."
        },
        {
          "label": "Google Chrome Browser",
          "value": "Chrome",
          "description": "Google Chrome browser instance."
        },
        {
          "label": "Copilot Language Server",
          "value": "CopilotLanguageServer",
          "description": "Language server for Copilot integration."
        },
        {
          "label": "Client/Server Runtime Subsystem",
          "value": "Csrss",
          "description": "Core Windows subsystem process."
        },
        {
          "label": "Input Method Editor",
          "value": "Ctfmon",
          "description": "IME support for input methods."
        },
        {
          "label": "Device Association Service Host",
          "value": "DasHost",
          "description": "Handles device associations."
        },
        {
          "label": "Visual Studio Development Environment",
          "value": "Devenv",
          "description": "Visual Studio IDE process."
        },
        {
          "label": "COM Surrogate",
          "value": "Dllhost",
          "description": "Runs COM objects outside of host process."
        },
        {
          "label": "File Co-Authoring Service",
          "value": "FileCoAuth",
          "description": "Supports real-time document co-editing."
        },
        {
          "label": "Font Driver Host",
          "value": "Fontdrvhost",
          "description": "Manages font drivers."
        },
        {
          "label": "Human Interface Device Monitor",
          "value": "HidMonitorSvc",
          "description": "Monitors HID devices."
        },
        {
          "label": "Intel Bluetooth Service",
          "value": "IbtSiva",
          "description": "Intel Bluetooth support service."
        },
        {
          "label": "Idle Process",
          "value": "Idle",
          "description": "Represents idle CPU time."
        },
        {
          "label": "Intel Content Protection Service",
          "value": "IntelCpHDCPSvc",
          "description": "Manages Intel HDCP content protection."
        }
      ]
    },
    {
      "direction": "Input",
      "type": "switch",
      "name": "FromUser",
      "label": "From User",
      "description": "Indicates whether to check if the process is running under a specific user.",
      "defaultValue": false,
      "required": false
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "UserName",
      "label": "User name",
      "description": "The name of the user to check (only applicable if \u0027From User\u0027 is enabled).",
      "defaultValue": "",
      "required": false,
      "renderIf": {
        "conditions": [
          {
            "field": "FromUser",
            "equals": true
          }
        ]
      }
    }
  ]
}

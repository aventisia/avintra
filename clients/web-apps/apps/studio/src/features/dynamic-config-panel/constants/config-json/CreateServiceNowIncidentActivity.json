{
  "name": "CreateServiceNowIncident",
  "label": "Create ServiceNow Incident",
  "description": "Creates a new incident in ServiceNow using a stored credential ID or token.",
  "version": "1.0.0",
  "auther": "@aventisia",
  "supportedPlatforms": ["cloud", "windows"],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "text",
      "name": "CredentialId",
      "label": "Credential ID / Token",
      "description": "ServiceNow credential ID, Base64 token, or OAuth2 token",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "ShortDescription",
      "label": "Short Description",
      "description": "Short description of the incident",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "Description",
      "label": "Description",
      "description": "Detailed description of the incident",
      "defaultValue": "",
      "required": false
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "AdditionalFields",
      "label": "Additional Fields",
      "description": "Additional fields as key-value pairs (e.g., \u0027urgency\u0027: \u00271\u0027)",
      "defaultValue": "",
      "required": false
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "Response",
      "label": "API Response",
      "description": "JSON response from ServiceNow API",
      "defaultValue": {
        "value": "Response",
        "enabled": true
      },
      "required": false
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "IncidentId",
      "label": "Incident Sys_Id",
      "description": "The sys_id of the created incident",
      "defaultValue": {
        "value": "IncidentId",
        "enabled": true
      },
      "required": false
    }
  ]
}

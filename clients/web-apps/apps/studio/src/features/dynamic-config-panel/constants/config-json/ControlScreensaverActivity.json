{
  "name": "ControlScreensaver",
  "label": "Control Screensaver",
  "description": "Enables, disables, starts, or stops the screensaver.",
  "version": "1.0.0",
  "auther": "@aventisia",
  "supportedPlatforms": ["windows"],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "select",
      "name": "Action",
      "label": "Action",
      "description": "The action to perform on the screensaver.",
      "defaultValue": "",
      "required": true,
      "selectOptions": [
        {
          "label": "Enable",
          "value": "Enable",
          "description": "Enables the screensaver."
        },
        {
          "label": "Disable",
          "value": "Disable",
          "description": "Disables the screensaver."
        },
        {
          "label": "Start",
          "value": "Start",
          "description": "Starts the screensaver."
        },
        {
          "label": "Stop",
          "value": "Stop",
          "description": "Stops the screensaver."
        }
      ]
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "TimeoutSeconds",
      "label": "Time Out Seconds",
      "description": "Timeout in seconds (only used when enabling screensaver).",
      "defaultValue": "",
      "required": false
    }
  ]
}

{
  "name": "CreateTTSAIAgent",
  "label": "Text To Speech",
  "description": "Convert text into natural-sounding speech using AI.",
  "version": "1.0.0",
  "auther": "@aventisia",
  "supportedPlatforms": ["cloud", "desktop"],
  "errorHandling": "standard",
  "testScreenType": "llmGenerateRequest",
  "fields": [
    {
      "direction": "Input",
      "type": "model-config-select",
      "name": "__ModelConfig__TextToSpeech",
      "defaultValue": {
        "is_byok_enabled": true,
        "provider": "elevenlabs",
        "credential_name": "",
        "model": "eleven_v3"
      },
      "required": false,
      "category": "Models"
    },
    {
      "direction": "Input",
      "type": "voice-config-select",
      "name": "__VoiceConfig__TextToSpeech",
      "defaultValue": {
        "language": "en",
        "voice": "",
        "speed": 1
      },
      "required": false,
      "category": "Models"
    },
    {
      "direction": "Input",
      "type": "textarea",
      "name": "InputText",
      "label": "Input Text",
      "required": false,
      "category": "Inputs"
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "Result",
      "label": "Result",
      "description": "Result.",
      "defaultValue": {
        "value": "Result",
        "enabled": true
      },
      "required": false,
      "category": "Models"
    }
  ]
}

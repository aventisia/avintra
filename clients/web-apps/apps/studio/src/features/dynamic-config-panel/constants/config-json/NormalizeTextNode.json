{
  "name": "NormalizeTextNode",
  "label": "Normalize Text",
  "description": "Normalizes a text by removing accents, collapsing whitespace, and converting the case.",
  "version": "1.0.0",
  "author": "@aventisia",
  "supportedPlatforms": ["cloud", "windows"],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "badge": "Beta",
  "fields": [
    {
      "direction": "Input",
      "type": "text",
      "name": "Text",
      "label": "Text",
      "description": "The text to normalize.",
      "defaultValue": "",
      "required": false
    },
    {
      "direction": "Input",
      "type": "switch",
      "name": "RemoveAccents",
      "label": "Remove Accents",
      "description": "Removes diacritical marks (accents) from characters.",
      "defaultValue": true,
      "required": false
    },
    {
      "direction": "Input",
      "type": "switch",
      "name": "CollapseWhitespace",
      "label": "Collapse Whitespace",
      "description": "Replaces multiple consecutive whitespace characters with a single space.",
      "defaultValue": true,
      "required": false
    },
    {
      "direction": "Input",
      "type": "select",
      "name": "NormalizeCase",
      "label": "Normalize Case",
      "description": "Converts the text to the selected case format.",
      "defaultValue": "Lowercase",
      "required": false,
      "selectOptions": [
        {
          "label": "None",
          "value": "None",
          "description": "Leaves the text casing unchanged."
        },
        {
          "label": "Lowercase",
          "value": "Lowercase",
          "description": "Converts all characters to lowercase."
        },
        {
          "label": "Uppercase",
          "value": "Uppercase",
          "description": "Converts all characters to uppercase."
        },
        {
          "label": "Title Case",
          "value": "TitleCase",
          "description": "Capitalizes the first letter of each word."
        }
      ]
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "NormalizedText",
      "label": "Normalized Text",
      "description": "The normalized text.",
      "defaultValue": {
        "value": "NormalizedText",
        "enabled": true
      },
      "required": false
    }
  ]
}

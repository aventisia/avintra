{
  "name": "OpenFtpConnection",
  "label": "Open FTP Connection",
  "description": "Establishes a specific connection to a remote FTP server and stores that connection as a variable for later use.",
  "version": "1.0.0",
  "auther": "@aventisia",
  "supportedPlatforms": ["cloud", "windows"],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "text",
      "name": "Host",
      "label": "Host",
      "description": "The FTP server URL (e.g., ftp.example.com).",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "Port",
      "label": "Port",
      "description": "The port number for the FTP connection (default is21).",
      "defaultValue": 21,
      "required": false
    },
    {
      "direction": "Input",
      "type": "switch",
      "name": "ActiveMode",
      "label": "Active Mode",
      "description": "If true, uses active mode for FTP connection.",
      "defaultValue": "",
      "required": false
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "Username",
      "label": "Username",
      "description": "The username for authentication.",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "password",
      "name": "Password",
      "label": "Password",
      "description": "The password for authentication.",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "FtpConnection",
      "label": "FTP Connection",
      "description": "The connection object for the opened FTP connection.",
      "defaultValue": {
        "value": "FtpConnection",
        "enabled": true
      },
      "required": false
    }
  ]
}

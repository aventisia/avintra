{
  "name": "AddQuickExpense",
  "label": "Add Quick Expense",
  "description": "Adds a quick expense in SAP Concur for later linking to a report.",
  "version": "1.0.0",
  "auther": "@aventisia",
  "supportedPlatforms": ["cloud", "windows"],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "text",
      "name": "ClientId",
      "label": "Client ID",
      "description": "The Client ID from SAP Concur App Management.",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "ClientSecret",
      "label": "Client Secret",
      "description": "The Client Secret from SAP Concur App Management.",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "Scope",
      "label": "Scope",
      "description": "The scope required (e.g., quickexpense.write).",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "Amount",
      "label": "Amount",
      "description": "The amount of the expense.",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "Currency",
      "label": "Currency",
      "description": "Currency code (e.g., USD).",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "ExpenseType",
      "label": "Expense Type",
      "description": "Expense type code (e.g., MEALS).",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "TransactionDate",
      "label": "Transaction Date",
      "description": "Date of transaction (YYYY-MM-DD).",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "Description",
      "label": "Description",
      "description": "Optional description of the expense.",
      "defaultValue": "",
      "required": false
    },
    {
      "direction": "Input",
      "type": "switch",
      "name": "ContinueOnError",
      "label": "Continue on Error",
      "description": "If true, workflow continues even if the request fails.",
      "defaultValue": false,
      "required": false
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "Response",
      "label": "Response",
      "description": "Response from SAP Concur API.",
      "defaultValue": {
        "value": "Response",
        "enabled": true
      },
      "required": false
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "StatusCode",
      "label": "Status Code",
      "description": "HTTP status code returned by the API.",
      "defaultValue": {
        "value": "StatusCode",
        "enabled": true
      },
      "required": false
    }
  ]
}

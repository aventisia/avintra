{
  "name": "FindCommonListItemsNode",
  "label": "Find Common List Items",
  "description": "Finds common items between two lists and returns them as a new list.",
  "version": "1.0.0",
  "author": "@aventisia",
  "supportedPlatforms": ["cloud", "windows"],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "text",
      "name": "FirstList",
      "label": "First List",
      "description": "The first list to compare.",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "SecondList",
      "label": "Second List",
      "description": "The second list to compare.",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "IntersectionList",
      "label": "Intersection List",
      "description": "Returns a list containing the common items from both input lists.",
      "defaultValue": {
        "value": "IntersectionList",
        "enabled": true
      },
      "required": false
    }
  ]
}

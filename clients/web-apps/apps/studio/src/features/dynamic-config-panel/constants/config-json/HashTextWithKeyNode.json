{
  "name": "HashTextWithKeyNode",
  "label": "Hash Text with Key",
  "description": "Hash a string with a key, using a specified algorithm",
  "version": "1.0.0",
  "author": "@aventisia",
  "supportedPlatforms": ["cloud", "windows"],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "text",
      "name": "Text",
      "label": "Text to Hash",
      "description": "The text you want to hash",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "Key",
      "label": "Key to Use",
      "description": "The key to use in hashing",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "select",
      "name": "Algorithm",
      "label": "Hashing Algorithm",
      "description": "The algorithm to use for hashing (SHA256, SHA512, or MD5)",
      "defaultValue": "",
      "required": true,
      "selectOptions": [
        {
          "label": "MD5",
          "value": "Md5",
          "description": "MD5 hashing algorithm"
        },
        {
          "label": "SHA256",
          "value": "Sha256",
          "description": "SHA-256 hashing algorithm"
        },
        {
          "label": "SHA512",
          "value": "Sha512",
          "description": "SHA-512 hashing algorithm"
        }
      ]
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "HashedText",
      "label": "Hashed Text",
      "description": "The hashed text",
      "defaultValue": {
        "value": "HashedText",
        "enabled": true
      },
      "required": false
    }
  ]
}

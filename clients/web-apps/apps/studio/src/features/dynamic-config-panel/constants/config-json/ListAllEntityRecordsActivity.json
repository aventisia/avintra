{
  "name": "ListAllEntityRecords",
  "label": "List All Entity Records",
  "description": "Lists all records for a specified entity using SAP OData services.",
  "version": "1.0.0",
  "auther": "@aventisia",
  "supportedPlatforms": ["cloud", "windows"],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "text",
      "name": "ConnectionUrl",
      "label": "Connection URL",
      "description": "The base URL of the SAP OData service endpoint.",
      "defaultValue": "https://your-sap-server/sap/opu/odata/sap/",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "EntitySetName",
      "label": "Entity Set Name",
      "description": "The name of the OData entity set to list (e.g., \u0027SalesOrder\u0027).",
      "defaultValue": "SalesOrder",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "Username",
      "label": "Username",
      "description": "Username for Basic Authentication (if required).",
      "defaultValue": "",
      "required": false
    },
    {
      "direction": "Input",
      "type": "password",
      "name": "Password",
      "label": "Password",
      "description": "Password for Basic Authentication (if required).",
      "defaultValue": "",
      "required": false
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "BearerToken",
      "label": "Bearer Token",
      "description": "Bearer token for OAuth2 authentication (if required).",
      "defaultValue": "",
      "required": false
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "QueryParameters",
      "label": "Query Parameters",
      "description": "Optional OData query parameters (e.g., $top=10\u0026$filter=Status eq \u0027Active\u0027).",
      "defaultValue": "",
      "required": false
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "Response",
      "label": "Response",
      "description": "The list of records returned as JSON array from the OData server.",
      "defaultValue": {
        "value": "Response",
        "enabled": true
      },
      "required": false
    }
  ]
}

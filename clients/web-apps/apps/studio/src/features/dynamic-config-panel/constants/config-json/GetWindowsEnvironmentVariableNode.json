{
  "name": "GetWindowsEnvironmentVariableNode",
  "label": "Get windows environment variable",
  "description": "Retrieves the value of an environment variable.",
  "version": "1.0.0",
  "author": "@aventisia",
  "supportedPlatforms": ["windows"],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "select",
      "name": "EnvironmentVariableName",
      "label": "Environment variable name",
      "description": "The name of the environment variable to retrieve.",
      "defaultValue": "USERNAME",
      "required": true,
      "selectOptions": [
        {
          "label": "Number of Processors",
          "value": "NUMBER_OF_PROCESSORS",
          "description": "Number of Processors"
        },
        {
          "label": "Operating System",
          "value": "OS",
          "description": "Operating System"
        },
        {
          "label": "Path",
          "value": "PATH",
          "description": "System Path"
        },
        {
          "label": "Path Extensions",
          "value": "PATHEXT",
          "description": "Path Extensions"
        },
        {
          "label": "Processor Architecture",
          "value": "PROCESSOR_ARCHITECTURE",
          "description": "Processor Architecture"
        },
        {
          "label": "Processor Identifier",
          "value": "PROCESSOR_IDENTIFIER",
          "description": "Processor Identifier"
        },
        {
          "label": "Processor Level",
          "value": "PROCESSOR_LEVEL",
          "description": "Processor Level"
        },
        {
          "label": "Processor Revision",
          "value": "PROCESSOR_REVISION",
          "description": "Processor Revision"
        },
        {
          "label": "PowerShell Module Path",
          "value": "PSMODULEPATH",
          "description": "PowerShell Module Path"
        },
        {
          "label": "Temporary Directory",
          "value": "TEMP",
          "description": "Temporary Directory"
        },
        {
          "label": "TMP Directory",
          "value": "TMP",
          "description": "TMP Directory"
        },
        {
          "label": "Username",
          "value": "USERNAME",
          "description": "Current User\u0027s Username"
        },
        {
          "label": "Windows Directory",
          "value": "WINDIR",
          "description": "Windows Directory"
        },
        {
          "label": "ZES Enable Sysman",
          "value": "ZES_ENABLE_SYSMAN",
          "description": "ZES Enable Sysman"
        },
        {
          "label": "Unknown",
          "value": "None",
          "description": "Unknown Environment Variable"
        },
        {
          "label": "OneDrive",
          "value": "OneDrive",
          "description": "OneDrive environment variable"
        },
        {
          "label": "OneDrive Commercial",
          "value": "OneDriveCommercial",
          "description": "OneDrive Commercial environment variable"
        },
        {
          "label": "OneDrive Consumer",
          "value": "OneDriveConsumer",
          "description": "OneDrive Consumer environment variable"
        }
      ]
    },
    {
      "direction": "Input",
      "type": "switch",
      "name": "SearchForVariableOnlyInScope",
      "label": "Search for variable only in scope",
      "description": "Indicates whether to search for the variable only within the specified scope.",
      "defaultValue": false,
      "required": false
    },
    {
      "direction": "Input",
      "type": "select",
      "name": "Scope",
      "label": "Scope",
      "description": "Specifies the scope (User or System) to search for the environment variable.",
      "defaultValue": "User",
      "required": false,
      "selectOptions": [
        {
          "label": "User",
          "value": "User",
          "description": "Environment variables specific to the current user."
        },
        {
          "label": "System",
          "value": "System",
          "description": "Environment variables for the entire system (machine-level)."
        }
      ],
      "renderIf": {
        "conditions": [
          {
            "field": "SearchForVariableOnlyInScope",
            "equals": true
          }
        ]
      }
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "EnvironmentVariableValue",
      "label": "Environment Variable Value",
      "description": "The retrieved value of the environment variable.",
      "defaultValue": {
        "value": "EnvironmentVariableValue",
        "enabled": true
      },
      "required": false
    }
  ]
}

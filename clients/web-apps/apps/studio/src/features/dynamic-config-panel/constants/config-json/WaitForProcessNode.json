{
  "name": "WaitForProcessNode",
  "label": "Wait For Process",
  "description": "Waits for a specific process to start or stop.",
  "version": "1.0.0",
  "author": "@aventisia",
  "supportedPlatforms": ["windows"],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "select",
      "name": "ProcessName",
      "label": "Process Name",
      "description": "The name of the process to monitor.",
      "defaultValue": "",
      "required": true,
      "selectOptions": [
        {
          "label": "Aggregator Host",
          "value": "AggregatorHost",
          "description": "Aggregator Host service."
        },
        {
          "label": "Application Message Forwarder",
          "value": "ApMsgFwd",
          "description": "Forwards application messages."
        },
        {
          "label": "AP Notification Executor",
          "value": "ApntEx",
          "description": "Executes AP notifications."
        },
        {
          "label": "Apoint Service",
          "value": "Apoint",
          "description": "Apoint background service."
        },
        {
          "label": "Generic Application",
          "value": "App",
          "description": "Standard application process."
        },
        {
          "label": "Remote AP Service",
          "value": "ApRemote",
          "description": "Remote access AP service."
        },
        {
          "label": "Windows Audio Device Graph Isolation",
          "value": "Audiodg",
          "description": "Manages audio isolation."
        },
        {
          "label": "Google Chrome Browser",
          "value": "Chrome",
          "description": "Google Chrome browser instance."
        },
        {
          "label": "Copilot Language Server",
          "value": "CopilotLanguageServer",
          "description": "Language server for Copilot integration."
        },
        {
          "label": "Client/Server Runtime Subsystem",
          "value": "Csrss",
          "description": "Core Windows subsystem process."
        },
        {
          "label": "Input Method Editor",
          "value": "Ctfmon",
          "description": "IME support for input methods."
        },
        {
          "label": "Device Association Service Host",
          "value": "DasHost",
          "description": "Handles device associations."
        },
        {
          "label": "Visual Studio Development Environment",
          "value": "Devenv",
          "description": "Visual Studio IDE process."
        },
        {
          "label": "COM Surrogate",
          "value": "Dllhost",
          "description": "Runs COM objects outside of host process."
        },
        {
          "label": "File Co-Authoring Service",
          "value": "FileCoAuth",
          "description": "Supports real-time document co-editing."
        },
        {
          "label": "Font Driver Host",
          "value": "Fontdrvhost",
          "description": "Manages font drivers."
        },
        {
          "label": "Human Interface Device Monitor",
          "value": "HidMonitorSvc",
          "description": "Monitors HID devices."
        },
        {
          "label": "Intel Bluetooth Service",
          "value": "IbtSiva",
          "description": "Intel Bluetooth support service."
        },
        {
          "label": "Idle Process",
          "value": "Idle",
          "description": "Represents idle CPU time."
        },
        {
          "label": "Intel Content Protection Service",
          "value": "IntelCpHDCPSvc",
          "description": "Manages Intel HDCP content protection."
        }
      ]
    },
    {
      "direction": "Input",
      "type": "switch",
      "name": "FromUser",
      "label": "From User",
      "description": "Indicates whether the process should be triggered by a specific user.",
      "defaultValue": false,
      "required": false
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "UserName",
      "label": "User Name",
      "description": "The name of the user associated with the process.",
      "defaultValue": "",
      "required": false,
      "renderIf": {
        "conditions": [
          {
            "field": "FromUser",
            "equals": true
          }
        ]
      }
    },
    {
      "direction": "Input",
      "type": "select",
      "name": "WaitForProcessTo",
      "label": "Wait For Process To",
      "description": "Specifies whether to wait for the process to start or stop.",
      "defaultValue": "Start",
      "required": false,
      "selectOptions": [
        {
          "label": "Start",
          "value": "Start",
          "description": "Waits for the process to start."
        },
        {
          "label": "Stop",
          "value": "Stop",
          "description": "Waits for the process to stop."
        }
      ]
    },
    {
      "direction": "Input",
      "type": "switch",
      "name": "FailWithTimeoutError",
      "label": "Fail With Timeout Error",
      "description": "Indicates whether the activity should fail if the timeout is reached.",
      "defaultValue": false,
      "required": false
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "Duration",
      "label": "Duration (Seconds)",
      "description": "The maximum time in seconds to wait for the process condition.",
      "defaultValue": 60,
      "required": false,
      "renderIf": {
        "conditions": [
          {
            "field": "FailWithTimeoutError",
            "equals": true
          }
        ]
      }
    }
  ]
}

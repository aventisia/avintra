{
  "name": "ClickDownloadLinkNode",
  "label": "Click Download Link on Web Page",
  "description": "Simulates clicking a download link on a web page and saves the file to the specified folder.",
  "version": "1.0.0",
  "author": "@aventisia",
  "supportedPlatforms": ["windows"],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "text",
      "name": "WebBrowserInstance",
      "label": "Web Browser Instance",
      "description": "Enter or choose the variable that contains the web browser instance to work with.",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "select",
      "name": "FindType",
      "label": "Find Type",
      "description": "Specifies how to find the element (e.g., ID, XPath, CssSelector).",
      "defaultValue": "XPath",
      "required": false,
      "selectOptions": [
        {
          "label": "XPath",
          "value": "XPath",
          "description": "Find by XPath expression"
        },
        {
          "label": "Id",
          "value": "Id",
          "description": "Find by HTML ID attribute"
        },
        {
          "label": "Css Selector",
          "value": "CssSelector",
          "description": "Find by CSS selector"
        },
        {
          "label": "Name",
          "value": "Name",
          "description": "Find by HTML name attribute"
        },
        {
          "label": "Class Name",
          "value": "ClassName",
          "description": "Find by HTML class name"
        },
        {
          "label": "Tag Name",
          "value": "TagName",
          "description": "Find by HTML tag name"
        },
        {
          "label": "Link Text",
          "value": "LinkText",
          "description": "Find by link text (exact match)"
        },
        {
          "label": "Partial Link Text",
          "value": "PartialLinkText",
          "description": "Find by partial link text"
        },
        {
          "label": "Inner Text",
          "value": "InnerText",
          "description": "Find by element\u0027s inner text"
        },
        {
          "label": "Title",
          "value": "Title",
          "description": "Find by element\u0027s title attribute"
        },
        {
          "label": "Value",
          "value": "Value",
          "description": "Find by element\u0027s value attribute"
        },
        {
          "label": "Placeholder",
          "value": "Placeholder",
          "description": "Find by element\u0027s placeholder attribute"
        },
        {
          "label": "Type",
          "value": "Type",
          "description": "Find by element\u0027s type attribute"
        },
        {
          "label": "Data Test Id",
          "value": "DataTestId",
          "description": "Find by element\u0027s data-testid attribute"
        },
        {
          "label": "Aria Label",
          "value": "AriaLabel",
          "description": "Find by element\u0027s aria-label attribute"
        },
        {
          "label": "Role",
          "value": "Role",
          "description": "Find by element\u0027s role attribute"
        },
        {
          "label": "JavaScript",
          "value": "JavaScript",
          "description": "Find by JavaScript expression"
        },
        {
          "label": "Sizzle",
          "value": "Sizzle",
          "description": "Find by Sizzle selector (jQuery-style)"
        },
        {
          "label": "Relative",
          "value": "Relative",
          "description": "Find by relative position to another element"
        },
        {
          "label": "Automation Id",
          "value": "AutomationId",
          "description": "Find by element\u0027s automation ID (for WPF/UWP apps)"
        }
      ]
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "ValueToFind",
      "label": "Value To Find",
      "description": "The selector (XPath, ID, etc.) used to locate the download link on the page.",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "DestinationFolder",
      "label": "Destination Folder",
      "description": "The full path of the folder where the downloaded file will be saved.",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "switch",
      "name": "WaitForDownload",
      "label": "Wait for File to Download",
      "description": "If true, waits until the file appears in the destination folder.",
      "defaultValue": false,
      "required": false
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "MaxWaitTime",
      "label": "Maximum Wait Time (Seconds)",
      "description": "The maximum time to wait for the file to appear in the destination folder.",
      "defaultValue": 30,
      "required": false,
      "renderIf": {
        "conditions": [
          {
            "field": "WaitForDownload",
            "equals": true
          }
        ]
      }
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "DownloadedFile",
      "label": "Downloaded File Output",
      "description": "Returns the full path of the downloaded file.",
      "defaultValue": {
        "value": "DownloadedFile",
        "enabled": true
      },
      "required": false
    }
  ]
}

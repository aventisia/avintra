{
  "name": "FormatDateTimeNode",
  "label": "Format DateTime",
  "description": "Formats a DateTime value into a standard or custom string format.",
  "version": "1.0.0",
  "author": "@aventisia",
  "supportedPlatforms": ["cloud", "windows"],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "text",
      "name": "DatetimeToConvert",
      "label": "DateTime Value",
      "description": "The DateTime value to format.",
      "defaultValue": "",
      "required": false
    },
    {
      "direction": "Input",
      "type": "select",
      "name": "FormatToUse",
      "label": "Format Option",
      "description": "Choose whether to use a standard or custom DateTime format.",
      "defaultValue": "Standard",
      "required": false,
      "selectOptions": [
        {
          "label": "Standard",
          "value": "Standard",
          "description": ""
        },
        {
          "label": "Custom",
          "value": "Custom",
          "description": ""
        }
      ]
    },
    {
      "direction": "Input",
      "type": "select",
      "name": "StandardFormat",
      "label": "Standard Format",
      "description": "The standard DateTime format to use. Examples use US English; other regional settings may format differently.",
      "defaultValue": "ShortDate",
      "required": false,
      "selectOptions": [
        {
          "label": "Short date",
          "value": "ShortDate",
          "description": "e.g. 11/3/2026 (US English)"
        },
        {
          "label": "Long date",
          "value": "LongDate",
          "description": "e.g. Tuesday, November 3, 2026 (US English)"
        },
        {
          "label": "Short time",
          "value": "ShortTime",
          "description": "e.g. 3:45 PM (US English)"
        },
        {
          "label": "Long time",
          "value": "LongTime",
          "description": "e.g. 3:45:30 PM (US English)"
        },
        {
          "label": "Full date and time",
          "value": "FullDatetimeLongTime",
          "description": "e.g. Tuesday, 03 November 2026 15:45:30 (fixed layout)"
        },
        {
          "label": "Short date and short time",
          "value": "FullDatetimeShortTime",
          "description": "e.g. 11/3/2026 3:45 PM (US English)"
        },
        {
          "label": "General date, short time",
          "value": "GeneralDatetimeShortTime",
          "description": "e.g. 11/3/2026 3:45 PM (US English)"
        },
        {
          "label": "General date, long time",
          "value": "GeneralDatetimeLongTime",
          "description": "e.g. 11/3/2026 3:45:30 PM (US English)"
        },
        {
          "label": "Sortable (ISO 8601)",
          "value": "SortableDatetime",
          "description": "e.g. 2026-11-03 15:45:30Z (fixed layout)"
        }
      ],
      "renderIf": {
        "conditions": [
          {
            "field": "FormatToUse",
            "equals": "Standard"
          }
        ]
      }
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "CustomFormat",
      "label": "Custom Format String",
      "description": "A custom format pattern. Examples using 3 November 2026, 3:45:30 PM:\n\n- \u0060yyyyMMdd\u0060 \u2192 20261103\n- \u0060yyyy-MM-dd\u0060 \u2192 2026-11-03\n- \u0060dd MMM yyyy\u0060 \u2192 03 Nov 2026\n- \u0060dddd, dd MMMM yyyy\u0060 \u2192 Tuesday, 03 November 2026\n- \u0060MM/dd/yyyy hh:mm tt\u0060 \u2192 11/03/2026 03:45 PM\n- \u0060HH:mm:ss\u0060 \u2192 15:45:30\n\nSpecifiers: \u0060yyyy\u0060 year, \u0060MM\u0060 month, \u0060MMM\u0060 short month, \u0060dd\u0060 day, \u0060ddd\u0060 short weekday, \u0060dddd\u0060 weekday, \u0060HH\u0060 24-hour, \u0060hh\u0060 12-hour, \u0060mm\u0060 minute, \u0060ss\u0060 second, \u0060tt\u0060 AM/PM.",
      "defaultValue": "",
      "required": false,
      "renderIf": {
        "conditions": [
          {
            "field": "FormatToUse",
            "equals": "Custom"
          }
        ]
      }
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "FormattedDateTime",
      "label": "Formatted DateTime String",
      "description": "The formatted DateTime as a string.",
      "defaultValue": {
        "value": "FormattedDateTime",
        "enabled": true
      },
      "required": false
    }
  ]
}

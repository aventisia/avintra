{
  "name": "GetAllServiceNowUsers",
  "label": "Get All ServiceNow Users",
  "description": "Retrieves multiple users from ServiceNow using a stored credential. Supports pagination.",
  "version": "1.0.0",
  "auther": "@aventisia",
  "supportedPlatforms": ["cloud", "windows"],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "text",
      "name": "CredentialId",
      "label": "Credential",
      "description": "The stored ServiceNow credential (Bearer token)",
      "defaultValue": "",
      "required": false
    },
    {
      "direction": "Input",
      "type": "switch",
      "name": "ReturnAll",
      "label": "Return All",
      "description": "If enabled, retrieves all users across all pages. If disabled, only returns up to \u0027Limit\u0027 records.",
      "defaultValue": "",
      "required": false
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "Limit",
      "label": "Limit",
      "description": "Maximum number of users to retrieve per request (used when Return All is off). Max: 1000.",
      "defaultValue": 50,
      "required": false,
      "renderIf": {
        "conditions": [
          {
            "field": "ReturnAll",
            "equals": "false"
          }
        ]
      }
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "Options",
      "label": "Options",
      "description": "Query parameters (e.g., active=true, sysparm_fields=user_name,short_description,email)",
      "defaultValue": "",
      "required": false
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "Subdomain",
      "label": "ServiceNow Subdomain",
      "description": "Your ServiceNow instance subdomain (e.g., \u0027dev12345\u0027)",
      "defaultValue": "",
      "required": false
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "Response",
      "label": "API Response",
      "description": "Raw JSON response from the last page (or first if error)",
      "defaultValue": {
        "value": "Response",
        "enabled": true
      },
      "required": false
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "Users",
      "label": "Users",
      "description": "List of retrieved users as JObject array",
      "defaultValue": {
        "value": "Users",
        "enabled": true
      },
      "required": false
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "TotalCount",
      "label": "Total Count",
      "description": "Total number of users retrieved",
      "defaultValue": {
        "value": "TotalCount",
        "enabled": true
      },
      "required": false
    }
  ]
}

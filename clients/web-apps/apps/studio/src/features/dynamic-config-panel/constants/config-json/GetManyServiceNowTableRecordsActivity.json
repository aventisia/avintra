{
  "name": "GetManyServiceNowTableRecords",
  "label": "Get Many ServiceNow Table Records",
  "description": "Retrieves multiple records from a ServiceNow table using only the provided Credential ID or token. Supports pagination.",
  "version": "1.0.0",
  "auther": "@aventisia",
  "supportedPlatforms": ["cloud", "windows"],
  "errorHandling": "standard",
  "testScreenType": "standard",
  "fields": [
    {
      "direction": "Input",
      "type": "text",
      "name": "InstanceUrl",
      "label": "Instance URL",
      "description": "Full ServiceNow instance URL (e.g., https://dev12345.service-now.com).",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "CredentialId",
      "label": "Credential / Token",
      "description": "For BasicAuth \u2192 provide Base64(username:password). For OAuth2 \u2192 provide Bearer token.",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "TableName",
      "label": "Table Name",
      "description": "Name of the ServiceNow table (e.g., incident, change_request, problem).",
      "defaultValue": "",
      "required": true
    },
    {
      "direction": "Input",
      "type": "switch",
      "name": "ReturnAll",
      "label": "Return All",
      "description": "If true, retrieves all records across pages. If false, only returns up to \u0027Limit\u0027 records.",
      "defaultValue": "",
      "required": false
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "Limit",
      "label": "Limit",
      "description": "Max number of records to retrieve when Return All = false. Max: 1000.",
      "defaultValue": 50,
      "required": false,
      "renderIf": {
        "conditions": [
          {
            "field": "ReturnAll",
            "equals": "false"
          }
        ]
      }
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "Options",
      "label": "Options",
      "description": "Query parameters (e.g., state=1^active=true or sysparm_fields=number,short_description).",
      "defaultValue": "",
      "required": false
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "Response",
      "label": "API Response",
      "description": "Raw JSON response from ServiceNow API.",
      "defaultValue": {
        "value": "Response",
        "enabled": true
      },
      "required": false
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "Records",
      "label": "Records",
      "description": "Array of retrieved records.",
      "defaultValue": {
        "value": "Records",
        "enabled": true
      },
      "required": false
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "TotalCount",
      "label": "Total Count",
      "description": "Number of retrieved records.",
      "defaultValue": {
        "value": "TotalCount",
        "enabled": true
      },
      "required": false
    }
  ]
}

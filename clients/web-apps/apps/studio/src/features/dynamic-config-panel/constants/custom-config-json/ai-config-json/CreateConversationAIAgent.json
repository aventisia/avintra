{
  "name": "CreateConversationAIAgent",
  "label": "Chat AI",
  "description": "Chat AI.",
  "version": "1.0.0",
  "auther": "@aventisia",
  "supportedPlatforms": ["cloud", "desktop"],
  "errorHandling": "none",
  "testScreenType": "none",
  "fields": [
    {
      "direction": "Input",
      "type": "prompt-input-v2",
      "name": "__Prompt__Conversation",
      "required": false,
      "min": 16,
      "defaultValue": "",
      "showTokenCount": false,
      "showVariables": false,
      "category": "System Prompt"
    },
    {
      "direction": "Input",
      "type": "model-config-select",
      "name": "__ModelConfig__Conversation",
      "defaultValue": {
        "is_byok_enabled": false,
        "provider": "openai",
        "credential_name": "",
        "model": "gpt-4o-mini",
        "temperature": 1,
        "top_p": 1,
        "max_output_tokens": null,
        "reasoning_effort": "medium"
      },
      "required": false,
      "showJsonOutput": false,
      "category": "Model"
    },
    {
      "direction": "Input",
      "type": "model-config-select",
      "name": "__ModelConfig__SpeechToText",
      "defaultValue": {
        "is_byok_enabled": true,
        "provider": "elevenlabs",
        "credential_name": "",
        "model": "",
        "temperature": 1,
        "top_p": 1,
        "max_output_tokens": null
      },
      "required": false,
      "showJsonOutput": false,
      "hideByok": true,
      "specialty": "stt",
      "category": "Voice"
    },
    {
      "direction": "Input",
      "type": "model-config-select",
      "name": "__ModelConfig__TextToSpeech",
      "defaultValue": {
        "is_byok_enabled": true,
        "provider": "elevenlabs",
        "credential_name": "",
        "model": "",
        "temperature": 1,
        "top_p": 1,
        "max_output_tokens": null
      },
      "required": false,
      "showJsonOutput": false,
      "hideByok": true,
      "specialty": "tts",
      "category": "Voice"
    },
    {
      "direction": "Input",
      "type": "voice-config-select",
      "name": "__VoiceConfig__TextToSpeech",
      "defaultValue": {
        "language": "en",
        "voice": "",
        "speed": 1
      },
      "required": false,
      "category": "Voice"
    },
    {
      "direction": "Input",
      "type": "knowledge-base-config",
      "name": "__KbConfig__Conversation",
      "label": "Knowledge Base(s)",
      "defaultValue": {
        "knowledgeBase": [],
        "sourceThreshold": 0.1,
        "numberOfChunks": 5
      },
      "required": false,
      "category": "Context"
    },
    {
      "direction": "Input",
      "type": "skills-config",
      "name": "__SkillsConfig__Conversation",
      "label": "Skill(s)",
      "defaultValue": {
        "skills": []
      },
      "required": false,
      "category": "Context"
    },
    {
      "direction": "Input",
      "type": "memory-config",
      "name": "__MemoryConfig__Conversation",
      "defaultValue": {
        "memoryProvider": "Memory Provider 1",
        "maxDataStored": 20
      },
      "required": false,
      "category": "Context"
    },
    {
      "direction": "Input",
      "type": "tools-config-select",
      "name": "__ToolsConfig__Conversation",
      "defaultValue": [],
      "category": "Tools"
    },
    {
      "direction": "Input",
      "type": "suggestions",
      "name": "__RecommendedActionsConfig__Conversation",
      "description": "Add suggestions for the initial chat start",
      "defaultValue": {
        "defaultActions": [],
        "enableDynamicActions": false,
        "followUpMessagePrompt": "You are a helpful AI assistant.\n\nReturn only valid JSON that matches the provided schema.\n\nRules:\n- Put the complete response in the \"text\" field.\n- Any question, clarification request, or information request for the user must appear only in the \"text\" field.\n- The \"followup_messages\" field is only for standalone actions the user can take without replying to the assistant.\n- Never include questions, follow-ups, or prompts in \"followup_messages\".\n- If the user must provide additional information to continue, \"followup_messages\" must be an empty array ([]).\n- Include at most 5 recommended actions.\n- Recommended actions should use clear, natural, user-facing language.\n- Do not include code, IDs, internal references, or technical jargon in recommended actions.\n- Return only JSON with no additional text or markdown."
      },
      "required": false,
      "category": "Other"
    }
  ]
}

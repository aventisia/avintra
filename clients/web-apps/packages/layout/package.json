  "devDependencies": {
    "@avplatform/eslint-config": "*",
    "@avplatform/tailwind-config": "*",
    "@avplatform/typescript-config": "*",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",

# Template for /opt/avintra/env/shared.env, loaded by all five backend containers (Compose `env_file`).
# Copy to /opt/avintra/env/shared.env, replace every CHANGE_ME, mode 600, owned by `deploy`. Never commit the real file.
# Copy the existing values from the bare-metal units on a server that already has data.

# Public host name without https://. Also builds the OAuth callback https://<APP_BASE_URL>/accounts/sso-redirect.
APP_BASE_URL=CHANGE_ME

# Bundled database (profile db in /opt/avintra/.env): postgres. External: the server IP or remote database host, never
# localhost or 127.x (inside a container that is the container itself).
POSTGRESQL_HOST=CHANGE_ME
POSTGRESQL_PORT=5432
POSTGRESQL_USERNAME=CHANGE_ME
POSTGRESQL_PASSWORD=CHANGE_ME

# Identical for Accounts, Workspace, Global Admin and LLM Pipeline.
# New server only: openssl rand -base64 64 | tr -d '\n'. Never regenerate on a server that has data.
JWT_SECRET_KEY=CHANGE_ME

# Compose service names. The one place service URLs live; the .NET services and LLM Pipeline read them.
ACCOUNTS_API_BASE_URL=http://accounts-api:4000
WORKSPACE_API_BASE_URL=http://workspace-api:4001
LLMPIPELINE_API_BASE_URL=http://llmpipeline-api:4003
CORSAIR_API_BASE_URL=http://corsair-api:4006

# Template for /opt/avintra/env/global-admin-api.env (read after shared.env); the file must exist, even empty.
# Global Admin needs only the database and JWT values from shared.env, so nothing is required here.

# Optional: uncomment only what the bare-metal Global Admin service sets today.
# ';'-separated origins with https://, for example the Global Admin site's own host.
# EXTRA_CORS_ORIGINS=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_MAIL_FROM_NAME=
# SMTP_MAIL_FROM_ADDRESS=

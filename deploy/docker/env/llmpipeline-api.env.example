# Template for /opt/avintra/env/llmpipeline-api.env (read after shared.env). Replace every CHANGE_ME; mode 600.
# Accounts and Workspace are reached through the *_BASE_URL values in shared.env.
# Do not add LIVEKIT_*: Compose sets them from /opt/avintra/.env.

# Required: without them chat answers "AI model isn't configured".
OPENAI_API_KEY=CHANGE_ME
OPENROUTER_API_KEY=CHANGE_ME

# Required on a Commercial/Enterprise deployment: the same pair as in accounts-api.env. When either is blank the AI endpoints answer 403.
ON_PREM_TENANT_ID=CHANGE_ME
ON_PREM_INSTANCE_KEY=CHANGE_ME

# Required for knowledge bases: the real Qdrant URL and key.
QDRANT_URL=CHANGE_ME
QDRANT_API_KEY=CHANGE_ME

# Optional: uncomment only what the bare-metal LLM Pipeline sets today.
# DEEPINFRA_API_KEY=
# GEMINI_API_KEY=
# CLAUDE_API_KEY=
# OLLAMA_API_KEY=
# ELEVENLABS_API_KEY=

# Template for /opt/avintra/env/workspace-api.env (read after shared.env). Replace every CHANGE_ME; mode 600.
# The same required values as accounts-api.env; the AES pair must match Accounts exactly.

ON_PREM_ADMIN_EMAIL=CHANGE_ME
AES_ENCRYPTION_KEY=CHANGE_ME
AES_INITIALIZATION_VECTOR=CHANGE_ME
AZURE_BLOB_STORAGE_CONNECTION_STRING=CHANGE_ME

# Optional: uncomment only what the bare-metal Workspace service sets today.
# ON_PREM_TENANT_ID=
# ON_PREM_INSTANCE_KEY=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_MAIL_FROM_NAME=
# SMTP_MAIL_FROM_ADDRESS=
# EXTRA_CORS_ORIGINS=
# EXTRA_ALLOWED_HOSTS=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# DEEPINFRA_API_KEY=
# OPENROUTER_API_KEY=
# RAZORPAY_ENABLED=true
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

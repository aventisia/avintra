# Template for /opt/avintra/env/accounts-api.env (read after shared.env). Replace every CHANGE_ME; mode 600.

ON_PREM_ADMIN_EMAIL=CHANGE_ME
# New server only: openssl rand -base64 32 / openssl rand -base64 16. Copy the existing pair if the database has data.
AES_ENCRYPTION_KEY=CHANGE_ME
AES_INITIALIZATION_VECTOR=CHANGE_ME
AZURE_BLOB_STORAGE_CONNECTION_STRING=CHANGE_ME

# Optional: uncomment only what the bare-metal Accounts service sets today.
# Commercial/Enterprise edition: set both (and the same pair in workspace-api.env and llmpipeline-api.env). Leave both unset for Community.
# ON_PREM_TENANT_ID=
# ON_PREM_INSTANCE_KEY=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_MAIL_FROM_NAME=
# SMTP_MAIL_FROM_ADDRESS=
# ';'-separated origins with https://, for example a separate Global Admin host.
# EXTRA_CORS_ORIGINS=
# ';'-separated host names; the hosts of the *_BASE_URL values are already allowed.
# EXTRA_ALLOWED_HOSTS=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# MICROSOFT_SSO_ENABLED=true
# MICROSOFT_SSO_CLIENT_ID=
# MICROSOFT_SSO_CLIENT_SECRET=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# DEEPINFRA_API_KEY=
# OPENROUTER_API_KEY=

# Template for /opt/avintra/env/corsair-api.env (read after shared.env). Replace CHANGE_ME; mode 600.
# The database, APP_BASE_URL and Workspace URL come from shared.env.

# Copy the bare-metal value (/home/admin/corsair/.env.local); stored vault credentials need it.
# New server only: openssl rand -hex 32
CORSAIR_KEK=CHANGE_ME

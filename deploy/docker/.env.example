# Template for /opt/avintra/.env, which fills the ${...} values in compose.yml. Containers never see this file.
DOCKERHUB_NS=aventisia
# deploy.sh rewrites this line after every successful deploy; any sha- value works before the first one.
AVINTRA_TAG=sha-0000000
ASPNETCORE_ENVIRONMENT=Production
# Browser URL of the bundled LiveKit through the host nginx: wss://<host>/livekit
LIVEKIT_WS_URL=
# docker run --rm livekit/livekit-server:v1.13.11 generate-keys
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

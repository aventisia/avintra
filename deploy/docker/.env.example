# Template for /opt/avintra/.env, which fills the ${...} values in compose.yml. Containers never see this file.
DOCKERHUB_NS=aventisia
# uat- on UAT (images built from the uat branch), empty on production.
AVINTRA_TAG_PREFIX=
# deploy.sh rewrites this line after every successful deploy; any value works before the first one.
AVINTRA_TAG=sha-0000000
ASPNETCORE_ENVIRONMENT=Production
# Browser URL of the bundled LiveKit through the host nginx: wss://<host>/livekit
LIVEKIT_WS_URL=
# docker run --rm livekit/livekit-server:v1.13.11 generate-keys
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Bundled database: set COMPOSE_PROFILES=db and give the same username and password as env/shared.env,
# with POSTGRESQL_HOST=postgres there. Leave all three blank to use an external Postgres.
COMPOSE_PROFILES=
POSTGRESQL_USERNAME=
POSTGRESQL_PASSWORD=

server
{
	listen 80;
	server_name ${APP_BASE_URL} uat-${APP_BASE_URL};
	return 301 https://$host$request_uri;
}

server
{
	listen 443 ssl;
	http2 on;
	server_name ${APP_BASE_URL} uat-${APP_BASE_URL};
	
	# Include common config
	include /etc/nginx/conf.d/common_ssl.conf;
	include /etc/nginx/conf.d/common_headers.conf;

	# Custom error pages
	error_page 404 /404.html;
	error_page 502 /502.html;
	
	location ~ ^/(404|502)\.html$ {
		root /usr/share/nginx/html;
		internal;
	}

    # NOTE: Order of location blocks matters. Keep api locations before client locations.

	# ----------------- /accounts -----------------
	# ----------------- /files/binaries (public binary downloads) -----------------
	location /files/binaries/ {
		proxy_pass http://accounts-apis:4000/api/binaries/;
		include /etc/nginx/conf.d/common_api_config.conf;
	}

	location ~ ^/accounts/api/(auth|me) {
		gzip off;
		rewrite ^/accounts/api/(.*)$ /api/$1 break; # Strip /accounts/ from the start of the URI
		proxy_pass http://accounts-apis:4000;
		include /etc/nginx/conf.d/common_api_config.conf;
	}

	location /accounts/api/ {
		proxy_pass http://accounts-apis:4000/api/;
		include /etc/nginx/conf.d/common_api_config.conf;
	}

	location /accounts/ {
		alias /usr/share/nginx/html/accounts/;
    	try_files $uri $uri.html $uri/ /index.html =404;
	}

	# ----------------- /studio -----------------
	location /studio/ {
		alias /usr/share/nginx/html/studio/;
		try_files $uri $uri.html $uri/ /index.html =404;
	}

	# ----------------- /llmpipeline -----------------
	location /llmpipeline/api/ {
		proxy_pass http://llmpipeline-apis:4003/api/;
		include /etc/nginx/conf.d/common_api_config.conf;
	}

	# ----------------- /apache-camel -----------------
	location /apache-camel/api/ {
		proxy_pass http://camel-apis:4005/api/;
		include /etc/nginx/conf.d/common_api_config.conf;
	}

	# ----------------- /workspace -----------------
	location ~ ^/workspace/api/(vault-credential) {
        gzip off;
		rewrite ^/workspace/api/(.*)$ /api/$1 break; # Strip /workspace/ from the start of the URI
		proxy_pass http://workspace-apis:4001;
		include /etc/nginx/conf.d/common_api_config.conf;
    }

	location /workspace/api/ {
		proxy_pass http://workspace-apis:4001/api/;
		include /etc/nginx/conf.d/common_api_config.conf;
	}

	location /workspace/ {
		alias /usr/share/nginx/html/workspace/;
		try_files $uri $uri.html $uri/ /index.html =404;
	}

	# ----------------- /globaladmin -----------------
	location /globaladmin/api/ {
		proxy_pass http://globaladmin-apis:4004/api/;
		include /etc/nginx/conf.d/common_api_config.conf;
	}

	location /globaladmin/ {
		alias /usr/share/nginx/html/globaladmin/;
		try_files $uri $uri.html $uri/ /globaladmin/index.html =404;
	}

	# IMPORTANT NOTE: temporary rollout support for the old /global-admin paths; remove once clients have moved.
	location /global-admin/api/ {
		proxy_pass http://globaladmin-apis:4004/api/;
		include /etc/nginx/conf.d/common_api_config.conf;
	}

	location /global-admin/ {
		rewrite ^/global-admin(.*)$ /globaladmin$1 redirect;
	}

	# ----------------- Static files / downloads -----------------
	location /files/ {
		alias /var/www/aventisia.com/files/;
		# Large self-contained runner zips may take time on slower connections.
		send_timeout 300s;
		client_body_timeout 300s;
		# Disable gzip for binary downloads; the zip is already compressed.
		gzip off;
		# Allow byte-range requests for resumable downloads.
		add_header Accept-Ranges bytes;
	}

	# ----------------- Default -----------------
	location = / {
		return 301 /accounts/;
	}
}
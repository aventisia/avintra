meta {
  name: Update subscription plan
  type: http
  seq: 5
}

put {
  url: {{ACCOUNTS_APIS_BASE_URL}}/subscription-plans
  body: json
  auth: none
}

body:json {
  {
    "id":"{{SUBSCRIPTION_PLAN_ID}}",
    "name": "Pro-20",
    "monthlyPrice": 20,
    "yearlyPrice": 100,
    "maxCredits": "2500",
    "maxPublishedItems": "15",
    "historyRetentionDays": "7",
    "maxSpaces": "10",
    "storageLimitMB": "200",
    "maxUsers": "15",
    "isDisabled": false
  }
  
}

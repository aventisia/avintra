meta {
  name: Insert subscription plan
  type: http
  seq: 2
}

post {
  url: {{ACCOUNTS_APIS_BASE_URL}}/subscription-plans
  body: json
  auth: none
}

body:json {
  {
    "name": "Pro-20",
    "monthlyPrice": 20,
    "yearlyPrice": 100,
    "maxCredits": "2500",
    "maxPublishedItems": "15",
    "historyRetentionDays": "7",
    "maxSpaces": "10",
    "storageLimitMB": "200",
    "maxUsers": "15"
  }
  
}

script:post-response {
  if(res.getStatus() == 200)
  {
    bru.setGlobalEnvVar("SUBSCRIPTION_PLAN_ID", res.getBody().data.id);
  }
}

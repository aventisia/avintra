meta {
  name: Delete multiple license credits
  type: http
  seq: 8
}

post {
  url: {{ACCOUNTS_APIS_BASE_URL}}/license-credit/delete-multiple
  body: none
  auth: none
}

script:pre-request {
  // Set licenseCreditIds in request body
  req.setBody(
    JSON.parse(`["${bru.getGlobalEnvVar("LICENSE_CREDIT_ID")}"]`)
  )
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
        "LICENSE_CREDIT_ID", 
        "00000000-0000-0000-0000-000000000000"
      );
  }
}

meta {
  name: Delete license credit
  type: http
  seq: 6
}

delete {
  url: {{ACCOUNTS_APIS_BASE_URL}}/license-credit/{{LICENSE_CREDIT_ID}}
  body: none
  auth: none
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
        "LICENSE_CREDIT_ID", 
        "00000000-0000-0000-0000-000000000000"
      );
  }
}

meta {
  name: Required - Insert plan
  type: http
  seq: 2
}

post {
  url: {{ACCOUNTS_APIS_BASE_URL}}/plan
  body: none
  auth: none
}

script:pre-request {
  const {faker} = require('@faker-js/faker');
  
  req.setBody(
    {
     //tenantId: bru.getGlobalEnvVar("TENANT_ID"),
     planType: "OnPrem",
     pricingComponent: "AIAgent",
     currency: "USD",
     unitPrice: 350,
     unit: "Credit",
     frequency: "Annually",
     cola : 5
    }
  )
    
}

script:post-response {
  if(res.getStatus() == 200){
    bru.setGlobalEnvVar(
    "PLAN_ID",
    res.getBody().data.id
    );
  }
}

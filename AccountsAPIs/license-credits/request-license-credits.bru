meta {
  name: Request license credits
  type: http
  seq: 2
}

post {
  url: {{ACCOUNTS_APIS_BASE_URL}}/license-credit/request
  body: none
  auth: none
}

script:pre-request {
  const {faker} = require('@faker-js/faker');
  
  req.setBody(
    {
      //tenantId: bru.getGlobalEnvVar("TENANT_ID"),
      planId: bru.getGlobalEnvVar("PLAN_ID"),
      additionalUnitsRequested: 10,
    }
  )
    
}

script:post-response {
  if(res.getStatus() == 200){
    bru.setGlobalEnvVar(
    "LICENSE_CREDIT_ID",
    res.getBody().data.id
    );
  }
}

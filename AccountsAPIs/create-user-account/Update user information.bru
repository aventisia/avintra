meta {
  name: Update user information
  type: http
  seq: 5
}

put {
  url: {{ACCOUNTS_APIS_BASE_URL}}/auth/user-info
  body: json
  auth: none
}

body:json {
  {
    "userId": "cb28ceee-dfc7-494c-bd78-5511eb1453b9",
    "firstName": "Rahmat",
    "lastName": "Ali",
    "Pwd": "Post@123"
  }
}

docs {
  To use the `create-account` endpoint, follow these steps:  
  
  1. Execute the Create OTP (VerifyEmailAddress) `create-code` endpoint. This must be done for the same email Id intended for account creation.
  2. The API will generate a verification code and update the Global environment variable `VERIFICATION_CODE_ID` accordingly.  
  3. Copy the OTP received in the email. Insert the OTP into the `secretCode` field within the payload.
  4. Submit the request to execute the `create-account` endpoint.  
}

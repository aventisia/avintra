meta {
  name: Insert account user
  type: http
  seq: 2
}

post {
  url: {{ACCOUNTS_APIS_BASE_URL}}/user
  body: none
  auth: none
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    firstName: faker.person.firstName(),
    lastName: faker.person.lastName(),
    email: faker.internet.email(),
    twoFactorEnabled: false,
    userRoles: [
      "Tenant user"
    ]
  })
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
          "ACCOUNT_USER_ID",
          res.getBody().data.id
      );
  }
}

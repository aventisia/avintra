meta {
  name: Delete multiple app integrations
  type: http
  seq: 7
}

post {
  url: {{ACCOUNTS_APIS_BASE_URL}}/app-integration/delete-multiple
  body: json
  auth: none
}

body:json {
  ["{{APP_INTEGRATION_ID}}"]
}

script:post-response {
  if (res.getBody().message === "TwoFA is enabled") {
      bru.setGlobalEnvVar("APP_INTEGRATION_ID", "00000000000000000000000000");
      }
  
}

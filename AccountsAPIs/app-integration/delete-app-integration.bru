meta {
  name: Delete app integration
  type: http
  seq: 5
}

delete {
  url: {{ACCOUNTS_APIS_BASE_URL}}/app-integration/{{APP_INTEGRATION_ID}}
  body: none
  auth: none
}

body:json {
  {
    "name": "{{$randomCompanyName}}"
  }
}

script:post-response {
  if(res.getStatus() == 200)
  {
    bru.setGlobalEnvVar("APP_INTEGRATION_ID", "00000000-0000-0000-0000-000000000000");
  }
}

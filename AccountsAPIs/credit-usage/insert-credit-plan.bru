meta {
  name: Insert credit plan
  type: http
  seq: 2
}

post {
  url: {{ACCOUNTS_APIS_BASE_URL}}/credit-usage
  body: json
  auth: none
}

body:json {
  {
    "serviceType": "OnPremLLM",
    "credits": "2"
  }
  
}

script:post-response {
  if(res.getStatus() == 200)
  {
    bru.setGlobalEnvVar("CREDIT_PLAN_ID", res.getBody().data.id);
  }
}

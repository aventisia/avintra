meta {
  name: Insert app secret
  type: http
  seq: 1
}

post {
  url: {{ACCOUNTS_APIS_BASE_URL}}/app-secret
  body: json
  auth: none
}

body:json {
  {
    "name": "ChatGPT",
    "description": "ChatGPT is an AI language model developed by OpenAI, capable of understanding and generating human-like text responses. It can assist with a wide range of tasks including answering questions, providing recommendations, and engaging in general conversation.",
    "type": "OpenAiApi",
    "appIntegrationId": "338c1df3-bd25-4244-a3d1-456f63bd8353",
    "data": {
      "apiKey": "Rhmt@1996",
      "organizationId": "d",
      "url": "https://api.openai.com/v2"
    }
  }
  
}

script:post-response {
  if(res.getStatus() == 200)
  {
    bru.setGlobalEnvVar("APP_SECRET_ID", res.getBody().data.id);
  }
}

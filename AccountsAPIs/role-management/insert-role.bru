meta {
  name: Insert role
  type: http
  seq: 2
}

post {
  url: {{ACCOUNTS_APIS_BASE_URL}}/account-role
  body: none
  auth: none
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    fullName: faker.person.jobType(),
    description: faker.lorem.lines(),
    rolePermissions: [
      {
        permissionType: "Trade",
        accesses: ["View", "Delete"]
      },
    ]
  })
  
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
        "ROLE_ID", 
        res.getBody().data.id
      );
  }
}

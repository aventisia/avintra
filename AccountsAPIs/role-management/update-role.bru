meta {
  name: Update role
  type: http
  seq: 4
}

put {
  url: {{ACCOUNTS_APIS_BASE_URL}}/manage-role
  body: none
  auth: none
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    id: bru.getGlobalEnvVar("ROLE_ID"),
    tenantId: bru.getGlobalEnvVar("TENANT_ID"),
    fullName: faker.person.jobType(),
    description: faker.lorem.lines(),
    rolePermissions: [
      {
        permissionType: "Roles",
        accesses: ["FullAccess", "Delete","Edit"]
      },
    ]
  })
  
}

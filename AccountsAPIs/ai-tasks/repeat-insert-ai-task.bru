meta {
  name: Repeat - Insert ai task
  type: http
  seq: 9
}

post {
  url: {{ACCOUNTS_APIS_BASE_URL}}/ai-task
  body: json
  auth: none
}

body:json {
  {
    "name": "Example AI Task",
    "systemInput": "The system-level input template for task execution.",
    "userInput": "User-specific input data for the task.",
    "modelProvider": "OpenAI",
    "model": "GPT-4",
    "isJsonOutput": true,
    "jsonSchema": "{\"type\": \"object\", \"properties\": {\"output\": {\"type\": \"string\"}}}",
    "maxOutputTokens": 1000,
    "temperature": 0.7,
    "topP": 0.9,
    "stream": true
  }
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
          "AI_TASK_ID",
          res.getBody().data.id
      );
  }
}

meta {
  name: Required - Get tenant info
  type: http
  seq: 1
}

post {
  url: {{ACCOUNTS_APIS_BASE_URL}}/auth/tenant-info
  body: none
  auth: none
}

script:pre-request {
  req.setBody({
    email: bru.getGlobalEnvVar("MY_EMAIL")
  })
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
          "TENANT_ID",
          res.getBody().data.tenantId
      );
  }
}

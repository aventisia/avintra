meta {
  name: Delete multiple plans
  type: http
  seq: 8
}

post {
  url: {{ACCOUNTS_APIS_BASE_URL}}/manage-pricing-plan/delete-multiple
  body: none
  auth: none
}

script:pre-request {
  // Set planIds in request body
  req.setBody(
    JSON.parse(`["${bru.getGlobalEnvVar("PLAN_ID")}"]`)
  )
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
        "PLAN_ID", 
        "00000000-0000-0000-0000-000000000000"
      );
  }
}

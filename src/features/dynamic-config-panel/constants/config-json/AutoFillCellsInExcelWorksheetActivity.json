[
  {
    "direction": "Input",
    "type": "text",
    "name": "ExcelApplication",
    "label": "Excel Application",
    "description": "The Excel Application object containing the target worksheet.",
    "defaultValue": "",
    "required": true
  },
  {
    "direction": "Input",
    "type": "select",
    "name": "RangesFormat",
    "label": "Ranges Format",
    "description": "Specifies how ranges are defined: by specific ranges or named cells.",
    "defaultValue": "SpecificRanges",
    "required": true,
    "selectOptions": [
      {
        "label": "Specific Ranges",
        "value": "SpecificRanges",
        "description": "Uses explicit cell ranges (e.g., A1:A5)."
      },
      {
        "label": "Named Cells",
        "value": "NamedCells",
        "description": "Uses named ranges (e.g., SourceRange, TargetRange)."
      }
    ]
  },
  {
    "direction": "Input",
    "type": "text",
    "name": "SourceRange",
    "label": "Source Range",
    "description": "The range containing the data to be copied (e.g., \u0027A1:A5\u0027).",
    "defaultValue": "",
    "required": false,
    "renderIf": {
      "conditions": [
        {
          "field": "RangesFormat",
          "equals": "SpecificRanges"
        }
      ]
    }
  },
  {
    "direction": "Input",
    "type": "text",
    "name": "TargetRange",
    "label": "Target Range",
    "description": "The range where the data should be pasted (e.g., \u0027A6:A10\u0027).",
    "defaultValue": "",
    "required": false,
    "renderIf": {
      "conditions": [
        {
          "field": "RangesFormat",
          "equals": "SpecificRanges"
        }
      ]
    }
  },
  {
    "direction": "Input",
    "type": "text",
    "name": "SourceNamedRange",
    "label": "Source Named Range",
    "description": "The name of the named range containing the source data.",
    "defaultValue": "",
    "required": false,
    "renderIf": {
      "conditions": [
        {
          "field": "RangesFormat",
          "equals": "NamedCells"
        }
      ]
    }
  },
  {
    "direction": "Input",
    "type": "text",
    "name": "TargetNamedRange",
    "label": "Target Named Range",
    "description": "The name of the named range where the data should be pasted.",
    "defaultValue": "",
    "required": false,
    "renderIf": {
      "conditions": [
        {
          "field": "RangesFormat",
          "equals": "NamedCells"
        }
      ]
    }
  }
]
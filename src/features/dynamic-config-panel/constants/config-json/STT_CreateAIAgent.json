{
  "name": "STT_CreateAIAgent",
  "label": "Speech To Text Model",
  "description": "Convert spoken language into written text using AI.",
  "version": "1.0.0",
  "auther": "@aventisia",
  "supportedPlatforms": ["cloud", "desktop"],
  "errorHandling": "standard",
  "testScreenType": "llmGenerateRequest",
  "fields": [
    {
      "direction": "Input",
      "type": "model-config-select",
      "name": "__ModelConfig__SpeechToText",
      "defaultValue": {
        "isByokEnabled": false,
        "provider": "openai",
        "credentials": "",
        "model": "gpt-4o-mini",
        "temp": 1,
        "topP": 1
      },
      "required": false,
      "category": "Models"
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "files",
      "label": "Files",

      "required": false,
      "category": "Models"
    },
    {
      "direction": "Input",
      "type": "prompt-input",
      "name": "prompt",
      "required": false,
      "min": 25,
      "category": "Prompt"
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "AIModelResult",
      "label": "Button Clicked Successfully",
      "description": "AI Model Result.",
      "defaultValue": {
        "value": "AIModelResult",
        "enabled": true
      },
      "required": false,
      "category": "Models"
    }
  ]
}

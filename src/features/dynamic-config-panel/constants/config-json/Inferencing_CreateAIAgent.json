{
  "name": "Inferencing_CreateAIAgent",
  "label": "Inferencing Model",
  "description": "Inferencing Model.",
  "version": "1.0.0",
  "auther": "@aventisia",
  "supportedPlatforms": ["cloud", "desktop"],
  "errorHandling": "standard",
  "testScreenType": "llmGenerateRequest",
  "fields": [
    {
      "direction": "Input",
      "type": "prompt-input",
      "name": "prompt",
      "required": false,
      "min": 16,
      "defaultValue": "",
      "category": "Prompt"
    },
    {
      "direction": "Input",
      "type": "model-config-select",
      "name": "__ModelConfig__Inferencing",
      "defaultValue": {
        "isByokEnabled": false,
        "provider": "openai",
        "credentials": "",
        "model": "gpt-4o-mini",
        "temperature": 1,
        "topP": 1,
        "isJsonOutput": true,
        "maxOutputToken": 50
      },
      "required": false,
      "category": "Models"
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "Files",
      "label": "Files",

      "required": false,
      "category": "Models"
    },
    {
      "direction": "Input",
      "type": "knowledge-base-config",
      "name": "KnowledgeBaseConfig",
      "label": "Knowledge Base",
      "defaultValue": {
        "knowledgeBase": "",
        "retrievalType": "Basic",
        "sourceThreshold": 1,
        "numberOfChunks": 10
      },
      "required": false,
      "category": "Memory"
    },
    {
      "direction": "Input",
      "type": "memory-config",
      "name": "MemoryConfig",
      "defaultValue": {
        "memoryProvider": "Memory Provider 1",
        "maxDataStored": 4
      },
      "required": false,
      "category": "Memory"
    },
    {
      "direction": "Input",
      "type": "text",
      "name": "Tools",
      "label": "Tools",

      "required": false,
      "category": "Tools"
    },
    {
      "direction": "Output",
      "type": "config-panel-output",
      "name": "AIModelResult",
      "label": "Button Clicked Successfully",
      "description": "AI Model Result.",
      "defaultValue": {
        "value": "AIModelResult",
        "enabled": true
      },
      "required": false,
      "category": "Prompt"
    }
  ]
}

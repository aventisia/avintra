meta {
  name: add open position
  type: http
  seq: 3
}

post {
  url: {{WORKBOARD_APIS_BASE_URL}}/open-position
  body: none
  auth: none
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
     recruiterId:faker.string.uuid(),
  companyId:faker.string.uuid(),
  role:faker.person.firstName(),
  department:faker.person.firstName(),
  jobType:"contract",
  employmentType:"permanent",
  essentialSkills:faker.person.firstName(),
  goodToHaveSkills:faker.person.firstName(),
  experienceLevel:"MidLevel",
  minimumExperience:1,
  maximumExperience:2,
  locationType:"remote",
  location:faker.person.firstName(),
  jobDescription:faker.person.firstName(),
  costCode:faker.person.firstName(),
  band:faker.person.firstName(),
  function:faker.person.firstName(),
  hiringManager:faker.person.firstName(),
  recruitmentSPOC:faker.person.firstName(),
  internalNotes:faker.person.firstName(),
    isclosed:false
  })
}

script:post-response {
   
}

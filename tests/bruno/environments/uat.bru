vars {
  ACCOUNTS_APIS_BASE_URL: https://uat-avintra.aventisia.com/accounts/api
  WORKSPACE_APIS_BASE_URL: https://uat-avintra.aventisia.com/workspace/api
  LLM_PIPELINE_APIS_BASE_URL: https://uat-avintra.aventisia.com/llmpipeline/api
  GLOBAL_ADMIN_BASE_URL: https://uat-globaladmin.aventisia.com/api

  # Apache Camel connector harness
  BASE_URL: https://camel-connectors-uat.example.com/api
  API_KEY: uat-api-key
  POSTGRES_HOST: postgres-uat.internal
  POSTGRES_PORT: 5432
  POSTGRES_DB: testdb
  POSTGRES_USER: uat-db-user
  POSTGRES_PASSWORD: uat-db-pass
  HTTP_HOST: echo-uat.internal
  HTTP_PORT: 8081
  FTP_HOST: ftp-uat.internal
  FTP_PORT: 21
  SFTP_PORT: 2222
  FTP_USERNAME: uat-ftp-user
  FTP_PASSWORD: uat-ftp-pass
  JMS_BROKER_URL: tcp://jms-uat.internal:61616
  JMS_USERNAME: uat-jms-user
  JMS_PASSWORD: uat-jms-pass
  JMS_DESTINATION: orders
  JMS_REPLY_TO: replies
  KAFKA_BROKERS: kafka-uat.internal:9092
  KAFKA_TOPIC: events
  KAFKA_GROUP_ID: harness-group
  KAFKA_USERNAME: uat-kafka-user
  KAFKA_PASSWORD: uat-kafka-pass
  SMTP_HOST: smtp-uat.internal
  SMTP_PORT: 587
  IMAP_HOST: imap-uat.internal
  IMAP_PORT: 993
  MAIL_TO: uat@example.com
  MAIL_USERNAME: uat-mail-user
  MAIL_PASSWORD: uat-mail-pass
  GITHUB_TOKEN: ghp_uat_access_token
  GITHUB_BASE_URL: https://api.github.com
  GITHUB_OWNER: acme
  GITHUB_REPO: demo
  GITHUB_BRANCH: main
  GITHUB_API_KEY: github-uat-api-key
  GITHUB_CLIENT_ID: <github-oauth-client-id>
  GITHUB_CLIENT_SECRET: <github-oauth-client-secret>
  GITHUB_REFRESH_TOKEN: <github-oauth-refresh-token>
  GITHUB_TOKEN_URL: https://github.com/login/oauth/access_token
  GITHUB_SCOPES: repo read:org
  M365_TOKEN: <graph-access-token>
  M365_TENANT_ID: <tenant-id>
  M365_CLIENT_ID: <client-id>
  M365_CLIENT_SECRET: <client-secret>
  M365_REFRESH_TOKEN: <graph-refresh-token>
  M365_TOKEN_URL: https://login.microsoftonline.com/{tenantId}/oauth2/v2.0/token
  M365_SCOPES: https://graph.microsoft.com/.default
  M365_API_KEY: m365-uat-gateway-api-key
  M365_AUTHORIZATION_CODE: <oauth-authorization-code>
  M365_REDIRECT_URI: https://camel-connectors-uat.example.com/callback
  M365_DEVICE_CODE: <device-code>
  M365_ASSERTION: <obo-assertion-jwt>
  M365_USER_ID: alex@contoso.com
  M365_USER_PRINCIPAL_NAME: alex@contoso.com
  M365_GROUP_ID: 00000000-0000-0000-0000-000000000000
  M365_SITE_ID: contoso.sharepoint.com:/sites/team
  M365_LIST_ID: 00000000-0000-0000-0000-000000000000
  M365_TEAM_ID: 00000000-0000-0000-0000-000000000000
  M365_CHANNEL_ID: 19:channel@thread.skype
  M365_BASE_URL: https://graph.microsoft.com/v1.0
  M365_SKU_ID: 00000000-0000-0000-0000-000000000000
  M365_RESOURCE_ID: 00000000-0000-0000-0000-000000000000
  M365_APP_ROLE_ID: 00000000-0000-0000-0000-000000000000
  M365_APP_ROLE_ASSIGNMENT_ID: 00000000-0000-0000-0000-000000000000
  M365_MESSAGE_ID: AAMkAD...
  M365_MAIL_FOLDER_ID: Inbox
  M365_ATTACHMENT_ID: AAMkAD...
  M365_ATTACHMENT_BASE64: <base64-encoded-file>
  M365_CALENDAR_ID: AAMkAD...
  M365_EVENT_ID: AAMkAD...
  M365_CONTACT_ID: AAMkAD...
  M365_ITEM_ID: 01ABCDEF...
  M365_PERMISSION_ID: aTowIy5m...
  M365_MEMBERSHIP_ID: MCMj...
  M365_CHAT_ID: 19:meeting_...@thread.v2
  M365_MEETING_ID: MSo1...
  M365_CALL_ID: 2f35...
  M365_ORGANIZATION_ID: 00000000-0000-0000-0000-000000000000
  M365_DEVICE_ID: 00000000-0000-0000-0000-000000000000
  M365_APPLICATION_ID: 00000000-0000-0000-0000-000000000000
  M365_SERVICE_PRINCIPAL_ID: 00000000-0000-0000-0000-000000000000
  M365_PRESENCE_SESSION_ID: session-1
  M365_PLAN_ID: 00000000-0000-0000-0000-000000000000
  M365_TASK_ID: 00000000-0000-0000-0000-000000000000
  M365_SEARCH_QUERY: quarterly
  M365_NOTIFICATION_URL: https://camel-connectors-uat.example.com/webhooks/graph
  M365_SUBSCRIPTION_ID: 00000000-0000-0000-0000-000000000000
  M365_PHOTO_BASE64: <base64-encoded-photo>
  FILE_DIRECTORY: /tmp/camel-harness
}
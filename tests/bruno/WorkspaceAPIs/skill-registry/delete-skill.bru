meta {
  name: Delete skill
  type: http
  seq: 7
}

delete {
  url: {{WORKSPACE_APIS_BASE_URL}}/skill-registry/{{SKILL_ID}}
  body: none
  auth: none
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
        "SKILL_ID", 
        "00000000-0000-0000-0000-000000000000"
      );
  }
}

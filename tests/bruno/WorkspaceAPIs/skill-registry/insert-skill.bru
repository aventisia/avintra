meta {
  name: Insert skill
  type: http
  seq: 4
}

post {
  url: {{WORKSPACE_APIS_BASE_URL}}/skill-registry
  body: json
  auth: none
}

body:json {
  {
    "name": "Intelligent Document Search",
    "description": "Provides semantic search capabilities over uploaded documents using vector embeddings, enabling users to quickly find relevant information across large knowledge bases.",
    "isGlobal": false,
    "isTenantWideAccess": false,
    "isActive": true,
    "isDisabled": false
  }
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
          "SKILL_ID",
          res.getBody().data.id
      );
  }
}

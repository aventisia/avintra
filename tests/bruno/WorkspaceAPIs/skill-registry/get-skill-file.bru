meta {
  name: Get skill file
  type: http
  seq: 12
}

get {
  url: {{WORKSPACE_API_BASE_URL}}/skill-registry/{{SKILL_ID}}/files/{{SKILL_FILE_ID}}
  body: none
  auth: none
}

tests {
  test("returns the requested file with its content", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data.id).to.equal(bru.getGlobalEnvVar("SKILL_FILE_ID"));
    expect(res.body.data.content).to.not.equal(null);
  });
}

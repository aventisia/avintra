meta {
  name: Delete vault credential with flow access
  type: http
  seq: 24
}

delete {
  url: {{WORKSPACE_API_BASE_URL}}/vault-credential/{{VAULT_CREDENTIAL_ID}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

script:post-response {
  test("vault credential delete returns 200 with data true", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data).to.equal(true);
  });
}

docs {
  > Deletes the Dev vault credential identified by VAULT_CREDENTIAL_ID, which must
  > currently hold flow-access rows. Confirm the rows are gone with a database
  > spot-check on agent_ResourceFlowAccess filtered by ResourceType 'VaultCredential'
  > and that credential id, because the credential itself no longer answers API
  > reads. Use a DEDICATED fixture credential, never a shared one.
}

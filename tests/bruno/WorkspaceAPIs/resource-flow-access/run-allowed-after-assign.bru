meta {
  name: Run allowed after assigning the flow to the restricted queue
  type: http
  seq: 28
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/execute-flow/execute
  body: json
  auth: bearer
}

body:json {
  {
    "flowVersionId": "{{RESTRICTED_FLOW_VERSION_ID}}"
  }
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

script:post-response {
  test("run is allowed with 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("an execution job is created", function() {
    expect(res.getBody().data.jobId).to.be.a("string");
    expect(res.getBody().data.flowVersionId).to.be.a("string");
  });
}

docs {
  > Run after assign-flow-for-run-allowed. The same manual run that returned 403 while
  > the flow was outside the restricted queue now returns 200 with a jobId. Any-agent
  > (unrestricted) resources never block, assigned or not.
}

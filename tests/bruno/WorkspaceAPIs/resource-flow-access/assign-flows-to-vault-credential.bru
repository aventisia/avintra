meta {
  name: Assign flows to vault credential
  type: http
  seq: 20
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/resource-flows/assign
  body: json
  auth: bearer
}

body:json {
  {
    "resourceType": "VaultCredential",
    "resourceId": "{{VAULT_CREDENTIAL_ID}}",
    "flowIds": [
      "{{FLOW_ID}}"
    ]
  }
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

script:post-response {
  const body = res.getBody();
  if (res.getStatus() === 200 && body?.data?.assignedCount >= 1) {
    bru.setGlobalEnvVar("EXPECT_FLOW_ASSIGNED", "true");
  }
  test("assign flows returns 200 with the result counts", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.assignedCount).to.be.at.least(1);
    expect(res.getBody().data.unassignedPublishedFlows).to.be.an("array");
  });
}

docs {
  > Assigns a single flow to the Dev vault credential identified by
  > VAULT_CREDENTIAL_ID through the bulk replace endpoint. A non-empty list also
  > restricts the credential. The caller must own the credential, own the flow,
  > and be a member of the flow. Provide ACCESS_TOKEN, VAULT_CREDENTIAL_ID and
  > FLOW_ID through the environment.
}

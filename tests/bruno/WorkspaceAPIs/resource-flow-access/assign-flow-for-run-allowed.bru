meta {
  name: Assign the flow to the restricted queue for the allowed run
  type: http
  seq: 27
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/resource-flows/assign
  body: json
  auth: bearer
}

body:json {
  {
    "resourceType": "Queue",
    "resourceId": "{{RESTRICTED_QUEUE_ID}}",
    "flowIds": [
      "{{RESTRICTED_FLOW_ID}}"
    ]
  }
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

script:post-response {
  test("assigning the flow to the restricted queue returns 200", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.assignedCount).to.be.at.least(1);
  });
}

docs {
  > Adds RESTRICTED_FLOW_ID to RESTRICTED_QUEUE_ID through the bulk replace endpoint, so
  > the queue restriction no longer blocks that flow. Run run-allowed-after-assign next.
  > Use a DEDICATED fixture queue: the request replaces the queue's whole flow set, so
  > restore the original assignments with a full flowIds list when finished.
}

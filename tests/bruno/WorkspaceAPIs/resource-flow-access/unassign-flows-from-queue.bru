meta {
  name: Unassign all flows from queue
  type: http
  seq: 17
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/resource-flows/assign
  body: json
  auth: bearer
}

body:json {
  {
    "resourceType": "Queue",
    "resourceId": "{{QUEUE_ID}}",
    "flowIds": []
  }
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

script:post-response {
  const body = res.getBody();
  if (res.getStatus() === 200 && body?.data?.removedCount >= 1) {
    bru.setGlobalEnvVar("EXPECT_QUEUE_FLOW_ASSIGNED", "false");
  }
  test("unassign flows returns 200 with a removed count", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.removedCount).to.be.at.least(1);
    expect(res.getBody().data.assignedCount).to.equal(0);
  });
}

docs {
  > Empties the target queue's flow assignments through the bulk endpoint, which is
  > also what re-opens the queue. Use a DEDICATED fixture queue: this request clears
  > every assignment on it.
}

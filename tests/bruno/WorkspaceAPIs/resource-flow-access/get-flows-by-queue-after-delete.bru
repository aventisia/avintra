meta {
  name: Get assigned flows after queue delete
  type: http
  seq: 20
}

get {
  url: {{WORKSPACE_API_BASE_URL}}/resource-flows/Queue/{{QUEUE_ID}}/assigned-flows
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

script:post-response {
  const body = res.getBody();
  const text = typeof body === "string" ? body : JSON.stringify(body);

  test("deleted queue no longer resolves", function() {
    expect(res.getStatus()).to.equal(404);
  });

  test("error names the missing queue", function() {
    expect(text).to.contain("The queue does not exist");
  });
}

docs {
  > Run after "Delete queue with flow access". A 404 confirms the queue is gone and
  > that its ws_ResourceFlowAccess rows were staged for deletion with it instead of
  > being left behind. A 200 with an empty list would mean the queue row survived.
}

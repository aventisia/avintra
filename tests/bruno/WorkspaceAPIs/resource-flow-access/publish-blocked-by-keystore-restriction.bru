meta {
  name: Publish blocked by restricted keystore
  type: http
  seq: 22
}

put {
  url: {{WORKSPACE_API_BASE_URL}}/flow/publish
  body: json
  auth: bearer
}

body:json {
  {
    "id": "{{RESTRICTED_FLOW_VERSION_ID}}",
    "flowId": "{{RESTRICTED_FLOW_ID}}",
    "name": "{{RESTRICTED_FLOW_NAME}}",
    "type": "Agent"
  }
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

script:post-response {
  const keyStoreName = bru.getGlobalEnvVar("RESTRICTED_KEYSTORE_NAME") || bru.getEnvVar("RESTRICTED_KEYSTORE_NAME");
  const body = res.getBody();
  const text = typeof body === "string" ? body : JSON.stringify(body);

  test("publish is blocked with 403", function() {
    expect(res.getStatus()).to.equal(403);
  });

  test("publish block message names the restricted keystore", function() {
    expect(text).to.contain("Cannot publish: flow ");
    expect(text).to.contain(keyStoreName);
  });
}

docs {
  > Requires RESTRICTED_FLOW_VERSION_ID to be a version of RESTRICTED_FLOW_ID whose
  > saved reactFlowObject references a keystore through a {{__config__<name>}}
  > placeholder, and RESTRICTED_KEYSTORE_NAME to name a Dev keystore whose flow
  > assignment is non-empty and does NOT include that flow. Publish then blocks with
  > HTTP 403 and the message
  > "Cannot publish: flow '<flow>' is not assigned to restricted keystore '<keystore>'".
  > Run this before the unassign request while the restriction is still present.
  > Clearing the keystore restriction (POST resource-flows/assign with resourceType,
  > resourceId and flowIds []) and re-running publish returns 200.
}

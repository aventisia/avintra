meta {
  name: Publish blocked by restricted credential (name reference)
  type: http
  seq: 23
}

put {
  url: {{WORKSPACE_API_BASE_URL}}/flow/publish
  body: json
  auth: bearer
}

body:json {
  {
    "id": "{{CREDENTIAL_NAME_REF_FLOW_VERSION_ID}}",
    "flowId": "{{CREDENTIAL_NAME_REF_FLOW_ID}}",
    "name": "{{CREDENTIAL_NAME_REF_FLOW_NAME}}",
    "type": "Agent"
  }
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

script:post-response {
  const credentialName = bru.getGlobalEnvVar("RESTRICTED_CREDENTIAL_NAME") || bru.getEnvVar("RESTRICTED_CREDENTIAL_NAME");
  const body = res.getBody();
  const text = typeof body === "string" ? body : JSON.stringify(body);

  test("publish is blocked with 403", function() {
    expect(res.getStatus()).to.equal(403);
  });

  test("publish block message names the restricted credential", function() {
    expect(text).to.contain("Cannot publish: flow ");
    expect(text).to.contain(credentialName);
  });
}

docs {
  > Requires CREDENTIAL_NAME_REF_FLOW_VERSION_ID to be a version of
  > CREDENTIAL_NAME_REF_FLOW_ID whose saved reactFlowObject references a credential
  > by name, and RESTRICTED_CREDENTIAL_NAME to name a Dev credential whose flow
  > assignment is non-empty and does NOT include that flow. This covers the
  > name-reference half of the GUID-vs-name rule. Publish then blocks with HTTP 403
  > and the message "Cannot publish: flow '<flow>' is not assigned to restricted
  > credential '<credential>'". Clearing the credential restriction (POST
  > resource-flows/assign with resourceType VaultCredential, resourceId and
  > flowIds []) and re-running publish returns 200.
}

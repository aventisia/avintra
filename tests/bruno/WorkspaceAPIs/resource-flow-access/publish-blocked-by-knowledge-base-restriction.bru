meta {
  name: Publish blocked by restricted knowledge base
  type: http
  seq: 33
}

put {
  url: {{WORKSPACE_API_BASE_URL}}/flow/publish
  body: json
  auth: bearer
}

body:json {
  {
    "id": "{{RESTRICTED_FLOW_VERSION_ID}}",
    "flowId": "{{RESTRICTED_FLOW_ID}}",
    "name": "{{RESTRICTED_FLOW_NAME}}",
    "type": "Agent"
  }
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

script:post-response {
  const knowledgeBaseName = bru.getGlobalEnvVar("RESTRICTED_KNOWLEDGE_BASE_NAME") || bru.getEnvVar("RESTRICTED_KNOWLEDGE_BASE_NAME");
  const body = res.getBody();
  const text = typeof body === "string" ? body : JSON.stringify(body);

  test("publish is blocked with 403", function() {
    expect(res.getStatus()).to.equal(403);
  });

  test("publish block message names the restricted knowledge base", function() {
    expect(text).to.contain("is not allowed to use the");
    expect(text).to.contain(knowledgeBaseName);
  });
}

docs {
  > Requires RESTRICTED_FLOW_VERSION_ID to be a version of RESTRICTED_FLOW_ID whose
  > saved reactFlowObject references a knowledge base by name in a knowledge step, and
  > RESTRICTED_KNOWLEDGE_BASE_NAME to name a Dev knowledge base whose flow assignment is
  > non-empty and does NOT include that flow. Publish then blocks with HTTP 403 and the
  > message "Cannot publish: '<flow>' is not allowed to use the knowledge base
  > '<kb>'". Run this before the unassign request while the restriction is still present.
  > Clearing the knowledge base restriction (POST resource-flows/assign with resourceType,
  > resourceId and flowIds []) and re-running publish returns 200.
}

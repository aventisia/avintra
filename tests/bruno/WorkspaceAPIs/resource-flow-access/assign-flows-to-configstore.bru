meta {
  name: Assign flows to config store
  type: http
  seq: 21
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/resource-flows/assign
  body: json
  auth: bearer
}

body:json {
  {
    "resourceType": "ConfigStore",
    "resourceId": "{{CONFIGSTORE_ID}}",
    "flowIds": [
      "{{FLOW_ID}}"
    ]
  }
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

script:post-response {
  const body = res.getBody();
  if (res.getStatus() === 200 && body?.data?.assignedCount >= 1) {
    bru.setGlobalEnvVar("EXPECT_CONFIGSTORE_FLOW_ASSIGNED", "true");
  }
  test("assign flows returns 200 with the result counts", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.assignedCount).to.be.at.least(1);
    expect(res.getBody().data.unassignedPublishedFlows).to.be.an("array");
  });
}

docs {
  > Assigns a single flow to the Dev config store identified by CONFIGSTORE_ID through the
  > bulk replace endpoint. The caller must be the config store owner or hold Edit access.
  > Provide ACCESS_TOKEN, CONFIGSTORE_ID and FLOW_ID through the environment.
}

meta {
  name: Run blocked by restricted credential
  type: http
  seq: 26
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/execute-flow/execute
  body: json
  auth: bearer
}

body:json {
  {
    "flowVersionId": "{{CREDENTIAL_NAME_REF_FLOW_VERSION_ID}}"
  }
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

script:post-response {
  const credentialName = bru.getGlobalEnvVar("RESTRICTED_CREDENTIAL_NAME") || bru.getEnvVar("RESTRICTED_CREDENTIAL_NAME");
  const body = res.getBody();
  const text = typeof body === "string" ? body : JSON.stringify(body);

  test("run is blocked with 403", function() {
    expect(res.getStatus()).to.equal(403);
  });

  test("run block message names the restricted credential", function() {
    expect(text).to.contain("Cannot run: this agent is not assigned to restricted resource(s):");
    expect(text).to.contain("credential '" + credentialName + "'");
  });
}

docs {
  > Requires CREDENTIAL_NAME_REF_FLOW_VERSION_ID to be an unpublished version of
  > CREDENTIAL_NAME_REF_FLOW_ID whose saved reactFlowObject references a credential by
  > name, and RESTRICTED_CREDENTIAL_NAME to name a Dev credential whose flow assignment
  > is non-empty and does NOT include that flow. The manual run returns HTTP 403 naming
  > the credential and creates no job.
}

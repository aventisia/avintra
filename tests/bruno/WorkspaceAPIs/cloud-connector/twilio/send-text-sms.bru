meta {
  name: Send text sms
  type: http
  seq: 1
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/cloud-connector/twilio/invoke
  body: json
  auth: none
}

body:json {
  {
    "agentId": "00000000-0000-0000-0000-000000000000",
    "agentName": "Test",
    "provider": "Twilio",
    "action": "SendTextSms",
    "credentialName": "DUMMY",
    "payload": {
      //"recipientType": "PhoneNumber", // MessagingServiceSID
      //"recipientTypeValue": "+14155238886",
      "recipientType": "MessagingServiceSID", //"PhoneNumber"
      "recipientTypeValue": "MG98ef2721dd9513223b48a75bb2278cb3",
      "toNumber": "+918924033961",
      "messageBody": "Hello, test the sms code"
    }
  }
}

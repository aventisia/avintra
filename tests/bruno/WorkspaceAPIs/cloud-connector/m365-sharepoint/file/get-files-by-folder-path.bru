meta {
  name: Get files by folder path
  type: http
  seq: 3
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/cloud-connector/m365/sharepoint/invoke
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:json {
  {
    "agentId": "00000000-0000-0000-0000-000000000000",
    "agentName": "Test",
    "provider": "M365Outlook",
    "action": "GetDriveItems",
    "credentialName": "DUMMY",
    "payload": {
      "DrivePath": "https://aventisia.sharepoint.com/sites/AventisiasProducts/Shared%20Documents/Product%20Development"
    }
  }
  
}

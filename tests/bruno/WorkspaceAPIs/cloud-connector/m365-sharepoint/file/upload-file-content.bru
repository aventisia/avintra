meta {
  name: Upload file content
  type: http
  seq: 2
}

post {
  url: {{WORKSPACE_APIS_BASE_URL}}/cloud-connector/m365/sharepoint/invoke
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:json {
  {
    "agentId": "00000000-0000-0000-0000-000000000000",
    "agentName": "Test",
    "provider": "M365Outlook",
    "action": "FileUpload",
    "credentialId": "DUMMY",
    "payload": {
      "drivePath": "https://aventisia.sharepoint.com/sites/AventisiasProducts/Shared%20Documents/Product%20Development",
      "fileName": "Excel_base_sheet1.pdf",
      "contentSource": "Base64",
      "content": ""
    }
  }
}

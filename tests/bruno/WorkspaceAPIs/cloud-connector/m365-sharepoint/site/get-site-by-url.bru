meta {
  name: Get site by url
  type: http
  seq: 3
}

post {
  url: {{WORKSPACE_APIS_BASE_URL}}/cloud-connector/m365/sharepoint/invoke
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:json {
  {
    "agentId": "00000000-0000-0000-0000-000000000000",
    "agentName": "Test",
    "provider": "M365Outlook",
    "action": "GetSiteByUrl",
    "credentialName": "DUMMY",
    "payload": { 
      "SiteUrl": "https://aventisia.sharepoint.com/sites/AventisiasProducts"
    }
  }
  
}

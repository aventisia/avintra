meta {
  name: Delete mail folder
  type: http
  seq: 5
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/cloud-connector/m365/outlook/invoke
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:json {
  {
    "agentId": "00000000-0000-0000-0000-000000000000",
    "agentName": "Test",
    "provider": "M365Outlook",
    "action": "DeleteMailFolder",
    "credentialName": "DUMMY",
    "payload": {
      "MailboxAddress": "{{MAILBOX_ADDRESS}}",
      "FolderId": "folder_Id"
    }
  }
  
}

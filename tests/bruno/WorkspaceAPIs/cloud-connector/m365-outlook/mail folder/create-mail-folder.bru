meta {
  name: Create mail folder
  type: http
  seq: 1
}

post {
  url: {{WORKSPACE_APIS_BASE_URL}}/cloud-connector/m365/outlook/invoke
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:json {
  {
    "agentId": "00000000-0000-0000-0000-000000000000",
    "agentName": "Test",
    "provider": "M365Outlook",
    "action": "CreateMailFolder",
    "credentialName": "DUMMY",
    "payload": {
      "MailboxAddress": "{{MAILBOX_ADDRESS}}",
      "DisplayName": "Cloud_Connector_Test_MailBox",
      "IsHidden": fakse
    }
  }
  
}

meta {
  name: Get emails by folder id
  type: http
  seq: 3
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/cloud-connector/m365/outlook/invoke
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:json {
  {
    "agentId": "00000000-0000-0000-0000-000000000000",
    "agentName": "Test",
    "provider": "M365Outlook",
    "action": "GetEmailsByFolder",
    "credentialName": "DUMMY",
    "payload": {
      "MailboxAddress": "{{MAILBOX_ADDRESS}}",
      "FolderId": "AAMkAGIzMzYxYmEyLTBlMjctNDBmNi04ZjcyLWJjYzMwMjI2NDI5YQAuAAAAAACmgkrdTS3ATqcjKICk77O7AQDB5qP7LiE2QYd7aQ-ZaTnZAAAAAAEKAAA="
    }
  }
}

meta {
  name: Send email
  type: http
  seq: 1
}

post {
  url: {{WORKSPACE_APIS_BASE_URL}}/cloud-connector/m365/outlook/invoke
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:json {
  {
    "agentId": "00000000-0000-0000-0000-000000000000",
    "agentName": "Test",
    "provider": "M365Outlook",
    "action": "SendEmail",
    "credentialId": "DUMMY",
    "payload": {
      "To": "email@domain.com",
      "From": "{{MAILBOX_ADDRESS}}",
      "Subject": "Test the Outlook:",
      "CC": "",
      "BCC": "",
      "ContentType": "Text",
      "Content": "Hello, I am from aventisia",
      "Importance": "Normal",
      "Sensitivity": "Normal",
      "SaveToSentItems": false
    }
  }
  
}

meta {
  name: Get email by id
  type: http
  seq: 3
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/cloud-connector/m365/outlook/invoke
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:json {
  {
    "agentId": "00000000-0000-0000-0000-000000000000",
    "agentName": "Test",
    "provider": "M365Outlook",
    "action": "GetEmailById",
    "credentialName": "DUMMY",
    "payload": {
      "MailboxAddress": "{{MAILBOX_ADDRESS}}",
      "MessageId": "AAMkAGIzMzYxYmEyLTBlMjctNDBmNi04ZjcyLWJjYzMwMjI2NDI5YQBGAAAAAACmgkrdTS3ATqcjKICk77O7BwDB5qP7LiE2QYd7aQ-ZaTnZAAAAAAEMAADB5qP7LiE2QYd7aQ-ZaTnZAAJ6-PimAAA=",
      "IncludeAttachments": false
      }
  }
}

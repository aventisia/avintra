meta {
  name: Move email to folder
  type: http
  seq: 7
}

post {
  url: {{WORC_APIS_BASE_URL}}/cloud-connector/m365/outlook/invoke
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:json {
  {
    "agentId": "00000000-0000-0000-0000-000000000000",
    "agentName": "Test",
    "provider": "M365Outlook",
    "action": "MoveEmailToFolder",
    "credentialId": "DUMMY",
    "payload": {
      "MailboxAddress": "{{MAILBOX_ADDRESS}}",
      "MessageId": "MessageId",
      "FolderId": "AAMkAGIzMzYxYmEyLTBlMjctNDBmNi04ZjcyLWJjYzMwMjI2NDI5YQAuAAAAAACmgkrdTS3ATqcjKICk77O7AQDB5qP7LiE2QYd7aQ-ZaTnZAAAAAAEKAAA="
    }
  }
}

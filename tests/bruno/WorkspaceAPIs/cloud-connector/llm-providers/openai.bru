    "credentialId": "DUMMY",
    "payload": {
      "model": "gpt-4o",
      "input": "Why is the sky blue?",//"Give me top 3 benefits of daily exercise",
      "files": null,
      "is_json_output": false,
      "json_schema": null,
      "max_output_tokens": 50,
      "temperature": 1.0,
      "top_p": 1.0,
      "stream": false

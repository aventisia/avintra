meta {
  name: 02 - Execute - create user table
  type: http
  seq: 2
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/cloud-connector/camel/invoke
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:json {
  {
    "agentId": "00000000-0000-0000-0000-000000000000",
    "agentName": "USER_E2E",
    "provider": "sql",
    "action": "Execute",
    "credentialName": "{{SQL_CREDENTIAL_NAME}}",
    "payload": {
      "query_sql": "CREATE TABLE users (id UUID NOT NULL DEFAULT gen_random_uuid() PRIMARY KEY, user_name TEXT NOT NULL UNIQUE, first_name TEXT NOT NULL, last_name TEXT NOT NULL, avatar_src TEXT, created_at TIMESTAMPTZ NOT NULL DEFAULT NOW())",
      "payload": {}
    }
  }
}

vars:pre-request {
  SQL_CREDENTIAL_NAME: Apache_Camel
}

tests {
  test("status code is 200", function() {
    expect(res.status).to.equal(200);
  });
  
  test("create user table succeeded", function() {
    expect(res.body.success).to.equal(true);
    expect(res.body.data.action).to.equal("Execute");
  });
}

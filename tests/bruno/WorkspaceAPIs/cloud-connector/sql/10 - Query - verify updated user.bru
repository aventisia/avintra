meta {
  name: 10 - Query - verify updated user
  type: http
  seq: 10
}

post {
  url: {{WORKSPACE_APIS_BASE_URL}}/cloud-connector/camel/invoke
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:json {
  {
    "agentId": "00000000-0000-0000-0000-000000000000",
    "agentName": "USER_E2E",
    "provider": "sql",
    "action": "Query",
    "credentialName": "{{SQL_CREDENTIAL_NAME}}",
    "payload": {
      "query_sql": "SELECT user_name, first_name, last_name, avatar_src FROM users WHERE user_name = 'alice@example.com'",
      "payload": {}
    }
  }
}

vars:pre-request {
  SQL_CREDENTIAL_NAME: Apache_Camel
}

tests {
  test("status code is 200", function() {
    expect(res.status).to.equal(200);
  });
  
  test("exactly one user remains after update", function() {
    expect(Array.isArray(res.body.data.response)).to.equal(true);
    expect(res.body.data.response.length).to.equal(1);
  });
  
  test("updated fields are persisted", function() {
    const row = res.body.data.response[0];
    expect(row.last_name).to.equal("Anderson-Smith");
    expect(row.avatar_src).to.equal("https://example.com/alice-avatar-v2.png");
    expect(row.first_name).to.equal("Alice");
  });
}

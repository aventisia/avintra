meta {
  name: 05 - Query - verify inserted user
  type: http
  seq: 5
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/cloud-connector/camel/invoke
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:json {
  {
    "agentId": "00000000-0000-0000-0000-000000000000",
    "agentName": "USER_E2E",
    "provider": "sql",
    "action": "Query",
    "credentialName": "{{SQL_CREDENTIAL_NAME}}",
    "payload": {
      "query_sql": "SELECT id, user_name, first_name, last_name, avatar_src, created_at FROM users WHERE user_name = 'alice@example.com'",
      "payload": {}
    }
  }
}

vars:pre-request {
  SQL_CREDENTIAL_NAME: Apache_Camel
}

tests {
  test("status code is 200", function() {
    expect(res.status).to.equal(200);
  });
  
  test("exactly one row exists for the dispatched user", function() {
    expect(Array.isArray(res.body.data.response)).to.equal(true);
    expect(res.body.data.response.length).to.equal(1);
  });
  
  test("inserted user matches the dispatched payload", function() {
    const row = res.body.data.response[0];
    expect(row.user_name).to.equal("alice@example.com");
    expect(row.first_name).to.equal("Alice");
    expect(row.last_name).to.equal("Anderson");
    expect(row.avatar_src).to.equal("https://example.com/alice.png");
  });
  
  test("id and timestamp columns were populated by the database", function() {
    expect(res.body.data.response[0].id).to.exist;
    expect(res.body.data.response[0].created_at).to.exist;
  });
}

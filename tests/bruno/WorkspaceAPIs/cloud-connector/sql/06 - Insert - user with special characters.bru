meta {
  name: 06 - Insert - user with special characters
  type: http
  seq: 6
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/cloud-connector/camel/invoke
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:json {
  {
    "agentId": "00000000-0000-0000-0000-000000000000",
    "agentName": "USER_E2E",
    "provider": "sql",
    "action": "Insert",
    "credentialName": "{{SQL_CREDENTIAL_NAME}}",
    "payload": {
      "query_sql": "INSERT INTO users(user_name, first_name, last_name, avatar_src) VALUES ('josé@example.com', 'José', 'Müller', 'https://example.com/josé.png')",
      "payload": {}
    }
  }
}

vars:pre-request {
  SQL_CREDENTIAL_NAME: Apache_Camel
}

tests {
  test("status code is 200", function() {
    expect(res.status).to.equal(200);
  });
  
  test("insert with special characters succeeded", function() {
    expect(res.body.success).to.equal(true);
  });
}

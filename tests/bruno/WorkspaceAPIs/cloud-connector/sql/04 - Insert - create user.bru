meta {
  name: 04 - Insert - create user
  type: http
  seq: 4
}

post {
  url: {{WORKSPACE_APIS_BASE_URL}}/cloud-connector/camel/invoke
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:json {
  {
    "agentId": "00000000-0000-0000-0000-000000000000",
    "agentName": "USER_E2E",
    "provider": "sql",
    "action": "Insert",
    "credentialName": "{{SQL_CREDENTIAL_NAME}}",
    "payload": {
      "query_sql": "INSERT INTO users(user_name, first_name, last_name, avatar_src) VALUES ('alice@example.com', 'Alice', 'Anderson', 'https://example.com/alice.png')",
      "payload": {}
    }
  }
}

vars:pre-request {
  SQL_CREDENTIAL_NAME: Apache_Camel
}

tests {
  test("status code is 200", function() {
    expect(res.status).to.equal(200);
  });
  
  test("insert user succeeded", function() {
    expect(res.body.success).to.equal(true);
    expect(res.body.data.action).to.equal("Insert");
  });
}

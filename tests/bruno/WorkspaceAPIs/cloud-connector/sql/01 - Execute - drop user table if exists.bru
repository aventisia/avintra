meta {
  name: 01 - Execute - drop user table if exists
  type: http
  seq: 1
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/cloud-connector/camel/invoke
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:json {
  {
    "agentId": "00000000-0000-0000-0000-000000000000",
    "agentName": "USER_E2E",
    "provider": "sql",
    "action": "Execute",
    "credentialName": "{{SQL_CREDENTIAL_NAME}}",
    "payload": {
      "query_sql": "DROP TABLE IF EXISTS users",
      "payload": {}
    }
  }
}

vars:pre-request {
  SQL_CREDENTIAL_NAME: Apache_Camel
}

tests {
  test("status code is 200", function() {
    expect(res.status).to.equal(200);
  });
  
  test("cloud connector invoke succeeded", function() {
    expect(res.body.success).to.equal(true);
    expect(res.body.data.provider).to.equal("sql");
    expect(res.body.data.action).to.equal("Execute");
  });
}

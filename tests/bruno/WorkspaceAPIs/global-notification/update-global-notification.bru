meta {
  name: Update global notification
  type: http
  seq: 2
}

put {
  url: {{WORKSPACE_API_BASE_URL}}/notification/global/
  body: json
  auth: none
}

body:json {
  "id": "{{GLOBAL_NOTIFICATION_ID}}",
  "message": "{{$randomLoremParagraph}}",
  "type": "Alert",
  "actionUrl": "{{$randomImageUrl}}"
}

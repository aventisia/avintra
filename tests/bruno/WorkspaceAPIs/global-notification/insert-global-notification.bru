meta {
  name: Insert global notification
  type: http
  seq: 1
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/notification/global/
  body: json
  auth: none
}

body:json {
  "message": "{{$randomLoremParagraph}}",
  "type": "Information",
  "actionUrl": "{{$randomImageUrl}}"
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
          "GLOBAL_NOTIFICATION_ID",
          res.getBody().data.id
      );
  }
}

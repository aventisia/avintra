meta {
  name: Update flow ignores folder
  type: http
  seq: 13
}

put {
  url: {{WORKSPACE_API_BASE_URL}}/flow
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:json {
  {
    "id": "{{FOLDER_FLOW_ID}}",
    "folderId": "00000000-0000-0000-0000-000000000000",
    "type": "Agent",
    "name": "placeholder"
  }
}

script:pre-request {
  req.setBody({
    id: bru.getGlobalEnvVar("FOLDER_FLOW_ID"),
    folderId: "00000000-0000-0000-0000-000000000000",
    type: "Agent",
    name: bru.getGlobalEnvVar("FOLDER_FLOW_NAME"),
    isDisabled: false
  });
}

script:post-response {
  test("PUT flow leaves the folder unchanged", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.folderId).to.equal(bru.getGlobalEnvVar("FOLDER_ID"));
  });
}

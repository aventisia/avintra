meta {
  name: Delete flow used by folder requests
  type: http
  seq: 22
}

delete {
  url: {{WORKSPACE_API_BASE_URL}}/flow/{{FOLDER_FLOW_ID}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

script:post-response {
  test("flow is deleted with 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
}

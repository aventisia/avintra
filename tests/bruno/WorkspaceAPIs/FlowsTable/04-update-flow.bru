meta {
  name: Update flow
  type: http
  seq: 4
}

put {
  url: {{WORKSPACE_API_BASE_URL}}/flow
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:json {
  {
    "id": "{{FLOW_ID}}",
    "type": "Agent",
    "name": "{{$randomProductName}}",
    "description": "{{$randomLoremParagraph}}",
    "isDisabled": true
  }
}

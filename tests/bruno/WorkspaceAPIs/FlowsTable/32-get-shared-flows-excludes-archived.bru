meta {
  name: Get shared flows excludes archived by default
  type: http
  seq: 32
}

get {
  url: {{WORKSPACE_API_BASE_URL}}/flow/list/shared
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

script:post-response {
  test("archived shared flow is left out of the default list", function() {
    expect(res.getStatus()).to.equal(200);
    const flow = res.getBody().data.find(item => item.id === bru.getGlobalEnvVar("SHARED_ARCHIVED_FLOW_ID"));
    expect(flow).to.equal(undefined);
  });
}

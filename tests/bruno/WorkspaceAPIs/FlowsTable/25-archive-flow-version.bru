meta {
  name: Archive flow version
  type: http
  seq: 25
}

put {
  url: {{WORKSPACE_API_BASE_URL}}/flow-version/update
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:json {
  {
    "id": "{{ARCHIVED_FLOW_VERSION_ID}}",
    "flowId": "{{ARCHIVED_FLOW_ID}}",
    "isArchived": true
  }
}

script:post-response {
  test("flow version is archived", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.isArchived).to.equal(true);
  });
}

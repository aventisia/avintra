meta {
  name: Archive flow version
  type: http
  seq: 25
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/agent/{{ARCHIVED_FLOW_ID}}/archive
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

script:post-response {
  test("flow version is archived in one call", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data).to.equal(2);
  });
}

docs {
  > Archives the flow's unarchived versions through `POST agent/{flowId}/archive`; the
  > response `data` is the number of archived versions. The caller is the flow creator,
  > which is the access the Agents list actions rely on.
}

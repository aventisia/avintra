meta {
  name: Get flows includes archived on request
  type: http
  seq: 27
}

get {
  url: {{WORKSPACE_API_BASE_URL}}/flow/list?includeArchived=true
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

script:post-response {
  test("archived flow is listed with its archive state and version time", function() {
    expect(res.getStatus()).to.equal(200);
    const flow = res.getBody().data.find(item => item.id === bru.getGlobalEnvVar("ARCHIVED_FLOW_ID"));
    expect(flow).to.not.equal(undefined);
    expect(flow.isArchived).to.equal(true);
    const createdAt = new Date(bru.getGlobalEnvVar("ARCHIVED_FLOW_CREATED_ON")).getTime();
    expect(new Date(flow.lastModifiedOn).getTime()).to.be.at.least(createdAt);
  });
}

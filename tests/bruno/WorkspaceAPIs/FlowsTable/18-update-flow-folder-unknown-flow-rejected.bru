meta {
  name: Update flow folder unknown flow rejected
  type: http
  seq: 18
}

put {
  url: {{WORKSPACE_API_BASE_URL}}/flow/folder
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:json {
  {
    "flowId": "ffffffff-ffff-ffff-ffff-ffffffffffff",
    "folderId": null
  }
}

script:post-response {
  test("unknown flow returns 404", function() {
    expect(res.getStatus()).to.equal(404);
    expect(String(res.getBody())).to.equal("Agent not found");
  });
}

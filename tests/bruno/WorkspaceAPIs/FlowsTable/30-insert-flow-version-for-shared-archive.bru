meta {
  name: Insert flow version for shared archive checks
  type: http
  seq: 30
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/flow-version/create
  body: json
  auth: bearer
}

auth:bearer {
  token: {{TU_ACCESS_TOKEN}}
}

body:json {
  {
    "flowId": "{{SHARED_ARCHIVED_FLOW_ID}}"
  }
}

script:post-response {
  test("flow version is created for the shared archive checks", function() {
    expect(res.getStatus()).to.equal(200);
  });
  if (res.getStatus() == 200) {
    bru.setGlobalEnvVar("SHARED_ARCHIVED_FLOW_VERSION_ID", res.getBody().data.id);
  }
}

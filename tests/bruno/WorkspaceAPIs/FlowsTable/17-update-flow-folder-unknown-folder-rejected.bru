meta {
  name: Update flow folder unknown folder rejected
  type: http
  seq: 17
}

put {
  url: {{WORKSPACE_API_BASE_URL}}/flow/folder
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:json {
  {
    "flowId": "{{FOLDER_FLOW_ID}}",
    "folderId": "ffffffff-ffff-ffff-ffff-ffffffffffff"
  }
}

script:post-response {
  test("unknown folder returns 404", function() {
    expect(res.getStatus()).to.equal(404);
    expect(String(res.getBody())).to.equal("Folder not found");
  });
}

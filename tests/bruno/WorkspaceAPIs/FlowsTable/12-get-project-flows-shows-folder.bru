meta {
  name: Get flows shows folder
  type: http
  seq: 12
}

get {
  url: {{WORKSPACE_API_BASE_URL}}/flow/list
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

script:post-response {
  test("flow list reports the folder of the flow", function() {
    expect(res.getStatus()).to.equal(200);
    const flow = res.getBody().data.find(item => item.id === bru.getGlobalEnvVar("FOLDER_FLOW_ID"));
    expect(flow).to.not.equal(undefined);
    expect(flow.folderId).to.equal(bru.getGlobalEnvVar("FOLDER_ID"));
  });
}

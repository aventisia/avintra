meta {
  name: Update flow folder clear
  type: http
  seq: 14
}

put {
  url: {{WORKSPACE_API_BASE_URL}}/flow/folder
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:json {
  {
    "flowId": "{{FOLDER_FLOW_ID}}",
    "folderId": null
  }
}

script:post-response {
  test("flow is moved to the top level", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().message).to.equal("Agent moved");
  });
}

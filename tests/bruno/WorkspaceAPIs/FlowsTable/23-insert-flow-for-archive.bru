meta {
  name: Insert flow for archive checks
  type: http
  seq: 23
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/flow
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:json {
  {
    "type": "Agent",
    "name": "Archived agent {{$randomProductName}} {{$randomInt}}",
    "description": "Created to verify the archived filter."
  }
}

script:post-response {
  test("flow is created for the archive checks", function() {
    expect(res.getStatus()).to.equal(200);
  });
  if (res.getStatus() == 200) {
    bru.setGlobalEnvVar("ARCHIVED_FLOW_ID", res.getBody().data.id);
    bru.setGlobalEnvVar("ARCHIVED_FLOW_CREATED_ON", res.getBody().data.createdOn);
  }
}

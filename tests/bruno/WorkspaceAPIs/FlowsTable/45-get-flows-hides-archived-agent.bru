meta {
  name: Get flows hides the archived agent by default
  type: http
  seq: 45
}

get {
  url: {{WORKSPACE_API_BASE_URL}}/flow/list
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

script:post-response {
  test("archived agent is left out of the active list", function() {
    expect(res.getStatus()).to.equal(200);
    const flow = res.getBody().data.find(item => item.id === bru.getGlobalEnvVar("UNARCHIVE_FLOW_ID"));
    expect(flow).to.equal(undefined);
  });
}

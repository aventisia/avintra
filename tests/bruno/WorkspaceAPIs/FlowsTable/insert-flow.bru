meta {
  name: Insert flow
  type: http
  seq: 3
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/flow
  body: json
  auth: none
}

body:json {
  "type": "Agent",
  "name": "{{$randomProductName}}",
  "description": "{{$randomLoremParagraph}}"
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
          "FLOW_ID",
          res.getBody().data.id
      );
  }
}

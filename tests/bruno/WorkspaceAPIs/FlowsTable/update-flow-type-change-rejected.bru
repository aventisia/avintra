meta {
  name: Update flow type change rejected
  type: http
  seq: 5
}

put {
  url: {{WORKSPACE_API_BASE_URL}}/flow
  body: json
  auth: none
}

body:json {
  "id": "{{FLOW_ID}}",
  "type": "ChatAgent",
  "name": "{{$randomProductName}}",
  "description": "{{$randomLoremParagraph}}",
  "isDisabled": false
}

script:post-response {
  test("type change is rejected with 409", function() {
    expect(res.getStatus()).to.equal(409);
    expect(res.getBody().message).to.equal("Agent type cannot be changed after creation.");
  });
}

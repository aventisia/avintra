meta {
  name: Archive shared flow version
  type: http
  seq: 31
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/agent/{{SHARED_ARCHIVED_FLOW_ID}}/archive
  body: none
  auth: bearer
}

auth:bearer {
  token: {{TU_ACCESS_TOKEN}}
}

script:post-response {
  test("shared flow version is archived by its creator", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data).to.equal(2);
  });
}

docs {
  > `TU_ACCESS_TOKEN` is not an operations manager, so a 200 here shows the archive
  > endpoint is no longer role-gated to OM: the flow creator can archive it.
}

meta {
  name: Archive shared flow version
  type: http
  seq: 31
}

put {
  url: {{WORKSPACE_API_BASE_URL}}/flow-version/update
  body: json
  auth: bearer
}

auth:bearer {
  token: {{TU_ACCESS_TOKEN}}
}

body:json {
  {
    "id": "{{SHARED_ARCHIVED_FLOW_VERSION_ID}}",
    "flowId": "{{SHARED_ARCHIVED_FLOW_ID}}",
    "isArchived": true
  }
}

script:post-response {
  test("shared flow version is archived", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.isArchived).to.equal(true);
  });
}

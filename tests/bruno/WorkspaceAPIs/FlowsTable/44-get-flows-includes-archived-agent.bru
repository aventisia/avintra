meta {
  name: Get flows includes the archived agent
  type: http
  seq: 44
}

get {
  url: {{WORKSPACE_API_BASE_URL}}/flow/list?includeArchived=true
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

script:post-response {
  test("archived agent is listed with its archive state", function() {
    expect(res.getStatus()).to.equal(200);
    const flow = res.getBody().data.find(item => item.id === bru.getGlobalEnvVar("UNARCHIVE_FLOW_ID"));
    expect(flow).to.not.equal(undefined);
    expect(flow.isArchived).to.equal(true);
  });

  test("archive does not disable the agent", function() {
    const flow = res.getBody().data.find(item => item.id === bru.getGlobalEnvVar("UNARCHIVE_FLOW_ID"));
    expect(flow.isDisabled).to.not.equal(true);
  });
}

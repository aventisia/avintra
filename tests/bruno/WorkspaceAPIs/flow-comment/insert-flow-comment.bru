meta {
  name: Insert flow comment
  type: http
  seq: 3
}

post {
  url: {{WORKSPACE_APIS_BASE_URL}}/flow-comment/
  body: none
  auth: none
}

body:json {
  {
      
  }
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    flowId: bru.getGlobalEnvVar("FLOW_ID"),
    comment: faker.lorem.paragraph()
  })
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
          "FLOW_COMMENT_ID",
          res.getBody().data.id
      );
  }
}

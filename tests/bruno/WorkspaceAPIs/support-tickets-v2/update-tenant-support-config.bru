meta {
  name: Update Tenant Support Config (SA)
  type: http
  seq: 12
}

put {
  url: {{ACCOUNTS_APIS_BASE_URL}}/sa/tenants/{{tenant_id}}/support-config
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Cookie: {{workspace_session_cookie}}
  tntid: {{tenant_id}}
}

body:json {
  {
    "isChangeRequestEnabled": true
  }
}

assert {
  res.status: eq 200
  res.body.data: neq null
  res.body.data.isChangeRequestEnabled: eq true
}

meta {
  name: Get Tenant Support Config (SA)
  type: http
  seq: 11
}

get {
  url: {{ACCOUNTS_APIS_BASE_URL}}/sa/tenants/{{tenant_id}}/support-config
  body: none
  auth: none
}

headers {
  Cookie: {{workspace_session_cookie}}
  tntid: {{tenant_id}}
}

assert {
  res.status: eq 200
  res.body.data: neq null
  res.body.data.isChangeRequestEnabled: isBool
}

meta {
  name: Add Comment
  type: http
  seq: 8
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/support-tickets/{{ticket_id}}/comments
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Cookie: {{workspace_session_cookie}}
  tntid: {{tenant_id}}
}

body:json {
  {
    "message": "This is a test comment on the support ticket."
  }
}

assert {
  res.status: eq 200
  res.body.data: neq null
  res.body.data.message: eq "This is a test comment on the support ticket."
}

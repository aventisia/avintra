meta {
  name: Get Ticket Detail
  type: http
  seq: 5
}

get {
  url: {{WORKSPACE_APIS_BASE_URL}}/support-tickets/{{ticket_id}}
  body: none
  auth: none
}

headers {
  Cookie: {{workspace_session_cookie}}
  tntid: {{tenant_id}}
}

assert {
  res.status: eq 200
  res.body.data: neq null
  res.body.data.id: eq "{{ticket_id}}"
}

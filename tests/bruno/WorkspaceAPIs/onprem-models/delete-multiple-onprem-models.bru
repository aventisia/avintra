meta {
  name: Delete multiple onprem models
  type: http
  seq: 10
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/onprem-model/delete-multiple
  body: json
  auth: none
}

body:json {
  ["{{ON_PREM_MODEL_ID}}"]
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
        "ON_PREM_MODEL_ID", 
        "00000000-0000-0000-0000-000000000000"
      );
  }
}

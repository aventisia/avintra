meta {
  name: Delete onprem model
  type: http
  seq: 8
}

delete {
  url: {{WORKSPACE_API_BASE_URL}}/onprem-model/{{ON_PREM_MODEL_ID}}
  body: none
  auth: none
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
        "ON_PREM_MODEL_ID", 
        "00000000-0000-0000-0000-000000000000"
      );
  }
}

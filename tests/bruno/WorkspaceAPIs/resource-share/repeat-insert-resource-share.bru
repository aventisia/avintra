meta {
  name: Repeat - Insert resource share
  type: http
  seq: 7
}

post {
  url: {{WORKSPACE_APIS_BASE_URL}}/resource-share
  body: json
  auth: none
}

body:json {
  {
    "resourceType": "AppSecret",
    "resourceId": "{{APP_SECRET_ID}}",
    "accessLevel": "View",
    "userId": "{{USER_ID}}"
  }
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
          "RESOURCE_SHARE_ID", res.getBody().data.id
      );
  }
}

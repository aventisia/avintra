meta {
  name: Delete resource share
  type: http
  seq: 6
}

delete {
  url: {{WORKSPACE_APIS_BASE_URL}}/resource-share/{{RESOURCE_SHARE_ID}}
  body: none
  auth: none
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
        "Flow_VERSION_USER_ID", 
        "00000000-0000-0000-0000-000000000000"
      );
  }
}

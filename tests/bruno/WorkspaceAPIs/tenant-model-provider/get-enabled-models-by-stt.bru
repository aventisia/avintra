meta {
  name: Get enabled models by STT capability
  type: http
  seq: 2
}

get {
  url: {{WORKSPACE_API_BASE_URL}}/tenant-model-provider/enabled-models?capability=Stt
  body: none
  auth: none
}

params:query {
  capability: Stt
}

headers {
  Cookie: {{workspace_session_cookie}}
  tntid: {{tenant_id}}
}

assert {
  res.status: eq 200
  res.body.data: isArray
}

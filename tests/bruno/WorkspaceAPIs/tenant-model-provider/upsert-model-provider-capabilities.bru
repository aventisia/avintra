meta {
  name: Upsert model provider with capability payload
  type: http
  seq: 5
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/tenant-model-provider
  body: json
  auth: none
}

headers {
  Cookie: {{workspace_session_cookie}}
  tntid: {{tenant_id}}
}

body:json {
  {
    "providerType": "OpenAI",
    "enabledModelIds": ["gpt-4o-mini", "text-embedding-3-small"],
    "enabledModels": [
      { "modelId": "gpt-4o-mini", "capability": "Text" },
      { "modelId": "text-embedding-3-small", "capability": "Embedding" }
    ],
    "isDisabled": false
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
}

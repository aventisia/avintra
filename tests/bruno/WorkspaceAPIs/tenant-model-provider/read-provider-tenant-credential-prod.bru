meta {
  name: OpenAI provider reads the tenant credential in Prod, not legacy
  type: http
  seq: 10
}

get {
  url: {{WORKSPACE_API_BASE_URL}}/tenant-model-provider/list
  body: none
  auth: none
}

headers {
  X-Env-Type: Prod
}

script:post-response {
  const body = res.getBody() || {};
  const status = res.getStatus();
  const p = (Array.isArray(body.data) ? body.data : []).find((x) => x.providerType === "OpenAI") || {};
  if (status === 200 && p.credentialName === bru.getVar("TENANT_CRED_NAME") && p.isLegacyCredential === false) { bru.pass("OpenAI provider reads the tenant credential in Prod, not legacy"); } else { bru.fail("OpenAI provider reads the tenant credential in Prod, not legacy: got " + status + " " + p.credentialName + " legacy=" + p.isLegacyCredential); }
}

docs {
  > Run right after upsert-provider-with-tenant-credential-cross-space. Add `X-Space-Id` of another space to prove the cross-space read.
}

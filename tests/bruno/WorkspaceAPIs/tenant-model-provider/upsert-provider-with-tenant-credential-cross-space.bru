meta {
  name: Upsert provider with a tenant credential, read it from another space and Prod
  type: http
  seq: 8
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/tenant-model-provider
  body: json
  auth: none
}

body:json {
  {
    "providerType": "OpenAI",
    "enabledModelIds": ["gpt-4o-mini"],
    "isDisabled": false,
    "credentialName": "{{TENANT_CRED_NAME}}"
  }
}

script:post-response {
  const status = res.getStatus();
  if (status === 200) { bru.pass("Provider saved with the tenant credential"); } else { bru.fail("Upsert failed: " + status); }
}

docs {
  > Run `Orchestrator/tenant-vault-credentials/01-` first. Then list providers with another
  > `X-Space-Id` and `X-Env-Type: Prod`: `credentialName` equals the tenant name and
  > `isLegacyCredential` is false. A provider on a space credential reports `isLegacyCredential: true`.
}

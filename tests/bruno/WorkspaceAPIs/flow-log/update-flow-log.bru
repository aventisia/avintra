meta {
  name: Update flow log
  type: http
  seq: 4
}

put {
  url: {{WORKSPACE_API_BASE_URL}}/Flow-log
  body: json
  auth: none
}

body:json {
  "flowId": "{{FLOW_ID}}",
  "id": "{{FLOW_LOG_ID}}",
  "startTime": "{{$isoTimestamp}}",
  "status": "Failed1",
  "duration": 1234,
  "remark": "{{$randomProductName}}",
  "version": "{{$randomFloat}}",
  "flowName": "{{$randomProductName}}"
}

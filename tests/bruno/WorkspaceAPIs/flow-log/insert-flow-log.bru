meta {
  name: Insert flow log
  type: http
  seq: 3
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/Flow-log
  body: json
  auth: none
}

body:json {
  "flowId": "{{FLOW_ID}}",
  "startTime": "{{$isoTimestamp}}",
  "status": "Failed1",
  "duration": 1234,
  "remark": "{{$randomProductName}}",
  "version": "{{$randomFloat}}",
  "flowName": "{{$randomProductName}}"
}

script:post-response {
  if(res.getStatus() == 200){
    bru.setGlobalEnvVar(
    "FLOW_LOG_ID",
    res.getBody().data.id
    );
  }
}

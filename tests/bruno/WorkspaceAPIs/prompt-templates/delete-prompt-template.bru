meta {
  name: Delete prompt template
  type: http
  seq: 8
}

delete {
  url: {{WORC_APIS_BASE_URL}}/prompt-template/{{PROMPT_TEMPLATE_ID}}
  body: none
  auth: none
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
        "PROMPT_TEMPLATE_ID", 
        "00000000-0000-0000-0000-000000000000"
      );
  }
}

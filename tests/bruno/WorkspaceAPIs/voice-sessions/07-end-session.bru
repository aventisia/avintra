meta {
  name: End realtime live voice session
  type: http
  seq: 7
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/assist/voice/sessions/{{VOICE_REALTIME_LIVE_CONVERSATION_ID}}/end
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

script:post-response {
  test("ends the session idempotently", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()?.data).to.equal(true);
  });
}

docs {
  > Ends the live session created by request 06. WorkspaceAPIs marks the
  > conversation `Completed` immediately, so the row stops counting against
  > `MAX_ACTIVE_VOICE_SESSIONS_PER_USER` even when no worker picked up the
  > dispatch. Request 08 repeats it to prove the end is idempotent.
}

meta {
  name: Delete flow
  type: http
  seq: 12
}

delete {
  url: {{WORKSPACE_APIS_BASE_URL}}/flow/{{FLOW_ID}}
  body: none
  auth: none
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    id: bru.getGlobalEnvVar("FLOW_VERSION_ID"),
  })
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
        "FLOW_ID", 
        "00000000-0000-0000-0000-000000000000"
      );
  }
}

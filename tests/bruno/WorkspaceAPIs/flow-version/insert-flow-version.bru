meta {
  name: Insert flow version
  type: http
  seq: 3
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/flow-version/create
  body: json
  auth: none
}

body:json {
  "flowId": "{{FLOW_ID}}",
  "isLocked": "{{$randomBoolean}}",
  "isDraft": "{{$randomBoolean}}"
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
          "FLOW_VERSION_ID",
          res.getBody().data.id
      );
  }
}

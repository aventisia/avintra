meta {
  name: Delete flow version
  type: http
  seq: 11
}

delete {
  url: {{WORKSPACE_API_BASE_URL}}/flow-version/delete/{{FLOW_VERSION_ID}}
  body: json
  auth: none
}

body:json {
  "id": "{{FLOW_VERSION_ID}}"
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
        "FLOW_VERSION_ID", 
        "00000000-0000-0000-0000-000000000000"
      );
  }
}

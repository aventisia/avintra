meta {
  name: Update flow block
  type: http
  seq: 4
}

put {
  url: {{WORKSPACE_API_BASE_URL}}/block
  body: json
  auth: none
}

body:json {
  "id": "{{FLOW_BLOCK_ID}}",
  "name": "{{$randomProductName}}",
  "description": "{{$randomLoremParagraph}}",
  "reactFlowObject": "",
  "flowVariablesObject": "",
  "inputOutputObject": "",
  "flowVersionId": "{{FLOW_VERSION_ID}}",
  "type": "TenantLevel",
  "isDisabled": false
}

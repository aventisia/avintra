meta {
  name: Delete flow block
  type: http
  seq: 6
}

delete {
  url: {{WORKSPACE_APIS_BASE_URL}}/block/{{FLOW_BLOCK_ID}}
  body: none
  auth: none
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
        "FLOW_USER_ID", 
        "00000000-0000-0000-0000-000000000000"
      );
  }
}

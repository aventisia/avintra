meta {
  name: Insert flow block
  type: http
  seq: 2
}

post {
  url: {{WORKSPACE_APIS_BASE_URL}}/block
  body: none
  auth: none
}

body:json {
  {
      
  }
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    name: faker.commerce.product(),
    description: faker.lorem.paragraph(),
    reactFlowObject: "{nodes: [], edges: [], viewport: {x: 0, y: 0,zoom: 1}}",
    flowVariablesObject: "",
    inputOutputObject: "",
    flowVersionId: bru.getGlobalEnvVar("FLOW_VERSION_ID"),
    type: "TenantLevel"
  })
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
          "FLOW_BLOCK_ID",
          res.getBody().data.id
      );
  }
}

meta {
  name: Insert flow block
  type: http
  seq: 2
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/block
  body: json
  auth: none
}

body:json {
  "name": "{{$randomProductName}}",
  "description": "{{$randomLoremParagraph}}",
  "reactFlowObject": "{nodes: [], edges: [], viewport: {x: 0, y: 0,zoom: 1}}",
  "flowVariablesObject": "",
  "inputOutputObject": "",
  "flowVersionId": "{{FLOW_VERSION_ID}}",
  "type": "TenantLevel"
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
          "FLOW_BLOCK_ID",
          res.getBody().data.id
      );
  }
}

meta {
  name: Delete multiple flow blocks
  type: http
  seq: 8
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/block/delete-multiple
  body: json
  auth: none
}

body:json {
  [
    "{{FLOW_BLOCK_ID}}"
  ]
}
script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
        "FLOW_BLOCK_ID", 
        "00000000-0000-0000-0000-000000000000"
      );
  }
}

docs {
  > TODO: Implement functionality to delete multiple flows only if the user provides an OTP or password, especially when the flows are linked to other sub-content.
}

meta {
  name: Insert node execution logs
  type: http
  seq: 2
}

post {
  url: {{WORKSPACE_APIS_BASE_URL}}/execution/logs/{{JOB_ID}}
  body: json
  auth: none
}

body:json {
  [
    {
      "nodeExecutionId": "{{NODE_EXECUTION_ID}}",
      "retryAttempt": 0,
      "nodeId": "{{NODE_ID}}",
      "nodeDisplayName": "{{NODE_DISPLAY_NAME}}",
      "nodeUniqueName": "{{NODE_UNIQUE_NAME}}",
      "isSuccess": true,
      "duration": 1.5,
      "inputs": {
        "input1": "value1"
      },
      "outputs": {
        "output1": "value1"
      }
    }
  ]
}

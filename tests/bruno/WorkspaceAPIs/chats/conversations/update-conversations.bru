meta {
  name: Update conversations
  type: http
  seq: 2
}

put {
  url: {{WORC_APIS_BASE_URL}}/assist/conversations
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:json {
  {
    "id": "{{CONVERSATION_ID}}",
    "flowVersionId": "{{FLOW_VERSION_ID}}",
    "userId": "{{USER_ID}}",
    "title": "Untitled Conversation",
    "status": "Active",
    "isDisabled": false
  }
}

meta {
  name: Delete conversation
  type: http
  seq: 9
}

delete {
  url: {{WORC_APIS_BASE_URL}}/assist/conversations/{{CONVERSATION_ID}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
        "Flow_VERSION_USER_ID", 
        "00000000-0000-0000-0000-000000000000"
      );
  }
}

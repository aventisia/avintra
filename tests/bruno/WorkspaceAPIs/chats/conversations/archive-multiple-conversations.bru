meta {
  name: Archive multiple conversations
  type: http
  seq: 5
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/assist/conversations/bulk/archive
  body: json
  auth: none
}

body:json {
  ["{{CONVERSATION_ID}}"]
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
        "FLOW_VERSION_USER_ID", 
        "00000000-0000-0000-0000-000000000000"
      );
  }
}

docs {

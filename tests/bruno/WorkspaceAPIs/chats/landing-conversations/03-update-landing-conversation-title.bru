meta {
  name: Update landing conversation title
  type: http
  seq: 3
}

put {
  url: {{WORKSPACE_API_BASE_URL}}/assist/conversations/landing/title
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:json {
  {
    "id": "{{LANDING_CONVERSATION_ID}}",
    "title": "placeholder"
  }
}

script:pre-request {
  const title = `  Quarterly 100%_plan ${Date.now()}  `;
  bru.setVar("LANDING_TITLE", title.trim());
  req.setBody({ id: bru.getVar("LANDING_CONVERSATION_ID"), title });
}

script:post-response {
  test("title is saved", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data).to.equal(true);
  });
}

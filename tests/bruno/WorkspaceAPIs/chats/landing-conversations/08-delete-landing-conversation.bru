meta {
  name: Delete landing conversation
  type: http
  seq: 8
}

delete {
  url: {{WORKSPACE_API_BASE_URL}}/assist/conversations/{{LANDING_CONVERSATION_ID}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

script:post-response {
  test("conversation is deleted", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data).to.equal(true);
  });
}

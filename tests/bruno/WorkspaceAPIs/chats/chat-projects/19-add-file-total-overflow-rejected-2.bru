meta {
  name: Total over 100 KB is refused
  type: http
  seq: 19
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/assist/chat-projects/{{CHAT_PROJECT_ID}}/files
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:json {
  {"name": "fill-2.txt", "content": ""}
}

script:post-response {
  test("the total cap is enforced", function() {
    expect(res.getStatus()).to.equal(400);
    expect(String(res.getBody())).to.contain("100 KB");
  });
}

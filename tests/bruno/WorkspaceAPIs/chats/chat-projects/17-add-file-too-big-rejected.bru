meta {
  name: Add file over 50 KB
  type: http
  seq: 17
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/assist/chat-projects/{{CHAT_PROJECT_ID}}/files
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:json {
  {"name": "big.txt", "content": ""}
}

script:post-response {
  test("an over-size file is refused", function() {
    expect(res.getStatus()).to.equal(400);
    expect(String(res.getBody())).to.contain("50 KB");
  });
}

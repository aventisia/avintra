meta {
  name: Clear project instructions
  type: http
  seq: 24
}

put {
  url: {{WORKSPACE_API_BASE_URL}}/assist/chat-projects
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:json {
  {"id": "{{CHAT_PROJECT_ID}}", "name": "Renamed again", "instructions": "  "}
}

script:post-response {
  test("blank instructions clear them", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.instructions == null).to.equal(true);
  });
}

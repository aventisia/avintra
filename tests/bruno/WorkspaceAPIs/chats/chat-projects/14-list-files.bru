meta {
  name: List project files
  type: http
  seq: 14
}

get {
  url: {{WORKSPACE_API_BASE_URL}}/assist/chat-projects/{{CHAT_PROJECT_ID}}/files
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}


script:post-response {
  test("the file is listed without its content", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.length).to.equal(1);
    expect(res.getBody().data[0].content).to.equal(undefined);
  });
}

meta {
  name: Add files past the 100 KB total
  type: http
  seq: 18
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/assist/chat-projects/{{CHAT_PROJECT_ID}}/files
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:json {
  {"name": "fill-1.txt", "content": ""}
}

script:post-response {
  test("a 50 KB file fits next to the small one", function() {
    expect(res.getStatus()).to.equal(201);
    if (res.getStatus() == 201) bru.setVar("CHAT_PROJECT_FILL_ID", res.getBody().data.id);
  });
}

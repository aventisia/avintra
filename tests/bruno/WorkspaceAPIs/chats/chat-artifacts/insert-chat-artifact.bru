meta {
  name: Insert chat artifact
  type: http
  seq: 1
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/assist/chat-artifacts
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:json {
  {
    "conversationId": "{{CONVERSATION_ID}}",
    "name": "notes.txt",
    "contentType": "text/plain",
    "sizeBytes": 1024,
    "blobPath": "data:text/plain;base64,aGVsbG8=",
    "sourceArtifact": null,
    "origin": "Generated"
  }
}

script:post-response {
  test("the file is added", function() { expect(res.getStatus()).to.equal(201); });
  if (res.getStatus() == 201) bru.setVar("CHAT_ARTIFACT_ID", res.getBody().data.id);
}

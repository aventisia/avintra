meta {
  name: Generate file from spec
  type: http
  seq: 2
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/assist/chat-artifacts/generate-from-spec
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:json {
  {
    "conversationId": "{{CONVERSATION_ID}}",
    "spec": "```sheet-spec\n{\"title\": \"Q3 spend\", \"columns\": [\"Category\", \"Amount\", \"Paid\"], \"rows\": [[\"Cloud\", 128000, true], [\"Travel\", 18000, false]]}\n```"
  }
}

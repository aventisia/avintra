meta {
  name: Unshare conversation
  type: http
  seq: 12
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/assist/conversations/{{ACTIONS_CONVERSATION_ID}}/unshare
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

script:post-response {
  test("sharing is stopped", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data).to.equal(true);
  });
}

meta {
  name: Unarchive conversation
  type: http
  seq: 9
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/assist/conversations/{{ACTIONS_CONVERSATION_ID}}/unarchive
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

script:post-response {
  test("conversation is restored", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data).to.equal(true);
  });
}

meta {
  name: Insert landing conversation
  type: http
  seq: 1
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/assist/conversations
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:json {
  {}
}

script:post-response {
  test("conversation is created", function() { expect(res.getStatus()).to.equal(200); });
  if (res.getStatus() == 200) bru.setVar("ACTIONS_CONVERSATION_ID", res.getBody().data.id);
}

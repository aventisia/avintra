meta {
  name: Update flow version user
  type: http
  seq: 4
}

put {
  url: {{WORC_APIS_BASE_URL}}/flowversion-user
  body: json
  auth: bearer
}

body:json {
  {
    "id": "{{FLOW_VERSION_USER_ID}}",
    "flowVersionId": "{{FLOW_VERSION_ID}}",
    "userId": "{{USER_ID}}",
    "isDisabled": false
  }
}

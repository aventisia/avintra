meta {
  name: Insert time trigger
  type: http
  seq: 2
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/time-trigger
  body: json
  auth: none
}

body:json {
  [
    {
      "name": "Test",
      "timezone": "Asia/Kolkata",
      "frequency": "Daily",
      "interval": 1,
      "atTime": "10:30:00",
      "weekdays": [],
      "monthDays": [],
      "agentIds": [],
      "effectiveDate": "2025-11-11T09:01:55.770Z",
      "endDate": "2025-12-11T09:01:55.770Z",
      "lastTriggeredTime": "2025-11-07T09:01:55.770Z",
      "nextTriggerTime": "2025-11-07T09:01:55.770Z",
      "exceptionHours": [
        0
      ],
      "exceptionWeekdays": [
        "Sunday"
      ],
      "exceptionDates": [
        "2025-11-07"
  ]
  }
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
          "TIME_TRIGGER_ID",
          res.getBody().data.id
      );
  }
}

meta {
  name: Delete multiple time triggers
  type: http
  seq: 7
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/time-trigger/delete-multiple
  body: json
  auth: none
}

body:json {
  [
    "{{TIME_TRIGGER_ID}}"
  ]
}
script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
        "TIME_TRIGGER_ID", 
        "00000000-0000-0000-0000-000000000000"
      );
  }
}

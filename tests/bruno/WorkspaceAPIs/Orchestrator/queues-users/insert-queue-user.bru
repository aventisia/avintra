meta {
  name: Insert queue user
  type: http
  seq: 2
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/queue-user
  body: json
  auth: none
}

body:json {
  {
    "queueId": "{{QUEUE_ID}}",
    "userId": "{{USER_ID}}"
  }
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
          "QUEUE_USER_ID", res.getBody().data.id
      );
  }
}

meta {
  name: Delete queue user
  type: http
  seq: 7
}

delete {
  url: {{WORKSPACE_API_BASE_URL}}/queue-user/{{QUEUE_USER_ID}}
  body: none
  auth: none
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
        "QUEUE_USER_ID", 
        "00000000-0000-0000-0000-000000000000"
      );
  }
}

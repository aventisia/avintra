meta {
  name: Create tenant credential with a non-model type (expect 400)
  type: http
  seq: 2
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/tenant-vault-credential
  body: json
  auth: none
}

body:json {
  {"name": "bruno-tenant-m365-{{$randomInt}}", "description": "bruno", "type": "EmailClient", "data": {"imapServer": "", "username": "", "password": "", "port": ""}}
}

script:post-response {
  const body = res.getBody() || {};
  const message = typeof body.message === "string" ? body.message : "";
  const status = res.getStatus();
  if (status === 400) { bru.pass("Non-model type rejected"); } else { bru.fail("Non-model type rejected: got " + status + " - " + message); }
}

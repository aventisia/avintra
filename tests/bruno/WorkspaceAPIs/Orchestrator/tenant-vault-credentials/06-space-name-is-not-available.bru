meta {
  name: Space name check sees the tenant name (expect false)
  type: http
  seq: 6
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/vault-credential/is-available
  body: json
  auth: none
}

headers {
  X-Env-Type: Dev
}

body:json {
  {"userInput": "{{TENANT_CRED_NAME}}"}
}

script:post-response {
  const body = res.getBody() || {};
  const message = typeof body.message === "string" ? body.message : "";
  const status = res.getStatus();
  if (status === 200 && body.data && body.data.result === false) { bru.pass("Tenant name reported as taken"); } else { bru.fail("Tenant name reported as taken: got " + status + " - " + message); }
}

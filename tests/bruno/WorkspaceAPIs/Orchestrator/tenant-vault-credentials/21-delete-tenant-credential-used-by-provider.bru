meta {
  name: Delete a tenant credential a provider uses (expect 400)
  type: http
  seq: 21
}

delete {
  url: {{WORKSPACE_API_BASE_URL}}/tenant-vault-credential/{{TENANT_CRED_ID}}
  body: none
  auth: none
}

script:post-response {
  const body = res.getBody() || {};
  const message = typeof body.message === "string" ? body.message : "";
  const status = res.getStatus();
  if (status === 400 && message.includes("model provider")) { bru.pass("Delete blocked with provider named"); } else { bru.fail("Delete blocked with provider named: got " + status + " - " + message); }
}

docs {
  > Needs the provider upsert request to have run (see folder docs). Keep that provider link for 22.
}

meta {
  name: Create a Dev space credential (expect 200)
  type: http
  seq: 3
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/vault-credential
  body: json
  auth: none
}

headers {
  X-Env-Type: Dev
}

body:json {
  {"name": "bruno-space-{{$randomInt}}", "description": "bruno", "type": "OpenAI", "data": {"apiKey": "sk-bruno-fake-{{$randomInt}}"}}
}

script:post-response {
  const body = res.getBody() || {};
  const message = typeof body.message === "string" ? body.message : "";
  const status = res.getStatus();
  if (status === 200 && body.data) { bru.setVar("SPACE_CRED_NAME", body.data.name); bru.setVar("SPACE_CRED_ID", body.data.id); }
  if (status === 200) { bru.pass("Space credential created"); } else { bru.fail("Space credential created: got " + status + " - " + message); }
}

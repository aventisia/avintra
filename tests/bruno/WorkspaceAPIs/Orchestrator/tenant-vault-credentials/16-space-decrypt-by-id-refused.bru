meta {
  name: Space decrypt by id does not return the tenant secret
  type: http
  seq: 16
}

get {
  url: {{WORKSPACE_API_BASE_URL}}/vault-credential/decrypted-data/{{TENANT_CRED_ID}}
  body: none
  auth: none
}

script:post-response {
  const body = res.getBody() || {};
  const message = typeof body.message === "string" ? body.message : "";
  const status = res.getStatus();
  const refused = [400, 404].includes(status) || (status === 200 && !(body.data && (body.data.id || body.data.apiKey)));
  if (refused && !JSON.stringify(body).includes("sk-bruno-fake")) { bru.pass("No secret returned"); } else { bru.fail("No secret returned: got " + status + " - " + message); }
}

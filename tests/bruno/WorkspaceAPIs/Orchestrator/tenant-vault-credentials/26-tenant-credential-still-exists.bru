meta {
  name: Tenant credential survived the space-side attempts
  type: http
  seq: 26
}

get {
  url: {{WORKSPACE_API_BASE_URL}}/tenant-vault-credential/list
  body: none
  auth: none
}

script:post-response {
  const body = res.getBody() || {};
  const list = Array.isArray(body.data) ? body.data : [];
  const status = res.getStatus();
  if (status === 200 && list.some((c) => c.id === bru.getVar("TENANT_CRED_ID") && c.name === bru.getVar("TENANT_CRED_NAME"))) { bru.pass("Tenant credential unchanged"); } else { bru.fail("Tenant credential unchanged: got " + status); }
}

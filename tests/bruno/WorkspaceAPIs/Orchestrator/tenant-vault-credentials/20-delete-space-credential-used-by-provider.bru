meta {
  name: Delete a credential a provider uses (expect 400 naming the provider)
  type: http
  seq: 20
}

delete {
  url: {{WORKSPACE_API_BASE_URL}}/vault-credential/{{PROVIDER_CRED_ID}}
  body: none
  auth: none
}

script:post-response {
  const body = res.getBody() || {};
  const message = typeof body.message === "string" ? body.message : "";
  const status = res.getStatus();
  if (status === 400 && message.includes("model provider")) { bru.pass("Delete blocked with provider named"); } else { bru.fail("Delete blocked with provider named: got " + status + " - " + message); }
}

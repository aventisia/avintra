meta {
  name: Forged numeric X-Env-Type still hides the tenant credential
  type: http
  seq: 14
}

get {
  url: {{WORKSPACE_API_BASE_URL}}/vault-credential/list
  body: none
  auth: none
}

headers {
  X-Env-Type: 2
}

script:post-response {
  const body = res.getBody() || {};
  const message = typeof body.message === "string" ? body.message : "";
  const status = res.getStatus();
  const text = JSON.stringify(body.data || []);
  if (status === 200 && !text.includes(bru.getVar("TENANT_CRED_NAME"))) { bru.pass("Tenant credential absent"); } else { bru.fail("Tenant credential absent: got " + status + " - " + message); }
}

meta {
  name: Direct decrypt by name refused for admin
  type: http
  seq: 17
}

get {
  url: {{WORKSPACE_API_BASE_URL}}/vault-credential/decrypted-data/by-name/{{TENANT_CRED_NAME}}
  body: none
  auth: none
}

script:post-response {
  const body = res.getBody() || {};
  const message = typeof body.message === "string" ? body.message : "";
  const status = res.getStatus();
  if (!JSON.stringify(body).includes("sk-bruno-fake") && message.includes("not found")) { bru.pass("Admin gets not-found, no secret"); } else { bru.fail("Admin gets not-found, no secret: got " + status + " - " + message); }
}

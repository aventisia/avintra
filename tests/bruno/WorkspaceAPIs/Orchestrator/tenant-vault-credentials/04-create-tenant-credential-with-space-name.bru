meta {
  name: Create tenant credential named like a space credential (expect 409)
  type: http
  seq: 4
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/tenant-vault-credential
  body: json
  auth: none
}

body:json {
  {"name": "{{SPACE_CRED_NAME}}", "description": "bruno", "type": "OpenAI", "data": {"apiKey": "sk-bruno-fake-1"}}
}

script:post-response {
  const body = res.getBody() || {};
  const message = typeof body.message === "string" ? body.message : "";
  const status = res.getStatus();
  if (status === 409) { bru.pass("Tenant create rejected for existing space name"); } else { bru.fail("Tenant create rejected for existing space name: got " + status + " - " + message); }
}

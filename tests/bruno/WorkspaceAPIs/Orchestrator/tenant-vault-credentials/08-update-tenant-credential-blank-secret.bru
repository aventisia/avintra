meta {
  name: Update tenant credential with a blank secret (expect 200)
  type: http
  seq: 8
}

put {
  url: {{WORKSPACE_API_BASE_URL}}/tenant-vault-credential
  body: json
  auth: none
}

body:json {
  {"id": "{{TENANT_CRED_ID}}", "name": "{{TENANT_CRED_NAME}}", "description": "edited", "type": "OpenAI", "data": {"apiKey": ""}}
}

script:post-response {
  const body = res.getBody() || {};
  const message = typeof body.message === "string" ? body.message : "";
  const status = res.getStatus();
  if (status === 200) { bru.pass("Tenant credential updated"); } else { bru.fail("Tenant credential updated: got " + status + " - " + message); }
}

meta {
  name: Create tenant credential while Prod is selected (expect 200)
  type: http
  seq: 1
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/tenant-vault-credential
  body: json
  auth: none
}

headers {
  X-Env-Type: Prod
}

body:json {
  {"name": "bruno-tenant-{{$randomInt}}", "description": "bruno", "type": "OpenAI", "data": {"apiKey": "sk-bruno-fake-{{$randomInt}}"}}
}

script:post-response {
  const body = res.getBody() || {};
  const message = typeof body.message === "string" ? body.message : "";
  const status = res.getStatus();
  const d = body.data || {};
  if (status === 200 && d.id) { bru.setVar("TENANT_CRED_ID", d.id); bru.setVar("TENANT_CRED_NAME", d.name); }
  if (status === 200 && d.id) { bru.pass("Tenant credential created while Prod is selected"); } else { bru.fail("Tenant credential created while Prod is selected: got " + status + " - " + message); }
}

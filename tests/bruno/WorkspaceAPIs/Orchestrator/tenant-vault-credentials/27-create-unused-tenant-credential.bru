meta {
  name: Create a tenant credential no provider uses (expect 200)
  type: http
  seq: 27
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/tenant-vault-credential
  body: json
  auth: none
}

body:json {
  {"name": "bruno-tenant-unused-{{$randomInt}}", "description": "bruno", "type": "OpenAI", "data": {"apiKey": "sk-bruno-fake-{{$randomInt}}"}}
}

script:post-response {
  const body = res.getBody() || {};
  const message = typeof body.message === "string" ? body.message : "";
  const status = res.getStatus();
  const d = body.data || {};
  if (status === 200 && d.id) { bru.setVar("UNUSED_TENANT_CRED_ID", d.id); bru.setVar("UNUSED_TENANT_CRED_NAME", d.name); }
  if (status === 200 && d.id) { bru.pass("Unused tenant credential created"); } else { bru.fail("Unused tenant credential created: got " + status + " - " + message); }
}

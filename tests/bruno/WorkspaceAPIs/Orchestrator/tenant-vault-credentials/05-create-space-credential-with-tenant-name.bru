meta {
  name: Create space credential named like a tenant credential (expect 409)
  type: http
  seq: 5
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/vault-credential
  body: json
  auth: none
}

headers {
  X-Env-Type: Dev
}

body:json {
  {"name": "{{TENANT_CRED_NAME}}", "description": "bruno", "type": "OpenAI", "data": {"apiKey": "sk-bruno-fake-1"}}
}

script:post-response {
  const body = res.getBody() || {};
  const message = typeof body.message === "string" ? body.message : "";
  const status = res.getStatus();
  if (status === 409) { bru.pass("Space create rejected for existing tenant name"); } else { bru.fail("Space create rejected for existing tenant name: got " + status + " - " + message); }
}

meta {
  name: Model call through the pipeline reaches the provider's tenant credential
  type: http
  seq: 22
}

post {
  url: {{LLMPIPELINE_API_BASE_URL}}/llm/generate
  body: json
  auth: bearer
}

auth:bearer {
  token: {{SPACE_USER_ACCESS_TOKEN}}
}

body:json {
  {
    "provider": "openai",
    "model": "gpt-4o-mini",
    "input": [{"role": "user", "content": "Say hi"}],
    "credential_name": "{{TENANT_CRED_NAME}}",
    "stream": false,
    "ref_type": "Platform",
    "ref_id": "",
    "ref_name": "",
    "action": "bruno_tenant_credential"
  }
}

script:post-response {
  const status = res.getStatus();
  const text = JSON.stringify(res.getBody() || {});
  const accepted = ![401, 403, 404, 422].includes(status) && !text.includes("No valid credentials found");
  if (accepted && !text.includes("sk-bruno-fake")) { bru.pass("Pipeline token accepted, no secret"); } else { bru.fail("Pipeline token accepted, no secret: got " + status + " - " + text.slice(0, 300)); }
}

docs {
  > Proves the model-call token the pipeline mints (Python) passes `ModelCallTokenHelper` (C#). Runs as a non-admin.
  > The fake key then fails at OpenAI, so any answer other than "No valid credentials found" means the backend
  > returned the tenant secret to the pipeline. Needs the provider link from `21-`.
}

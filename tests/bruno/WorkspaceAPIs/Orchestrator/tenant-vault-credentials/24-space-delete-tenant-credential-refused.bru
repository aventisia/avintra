meta {
  name: Space delete cannot remove the tenant credential
  type: http
  seq: 24
}

delete {
  url: {{WORKSPACE_API_BASE_URL}}/vault-credential/{{TENANT_CRED_ID}}
  body: none
  auth: none
}

script:post-response {
  const body = res.getBody() || {};
  const message = typeof body.message === "string" ? body.message : "";
  const status = res.getStatus();
  if ([400, 403, 404].includes(status)) { bru.pass("Space delete cannot remove the tenant credential"); } else { bru.fail("Space delete cannot remove the tenant credential: got " + status + " - " + message); }
}

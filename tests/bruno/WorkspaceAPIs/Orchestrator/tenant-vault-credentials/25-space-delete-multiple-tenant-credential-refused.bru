meta {
  name: Space delete-multiple cannot remove the tenant credential
  type: http
  seq: 25
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/vault-credential/delete-multiple
  body: json
  auth: none
}

body:json {
  ["{{TENANT_CRED_ID}}"]
}

script:post-response {
  const body = res.getBody() || {};
  const message = typeof body.message === "string" ? body.message : "";
  const status = res.getStatus();
  if ([400, 403, 404].includes(status)) { bru.pass("Space delete-multiple cannot remove the tenant credential"); } else { bru.fail("Space delete-multiple cannot remove the tenant credential: got " + status + " - " + message); }
}

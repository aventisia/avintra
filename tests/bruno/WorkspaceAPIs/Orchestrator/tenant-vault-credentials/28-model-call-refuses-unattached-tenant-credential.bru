meta {
  name: Model call through the pipeline cannot use an unattached tenant credential
  type: http
  seq: 28
}

post {
  url: {{LLMPIPELINE_API_BASE_URL}}/llm/generate
  body: json
  auth: bearer
}

auth:bearer {
  token: {{SPACE_USER_ACCESS_TOKEN}}
}

body:json {
  {
    "provider": "openai",
    "model": "gpt-4o-mini",
    "input": [{"role": "user", "content": "Say hi"}],
    "credential_name": "{{UNUSED_TENANT_CRED_NAME}}",
    "stream": false,
    "ref_type": "Platform",
    "ref_id": "",
    "ref_name": "",
    "action": "bruno_tenant_credential"
  }
}

script:post-response {
  const status = res.getStatus();
  const text = JSON.stringify(res.getBody() || {});
  if (status === 400 && text.includes("No valid credentials found") && !text.includes("sk-bruno-fake")) { bru.pass("Unattached tenant credential refused"); } else { bru.fail("Unattached tenant credential refused: got " + status + " - " + text.slice(0, 300)); }
}

docs {
  > A valid model-call token reaches only a tenant credential that an enabled model provider uses.
}

meta {
  name: Space update cannot change the tenant credential
  type: http
  seq: 23
}

put {
  url: {{WORKSPACE_API_BASE_URL}}/vault-credential
  body: json
  auth: none
}

body:json {
  {"id": "{{TENANT_CRED_ID}}", "name": "bruno-hijack-{{$randomInt}}", "type": "OpenAI", "data": {"apiKey": "sk-hijack"}}
}

script:post-response {
  const body = res.getBody() || {};
  const message = typeof body.message === "string" ? body.message : "";
  const status = res.getStatus();
  if ([400, 403, 404].includes(status)) { bru.pass("Space update cannot change the tenant credential"); } else { bru.fail("Space update cannot change the tenant credential: got " + status + " - " + message); }
}

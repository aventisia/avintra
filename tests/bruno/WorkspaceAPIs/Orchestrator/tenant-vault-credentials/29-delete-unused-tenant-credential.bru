meta {
  name: Delete an unused tenant credential (expect 200)
  type: http
  seq: 29
}

delete {
  url: {{WORKSPACE_API_BASE_URL}}/tenant-vault-credential/{{UNUSED_TENANT_CRED_ID}}
  body: none
  auth: none
}

script:post-response {
  const body = res.getBody() || {};
  const message = typeof body.message === "string" ? body.message : "";
  const status = res.getStatus();
  if (status === 200) { bru.pass("Unused tenant credential deleted"); } else { bru.fail("Unused tenant credential deleted: got " + status + " - " + message); }
}

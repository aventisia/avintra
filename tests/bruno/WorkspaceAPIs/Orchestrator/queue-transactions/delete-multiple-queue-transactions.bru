meta {
  name: Delete multiple queue transactions
  type: http
  seq: 10
}

delete {
  url: {{WORKSPACE_API_BASE_URL}}/queue-transaction/{{QUEUE_TRANSACTION_ID}}
  body: none
  auth: none
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
        "QUEUE_TRANSACTION_ID", 
        "00000000-0000-0000-0000-000000000000"
      );
  }
}

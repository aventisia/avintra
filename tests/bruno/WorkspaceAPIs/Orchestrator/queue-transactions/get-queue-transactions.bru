meta {
  name: Get queue transactions
  type: http
  seq: 6
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/queue-transaction/list
  body: json
  auth: none
}

body:json {
  [
    {
      "queueId": "{{QUEUE_ID}}",
      "queuePriority": [{
        "field": "Name",
        "OrderBy": "Ascending"
      }],
      "conditions": [
        {
          "field": "Id",
          "comparisonOperator": "GreaterThan",
          "value": "5"
        },
        {
          "field": "Location",
          "comparisonOperator": "NotEqualTo",
          "value": "Washington"
        }
  ]
  }
  
}

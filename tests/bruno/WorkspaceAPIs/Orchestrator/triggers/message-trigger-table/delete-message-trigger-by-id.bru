meta {
  name: Delete message trigger by id
  type: http
  seq: 6
}

delete {
  url: {{WORKSPACE_API_BASE_URL}}/message-trigger/{{EMAIL_TRIGGER_ID}}
  body: none
  auth: none
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
        "MESSAGE_TRIGGER_ID", 
        "00000000-0000-0000-0000-000000000000"
      );
  }
}

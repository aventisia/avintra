meta {
  name: Update time trigger
  type: http
  seq: 3
}

put {
  url: {{WORC_APIS_BASE_URL}}/email-trigger
  body: json
  auth: none
}

body:json {
  {
    "id": "{{EMAIL_TRIGGER_ID}}",
    "name": "Test",
    "timezone": "Asia/Kolkata",
    "mailbox": "support@company.com",
    "folder": "Inbox",
    "expiryDateTime": "2026-06-16T10:30:00Z",
    "resubscribeEnabled": true,
    "resubscribeFrequency": "90",
    "subscriptionId": "sub_1234567890abcdef",
    "credentialId": "DUMMY",
    "provider": "M365",
    "agents": [
      {
        "id": "4ab51170-f1aa-423f-a9cd-0a0f51ce528c",
        "name": "Display Message",
        "versionNumber": 1
      }
    ]
  }
}

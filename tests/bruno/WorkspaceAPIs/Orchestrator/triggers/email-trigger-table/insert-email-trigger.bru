meta {
  name: Insert email trigger
  type: http
  seq: 2
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/email-trigger
  body: json
  auth: none
}

body:json {
  [
    {
      "name": "Test",
      "timezone": "Asia/Kolkata",
      "mailbox": "contact@aventisia.com",
      "folder": "Inbox",
      "expiryDateTime": "2026-03-26T10:30:00Z",
      "resubscribeEnabled": true,
      "resubscribeFrequency": "90",
      "credentialName": "DUMMY",
      "provider": "M365",
      "agents": [
        {
          "id": "4ab51170-f1aa-423f-a9cd-0a0f51ce528c",
          "name": "Display Message",
          "versionNumber": 1
        }
  ]
  }
  
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
          "EMAIL_TRIGGER_ID",
          res.getBody().data.id
      );
  }
}

meta {
  name: Insert webhook trigger
  type: http
  seq: 2
}

post {
  url: {{WORKSPACE_APIS_BASE_URL}}/webhook-trigger
  body: json
  auth: none
}

body:json {
  {
    "name": "Order Processing Webhook",
    "apiKeyHash": "DUMMY",
    "expectedPayloadSchema": "{ \"type\": \"object\", \"properties\": { \"orderId\": { \"type\": \"string\" } } }",
    "callbackUrl": "https://example.com/webhook/callback",
    "apiKey": "plain-text-api-key-only-on-create",
    "agent":
      {
        "id": "4ab51170-f1aa-423f-a9cd-0a0f51ce528c",
        "name": "Display Message",
        "versionNumber": 1
      }
  }
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
          "WEBHOOK_TRIGGER_ID",
          res.getBody().data.id
      );
  }
}

meta {
  name: Delete webhook trigger by id
  type: http
  seq: 6
}

delete {
  url: {{WORC_APIS_BASE_URL}}/webhook-trigger/{{WEBHOOK_TRIGGER_ID}}
  body: none
  auth: bearer
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
        "WEBHOOK_TRIGGER_ID", 
        "00000000-0000-0000-0000-000000000000"
      );
  }
}

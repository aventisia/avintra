meta {
  name: Delete multiple webhook triggers
  type: http
  seq: 9
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/webhook-trigger/delete-multiple
  body: json
  auth: none
}

body:json {
  ["{{WEBHOOK_TRIGGER_ID}}"]
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
        "WEBHOOK_TRIGGER_ID", 
        "00000000-0000-0000-0000-000000000000"
      );
  }
}

meta {
  name: Delete multiple app secrets
  type: http
  seq: 9
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/app-secret/delete-multiple
  body: json
  auth: none
}

body:json {
  ["{{APP_SECRET_ID}}"]
}

script:post-response {
  if (res.getBody().message === "TwoFA is enabled") {
      bru.setGlobalEnvVar("APP_INTEGRATION_ID", "00000000000000000000000000");
      }
  
}

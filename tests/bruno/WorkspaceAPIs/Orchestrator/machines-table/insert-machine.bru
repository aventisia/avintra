meta {
  name: Insert machine
  type: http
  seq: 4
}

post {
  url: {{WORKSPACE_APIS_BASE_URL}}/machine
  body: json
  auth: none
}

body:json {
  {}
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    name: faker.lorem.lines(),
    ipAddress: faker.internet.ip(),
    hostname: faker.internet.displayName(),
    type: "Windows",
    status: "Idle",
    environment: "Development",
    currentTask: "FlowActivity",
    lastCheckedIn: faker.date.anytime(), 
    isAvailable: false,
    agentIds: []//JSON.parse(`["${bru.getGlobalEnvVar("FLOW_VERSION_ID")}"]`)
  })
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
          "MACHINE_ID",
          res.getBody().data.id
      );
  }
}

meta {
  name: Remove agents
  type: http
  seq: 6
}

post {
  url: {{WORKSPACE_APIS_BASE_URL}}/machine/{{MACHINE_ID}}/remove-agents
  body: none
  auth: none
}

script:pre-request {
  // Set agentId in request body
  req.setBody(
    JSON.parse(`["${bru.getGlobalEnvVar("FLOW_VERSION_ID")}"]`)
  )
}

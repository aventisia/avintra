meta {
  name: Register machine
  type: http
  seq: 3
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/machine-auth/register
  body: json
  auth: bearer
}

body:json {
  {
    "operatingSystem": "Windows",
    "osID": "bruno-register-test-machine-guid",
    "hostname": "bruno-register-host",
    "username": "bruno.register.user",
    "linkedUserAccountId": "{{ACCOUNT_USER_ID}}"
  }
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
          "MACHINE_ID",
          res.getBody().data.machineId
      );
      bru.setGlobalEnvVar(
          "MACHINE_JWT",
          res.getBody().data.jwt
      );
  }
}

meta {
  name: Delete queue transaction event
  type: http
  seq: 7
}

delete {
  url: {{WORKSPACE_API_BASE_URL}}/queue/transaction-events/{{QUEUE_TRANSACTION_EVENT_ID}}
  body: none
  auth: none
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
        "QUEUE_WORKITEM_ID", 
        "00000000-0000-0000-0000-000000000000"
      );
  }
}

meta {
  name: Delete machine flow
  type: http
  seq: 7
}

delete {
  url: {{WORKSPACE_API_BASE_URL}}/machine-flow/{{MACHINE_FLOW_ID}}
  body: none
  auth: none
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
        "MACHINE_FLOW_ID", 
        "00000000-0000-0000-0000-000000000000"
      );
  }
}

meta {
  name: Insert machine flow
  type: http
  seq: 4
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/machine-flow
  body: json
  auth: none
}

body:json {
  "flowVersionId": "{{FLOW_VERSION_ID}}",
  "machineId": "{{MACHINE_ID}}"
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
          "MACHINE_FLOW_ID",
          res.getBody().data.id
      );
  }
}

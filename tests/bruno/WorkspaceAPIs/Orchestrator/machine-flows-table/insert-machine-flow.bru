meta {
  name: Insert machine flow
  type: http
  seq: 4
}

post {
  url: {{WORKSPACE_APIS_BASE_URL}}/machine-flow
  body: none
  auth: none
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    flowVersionId: bru.getGlobalEnvVar("FLOW_VERSION_ID"),
    machineId: bru.getGlobalEnvVar("MACHINE_ID"),
  })
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
          "MACHINE_FLOW_ID",
          res.getBody().data.id
      );
  }
}

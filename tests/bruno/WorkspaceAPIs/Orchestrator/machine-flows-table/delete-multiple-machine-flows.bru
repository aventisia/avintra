meta {
  name: Delete multiple machine flows
  type: http
  seq: 9
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/machine-flow/delete-multiple
  body: json
  auth: none
}

body:json {
  [
    "{{MACHINE_FLOW_ID}}"
  ]
}
script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
        "MACHINE_FLOW_ID", 
        "00000000-0000-0000-0000-000000000000"
      );
  }
}

docs {

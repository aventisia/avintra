meta {
  name: Delete queue agent
  type: http
  seq: 6
}

delete {
  url: {{WORKSPACE_APIS_BASE_URL}}/queue-agent/{{QUEUE_AGENT_ID}}
  body: none
  auth: none
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
        "QUEUE_USER_ID", 
        "00000000-0000-0000-0000-000000000000"
      );
  }
}

meta {
  name: Repeat - Insert queue agent
  type: http
  seq: 7
}

post {
  url: {{WORKSPACE_APIS_BASE_URL}}/queue-agent
  body: json
  auth: none
}

body:json {
  {
    "queueId": "{{QUEUE_ID}}",
    "flowVersionId": "{{FLOW_VERSION_ID}}"
  }
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
          "QUEUE_AGENT_ID", res.getBody().data.id
      );
  }
}

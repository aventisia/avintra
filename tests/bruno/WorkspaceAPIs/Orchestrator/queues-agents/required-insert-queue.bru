meta {
  name: Required - Insert queue
  type: http
  seq: 1
}

post {
  url: {{WORKSPACE_APIS_BASE_URL}}/queue
  body: json
  auth: none
}

body:json {
  {
    "name": "Test_agent_queue",
    "type": "Agent",
    "description": "",
    "isUniqueReferencesEnforced": false,
    "isStoredEncrypted": false,
    "shouldRetryFailedItems": false,
    "shouldRetryAbandonedItems": false,
    "maximumRetryAttempts": 5,
    "inputSchema": [
      {
        "name": "Id",
        "description": "",
        "lebel": "",
        "type": "int",
        "isRequired": true,
        "isUsedForUniqueIdentifier": true
      },
      {
        "name": "Name",
        "description": "",
        "lebel": "",
        "type": "string",
        "isRequired": true,
        "isUsedForUniqueIdentifier": true
      },
      {
        "name": "Date",
        "description": "",
        "lebel": "",
        "type": "Date",
        "isRequired": true,
        "isUsedForUniqueIdentifier": false
      },
      {
        "name": "Location",
        "description": "",
        "lebel": "",
        "type": "string",
        "isRequired": false,
        "isUsedForUniqueIdentifier": false
      }
    ]
  }
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
          "QUEUE_ID", res.getBody().data.id
      );
  }
}

meta {
  name: Delete multiple queue agents
  type: http
  seq: 8
}

post {
  url: {{WORKSPACE_APIS_BASE_URL}}/queue-agent/delete-multiple
  body: json
  auth: none
}

body:json {
  ["{{QUEUE_AGENT_ID}}"]
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
        "QUEUE_USER_ID", 
        "00000000-0000-0000-0000-000000000000"
      );
  }
}

docs {

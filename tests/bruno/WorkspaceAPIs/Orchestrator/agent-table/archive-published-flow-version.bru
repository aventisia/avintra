    "isDisabled": false
  }
}

script:post-response {
  test("response status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("flow version is archived", function() {
    expect(res.getBody().data.isArchived).to.equal(true);
  });
}

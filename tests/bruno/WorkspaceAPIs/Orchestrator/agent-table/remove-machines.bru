meta {
  name: Remove machines
  type: http
  seq: 11
}

post {
  url: {{WORKSPACE_APIS_BASE_URL}}/agent/{{FLOW_VERSION_ID}}/remove-machines
  body: none
  auth: none
}

script:pre-request {
  // Set machineId in request body
  req.setBody(
    JSON.parse(`["${bru.getGlobalEnvVar("MACHINE_ID")}"]`)
  )
}

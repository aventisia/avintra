meta {
  name: Required - Get flow versions
  type: http
  seq: 2
}

get {
  url: {{WORKSPACE_APIS_BASE_URL}}/flow-version/list/{{FLOW_ID}}
  body: none
  auth: none
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    flowId: bru.getGlobalEnvVar("FLOW_ID"),
  })
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
          "FLOW_VERSION_ID",
          res.getBody().data[0].id
      );
  }
}

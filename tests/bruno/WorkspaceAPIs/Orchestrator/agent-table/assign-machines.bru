meta {
  name: Assign machines
  type: http
  seq: 9
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/agent/{{FLOW_VERSION_ID}}/assign-machines
  body: json
  auth: none
}

body:json {
  [
    "{{MACHINE_ID}}"
  ]
}
script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
          "MACHINE_FLOW_ID",
          res.getBody().data.id
      );
  }
}

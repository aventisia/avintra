meta {
  name: Assign machines
  type: http
  seq: 9
}

post {
  url: {{WORKSPACE_APIS_BASE_URL}}/agent/{{FLOW_VERSION_ID}}/assign-machines
  body: none
  auth: none
}

script:pre-request {
  // Set machineId in request body
  req.setBody(
    JSON.parse(`["${bru.getGlobalEnvVar("MACHINE_ID")}"]`)
  )
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
          "MACHINE_FLOW_ID",
          res.getBody().data.id
      );
  }
}

meta {
  name: Delete multiple vaults
  type: http
  seq: 9
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/vault/delete-multiple
  body: json
  auth: none
}

body:json {
  [
    "{{VAULT_ID}}"
  ]
}
script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
        "VAULT_ID", 
        "00000000-0000-0000-0000-000000000000"
      );
  }
}
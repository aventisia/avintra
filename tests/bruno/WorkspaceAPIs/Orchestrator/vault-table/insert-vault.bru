meta {
  name: Insert vault
  type: http
  seq: 2
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/vault
  body: json
  auth: none
}

body:json {
  "name": "{{$randomProductName}}",
  "description": "{{$randomLoremParagraph}}",
  "username": "{{$randomLoremParagraph}}",
  "password": "{{$randomLoremParagraph}}"
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
          "VAULT_ID",
          res.getBody().data.id
      );
  }
}

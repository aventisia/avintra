meta {
  name: Delete vault
  type: http
  seq: 7
}

delete {
  url: {{WORKSPACE_API_BASE_URL}}/vault/{{VAULT_ID}}
  body: none
  auth: none
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
        "VAULT_ID", 
        "00000000-0000-0000-0000-000000000000"
      );
  }
}

meta {
  name: Update vault
  type: http
  seq: 3
}

put {
  url: {{WORKSPACE_API_BASE_URL}}/vault
  body: json
  auth: none
}

body:json {
  "id": "{{VAULT_ID}}",
  "name": "{{$randomProductName}}",
  "description": "{{$randomLoremParagraph}}",
  "username": "{{$randomLoremParagraph}}",
  "password": "{{$randomLoremParagraph}}",
  "isDisabled": false
}

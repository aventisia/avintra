meta {
  name: Repeat - Insert job
  type: http
  seq: 15
}

post {
  url: {{WORKSPACE_APIS_BASE_URL}}/job
  body: none
  auth: none
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    flowVersionId: bru.getGlobalEnvVar("FLOW_VERSION_ID"),
    status: "Failed",
    startTime: faker.date.soon(),
  })
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
          "JOB_ID",
          res.getBody().data.id
      );
  }
}

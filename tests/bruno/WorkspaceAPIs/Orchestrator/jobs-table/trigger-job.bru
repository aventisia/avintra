meta {
  name: Trigger job
  type: http
  seq: 17
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/job/trigger
  body: json
  auth: none
}

headers {
  X-TENANT-ID: {{TENANT_ID}}
  X-API-KEY: {{CUSTOM_API_KEY}}
}

body:json {
  {
    "flowVersionId": "{{FLOW_VERSION_ID}}",
    "triggerType": "WebhookTrigger"
  }
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
          "JOB_ID",
          res.getBody().data.id
      );
  }
}

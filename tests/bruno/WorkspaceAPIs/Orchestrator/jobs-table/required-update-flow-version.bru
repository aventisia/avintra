meta {
  name: Required - Update flow version
  type: http
  seq: 3
}

put {
  url: {{WORKSPACE_APIS_BASE_URL}}/flow-version/create
  body: none
  auth: none
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    flowId: bru.getGlobalEnvVar("FLOW_ID"),
    isLocked: faker.datatype.boolean(),
    isPublished: true,
  })
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
          "FLOW_VERSION_ID",
          res.getBody().data.id
      );
  }
}

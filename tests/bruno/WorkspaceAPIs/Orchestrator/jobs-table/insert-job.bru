meta {
  name: Insert job
  type: http
  seq: 4
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/job
  body: json
  auth: none
}

body:json {
  "flowVersionId": "{{FLOW_VERSION_ID}}",
  "status": "Running",
  "startTime": "{{$randomFutureDate}}"
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
          "JOB_ID",
          res.getBody().data.id
      );
  }
}

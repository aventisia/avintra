meta {
  name: Delete multiple queue workitems
  type: http
  seq: 11
}

post {
  url: {{WORKSPACE_APIS_BASE_URL}}/queue/workitem/delete-multiple
  body: json
  auth: none
}

body:json {
  ["{{QUEUE_WORKITEM_ID}}"]
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
        "QUEUE_WORKITEM_ID", 
        "00000000-0000-0000-0000-000000000000"
      );
  }
}

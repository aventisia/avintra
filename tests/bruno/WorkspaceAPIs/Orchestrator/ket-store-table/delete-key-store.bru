meta {
  name: Delete key store
  type: http
  seq: 9
}

delete {
  url: {{WORKSPACE_API_BASE_URL}}/key-store/{{CONFIG_ITEM_ID}}
  body: none
  auth: none
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
        "CONFIG_ITEM_ID", 
        "00000000-0000-0000-0000-000000000000"
      );
  }
}

meta {
  name: Insert aliased catalog credential
  type: http
  seq: 2.2
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/vault-credential
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:json {
  {
    "name": "Bruno OpenRouter {{$randomProductName}}",
    "description": "Catalog alias type that resolves to the OpenRouter plugin",
    "type": "OpenRouter",
    "data": {
      "ApiKey": "bruno-test-api-key"
    }
  }
}

script:post-response {
  if(res.getStatus() == 200)
  {
    bru.setGlobalEnvVar("ALIAS_VAULT_CREDENTIAL_ID", res.getBody().data.id);
  }
}

tests {
  test("accepts the OpenRouter alias type", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data).to.have.property("id");
  });
}

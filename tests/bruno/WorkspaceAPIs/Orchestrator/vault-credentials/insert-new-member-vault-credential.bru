meta {
  name: Insert new catalog member credential
  type: http
  seq: 2.1
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/vault-credential
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:json {
  {
    "name": "Bruno Agiled {{$randomProductName}}",
    "description": "Newly listed Corsair catalog member with an API key",
    "type": "Agiled",
    "data": {
      "ApiKey": "bruno-test-api-key"
    }
  }
}

script:post-response {
  if(res.getStatus() == 200)
  {
    bru.setGlobalEnvVar("NEW_MEMBER_VAULT_CREDENTIAL_ID", res.getBody().data.id);
  }
}

tests {
  test("accepts a credential type added with the catalog", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data).to.have.property("id");
  });
}

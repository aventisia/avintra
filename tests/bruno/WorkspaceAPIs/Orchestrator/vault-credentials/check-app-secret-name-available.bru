meta {
  name: Check app secret name available
  type: http
  seq: 1
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/vault-credential/is-available
  body: json
  auth: none
}

body:json {
  {
    "userInput": "ChatGPT"
  }
  
}

script:post-response {
  if(res.getStatus() == 200)
  {
    bru.setGlobalEnvVar("VAULT_CREDENTIAL_ID", res.getBody().data.id);
  }
}

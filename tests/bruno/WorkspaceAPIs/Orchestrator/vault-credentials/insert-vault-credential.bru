meta {
  name: Insert vault credential
  type: http
  seq: 2
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/vault-credential
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:json {
  {
    "name": "Bruno OpenAI {{$randomProductName}}",
    "description": "Platform OpenAI credential to confirm platform items still save",
    "type": "OpenAI",
    "data": {
      "ApiKey": "bruno-test-api-key",
      "OrganizationId": "",
      "Url": "https://api.openai.com/v1"
    }
  }
}

script:post-response {
  if(res.getStatus() == 200)
  {
    bru.setGlobalEnvVar("VAULT_CREDENTIAL_ID", res.getBody().data.id);
    bru.setGlobalEnvVar("VAULT_CREDENTIAL_NAME", res.getBody().data.name);
  }
}

tests {
  test("saves the platform OpenAI credential", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data).to.have.property("id");
  });
}

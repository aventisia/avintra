meta {
  name: Insert vault credential
  type: http
  seq: 2
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/vault-credential
  body: json
  auth: none
}

body:json {
  {
    "name": "EmailClient",
    "description": "email client basic credentials to provide email services",
    "type": "EmailClient",
    "data": {
      "imapServer": "",
      "username": "",
      "password": "",
      "port": ""
    }
  }
}

script:post-response {
  if(res.getStatus() == 200)
  {
    bru.setGlobalEnvVar("VAULT_CREDENTIAL_ID", res.getBody().data.id);
  }
}

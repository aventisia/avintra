meta {
  name: Update vault credential
  type: http
  seq: 5
}

put {
  url: {{WORKSPACE_API_BASE_URL}}/vault-credential
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:json {
  {
    "id": "{{VAULT_CREDENTIAL_ID}}",
    "name": "{{VAULT_CREDENTIAL_NAME}}",
    "description": "Updated platform OpenAI credential",
    "type": "OpenAI",
    "data": {
      "ApiKey": "bruno-test-api-key-updated",
      "OrganizationId": "",
      "Url": "https://api.openai.com/v1"
    },
    "isDisabled": false
  }
}

tests {
  test("updates the platform OpenAI credential", function() {
    expect(res.getStatus()).to.equal(200);
  });
}

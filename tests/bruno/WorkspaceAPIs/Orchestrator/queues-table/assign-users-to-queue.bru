meta {
  name: Assign users to queue
  type: http
  seq: 13
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/agent/{{QUEUE_ID}}/assign-users
  body: json
  auth: none
}

body:json {
  [
    "{{USER_ID}}"
  ]
}
script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
          "MACHINE_FLOW_ID",
          res.getBody().data.id
      );
  }
}

meta {
  name: Assign agents to queue
  type: http
  seq: 10
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/queue/{{QUEUE_ID}}/assign-agents
  body: json
  auth: none
}

body:json {
  [
    "{{FLOW_VERSION_ID}}"
  ]
}
script:post-response {
  const body = res.getBody();
  if (res.getStatus() === 200 && body?.data === true) {
    bru.setEnvVar("EXPECT_AGENT_ASSIGNED", "true");
  }
  test("assign agents returns 200 with data true", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data).to.equal(true);
  });
}

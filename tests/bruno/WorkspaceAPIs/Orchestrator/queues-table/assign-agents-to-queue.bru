meta {
  name: Assign agents to queue
  type: http
  seq: 10
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/queue/{{QUEUE_ID}}/assign-agents
  body: json
  auth: none
}

body:json {
  [
    "{{FLOW_VERSION_ID}}"
  ]
}
script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
          "MACHINE_FLOW_ID",
          res.getBody().data.id
      );
  }
}

meta {
  name: Repeat - Insert queue
  type: http
  seq: 7
}

post {
  url: {{WORKSPACE_APIS_BASE_URL}}/queue
  body: none
  auth: none
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    name: faker.commerce.product(),
  })
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
          "QUEUE_ID",
          res.getBody().data.id
      );
  }
}

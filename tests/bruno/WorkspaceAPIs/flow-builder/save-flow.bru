meta {
  name: Save flow
  type: http
  seq: 3
}

put {
  url: {{WORKSPACE_API_BASE_URL}}/flow/save
  body: json
  auth: none
}

body:json {
  "id": "{{FLOW_ID}}",
  "thumbnail": "none",
  "reactFlowObject": "{nodes: [], edges: [], viewport: {x: 0, y: 0,zoom: 1}}",
  "inputOutputObject": "",
  "versionId": "{{FLOW_VERSION_ID}}"
}

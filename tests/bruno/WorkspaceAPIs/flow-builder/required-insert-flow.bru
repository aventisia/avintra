meta {
  name: Required - Insert flow
  type: http
  seq: 1
}

post {
  url: {{WORC_APIS_BASE_URL}}/flow
  body: json
  auth: none
}

body:json {
  {
    "type": "AutomationAgent",
    "name": "test",
    "description": ""
  }
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    type: "AutomationAgent",
    name: faker.commerce.product(),
    description: faker.lorem.paragraph(),
  })
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
          "FLOW_ID",
          res.getBody().data.id
      );
  }
}

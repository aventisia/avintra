meta {
  name: Update flow publish
  type: http
  seq: 4
}

put {
  url: {{WORKSPACE_API_BASE_URL}}/flow/publish
  body: json
  auth: none
}

body:json {
  "id": "{{FLOW_VERSION_ID}}",
  "flowId": "bf93db05-de54-491c-8425-4f76f707fa64",
  "name": "{{$randomCompanyName}}",
  "description": "{{$randomLoremParagraph}}",
  "reactFlowObject": "{{$guid}}",
  "accessType": "TenantLevel",
  "type": "Agent",
  "thumbnail": "none",
  "isPublished": true
}

docs {
  > bru.getGlobalEnvVar("FLOW_ID")
}

meta {
  name: Update execution log
  type: http
  seq: 5
}

put {
  url: {{WORKSPACE_API_BASE_URL}}/execution-log/update
  body: json
  auth: none
}

body:json {
  "id": "{{LOG_ID}}",
  "actionName": "{{$randomCommonFileName}}",
  "inputData": "{{$randomLoremSentence}}",
  "outputData": "{{$randomLoremSentence}}",
  "flowExecutionLogId": "{{EXECUTION_LOG_ID}}"
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
          "LOG_ID",
          res.getBody().data.id
      );
  }
}

meta {
  name: Update execution log
  type: http
  seq: 5
}

put {
  url: {{WORKSPACE_APIS_BASE_URL}}/execution-log/update
  body: none
  auth: none
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    id: bru.getGlobalEnvVar("LOG_ID"),
    actionName: faker.system.commonFileName(),
    inputData: faker.lorem.sentence(),
    outputData: faker.lorem.sentence(),
    flowExecutionLogId: bru.getGlobalEnvVar("EXECUTION_LOG_ID")
  })
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
          "LOG_ID",
          res.getBody().data.id
      );
  }
}

meta {
  name: Insert flow execution log
  type: http
  seq: 4
}

post {
  url: {{WORKSPACE_APIS_BASE_URL}}/execution-log/create
  body: none
  auth: none
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    flowExecutionLogId: bru.getGlobalEnvVar("EXECUTION_LOG_ID"),
    actionName: faker.system.commonFileName(),
    inputData: faker.lorem.sentence(),
    outputData: faker.lorem.sentence()
  })
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
          "LOG_ID",
          res.getBody().data.id
      );
  }
}

meta {
  name: Insert flow execution log
  type: http
  seq: 4
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/execution-log/create
  body: json
  auth: none
}

body:json {
  "flowExecutionLogId": "{{EXECUTION_LOG_ID}}",
  "actionName": "{{$randomCommonFileName}}",
  "inputData": "{{$randomLoremSentence}}",
  "outputData": "{{$randomLoremSentence}}"
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
          "LOG_ID",
          res.getBody().data.id
      );
  }
}

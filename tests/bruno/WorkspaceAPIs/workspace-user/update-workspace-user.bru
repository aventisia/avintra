meta {
  name: Update workspace user
  type: http
  seq: 4
}

put {
  url: {{WORKSPACE_API_BASE_URL}}/user/
  body: json
  auth: none
}

body:json {
  "id": "{{WORKSPACE_USER_ID}}",
  "userName": "{{$randomEmail}}",
  "firstName": "{{$randomFirstName}}",
  "lastName": "{{$randomLastName}}",
  "avatarSrc": "{{$randomImageUrl}}"
}

meta {
  name: Update workspace user
  type: http
  seq: 5
}

put {
  url: {{WORKSPACE_APIS_BASE_URL}}/user/
  body: none
  auth: none
}

body:json {
  {
    
  }
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    id: bru.getGlobalEnvVar("WORKSPACE_USER_ID"),
    userName: faker.internet.email(),
    firstName: faker.person.firstName(),
    lastName: faker.person.lastName(),
    avatarSrc: faker.image.url()
  })
}

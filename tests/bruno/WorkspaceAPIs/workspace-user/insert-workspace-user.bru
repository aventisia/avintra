meta {
  name: Insert workspace user
  type: http
  seq: 2
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/user
  body: json
  auth: none
}

body:json {
  "id": "{{ACCOUNT_USER_ID}}",
  "userName": "{{$randomEmail}}",
  "firstName": "{{$randomFirstName}}",
  "lastName": "{{$randomLastName}}",
  "avatarSrc": "{{$randomImageUrl}}"
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
          "WORKSPACE_USER_ID",
          res.getBody().data.id
      );
  }
}

docs {
  > DO NOT directly call this endpoint to insert workspace users into the production database. This endpoint is intended to be invoked only through AccountsAPIs endpoints
}

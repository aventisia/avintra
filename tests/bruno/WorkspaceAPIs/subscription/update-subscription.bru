meta {
  name: Update subscription
  type: http
  seq: 2
}

put {
  url: {{WORKSPACE_API_BASE_URL}}/subscription/
  body: json
  auth: none
}

body:json {
  "id": "{{SUBSCRIPTION_ID}}",
  "startDate": "{{$isoTimestamp}}",
  "dueDate": "{{$isoTimestamp}}",
  "planId": "{{PLAN_ID}}"
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
          "SUBSCRIPTION_ID",
          res.getBody().data.id
      );
     bru.setGlobalEnvVar(
          "USER_ID", 
          res.getBody().data.createdByUserId)
  }
}

meta {
  name: Required - Insert flow
  type: http
  seq: 1
}

post {
  url: {{WORC_APIS_BASE_URL}}/flow
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:json {
  {
    "Type": "Agent",
    "name": "test_agent",
    "description": ""
  }
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
          "FLOW_ID",
          res.getBody().data.id
      );
  }
}

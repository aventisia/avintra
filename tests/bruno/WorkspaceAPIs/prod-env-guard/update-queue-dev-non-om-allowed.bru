meta {
  name: Update DEV queue remains available to non-OM (expect 200)
  type: http
  seq: 15
}

put {
  url: {{WORKSPACE_API_BASE_URL}}/queue
  body: json
  auth: bearer
}

auth:bearer {
  token: {{PROD_TD_ACCESS_TOKEN}}
}

headers {
  X-Env-Type: Dev
}

body:json {
  {
    "id": "{{DEV_TD_QUEUE_ID}}",
    "name": "DEV non-OM authorization fixture",
    "type": "User",
    "processingMode": "Manual",
    "description": "Authorization test fixture",
    "isUniqueReferencesEnforced": false,
    "isStoredEncrypted": false,
    "shouldRetryFailedItems": false,
    "shouldRetryAbandonedItems": false,
    "maximumRetryAttempts": 5,
    "inputSchema": [],
    "outputSchema": null,
    "statuses": [],
    "isTenantWideAccess": false,
    "credentialName": null,
    "isDisabled": false,
    "routeToQueues": null
  }
}

script:post-response {
  const body = res.getBody();
  if (res.getStatus() === 200 && body?.message === "Queue updated successfully") {
    bru.pass("Non-OM DEV queue update remains allowed");
  } else {
    bru.fail("Expected DEV update success, got " + res.getStatus() + " - " + (body?.message ?? ""));
  }
}

docs {
  > Requires a dedicated DEV queue owned by the TD user/token, seeded with the
  > values in this request so the request does not change its configuration.
}

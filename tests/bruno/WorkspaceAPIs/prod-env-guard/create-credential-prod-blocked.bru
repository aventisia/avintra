meta {
  name: Create credential blocked in PROD (expect 400)
  type: http
  seq: 2
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/vault-credential
  body: json
  auth: none
}

headers {
  X-Env-Type: Prod
}

body:json {
  {
    "name": "bruno-prod-guard-{{$randomInt}}",
    "description": "prod env guard test",
    "type": "EmailClient",
    "data": {
      "imapServer": "",
      "username": "",
      "password": "",
      "port": ""
    }
  }
}

script:post-response {
  const body = res.getBody();
  const message = typeof body?.message === "string" ? body.message : "";
  if (res.getStatus() === 400 && message.includes("PROD environment")) {
    bru.pass("Create credential correctly blocked in PROD");
  } else {
    bru.fail("Expected 400 PROD guard, got " + res.getStatus() + " - " + message);
  }
}

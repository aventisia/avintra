meta {
  name: Register skill file blocked in PROD (expect 400)
  type: http
  seq: 10
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/skill-registry/{{SKILL_ID}}/files
  body: json
  auth: none
}

headers {
  X-Env-Type: Prod
}

body:json {
  {
    "fileName": "prod-guard.md",
    "content": "# Prod guard test",
    "fileType": "markdown"
  }
}

script:post-response {
  const body = res.getBody();
  const message = typeof body?.message === "string" ? body.message : "";
  if (res.getStatus() === 400 && message.includes("PROD environment")) {
    bru.pass("Register skill file correctly blocked in PROD");
  } else {
    bru.fail("Expected 400 PROD guard, got " + res.getStatus() + " - " + message);
  }
}

meta {
  name: Share PROD queue blocked (expect 400)
  type: http
  seq: 18
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/resource-user-access/bulk
  body: json
  auth: bearer
}

auth:bearer {
  token: {{PROD_TD_ACCESS_TOKEN}}
}

headers {
  X-Env-Type: Prod
}

body:json {
  {
    "resourceType": "Queue",
    "resourceId": "{{PROD_TD_QUEUE_ID}}",
    "users": [
      {
        "accessLevel": "View",
        "userId": "00000000-0000-0000-0000-000000000001"
      }
    ]
  }
}

script:post-response {
  const body = res.getBody();
  const message = typeof body?.message === "string" ? body.message : "";
  if (res.getStatus() === 400 && message.includes("Cannot share a published (PROD) queue")) {
    bru.pass("Sharing a PROD queue correctly blocked");
  } else {
    bru.fail("Expected 400 PROD share guard, got " + res.getStatus() + " - " + message);
  }
}

docs {
  > Sharing is disabled for persisted PROD Configure resources. The guard runs
  > before recipient validation, so the placeholder user id is never resolved.
  > Requires `PROD_TD_QUEUE_ID` pointing at a PROD queue.
}

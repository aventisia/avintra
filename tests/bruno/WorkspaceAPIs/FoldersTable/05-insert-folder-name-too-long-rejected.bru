meta {
  name: Insert folder name too long rejected
  type: http
  seq: 5
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/folder
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:json {
  {
    "name": "placeholder"
  }
}

script:pre-request {
  req.setBody({ name: "a".repeat(51) });
}

script:post-response {
  test("name longer than 50 characters is rejected with 400", function() {
    expect(res.getStatus()).to.equal(400);
  });
}

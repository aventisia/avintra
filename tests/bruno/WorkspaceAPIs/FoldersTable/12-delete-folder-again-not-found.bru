meta {
  name: Delete folder again not found
  type: http
  seq: 12
}

delete {
  url: {{WORKSPACE_API_BASE_URL}}/folder/{{FOLDER_ID}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

script:post-response {
  test("deleting a missing folder returns 404", function() {
    expect(res.getStatus()).to.equal(404);
    expect(String(res.getBody())).to.equal("Folder not found");
  });
}

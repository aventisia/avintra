meta {
  name: Delete folder
  type: http
  seq: 11
}

delete {
  url: {{WORKSPACE_API_BASE_URL}}/folder/{{FOLDER_ID}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

script:post-response {
  test("folder is deleted with 200", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().message).to.equal("Folder deleted");
  });
}

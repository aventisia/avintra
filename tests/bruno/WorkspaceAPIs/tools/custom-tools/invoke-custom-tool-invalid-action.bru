meta {
  name: Invoke custom tool rejects invalid action
  type: http
  seq: 16
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/cloud-connector/custom-tool/invoke
  body: json
  auth: none
}

body:json {
  {
    "agentId": "00000000-0000-0000-0000-000000000000",
    "agentName": "Bruno Custom Tool Invalid Action Test",
    "provider": "customtool",
    "action": "not-a-tool-id",
    "credentialName": null,
    "payload": {}
  }
}

script:post-response {
  const status = res.getStatus();

  test("rejects a malformed action with a plain-text 400", function() {
    expect(status).to.equal(400);
    expect(typeof res.getBody()).to.equal("string");
    expect(res.getBody()).to.include("Invalid action");
  });
}
meta {
  name: Get usable tool operations
  type: http
  seq: 13
}

get {
  url: {{WORKSPACE_API_BASE_URL}}/tools/usable/{{USABLE_TOOL_ID}}/operations
  body: none
  auth: none
}

script:post-response {
  const data = res.getBody()?.data ?? {};

  test("returns operations for a usable tool", function() {
    expect(res.getStatus()).to.equal(200);
    expect(data).to.have.property("operations");
    expect(data.operations).to.be.an("array");
  });
}

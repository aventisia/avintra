meta {
  name: Create tool
  type: http
  seq: 2
}

post {
  url: {{WORKSPACE_APIS_BASE_URL}}/tools
  body: json
  auth: none
}

body:json {
  {
    "name": "Sample Custom Tool",
    "description": "A sample custom API tool",
    "type": "Custom",
    "baseUrl": "https://api.example.com",
    "openApiSpec": "{\"openapi\":\"3.0.0\",\"info\":{\"title\":\"Sample API\",\"version\":\"1.0.0\"},\"paths\":{\"/users\":{\"get\":{\"operationId\":\"listUsers\",\"summary\":\"List users\"}}}}",
    "authenticationType": "ApiKeyHeader",
    "credentialName": null,
    "isTenantWideAccess": false
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setGlobalEnvVar("TOOL_ID", res.getBody().data.id);
  }
}

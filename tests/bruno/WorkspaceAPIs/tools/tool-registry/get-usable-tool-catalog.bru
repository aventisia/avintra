meta {
  name: Get usable tool catalog
  type: http
  seq: 14
}

get {
  url: {{WORKSPACE_API_BASE_URL}}/tools/usable/catalog
  body: none
  auth: none
}

script:post-response {
  const data = res.getBody()?.data ?? {};

  test("returns the usable tool catalog", function() {
    expect(res.getStatus()).to.equal(200);
    expect(data).to.be.an("array");
    data.forEach(function(tool) {
      expect(tool).to.have.property("id");
      expect(tool).to.have.property("name");
      expect(tool).to.have.property("operations");
      expect(tool.operations).to.be.an("array");
      tool.operations.forEach(function(operation) {
        expect(operation).to.have.property("operationId");
      });
    });
  });
}
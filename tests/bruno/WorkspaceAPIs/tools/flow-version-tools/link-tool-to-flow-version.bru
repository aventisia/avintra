meta {
  name: Link tool to flow version
  type: http
  seq: 2
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/flow-version-tools
  body: json
  auth: none
}

body:json {
  {
    "flowVersionId": "{{FLOW_VERSION_ID}}",
    "toolId": "{{TOOL_ID}}",
    "allowedOperations": ["GET /users"],
    "credentialName": null
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setGlobalEnvVar("FLOW_VERSION_TOOL_ID", res.getBody().data.id);
  }
}

meta {
  name: Update flow version tool
  type: http
  seq: 3
}

put {
  url: {{WORKSPACE_API_BASE_URL}}/flow-version-tools
  body: json
  auth: none
}

body:json {
  {
    "id": "{{FLOW_VERSION_TOOL_ID}}",
    "flowVersionId": "{{FLOW_VERSION_ID}}",
    "toolId": "{{TOOL_ID}}",
    "allowedOperations": ["GET /users", "POST /users"],
    "credentialName": null
  }
}

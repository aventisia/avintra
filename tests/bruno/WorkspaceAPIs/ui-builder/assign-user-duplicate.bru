meta {
  name: Assign user duplicate returns 409
  type: http
  seq: 15
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/uibuilder-project-user
  body: json
  auth: none
}

body:json {
  "uiBuilderProjectId": "{{UIBUILDER_PROJECT_ID}}",
  "userId": "{{USER_ID}}"
}

tests {

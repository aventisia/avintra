meta {
  name: Share published UI builder project with a user again returns 409
  type: http
  seq: 15
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/resource-user-access/bulk
  body: json
  auth: none
}

body:json {
  {
    "resourceType": "UiBuilderPublished",
    "resourceId": "{{UIBUILDER_PROJECT_ID}}",
    "users": [
      {
        "accessLevel": "View",
        "userId": "{{USER_ID}}"
      }
    ]
  }
}

tests {
  test("status code is 409", function() {
    expect(res.status).to.equal(409);
  });
}

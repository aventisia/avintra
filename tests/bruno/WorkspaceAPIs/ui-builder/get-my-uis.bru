meta {
  name: Get my UIs
  type: http
  seq: 17
}

get {
  url: {{WORKSPACE_API_BASE_URL}}/ui-builder/my
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

tests {
  test("status code is 200", function() {
    expect(res.status).to.equal(200);
  });

  test("response data is an array", function() {
    expect(res.body.data).to.be.an("array");
  });

  test("rows expose the pinned published version", function() {
    res.body.data.forEach(function(row) {
      expect(row.publishedVersionNumber).to.be.a("number");
    });
  });

  test("published project is visible to its owner", function() {
    var projectId = bru.getGlobalEnvVar("UIBUILDER_PROJECT_ID") || bru.getEnvVar("UIBUILDER_PROJECT_ID");
    expect(res.body.data.map(function(row) { return row.id; })).to.include(projectId);
  });
}

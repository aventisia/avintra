meta {
  name: Insert UI builder version for pin stability
  type: http
  seq: 20
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/ui-builder/{{UIBUILDER_PROJECT_ID}}/versions
  body: json
  auth: none
}

body:json {
  "uiBuilderProjectId": "{{UIBUILDER_PROJECT_ID}}",
  "promptText": "Pin stability check version",
  "generatedHtml": "<!doctype html><html><body><h1>Pin stability</h1></body></html>",
  "provider": "openai",
  "model": "gpt-4o-mini"
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
          "UIBUILDER_NEW_VERSION_NUMBER",
          res.getBody().data.versionNumber
      );
  }
}

tests {
  test("status code is 200", function() {
    expect(res.status).to.equal(200);
  });

  test("new version number is captured", function() {
    expect(res.body.data.versionNumber).to.be.a("number");
  });
}

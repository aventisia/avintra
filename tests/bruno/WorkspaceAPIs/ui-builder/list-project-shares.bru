meta {
  name: List builder shares returns only project access
  type: http
  seq: 23
}

get {
  url: {{WORKSPACE_API_BASE_URL}}/resource-user-access/{{UIBUILDER_PROJECT_ID}}/list?resourceType=UiBuilder
  body: none
  auth: none
}

tests {
  test("status code is 200", function() {
    expect(res.status).to.equal(200);
  });

  test("rows are builder access only", function() {
    expect(res.body.data).to.be.an("array").that.is.not.empty;
    res.body.data.forEach(function(row) {
      expect(row.resourceType).to.equal("UiBuilder");
    });
  });
}

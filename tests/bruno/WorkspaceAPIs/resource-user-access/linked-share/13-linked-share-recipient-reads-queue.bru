meta {
  name: The new person sees the queue at Can view (AC2)
  type: http
  seq: 13
}

get {
  url: {{WORKSPACE_API_BASE_URL}}/resource-user-access/{{LINK_QUEUE_ID}}/list
  body: none
  auth: bearer
}

auth:bearer {
  token: {{LINK_RECIPIENT_TOKEN}}
}

script:post-response {
  const body = res.getBody();
  const data = Array.isArray(body?.data) ? body.data : [];
  const recipientId = bru.getEnvVar("LINK_RECIPIENT_ID");
  const mine = data.find((share) => share.userId === recipientId);

  test("the new person can read the queue's share list", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("the new person holds Can view on the queue", function() {
    expect(mine, "share row for " + recipientId + " is missing").to.be.an("object");
    expect(mine.accessLevel).to.equal("View");
  });
}

docs {
  > AC2 read-back for a non-credential type. Run after `12-`.
}

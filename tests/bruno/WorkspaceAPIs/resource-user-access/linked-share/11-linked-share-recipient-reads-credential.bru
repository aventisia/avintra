meta {
  name: The new person now holds Can view on the credential (AC1/AC2)
  type: http
  seq: 11
}

get {
  url: {{WORKSPACE_API_BASE_URL}}/resource-user-access/{{LINK_DEV_CREDENTIAL_ID}}/list
  body: none
  auth: bearer
}

auth:bearer {
  token: {{LINK_RECIPIENT_TOKEN}}
}

script:post-response {
  const body = res.getBody();
  const data = Array.isArray(body?.data) ? body.data : [];
  const recipientId = bru.getEnvVar("LINK_RECIPIENT_ID");
  const mine = data.find((share) => share.userId === recipientId);

  test("the new person can read the credential's share list", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("the new person holds Can view on the credential", function() {
    expect(mine, "share row for " + recipientId + " is missing").to.be.an("object");
    expect(mine.accessLevel).to.equal("View");
  });
}

docs {
  > AC1/AC2 read-back: Can view is what the credential run-time check accepts, so
  > the agent runs for the new person without a credential access error.
  > Run after `10-`.
}

meta {
  name: Save shares the Dev credential with the new person (AC1)
  type: http
  seq: 10
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/resource-user-access/bulk
  body: json
  auth: bearer
}

auth:bearer {
  token: {{LINK_OWNER_TOKEN}}
}

body:json {
  {
    "resourceType": "VaultCredential",
    "resourceId": "{{LINK_DEV_CREDENTIAL_ID}}",
    "users": [
      {
        "accessLevel": "View",
        "userId": "{{LINK_RECIPIENT_ID}}"
      }
    ]
  }
}

script:post-response {
  test("the agent owner shares the linked credential at Can view", function() {
    expect([200, 409]).to.include(res.getStatus());
  });
}

docs {
  > The dialog's linked-item fan-out is one `POST resource-user-access/bulk`
  > per candidate, all recipients at View. 409 means the recipient already had
  > the row (add-only), which the dialog treats as non-fatal.
}

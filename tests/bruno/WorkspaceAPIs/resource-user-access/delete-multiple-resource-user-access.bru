meta {
  name: Delete multiple resource share
  type: http
  seq: 8
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/resource-user-access/delete-multiple
  body: json
  auth: none
}

body:json {
  ["{{RESOURCE_USER_ACCESS_ID}}"]
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
        "FLOW_VERSION_USER_ID", 
        "00000000-0000-0000-0000-000000000000"
      );
  }
}


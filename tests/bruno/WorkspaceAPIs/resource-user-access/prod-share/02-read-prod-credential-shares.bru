meta {
  name: Read PROD credential shares
  type: http
  seq: 2
}

get {
  url: {{WORKSPACE_API_BASE_URL}}/resource-user-access/{{PROD_SHARE_CREDENTIAL_ID}}/list
  body: none
  auth: bearer
}

auth:bearer {
  token: {{PROD_SHARE_OWNER_TOKEN}}
}

script:post-response {
  test("PROD clone carries the Dev sharing list with one Owner", function() {
    expect(res.getStatus()).to.equal(200);
    const shares = res.getBody().data || [];
    const level = (userId) => {
      const row = shares.find((entry) => entry.userId === userId);
      return row ? row.accessLevel : null;
    };
    const owners = shares.filter((entry) => entry.accessLevel === "Owner");
    expect(owners.length).to.equal(1);
    expect(level(bru.getEnvVar("PROD_SHARE_PUBLISHER_ID"))).to.equal("Owner");
    expect(level(bru.getEnvVar("PROD_SHARE_DEV_OWNER_ID"))).to.equal("FullAccess");
    expect(level(bru.getEnvVar("PROD_SHARE_USER_ID"))).to.equal(
      bru.getEnvVar("PROD_SHARE_USER_LEVEL") || "View",
    );
  });
}

docs {
  > AC1–AC3/AC6 read-back: the publisher is the only Owner, the non-publisher Dev
  > Owner holds FullAccess, and every Dev sharee keeps their Dev level on the
  > PROD clone. Run after `01-` (first publish) and again after a republish.
}

meta {
  name: PROD share - tenant-wide toggle off
  type: http
  seq: 13
}

put {
  url: {{WORKSPACE_API_BASE_URL}}/resource-user-access/tenant-access
  body: json
  auth: bearer
}

auth:bearer {
  token: {{PROD_SHARE_OWNER_TOKEN}}
}

body:json {
  {
    "resourceType": "{{PROD_SHARE_RESOURCE_TYPE}}",
    "resourceId": "{{PROD_SHARE_RESOURCE_ID}}",
    "isTenantWideAccess": false
  }
}

script:post-response {
  test("owner can toggle tenant-wide access back off", function() {
    expect(res.getStatus()).to.equal(200);
  });
}

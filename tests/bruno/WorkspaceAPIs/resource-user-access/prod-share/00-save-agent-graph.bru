meta {
  name: Save agent graph referencing the Dev resources
  type: http
  seq: 0
}

put {
  url: {{WORKSPACE_API_BASE_URL}}/flow/save
  body: json
  auth: bearer
}

auth:bearer {
  token: {{PROD_SHARE_OWNER_TOKEN}}
}

body:json {
  {
    "id": "{{PROD_SYNC_FLOW_ID}}",
    "versionId": "{{PROD_SYNC_FLOW_VERSION_ID}}",
    "thumbnail": "none",
    "reactFlowObject": "{\"nodes\":[{\"id\":\"node-1\",\"type\":\"toolNode\",\"data\":{\"name\":\"node-1\",\"label\":\"node-1\",\"outputs\":[],\"inputs\":[{\"key\":\"__CredentialName__\",\"value\":\"{{PROD_SYNC_CREDENTIAL_NAME}}\"},{\"key\":\"QueueName\",\"value\":\"{{PROD_SYNC_QUEUE_NAME}}\"},{\"key\":\"__ToolsConfig__\",\"value\":[{\"tool\":\"{{PROD_SYNC_TOOL_NAME}}\"}]},{\"key\":\"__KbConfig__\",\"value\":{\"knowledgeBase\":[\"{{PROD_SYNC_KB_NAME}}\"]}},{\"key\":\"__SkillsConfig__\",\"value\":{\"skills\":[\"{{PROD_SYNC_SKILL_NAME}}\"]}},{\"key\":\"__StoreConfig__\",\"value\":{\"name\":\"{{PROD_SYNC_STORE_PLACEHOLDER}}\"}}]}}],\"edges\":[]}"
  }
}

script:post-response {
  test("draft version stores the graph that references every Configure type", function() {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  > Publish collects its resource references from the stored version graph, so the
  > draft must be saved with the credential, queue, tool, knowledge base, skill
  > and key store names before `01-publish-agent-referencing-credential` runs.
  > The key store is referenced through the `{{__config__NAME}}` placeholder.
}

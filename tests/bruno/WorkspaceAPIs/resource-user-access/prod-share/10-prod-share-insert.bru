meta {
  name: PROD share - insert
  type: http
  seq: 10
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/resource-user-access
  body: json
  auth: bearer
}

auth:bearer {
  token: {{PROD_SHARE_OWNER_TOKEN}}
}

body:json {
  {
    "resourceType": "{{PROD_SHARE_RESOURCE_TYPE}}",
    "resourceId": "{{PROD_SHARE_RESOURCE_ID}}",
    "accessLevel": "View",
    "userId": "{{PROD_SHARE_MEMBER_ID}}"
  }
}

script:post-response {
  test("owner can share a PROD resource", function() {
    expect(res.getStatus()).to.equal(200);
    bru.setVar("PROD_SHARE_ACCESS_ID", res.getBody().data.id);
  });
}

docs {
  > AC4: the block that returned 400 `Cannot share a published (PROD) …` is
  > gone for this mutation.
}

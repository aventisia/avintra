meta {
  name: PROD share - update level
  type: http
  seq: 11
}

put {
  url: {{WORKSPACE_API_BASE_URL}}/resource-user-access
  body: json
  auth: bearer
}

auth:bearer {
  token: {{PROD_SHARE_OWNER_TOKEN}}
}

body:json {
  {
    "id": "{{PROD_SHARE_ACCESS_ID}}",
    "resourceType": "{{PROD_SHARE_RESOURCE_TYPE}}",
    "resourceId": "{{PROD_SHARE_RESOURCE_ID}}",
    "accessLevel": "Edit",
    "userId": "{{PROD_SHARE_MEMBER_ID}}"
  }
}

script:post-response {
  test("owner can change a user's level on a PROD resource", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.accessLevel).to.equal("Edit");
  });
}

docs {
  > AC7: change someone's access level in PROD. Uses the id captured by `10-`.
}

meta {
  name: Publish agent referencing shared resources
  type: http
  seq: 1
}

put {
  url: {{WORKSPACE_API_BASE_URL}}/flow/publish
  body: json
  auth: bearer
}

auth:bearer {
  token: {{PROD_SHARE_OWNER_TOKEN}}
}

body:json {
  {
    "id": "{{PROD_SYNC_FLOW_VERSION_ID}}",
    "flowId": "{{PROD_SYNC_FLOW_ID}}",
    "name": "{{PROD_SYNC_FLOW_NAME}}",
    "type": "Agent"
  }
}

script:post-response {
  test("agent publishes and clones its Dev resources to PROD", function() {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  > Publishes the draft saved by `00-`, so `EnsureProdClonesAsync` creates the
  > PROD clones, assigns the publisher as Owner and copies every Dev sharing
  > list add-only (a non-publisher Dev Owner arrives as FullAccess).
  > Republishing the same version is the add-only re-sync path (AC3/AC6).
}

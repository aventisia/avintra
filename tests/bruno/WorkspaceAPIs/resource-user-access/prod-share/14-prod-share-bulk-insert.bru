meta {
  name: PROD share - bulk insert
  type: http
  seq: 14
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/resource-user-access/bulk
  body: json
  auth: bearer
}

auth:bearer {
  token: {{PROD_SHARE_OWNER_TOKEN}}
}

body:json {
  {
    "resourceType": "{{PROD_SHARE_RESOURCE_TYPE}}",
    "resourceId": "{{PROD_SHARE_RESOURCE_ID}}",
    "users": [
      {
        "accessLevel": "View",
        "userId": "{{PROD_SHARE_MEMBER_TWO_ID}}"
      },
      {
        "accessLevel": "View",
        "userId": "{{PROD_SHARE_MEMBER_THREE_ID}}"
      }
    ]
  }
}

script:post-response {
  test("owner can bulk-share a PROD resource", function() {
    expect(res.getStatus()).to.equal(200);
  });
}

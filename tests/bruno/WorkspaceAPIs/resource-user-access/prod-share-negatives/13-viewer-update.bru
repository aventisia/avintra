meta {
  name: PROD share negatives - viewer self-escalate
  type: http
  seq: 13
}

put {
  url: {{WORKSPACE_API_BASE_URL}}/resource-user-access
  body: json
  auth: bearer
}

auth:bearer {
  token: {{NEG_VIEWER_TOKEN}}
}

body:json {
  {
    "id": "{{NEG_VIEWER_ACCESS_ID}}",
    "resourceType": "Queue",
    "resourceId": "{{NEG_RESOURCE_ID}}",
    "accessLevel": "Owner",
    "userId": "{{NEG_VIEWER_ID}}"
  }
}

script:post-response {
  test("a View-only user cannot raise their own level", function() {
    expect(res.getStatus()).to.equal(403);
  });
}

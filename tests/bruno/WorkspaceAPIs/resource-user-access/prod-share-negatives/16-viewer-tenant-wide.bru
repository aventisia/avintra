meta {
  name: PROD share negatives - viewer tenant-wide
  type: http
  seq: 16
}

put {
  url: {{WORKSPACE_API_BASE_URL}}/resource-user-access/tenant-access
  body: json
  auth: bearer
}

auth:bearer {
  token: {{NEG_VIEWER_TOKEN}}
}

body:json {
  {
    "resourceType": "Queue",
    "resourceId": "{{NEG_RESOURCE_ID}}",
    "isTenantWideAccess": true
  }
}

script:post-response {
  test("a View-only user cannot flip tenant-wide access", function() {
    expect(res.getStatus()).to.equal(403);
  });
}

docs {
  > PT-04 first live execution: tenant-wide alone resolves to View, never share rights.
}

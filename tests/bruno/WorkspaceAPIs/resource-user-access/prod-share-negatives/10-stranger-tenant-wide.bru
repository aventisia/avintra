meta {
  name: PROD share negatives - stranger tenant-wide
  type: http
  seq: 10
}

put {
  url: {{WORKSPACE_API_BASE_URL}}/resource-user-access/tenant-access
  body: json
  auth: bearer
}

auth:bearer {
  token: {{NEG_STRANGER_TOKEN}}
}

body:json {
  {
    "resourceType": "Queue",
    "resourceId": "{{NEG_RESOURCE_ID}}",
    "isTenantWideAccess": true
  }
}

script:post-response {
  test("another tenant cannot flip tenant-wide access", function() {
    expect(res.getStatus()).to.equal(404);
  });
}

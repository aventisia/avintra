meta {
  name: PROD share negatives - viewer cannot share a tenant-wide resource
  type: http
  seq: 21
}

put {
  url: {{WORKSPACE_API_BASE_URL}}/resource-user-access/tenant-access
  body: json
  auth: bearer
}

auth:bearer {
  token: {{NEG_VIEWER_TOKEN}}
}

body:json {
  {
    "resourceType": "Queue",
    "resourceId": "{{NEG_RESOURCE_ID}}",
    "isTenantWideAccess": false
  }
}

script:post-response {
  test("tenant-wide access does not confer share rights", function() {
    expect(res.getStatus()).to.equal(403);
  });
}

docs {
  > Runs while `20-` has tenant-wide access on: a View-only user still cannot change sharing.
}

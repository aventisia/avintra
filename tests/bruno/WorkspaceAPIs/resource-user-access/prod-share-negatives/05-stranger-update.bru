meta {
  name: PROD share negatives - stranger update
  type: http
  seq: 5
}

put {
  url: {{WORKSPACE_API_BASE_URL}}/resource-user-access
  body: json
  auth: bearer
}

auth:bearer {
  token: {{NEG_STRANGER_TOKEN}}
}

body:json {
  {
    "id": "{{NEG_VIEWER_ACCESS_ID}}",
    "resourceType": "Queue",
    "resourceId": "{{NEG_RESOURCE_ID}}",
    "accessLevel": "Owner",
    "userId": "{{NEG_VIEWER_ID}}"
  }
}

script:post-response {
  test("another tenant cannot change an access level", function() {
    expect(res.getStatus()).to.equal(404);
  });
}

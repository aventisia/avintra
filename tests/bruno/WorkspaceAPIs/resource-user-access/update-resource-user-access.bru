meta {
  name: Update resource share
  type: http
  seq: 2
}

put {
  url: {{WORKSPACE_API_BASE_URL}}/resource-user-access
  body: json
  auth: none
}

body:json {
  {
    "id": "{{RESOURCE_USER_ACCESS_ID}}",
    "resourceType": "VaultCredential",
    "resourceId": "{{VAULT_CREDENTIAL_ID}}",
    "accessLevel": "FullAccess",
    "userId": "{{USER_ID}}"
  }
}

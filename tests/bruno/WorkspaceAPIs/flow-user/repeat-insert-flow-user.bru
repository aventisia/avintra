meta {
  name: Repeat - Insert flow user
  type: http
  seq: 7
}

post {
  url: {{WORKSPACE_APIS_BASE_URL}}/flow-user
  body: none
  auth: none
}

body:json {
  {
      
  }
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    flowId: bru.getGlobalEnvVar("FLOW_ID"),
    userId: bru.getGlobalEnvVar("USER_ID"),
    type: "Edit"
  })
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
          "FLOW_USER_ID",
          res.getBody().data.id
      );
  }
}

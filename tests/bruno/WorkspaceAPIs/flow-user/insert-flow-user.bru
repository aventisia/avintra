meta {
  name: Insert flow user
  type: http
  seq: 2
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/flow-user
  body: json
  auth: none
}

body:json {
  "flowId": "{{FLOW_ID}}",
  "userId": "{{USER_ID}}",
  "type": "Edit"
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
          "FLOW_USER_ID",
          res.getBody().data.id
      );
  }
}

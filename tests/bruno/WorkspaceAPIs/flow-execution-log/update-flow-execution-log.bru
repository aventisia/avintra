meta {
  name: Update flow execution log
  type: http
  seq: 4
}

put {
  url: {{WORKSPACE_API_BASE_URL}}/flow-execution-log/update
  body: json
  auth: none
}

body:json {
  "id": "{{EXECUTION_LOG_ID}}",
  "flowId": "b6f680a0-31ec-4128-96df-55b84e1daf2b",
  "flowVersionId": "81363bc4-eee0-4a30-90c8-362f5486fdf8",
  "name": "{{$randomFirstName}}",
  "startTime": "{{$isoTimestamp}}",
  "endTime": "{{$isoTimestamp}}",
  "retryCount": 1,
  "version": 1,
  "duration": 200,
  "status": "Succeeded",
  "errorMessage": "No error",
  "executionType": "Scheduler"
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
          "EXECUTION_LOG_ID",
          res.getBody().data.id
      );
  }
}

docs {
  > bru.getGlobalEnvVar("FLOW_ID")
}

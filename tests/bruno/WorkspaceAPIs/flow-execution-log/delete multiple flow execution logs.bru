meta {
  name: Delete multiple flow execution logs
  type: http
  seq: 7
}

post {
  url: {{WORKSPACE_API_BASE_URL}}/flow-execution-log/delete-multiple
  body: json
  auth: none
}

body:json {
  [
    "{{EXECUTION_LOG_ID}}"
  ]
}
script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
        "EXECUTION_LOG_ID", 
        "00000000-0000-0000-0000-000000000000"
      );
  }
}

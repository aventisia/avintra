meta {
  name: Update project template
  type: http
  seq: 2
}

put {
  url: {{WORKSPACE_API_BASE_URL}}/project-template
  body: json
  auth: none
}

body:json {
  [
    {
      "id": "{{PROJECT_TEMPLATE_ID}}",
      "name": "Manager",
      "description": "",
      "type": "Agent",
      "accessType": "Public",
      "accessPath": "/agent?f=6cfa0f4b-8516-4bb4-97d3-ed8a67a4c35e&v=516b6972-bd80-4174-94b1-a00d64d81032","tags": ["Test","Tata"],
      "refId": "516b6972-bd80-4174-94b1-a00d64d81032",
      "resources": [
        {
          "id": "30c97d97-b0d5-445b-8e1a-a61d3ec2796b",
          "name": "Bakery_Store_Invoice_Format.pdf",
          "size": 154885,
          "path": "/files/ff1a4458-f8eb-477c-9560-b8f6614221e8.pdf",
          "extension": "PDF"
        }
  ]
  }
}

body:multipart-form {
  Name: Test
  Description: This is test
  Type: Agent
  AccessType: Public
  RefId: 516b6972-bd80-4174-94b1-a00d64d81032
  Tags: ["Test","Template"]
  Files: @file(/home/rahmat/Gitea/Test/Bakery_Store_Invoice_Format.pdf)
}

script:post-response {
  if(res.getStatus() == 200){
    bru.setGlobalEnvVar(
    "PROJECT_TEMPLATE_ID",
    res.getBody().data.id
    );
  }
}

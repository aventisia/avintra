meta {
  name: Get job after execution graph denial
  type: http
  seq: 13
}

get {
  url: {{WORKSPACE_API_BASE_URL}}/job/{{RESTRICTED_GRAPH_JOB_ID}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

script:post-response {
  const jobId = bru.getGlobalEnvVar("RESTRICTED_GRAPH_JOB_ID") || bru.getEnvVar("RESTRICTED_GRAPH_JOB_ID");
  const body = res.getBody();
  const text = typeof body === "string" ? body : JSON.stringify(body);

  test("job fetch returns 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("job is recorded as Failed", function() {
    expect(res.getBody().data.id).to.equal(jobId);
    expect(res.getBody().data.status).to.equal("Failed");
  });

  test("job remark carries the restriction message", function() {
    expect(text).to.contain("Cannot run: this agent is not assigned to restricted resource(s):");
  });
}

docs {
  > Run after get-execution-graph-blocked-by-restriction. A denied graph fetch marks the
  > job Failed and stores the full restriction message in its remark, so the failure is
  > visible in the job list even though the runner only sees an HTTP error.
  > ACCESS_TOKEN must belong to an OM user.
}

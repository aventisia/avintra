meta {
  name: Get execution graph
  type: http
  seq: 2
}

get {
  url: {{WORKSPACE_API_BASE_URL}}/execution/graph/{{JOB_ID}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

vars:pre-request {
  JOB_ID: f6158c61-8e2e-4238-968a-fb52566abe4d
}

assert {
  res.status: eq 200
  res.body.statusCode: eq 200
  res.body.message: isDefined
  res.body.data.jobId: isDefined
  res.body.data.flowVersionId: isDefined
  res.body.data.reactFlowObject: isDefined
}

script:post-response {
  if (res.status === 200 && res.body?.data?.jobId) {
      bru.setGlobalEnvVar("EXECUTION_CONTRACT_JOB_ID", res.body.data.jobId);
  }
}

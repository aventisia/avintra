meta {
  name: create - calendar event
  type: http
  seq: 79
}

post {
  url: {{BASE_URL}}/connectors/m365
  body: json
  auth: none
}

body:json {
  {
    "connector": "m365",
    "operation": "calendarevent.create",
    "configuration": {
      "baseUrl": "{{M365_BASE_URL}}",
      "userId": "{{M365_USER_ID}}"
    },
    "auth": {
      "type": "accessToken",
      "token": "{{M365_TOKEN}}"
    },
    "payload": {
      "subject": "Planning",
      "start": {
        "dateTime": "2026-09-01T09:00:00",
        "timeZone": "UTC"
      },
      "end": {
        "dateTime": "2026-09-01T10:00:00",
        "timeZone": "UTC"
      }
    }
  }
}

tests {
  test("status code is 200", function() {
    expect(res.status).to.equal(200);
  });

  test("response ok is true", function() {
    expect(res.body.ok).to.equal(true);
  });

  test("response identifies the connector", function() {
    expect(res.body.connector).to.equal('m365');
  });

  test("response includes targetUri", function() {
    expect(res.body.targetUri).to.be.a('string');
  });
}

meta {
  name: clone - team
  type: http
  seq: 149
}

post {
  url: {{BASE_URL}}/connectors/m365
  body: json
  auth: none
}

body:json {
  {
    "connector": "m365",
    "operation": "teams.clone",
    "configuration": {
      "baseUrl": "{{M365_BASE_URL}}",
      "teamId": "{{M365_TEAM_ID}}"
    },
    "auth": {
      "type": "accessToken",
      "token": "{{M365_TOKEN}}"
    },
    "payload": {
      "displayName": "Cloned Team",
      "description": "Clone",
      "mailNickname": "cloneteam",
      "visibility": "private",
      "partsToClone": "apps,channels,members,settings,tabs"
    }
  }
}

tests {
  test("status code is 200", function() {
    expect(res.status).to.equal(200);
  });

  test("response ok is true", function() {
    expect(res.body.ok).to.equal(true);
  });

  test("response identifies the connector", function() {
    expect(res.body.connector).to.equal('m365');
  });

  test("response includes targetUri", function() {
    expect(res.body.targetUri).to.be.a('string');
  });
}

meta {
  name: add - mail attachment
  type: http
  seq: 68
}

post {
  url: {{BASE_URL}}/connectors/m365
  body: json
  auth: none
}

body:json {
  {
    "connector": "m365",
    "operation": "mailattachment.add",
    "configuration": {
      "baseUrl": "{{M365_BASE_URL}}",
      "userId": "{{M365_USER_ID}}",
      "messageId": "{{M365_MESSAGE_ID}}"
    },
    "auth": {
      "type": "accessToken",
      "token": "{{M365_TOKEN}}"
    },
    "payload": {
      "@odata.type": "#microsoft.graph.fileAttachment",
      "name": "hello.txt",
      "contentBytes": "{{M365_ATTACHMENT_BASE64}}"
    }
  }
}

tests {
  test("status code is 200", function() {
    expect(res.status).to.equal(200);
  });

  test("response ok is true", function() {
    expect(res.body.ok).to.equal(true);
  });

  test("response identifies the connector", function() {
    expect(res.body.connector).to.equal('m365');
  });

  test("response includes targetUri", function() {
    expect(res.body.targetUri).to.be.a('string');
  });
}

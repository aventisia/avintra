meta {
  name: update - mail attachment
  type: http
  seq: 69
}

post {
  url: {{BASE_URL}}/connectors/m365
  body: json
  auth: none
}

body:json {
  {
    "connector": "m365",
    "operation": "mailattachment.update",
    "configuration": {
      "baseUrl": "{{M365_BASE_URL}}",
      "userId": "{{M365_USER_ID}}",
      "messageId": "{{M365_MESSAGE_ID}}",
      "attachmentId": "{{M365_ATTACHMENT_ID}}"
    },
    "auth": {
      "type": "accessToken",
      "token": "{{M365_TOKEN}}"
    },
    "payload": {
      "name": "renamed.txt"
    }
  }
}

tests {
  test("status code is 200", function() {
    expect(res.status).to.equal(200);
  });

  test("response ok is true", function() {
    expect(res.body.ok).to.equal(true);
  });

  test("response identifies the connector", function() {
    expect(res.body.connector).to.equal('m365');
  });

  test("response includes targetUri", function() {
    expect(res.body.targetUri).to.be.a('string');
  });
}

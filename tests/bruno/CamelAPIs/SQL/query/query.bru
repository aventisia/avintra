meta {
  name: query - run raw SQL
  type: http
  seq: 1
}

post {
  url: {{APACHE_CAMEL_BASE_URL}}/connectors/sql
  body: json
  auth: none
}

body:json {
  {
    "connector": "sql",
    "operation": "query",
    "configuration": {
      "query": "SELECT * FROM users"
    },
    "auth": {
      "type": "database",
      "properties": {
        "url": "jdbc:postgresql://{{POSTGRES_HOST}}:{{POSTGRES_PORT}}/{{POSTGRES_DB}}",
        "username": "{{POSTGRES_USER}}",
        "password": "{{POSTGRES_PASSWORD}}"
      }
    },
    "payload": null
  }
}

tests {
  test("status code is 200", function() {
    expect(res.status).to.equal(200);
  });
  
  test("response ok is true", function() {
    expect(res.body.ok).to.equal(true);
  });
  
  test("response identifies the connector", function() {
    expect(res.body.connector).to.equal('sql');
  });
  
  test("response includes targetUri", function() {
    expect(res.body.targetUri).to.be.a('string');
  });
}

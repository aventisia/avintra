meta {
  name: PUT - update item by id
  type: http
  seq: 3
}

post {
  url: {{CAMEL_API_BASE_URL}}/connectors/http
  body: json
  auth: none
}

body:json {
  {
    "connector": "http",
    "operation": "PUT",
    "configuration": {
      "host": "{{HTTP_HOST}}:{{HTTP_PORT}}",
      "path": "items/1",
      "httpMethod": "PUT"
    },
    "headers": {
      "Content-Type": "application/json"
    },
    "auth": null,
    "payload": {
      "id": 1,
      "name": "updated"
    }
  }
}

tests {
  test("status code is 200", function() {
    expect(res.status).to.equal(200);
  });

  test("response ok is true", function() {
    expect(res.body.ok).to.equal(true);
  });

  test("response identifies the connector", function() {
    expect(res.body.connector).to.equal('http');
  });

  test("response includes targetUri", function() {
    expect(res.body.targetUri).to.be.a('string');
  });
}

meta {
  name: GET - fetch echo endpoint
  type: http
  seq: 1
}

post {
  url: {{BASE_URL}}/connectors/http
  body: json
  auth: none
}

body:json {
  {
    "connector": "http",
    "operation": "GET",
    "configuration": {
      "host": "{{HTTP_HOST}}:{{HTTP_PORT}}",
      "path": "echo",
      "httpMethod": "GET"
    },
    "headers": {},
    "auth": null,
    "payload": null
  }
}

tests {
  test("status code is 200", function() {
    expect(res.status).to.equal(200);
  });

  test("response ok is true", function() {
    expect(res.body.ok).to.equal(true);
  });

  test("response identifies the connector", function() {
    expect(res.body.connector).to.equal('http');
  });

  test("response includes targetUri", function() {
    expect(res.body.targetUri).to.be.a('string');
  });
}

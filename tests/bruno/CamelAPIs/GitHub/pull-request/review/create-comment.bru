meta {
  name: create review comment - pull request
  type: http
  seq: 42
}

post {
  url: {{BASE_URL}}/connectors/github
  body: json
  auth: none
}

body:json {
  {
    "connector": "github",
    "operation": "pullrequest.review.create-comment",
    "configuration": {
      "baseUrl": "{{GITHUB_BASE_URL}}",
      "owner": "{{GITHUB_OWNER}}",
      "repo": "{{GITHUB_REPO}}",
      "number": "1",
      "reviewId": "1"
    },
    "auth": {
      "type": "accessToken",
      "token": "{{GITHUB_TOKEN}}"
    },
    "payload": {
      "body": "Inline comment",
      "path": "src/Main.java",
      "line": 10
    }
  }
}

tests {
  test("status code is 200", function() {
    expect(res.status).to.equal(200);
  });

  test("response ok is true", function() {
    expect(res.body.ok).to.equal(true);
  });

  test("response identifies the connector", function() {
    expect(res.body.connector).to.equal('github');
  });

  test("response includes targetUri", function() {
    expect(res.body.targetUri).to.be.a('string');
  });
}

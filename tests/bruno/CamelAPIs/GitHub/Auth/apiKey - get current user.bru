meta {
  name: apiKey - get current user
  type: http
  seq: 3
}

post {
  url: {{BASE_URL}}/connectors/github
  body: json
  auth: none
}

body:json {
  {
    "connector": "github",
    "operation": "user.get-current",
    "configuration": {
      "baseUrl": "{{GITHUB_BASE_URL}}"
    },
    "auth": {
      "type": "apiKey",
      "apiKey": "{{GITHUB_API_KEY}}",
      "apiKeyHeader": "Authorization"
    },
    "payload": null
  }
}

tests {
  test("status code is 200", function() {
    expect(res.status).to.equal(200);
  });

  test("response ok is true", function() {
    expect(res.body.ok).to.equal(true);
  });

  test("response identifies the connector", function() {
    expect(res.body.connector).to.equal('github');
  });
}

# Copy this file to `.env` (gitignored; scripts/setup.sh does this) and fill in your own values.
# Bruno loads `tests/bruno/.env` automatically for both the CLI and the
# desktop app, exposing each entry as {{process.env.<NAME>}}.
# `environments/*.bru` map the login credentials below into {{MY_EMAIL}}/{{MY_PWD}}.
#
# Quote values that contain #, \, " or newlines, e.g. MY_PWD="p@ss#word".

# Login credentials used by AccountsAPIs/login-with-pwd
MY_EMAIL=you@example.com
MY_PWD=your-password

# Per-role login credentials (workspace roles SA/TA/OM/TD/TU).
# The DB seed creates only the super user (random password); create one user
# per role manually (localhost) or via a future seed before using these.
SA_EMAIL=
SA_PWD=
TA_EMAIL=
TA_PWD=
OM_EMAIL=
OM_PWD=
TD_EMAIL=
TD_PWD=
TU_EMAIL=
TU_PWD=

# Local service ports used by environments/localhost.bru. `scripts/create-worktree`
# re-prefixes these with the worktree number when copying .env into a new worktree,
# so `--env localhost` automatically targets that worktree's services.
ACCOUNTS_API_PORT=4000
WORKSPACE_API_PORT=4001
LLMPIPELINE_API_PORT=4003
CAMEL_API_PORT=4005
CORSAIR_API_PORT=4006
GLOBALADMIN_API_PORT=4004

# Global Admin session token used by the GlobalAdminAPIs collection. Sign in as
# a user with the SA role in a Commercial deployment and paste its accessToken.
SA_TOKEN=

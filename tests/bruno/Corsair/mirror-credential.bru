meta {
  name: Mirror Credential
  type: http
  seq: 3
}

post {
  url: {{CORSAIR_SIDECAR_URL}}/credentials
  body: json
  auth: none
}

body:json {
  {
    "connectionId": "{{CORSAIR_CONNECTION_ID}}",
    "plugin": "{{CORSAIR_PLUGIN}}",
    "apiKey": "{{CORSAIR_PLUGIN_API_KEY}}"
  }
}

assert {
  res.status: eq 200
  res.body: contains "success"
}

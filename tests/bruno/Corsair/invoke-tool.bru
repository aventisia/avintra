meta {
  name: Invoke Tool
  type: http
  seq: 4
}

post {
  url: {{CORSAIR_SIDECAR_URL}}/corsair/invoke
  body: json
  auth: none
}

headers {
  X-Corsair-Api-Key: {{CORSAIR_API_KEY}}
}

body:json {
  {
    "connectionId": "73bd9857-bac7-4b97-8b7f-4ab261d39b7e",
    "plugin": "github",
    "action": "repositories.list",
    "payload": {}
  }
}

assert {
  res.status: eq 200
  res.body: contains "success"
}

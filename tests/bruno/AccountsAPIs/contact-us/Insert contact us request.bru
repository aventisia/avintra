meta {
  name: Insert contact us request
  type: http
  seq: 1
}

post {
  url: {{ACCOUNTS_API_BASE_URL}}/contact-us
  body: json
  auth: none
}

body:json {
  "name": "{{$randomFullName}}",
  "email": "{{$randomEmail}}",
  "phone": "{{$randomPhoneNumber}}",
  "message": "{{$randomLoremParagraph}}"
}

meta {
  name: Delete ai task
  type: http
  seq: 8
}

delete {
  url: {{ACCOUNTS_API_BASE_URL}}/ai-task/{{AI_TASK_ID}}
  body: none
  auth: none
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
        "AI_TASK_ID", 
        "00000000-0000-0000-0000-000000000000"
      );
  }
}

meta {
  name: Delete multiple ai tasks
  type: http
  seq: 10
}

post {
  url: {{ACCOUNTS_API_BASE_URL}}/ai-task/delete-multiple
  body: json
  auth: none
}

body:json {
  ["{{AI_TASK_ID}}"]
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
        "AI_TASK_ID", 
        "00000000-0000-0000-0000-000000000000"
      );
  }
}

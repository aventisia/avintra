meta {
  name: Repeat - Insert credit plan
  type: http
  seq: 7
}

post {
  url: {{ACCOUNTS_APIS_BASE_URL}}/credit-plans
  body: json
  auth: none
}

body:json {
  {
    "serviceType": "Gpt4oMiniInput",
    "unitType": "Tokens",
    "oneUnit": "30",
    "credits": "15"
  }
  
}

script:post-response {
  if(res.getStatus() == 200)
  {
    bru.setGlobalEnvVar("CREDIT_PLAN_ID", res.getBody().data.id);
  }
}

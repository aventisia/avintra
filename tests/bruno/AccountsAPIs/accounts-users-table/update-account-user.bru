meta {
  name: Update account user
  type: http
  seq: 3
}

put {
  url: {{ACCOUNTS_API_BASE_URL}}/user/
  body: json
  auth: none
}

body:json {
  {
    "id": "{{ACCOUNT_USER_ID}}",
    "firstName": "{{$randomFirstName}}",
    "lastName": "{{$randomLastName}}",
    "email": "{{$randomEmail}}",
    "twoFactorEnabled": false,
    "userRoles": [
        "Tenant user"
      ]
  }
}

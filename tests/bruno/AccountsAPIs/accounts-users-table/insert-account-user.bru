meta {
  name: Insert account user
  type: http
  seq: 2
}

post {
  url: {{ACCOUNTS_API_BASE_URL}}/user
  body: json
  auth: none
}

body:json {
  "firstName": "{{$randomFirstName}}",
  "lastName": "{{$randomLastName}}",
  "email": "{{$randomEmail}}",
  "twoFactorEnabled": false,
  "userRoles": [
      "Tenant user"
    ]
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
          "ACCOUNT_USER_ID",
          res.getBody().data.id
      );
  }
}

meta {
  name: update-pwd set first password
  type: http
  seq: 11
}

post {
  url: {{ACCOUNTS_API_BASE_URL}}/me/update-pwd
  body: json
  auth: none
}

body:json {
  "oldPwd": "",
  "newPwd": "REPLACE-WITH-A-FRESH-VALUE-8-TO-16-CHARS",
  "logoffFromOtherSessions": false
}

tests {
  test("sets the first password without a current password", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("confirms the password was updated", function() {
    expect(res.getBody()).to.contain("Your password has been updated successfully");
  });
}

docs {
  > Run this with a passwordless (social sign-up) session: sign in via a social
  > provider first so the request carries that session's cookies, then replace
  > `newPwd` with a fresh 8-to-16-character value on every run. A repeat run
  > with the same value trips the obsolete-password policy, and running it as
  > an account that already has a password correctly returns
  > "Old password is incorrect" instead of 200.
}

meta {
  name: Update name
  type: http
  seq: 5
}

post {
  url: {{ACCOUNTS_APIS_BASE_URL}}/me/update-name
  body: json
  auth: none
}

script:pre-request {
  const {faker} = require('@faker-js/faker');
  
  req.setBody({
    firstName: faker.commerce.product(),
    lastName: faker.commerce.product(),
  })
}

meta {
  name: update profile
  type: http
  seq: 3
}

put {
  url: {{ACCOUNTS_API_BASE_URL}}/me/update-profile
  body: json
  auth: none
}

body:json {
  "avatarSrc": "{{$randomAvatarImage}}",
  "firstName": "{{$randomFirstName}}",
  "lastName": "{{$randomLastName}}",
  "dateOfBirth": "{{$randomPastDate}}",
  "phoneNumber": "{{$randomPhoneNumber}}",
  "phoneNumberType": "Home",
  "addressLin1": "{{$randomStreetAddress}}",
  "addressLine2": "{{$randomStreetAddress}}",
  "gender": "female",
  "country": "{{$randomCountry}}",
  "city": "{{$randomCity}}",
  "stateOrProvince": "{{$randomState}}",
  "zipOrPostalCode": "{{$randomZipCode}}"
}

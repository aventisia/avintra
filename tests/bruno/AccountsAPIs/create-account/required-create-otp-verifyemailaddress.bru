meta {
  name: Required - Create OTP (VerifyEmailAddress)
  type: http
  seq: 2
}

post {
  url: {{ACCOUNTS_APIS_BASE_URL}}/auth/create-code
  body: none
  auth: none
}

body:json {
  {
      "email": "{{MY_EMAIL}}",
      "requestType": "VerifyEmailAddress"
  }
}

script:pre-request {
  req.setBody({
    email: bru.getGlobalEnvVar("MY_EMAIL"),
    requestType: "VerifyEmailAddress"
  })
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
        "VERIFICATION_CODE_ID", 
        res.getBody().data.verificationCodeId
      );
  }
}

docs {
  This endpoint must be called before creating an account or whenever a user is going to change their email address.
  
  > Note: This endpoint always returns a success response regardless of the actual outcome. This is done for security reasons and the client will not be informed of the specific result.
}

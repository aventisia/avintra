meta {
  name: Update tenant subscription frequency
  type: http
  seq: 7
}

put {
  url: {{ACCOUNTS_API_BASE_URL}}/tenant-subscriptions/frequency
  body: json
  auth: none
}

body:json {
  {
    "subscriptionId": "{{TENANT_SUBSCRIPTION_ID}}",
    "planId": "{{SUBSCRIPTION_PLAN_ID}}",
    "frequency": "Yearly"
  }
  
}
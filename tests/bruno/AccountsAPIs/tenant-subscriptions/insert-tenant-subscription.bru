meta {
  name: Insert tenant subscription
  type: http
  seq: 2
}

post {
  url: {{ACCOUNTS_API_BASE_URL}}/tenant-subscriptions
  body: json
  auth: none
}

body:json {
  {
    "planId": "{{SUBSCRIPTION_PLAN_ID}}",
    "startDate": "2025-08-20",
    "endDate": "2026-08-20"
  }
  
}

script:post-response {
  if(res.getStatus() == 200)
  {
    bru.setGlobalEnvVar("TENANT_SUBSCRIPTION_ID", res.getBody().data.id);
  }
}

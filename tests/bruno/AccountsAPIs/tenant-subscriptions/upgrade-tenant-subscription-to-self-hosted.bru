meta {
  name: Upgrade tenant subscription to self hosted
  type: http
  seq: 8
}

post {
  url: {{ACCOUNTS_API_BASE_URL}}/tenant-subscriptions/self-hosted/upgrade
  body: json
  auth: none
}

body:json {
  {
    "subscriptionId": "{{TENANT_SUBSCRIPTION_ID}}",
    "planId": "{{SUBSCRIPTION_PLAN_ID}}"
  }
  
}


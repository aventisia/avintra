meta {
  name: Delete Log
  type: http
  seq: 3
}

delete {
  url: {{ACCOUNTS_API_BASE_URL}}/audit-log/delete/{{AUDIT_LOG_ID}}
  body: none
  auth: none
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
        "AUDIT_LOG_ID", 
        "00000000-0000-0000-0000-000000000000"
      );
  }
}
meta {
  name: Verify 2FA code
  type: http
  seq: 3
}

post {
  url: {{ACCOUNTS_API_BASE_URL}}/auth/verify-2fa-code
  body: json
  auth: none
}

body:json {
  "email": "{{MY_EMAIL}}",
  "requestType": "TwoFA",
  "verificationCodeId": "{{VERIFICATION_CODE_ID}}",
  "secretCode": "000000"
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
        "VERIFICATION_CODE_ID", 
        "00000000-0000-0000-0000-000000000000"
      );
  }
}

docs {
  > The `Verify 2FA Code` endpoint is applicable only when two-factor authentication (2FA) is enabled for the user. Before calling the `Verify 2FA Code` endpoint, you must first authenticate the user by using the login endpoint (via `Login with pwd` or any supported single sign-on method).
}

meta {
  name: Insert role
  type: http
  seq: 1
}

post {
  url: {{ACCOUNTS_API_BASE_URL}}/role/
  body: json
  auth: none
}

body:json {
  "FullName": "{{$randomJobTitle}}",
  "Description": "{{$randomLoremSentence}}"
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
          "ROLE_ID",
          res.getBody().data.id
      );
  }
}

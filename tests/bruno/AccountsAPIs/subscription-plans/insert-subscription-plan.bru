meta {
  name: Insert subscription plan
  type: http
  seq: 2
}

post {
  url: {{ACCOUNTS_API_BASE_URL}}/subscription-plans
  body: json
  auth: none
}

body:json {
  {
    "name": "Pro-Test",
    "price": 20,
    "type": "Pro",
    "frequency": "Monthly",
    "currency": "USD",
    "status": "Custom",
    "maxCredits": "24",
    "maxPublishedItems": "15",
    "historyRetentionDays": "7",
    "maxSpaces": "10",
    "storageLimitMB": "200",
    "maxUsers": "15",
    "isRazorpay": false
  }
  
}

script:post-response {
  if(res.getStatus() == 200)
  {
    bru.setGlobalEnvVar("SUBSCRIPTION_PLAN_ID", res.getBody().data.id);
  }
}

meta {
  name: Update subscription plan
  type: http
  seq: 6
}

put {
  url: {{ACCOUNTS_API_BASE_URL}}/subscription-plans
  body: json
  auth: none
}

body:json {
  {
    "id":"{{SUBSCRIPTION_PLAN_ID}}",
    "name": "Pro-20",
    "price": 20,
    "type": "Pro",
    "frequency": "Monthly",
    "currency": "INR",
    "status": "Custom",
    "maxCredits": "2500",
    "maxPublishedItems": "15",
    "historyRetentionDays": "7",
    "maxSpaces": "10",
    "storageLimitMB": "200",
    "maxUsers": "15",
    "isRazorpay": false,
    "isDisabled": false
  }
  
}

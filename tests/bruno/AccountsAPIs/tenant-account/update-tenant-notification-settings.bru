meta {
  name: Update tenant notification settings
  type: http
  seq: 9
}

put {
  url: {{ACCOUNTS_API_BASE_URL}}/tenant-account/notification-settings
  body: json
  auth: none
}

body:json {
  {
    "lowCredits": false,
    "subscription": true,
    "publishAgent": true,
    "subscriptionRenewalReminderDays": 7,
    "lowCreditThreshold": 1000,
    "deliveryChannel": "Platform"
  }
}

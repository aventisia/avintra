meta {
  name: Get tenant preferences
  type: http
  seq: 3
}

get {
  url: {{ACCOUNTS_API_BASE_URL}}/tenant-account/preferences
  body: none
  auth: none
}

tests {
  test("reports SSO availability", function() {
    expect(res.getBody().data).to.have.property("isSSOAvailable");
    expect(res.getBody().data.isSSOAvailable).to.be.a("boolean");
  });
}

meta {
  name: Get branding
  type: http
  seq: 1
}

get {
  url: {{ACCOUNTS_API_BASE_URL}}/branding
  body: none
  auth: none
}

script:post-response {
  const data = res.getBody()?.data ?? {};

  test("returns the deployment branding contract", function() {
    expect(res.getStatus()).to.equal(200);

    // Every branding field is optional and serialized as null when unset, so assert the
    // contract shape is present rather than specific values.
    ["appName", "companyName", "logoUrl", "logoUrlDark", "fullLogoUrl", "faviconUrl", "primaryColor", "secondaryColor"].forEach((field) => {
      expect(data).to.have.property(field);
    });
  });
}

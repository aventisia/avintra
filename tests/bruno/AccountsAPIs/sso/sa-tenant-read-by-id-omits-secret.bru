meta {
  name: Super admin tenant read omits the SSO configuration
  type: http
  seq: 13
}

get {
  url: {{ACCOUNTS_API_BASE_URL}}/tenant/{{TENANT_ID}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

tests {
  test("responds with 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns the stored SSO configuration as null", function() {
    expect(res.getBody().data.ssoConfigJson).to.equal(null);
  });

  test("carries no secret material in the payload", function() {
    expect(res.getStatus()).to.equal(200);
    expect(JSON.stringify(res.getBody())).to.not.contain("byoClientSecret");
  });
}

docs {
  > Preconditions: a Super Admin bearer token in the `ACCESS_TOKEN` global environment variable and
  > `TENANT_ID` pointing at an existing tenant. A single tenant read must never expose the stored SSO
  > configuration or the protected secret document.
  >
  > Reading a failure: 401/403 means the bearer token is missing or is not a Super Admin session, and 400
  > means `TENANT_ID` is missing. Both are environment gaps - the assertions stay strict.
  >
  > Requires: `ACCESS_TOKEN` (Super Admin login), `TENANT_ID`.
}

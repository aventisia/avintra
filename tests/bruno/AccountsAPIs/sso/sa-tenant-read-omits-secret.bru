meta {
  name: Super admin tenant list omits the SSO configuration
  type: http
  seq: 12
}

get {
  url: {{ACCOUNTS_API_BASE_URL}}/tenant
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

tests {
  test("responds with 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns tenants to inspect", function() {
    const tenants = res.getBody().data;

    expect(tenants).to.be.an("array");
    expect(tenants.length).to.be.above(0);
  });

  test("omits the stored SSO configuration on every tenant", function() {
    const tenants = res.getBody().data;

    tenants.forEach(function(tenant) {
      expect(tenant.ssoConfigJson).to.equal(undefined);
    });
  });

  test("carries no secret material in the payload", function() {
    expect(res.getStatus()).to.equal(200);
    expect(JSON.stringify(res.getBody())).to.not.contain("byoClientSecret");
  });
}

docs {
  > Preconditions: a Super Admin bearer token in the `ACCESS_TOKEN` global environment variable and at least
  > one tenant in the environment. The tenant list must never expose the stored SSO configuration, and the
  > protected secret document must not appear anywhere in the payload.
  >
  > Reading a failure: 401/403 means the bearer token is missing or is not a Super Admin session. That is an
  > environment gap - the assertions stay strict and must never be softened into a conditional pass.
  >
  > Requires: `ACCESS_TOKEN` (Super Admin login).
}

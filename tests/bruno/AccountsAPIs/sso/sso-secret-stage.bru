meta {
  name: Tenant secret is staged while SSO stays off
  type: http
  seq: 10
}

put {
  url: {{ACCOUNTS_API_BASE_URL}}/tenant-account/preferences
  body: json
  auth: none
}

body:json {
  {
    "id": "{{TENANT_ID}}",
    "isSSOEnabled": false,
    "isPwdEnabled": true,
    "isPwdNeverExpiresEnabled": true,
    "daysBeforePwdExpires": 730,
    "isIdleSessionTimeoutEnabled": true,
    "idleSessionTimeoutMinutes": 10,
    "isTwoFAEnabled": false,
    "ssoConfigJson": "{\"v\":1,\"provider\":\"microsoft_entra\",\"byoClientId\":\"bruno-byo-client\",\"byoClientSecret\":\"bruno-staged-secret-271\"}"
  }
}

tests {
  test("responds with 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("reports the staged secret as present", function() {
    const data = res.getBody().data;

    expect(data.ssoSecretPresent).to.equal(true);
  });

  test("never echoes the submitted secret", function() {
    expect(res.getStatus()).to.equal(200);

    const body = res.getBody();
    const data = body && body.data ? body.data : {};
    const stored = JSON.stringify(data);

    expect(stored).to.not.contain("bruno-staged-secret-271");
    expect(stored).to.not.contain("byoClientSecret");
  });

  test("keeps the tenant-supplied client id", function() {
    const data = res.getBody().data;
    const config = JSON.parse(data.ssoConfigJson);

    expect(config.byoClientId).to.equal("bruno-byo-client");
  });
}

docs {
  > Preconditions: a tenant admin session (see `ta-login.bru`) and `TENANT_ID` pointing at an Organization
  > tenant with an email domain and SSO switched off. Saving credentials while SSO is off must protect and
  > keep the secret, and the redacted response must report `ssoSecretPresent` without any secret material.
  > `tenant-account/get-tenant-preferences.bru` shows the same field on a plain GET of the stored document.
  >
  > Reading a failure: 401 means no tenant admin session, 400 means the tenant fixture is wrong (not an
  > Organization, no domain). Both are environment gaps, not regressions.
  >
  > Requires: `MY_EMAIL`, `MY_PWD`, `TENANT_ID`.
}

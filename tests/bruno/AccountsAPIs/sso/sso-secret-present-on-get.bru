meta {
  name: Tenant preferences GET shows staged secret presence only
  type: http
  seq: 11
}

get {
  url: {{ACCOUNTS_API_BASE_URL}}/tenant-account/preferences
  body: none
  auth: none
}

tests {
  test("responds with 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("reports secret presence without secret material", function() {
    const data = res.getBody().data;
    const stored = JSON.stringify(data);

    expect(data.ssoSecretPresent).to.equal(true);
    expect(stored).to.not.contain("byoClientSecret");
  });
}

docs {
  > Preconditions: a tenant admin session (see `ta-login.bru`) for a tenant whose BYO secret was saved, for
  > example by `sso-secret-stage.bru` just before this file. The plain GET must surface `ssoSecretPresent`
  > and must never return the stored or protected secret.
  >
  > Reading a failure: 401 means no tenant admin session, and a false `ssoSecretPresent` means no secret was
  > ever staged for this tenant (fixture gap, not a regression).
  >
  > Requires: `MY_EMAIL`, `MY_PWD`.
}

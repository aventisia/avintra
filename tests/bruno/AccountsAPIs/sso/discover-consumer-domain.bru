meta {
  name: Discover rejects consumer domain
  type: http
  seq: 2
}

post {
  url: {{ACCOUNTS_API_BASE_URL}}/auth/discover
  body: json
  auth: none
}

body:json {
  {
    "email": "someone@gmail.com"
  }
}

tests {
  test("responds with 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("never returns a login URL for a consumer domain", function() {
    expect(res.getBody().data.ssoLoginUrl).to.equal(null);
    expect(res.getBody().data.tenantId).to.equal(null);
  });
}

docs {
  > Public/consumer mail domains can never map to an organization single sign-on tenant.
}

meta {
  name: Entra callback rejects missing code
  type: http
  seq: 6
}

get {
  url: {{ACCOUNTS_API_BASE_URL}}/auth/entra/token?code=
  body: none
  auth: none
}

tests {
  test("responds with 400", function() {
    expect(res.getStatus()).to.equal(400);
  });

  test("names the missing authorization code", function() {
    expect(res.getBody()).to.contain("The code field is required.");
  });
}

docs {
  > `?code=` is absent, so the framework request binding rejects the required `code` parameter before the
  > controller runs. The service-level message `Authorization code is missing.` is asserted by the
  > present-but-blank sibling file.
}

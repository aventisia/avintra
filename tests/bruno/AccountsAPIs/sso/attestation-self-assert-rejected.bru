meta {
  name: Attestation cannot be self-asserted
  type: http
  seq: 9
}

put {
  url: {{ACCOUNTS_API_BASE_URL}}/tenant-account/preferences
  body: json
  auth: none
}

body:json {
  {
    "id": "{{TENANT_ID}}",
    "isSSOEnabled": false,
    "isPwdEnabled": true,
    "isPwdNeverExpiresEnabled": true,
    "daysBeforePwdExpires": 730,
    "isIdleSessionTimeoutEnabled": true,
    "idleSessionTimeoutMinutes": 10,
    "isTwoFAEnabled": false,
    "domainVerifyAttestation": false,
    "ssoConfigJson": "{\"v\":1,\"provider\":\"microsoft_entra\",\"externalTenantId\":\"11111111-2222-3333-4444-555555555555\",\"domainVerified\":true,\"domainVerifiedOn\":\"1999-01-01T00:00:00.0000000Z\",\"domainVerifiedBy\":\"attacker\"}"
  }
}

tests {
  test("responds with 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("stores no forged attestor identity or timestamp", function() {
    expect(res.getStatus()).to.equal(200);

    const body = res.getBody();
    const stored = body && body.data ? JSON.stringify(body.data) : "";

    expect(stored).to.not.contain("attacker");
    expect(stored).to.not.contain("1999-01-01");
  });

  test("derives the attestation state instead of trusting the document", function() {
    const data = res.getBody().data;
    const config = JSON.parse(data.ssoConfigJson);

    expect(config.domainVerified).to.equal(false);
    expect(config.domainVerified).to.equal(data.domainVerified);
  });
}

docs {
  > Preconditions: a tenant admin session (see `ta-login.bru`), `TENANT_ID` pointing at an Organization
  > tenant that has an email domain set and whose SSO configuration has never been attested. The submitted
  > document claims `domainVerified:true` with an attacker identity while the attestation checkbox is false;
  > the server must ignore all three client-supplied values. The `emailDomain` is left out on purpose so the
  > stored tenant domain is used.
  >
  > Reading a failure: 401 means no tenant admin session, 400 means the tenant is not an Organization or has
  > no domain, and the third test fails when the fixture tenant already carries a legitimate attestation
  > (reuse endpoint asserts preserved stored values). All are environment gaps, not regressions.
  >
  > Requires: `MY_EMAIL`, `MY_PWD`, `TENANT_ID`.
}

meta {
  name: Entra callback rejects missing state
  type: http
  seq: 4
}

get {
  url: {{ACCOUNTS_API_BASE_URL}}/auth/entra/token?code=test-code
  body: none
  auth: none
}

tests {
  test("responds with 400", function() {
    expect(res.getStatus()).to.equal(400);
  });

  test("names the SSO state as the reason", function() {
    expect(res.getBody()).to.contain("Invalid or expired SSO state.");
  });
}

docs {
  > CSRF guard: the callback requires the single-use state issued with the authorize URL.
}

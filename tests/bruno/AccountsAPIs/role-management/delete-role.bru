meta {
  name: Delete role
  type: http
  seq: 6
}

delete {
  url: {{ACCOUNTS_API_BASE_URL}}/manage-role/{{ROLE_ID}}
  body: none
  auth: none
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
        "ROLE_ID", "00000000-0000-0000-0000-000000000000"
      );
  }
}

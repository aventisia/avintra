meta {
  name: Exchange refuses a mismatched state
  type: http
  seq: 10
}

post {
  url: {{ACCOUNTS_API_BASE_URL}}/auth/desktop/exchange
  body: json
  auth: none
}

body:json {
  {
    "code": "{{DESKTOP_SIGN_IN_CODE_WRONG_STATE}}",
    "state": "desktop-state-not-the-one-that-started-it",
    "codeVerifier": "dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk"
  }
}

tests {
  test("responds with 400", function() {
    expect(res.getStatus()).to.equal(400);
  });

  test("refuses the mismatched attempt", function() {
    expect(res.getBody()).to.contain("Invalid or expired desktop sign-in code.");
  });
}

docs {
  > The code is bound to the state the app generated for that attempt, so a code delivered with another
  > state signs no one in. The failed exchange burns the code.
}

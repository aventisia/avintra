meta {
  name: Exchange refuses a reused code
  type: http
  seq: 7
}

post {
  url: {{ACCOUNTS_API_BASE_URL}}/auth/desktop/exchange
  body: json
  auth: none
}

body:json {
  {
    "code": "{{DESKTOP_SIGN_IN_CODE}}",
    "state": "desktop-state-rfc7636-example",
    "codeVerifier": "dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk"
  }
}

tests {
  test("responds with 400", function() {
    expect(res.getStatus()).to.equal(400);
  });

  test("refuses the second use", function() {
    expect(res.getBody()).to.contain("Invalid or expired desktop sign-in code.");
  });
}

docs {
  > The code minted by `Mint a desktop sign-in code` was consumed by `Exchange the desktop sign-in code for
  > a session`, so the same code signs no one in again. A double-clicked Continue behaves the same way.
}

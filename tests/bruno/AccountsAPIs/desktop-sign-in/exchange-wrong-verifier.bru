meta {
  name: Exchange refuses a mismatched code verifier
  type: http
  seq: 12
}

post {
  url: {{ACCOUNTS_API_BASE_URL}}/auth/desktop/exchange
  body: json
  auth: none
}

body:json {
  {
    "code": "{{DESKTOP_SIGN_IN_CODE_WRONG_VERIFIER}}",
    "state": "desktop-state-wrong-verifier-case",
    "codeVerifier": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
  }
}

tests {
  test("responds with 400", function() {
    expect(res.getStatus()).to.equal(400);
  });

  test("refuses the mismatched attempt", function() {
    expect(res.getBody()).to.contain("Invalid or expired desktop sign-in code.");
  });
}

docs {
  > PKCE S256 binds the code to the app that started the attempt: only the verifier whose challenge was
  > minted with the code passes. The submitted verifier here is a different syntactically valid value.
}

meta {
  name: Create user account
  type: http
  seq: 3
}

post {
  url: {{ACCOUNTS_API_BASE_URL}}/auth/create-user-account
  body: json
  auth: none
}

body:json {
  {
      "email": "{{MY_EMAIL}}",
      "firstName": "Rahmat",
      "lastName": "Ali",
      "pwd": "Post@123",
      "verificationCodeId": "{{VERIFICATION_CODE_ID}}",
      "secretCode": "558532",
      "isSocialSignUp": false
  }
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
        "USER_ID", 
        res.getBody().data.id
      );
  }
}

docs {
  To use the `register` endpoint, follow these steps:  
  
  1. Execute the Create OTP (VerifyEmailAddress) `create-code` endpoint. This must be done for the same email Id intended for account creation.
  2. The API will generate a verification code and update the Global environment variable `VERIFICATION_CODE_ID` accordingly.  
  3. Copy the OTP received in the email. Insert the OTP into the `secretCode` field within the payload.
  4. Submit the request to execute the `register` endpoint.  
}

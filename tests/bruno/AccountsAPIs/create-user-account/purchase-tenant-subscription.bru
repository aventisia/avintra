meta {
  name: Purchase tenant subscription
  type: http
  seq: 5
}

post {
  url: {{ACCOUNTS_API_BASE_URL}}/tenant-subscriptions/purchase-plan
  body: json
  auth: none
}

body:json {
  {
    "planId": "{{SUBSCRIPTION_PLAN_ID}}",
    "frequency": "Monthly",
    "addressLine1": "123 Main Street",
    "addressLine2": "Apt 4B",
    "city": "Noida",
    "postalCode": "123456",
    "state": "Uttar Pradesh",
    "country": "India",
    "isWillingToFileGst": true,
    "gstNumber": "GST1234567890",
    "amount": 24,
    "taxRate": 18
  }
  
}

script:post-response {
  if(res.getStatus() == 200)
  {
    bru.setGlobalEnvVar("TENANT_SUBSCRIPTION_ID", res.getBody().data.id);
  }
}

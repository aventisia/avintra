meta {
  name: Update role
  type: http
  seq: 3
}

put {
  url: {{ACCOUNTS_API_BASE_URL}}/tenant-role
  body: json
  auth: none
}

body:json {
  "id": "{{ROLE_ID}}",
  "fullName": "{{$randomJobTitle}}",
  "description": "{{$randomLoremSentences}}",
  "rolePermissions": [
    {
      "permissionType": "Roles",
      "accesses": ["FullAccess", "Delete", "Edit"]
    }
  ]
}

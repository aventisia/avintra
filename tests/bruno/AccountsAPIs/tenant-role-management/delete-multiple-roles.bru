meta {
  name: Delete multiple roles
  type: http
  seq: 9
}

post {
  url: {{ACCOUNTS_API_BASE_URL}}/tenant-role/delete-multiple
  body: json
  auth: none
}

body:json {
  [
    "{{ROLE_ID}}"
  ]
}
script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
          "ROLE_ID",
          []
      );
  }
}

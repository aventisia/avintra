meta {
  name: Insert role
  type: http
  seq: 2
}

post {
  url: {{ACCOUNTS_API_BASE_URL}}/tenant-role
  body: json
  auth: none
}

body:json {
  "fullName": "{{$randomJobTitle}}",
  "description": "{{$randomLoremSentences}}",
  "rolePermissions": [
      {
        "permissionType": "Roles",
        "accesses": ["View", "Delete"]
      }
    ]
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
        "ROLE_ID", 
        res.getBody().data.id
      );
  }
}

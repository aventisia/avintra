meta {
  name: Insert tenant
  type: http
  seq: 2
}

post {
  url: {{ACCOUNTS_API_BASE_URL}}/tenant/
  body: json
  auth: none
}

body:json {
  "name": "{{$randomCompanyName}}"
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
          "TENANT_ID",
          res.getBody().data.id
      );
  }
}

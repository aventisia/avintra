meta {
  name: Disable multiple tenants
  type: http
  seq: 7
}

post {
  url: {{ACCOUNTS_API_BASE_URL}}/tenant/disable-multiple
  body: json
  auth: none
}

body:json {
  [
    "{{TENANT_ID}}"
  ]
}
script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
        "TENANT_ID", 
        "00000000-0000-0000-0000-000000000000"
      );
  }
}

meta {
  name: Is tenant name available
  type: http
  seq: 1
}

post {
  url: {{ACCOUNTS_APIS_BASE_URL}}/tenant/is-available
  body: none
  auth: none
}

body:json {
  {
    "userInput": "Sauer - Homenick"
  }
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    userInput: faker.company.name(),
  })
}

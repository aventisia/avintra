meta {
  name: Select tenant option list
  type: http
  seq: 8
}

get {
  url: {{ACCOUNTS_API_BASE_URL}}/tenant/tenants-to-select
  body: json
  auth: none
}

body:json {
  "name": "{{$randomCompanyName}}"
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
          "TENANT_ID",
          res.getBody().data.id
      );
  }
}

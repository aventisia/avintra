meta {
  name: Update tenant
  type: http
  seq: 3
}

put {
  url: {{ACCOUNTS_API_BASE_URL}}/tenant
  body: json
  auth: none
}

body:json {
  "id": "{{TENANT_ID}}",
  "name": "{{$randomCompanyName}}",
  "expiresOn": "{{$randomFutureDate}}",
  "isSSOEnabled": false,
  "isPwdEnabled": true,
  "isPwdNeverExpiresEnabled": true,
  "daysBeforePwdExpires": 720,
  "isIdleSessionTimeoutEnabled": true,
  "idleSessionTimeoutMinutes": 20,
  "isTwoFAEnabled": false,
  "ssoConfigJson": "{}",
  "dbOption": "Shared",
  "dbUserId": "",
  "dbPwd": "",
  "dbHost": "",
  "dbPort": 0,
  "dbNamePrefix": "",
  "isDisabled": true
}

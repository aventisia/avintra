meta {
  name: Delete tenant
  type: http
  seq: 5
}

delete {
  url: {{ACCOUNTS_API_BASE_URL}}/tenant/{{TENANT_ID}}
  body: none
  auth: none
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
        "TENANT_ID", 
        "00000000-0000-0000-0000-000000000000"
      );
  }
}

meta {
  name: Repeat - Insert tenant
  type: http
  seq: 6
}

post {
  url: {{ACCOUNTS_APIS_BASE_URL}}/tenant/
  body: none
  auth: none
}

body:json {
  {
    "name": "{{$randomCompanyName}}"
  }
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    name: faker.company.name(),
  })
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
          "TENANT_ID",
          res.getBody().data.id
      );
  }
}

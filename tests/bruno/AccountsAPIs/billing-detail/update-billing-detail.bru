    "addressLine2": "Apt 4B",
    "city": "Okhala",
    "postalCode": "123456",
    "state": "Delhi",
    "country": "India",
    "isWillingToFileGst": true,
    "gstNumber": "GST1234567890",
    "amount": 24,
    "taxRate": 18,
    "planId": "bd93aa99-205a-4e42-95e8-0788889a6ccb"
  }
}

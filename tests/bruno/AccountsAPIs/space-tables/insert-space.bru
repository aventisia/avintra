meta {
  name: Insert space
  type: http
  seq: 2
}

post {
  url: {{ACCOUNTS_API_BASE_URL}}/space
  body: json
  auth: none
}

body:json {
  {
    "name": "Marketing Workspace",
    "description": "Workspace for the marketing team to collaborate on campaigns.",
    "userIds": ["117e0ba1-b316-4ac2-8a66-f4bee5631b9b"]
  }
  
}

script:post-response {
  if(res.getStatus() == 200){
       bru.setGlobalEnvVar(
          "SPACE_ID", 
          res.getBody().data.id)
  }
}

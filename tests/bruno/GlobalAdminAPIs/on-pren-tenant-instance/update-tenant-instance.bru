meta {
  name: Update tenant instance
  type: http
  seq: 5
}

put {
  url: {{GLOBALADMIN_API_BASE_URL}}/onprem/instance
  body: json
  auth: inherit
}

body:json {
  {
    "id": "{{TENANT_INSTANCE_ID}}",
    "onPremTenantId": "{{ON_PREM_TENANT_ID}}",
    "name": "instance_name",
    "type": "NonProd",
    "platformVersion": "1.1",
    "deployedOn": "2025-12-11",
    "lastValidatedOn": "2026-12-11",
    "noOfInvalidCheck": 0
  }
}

script:post-response {
  if(res.getStatus() == 200){
    bru.setGlobalEnvVar(
          "TENANT_INSTANCE_NAME",res.getBody().data.name
      );
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

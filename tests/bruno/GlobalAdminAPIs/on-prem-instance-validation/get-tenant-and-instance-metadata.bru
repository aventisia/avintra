meta {
  name: get tenant and instance metadata
  type: http
  seq: 4
}

get {
  url: {{GLOBALADMIN_API_BASE_URL}}/onprem/instance/metadata
  body: none
  auth: inherit
}

headers {
  X-OnPrem-Tenant-Id: {{GLOBALADMIN_METADATA_TENANT_ID}}
  X-OnPrem-Instance-Key: {{GLOBALADMIN_METADATA_INSTANCE_KEY}}
}

script:post-response {
  const data = res.getBody()?.data ?? {};

  test("covers the deployment allowance contract", function() {
    expect(res.getStatus()).to.equal(200);

    // IMPORTANT NOTE: the service omits the allowances until GlobalAdminAPIs#10 is deployed; an omitted allowance means "not allowed".
    ["ssoAllowed", "brandingAllowed"].forEach((field) => {
      expect(data[field] ?? false).to.be.a("boolean");
    });
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

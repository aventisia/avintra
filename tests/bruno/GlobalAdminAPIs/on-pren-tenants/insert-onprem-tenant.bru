meta {
  name: Insert onprem tenant
  type: http
  seq: 2
}

post {
  url: {{GLOBALADMIN_API_BASE_URL}}/onprem-tenant
  body: json
  auth: inherit
}

body:json {
  {
    "name": "tenant_name",
    "type": "Enterprise",
    "executionTimeAllowed": 1000,
    "contractStartDate": "2025-12-11",
    "contractRenewalDate": "2026-12-11",
    "isExecutionDisabled": false,
    "isLoginDisabled": false,
    "isSsoAllowed": false,
    "isBrandingAllowed": false,
    "outEmails": "",
    "tenantEmails": "" 
  }
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
          "ON_PREM_TENANT_ID",res.getBody().data.id
      );
    bru.setGlobalEnvVar(
          "ON_PREM_TENANT_NAME",res.getBody().data.name
      );
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

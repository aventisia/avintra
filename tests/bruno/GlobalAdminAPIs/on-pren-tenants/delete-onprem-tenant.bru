meta {
  name: Delete onprem tenant
  type: http
  seq: 10
}

delete {
  url: {{GLOBALADMIN_API_BASE_URL}}/onprem-tenant/{{ON_PREM_TENANT_ID}}
  body: json
  auth: inherit
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
          "ON_PREM_TENANT_ID","00000000-0000-0000-0000-000000000000"
      );
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

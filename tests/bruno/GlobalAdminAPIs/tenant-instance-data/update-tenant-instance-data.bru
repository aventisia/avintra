meta {
  name: Update tenant instance data
  type: http
  seq: 5
}

put {
  url: {{GLOBALADMIN_API_BASE_URL}}/onprem/instance-data
  body: json
  auth: inherit
}

body:json {
  {
    "id": "{{TENANT_INSTANCE_DATA_ID}}",
    "onPremInstanceId": "{{TENANT_INSTANCE_ID}}",
    "validatedBy": "StartUpService",
    "executedJobs": 1,
    "executionTime": 1,
    "users": 1,
    "publishedAgents": 1,
    "validatedOn": "2025-12-11"
  }
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
          "TENANT_INSTANCE_DATA_ID",res.getBody().data.id
      );
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

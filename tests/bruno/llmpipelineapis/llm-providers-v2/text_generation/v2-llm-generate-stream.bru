meta {
  name: v2 llm generate - stream
  type: http
  seq: 2
}

post {
  url: {{LLMPIPELINE_API_BASE_URL}}/v2/llm/generate
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:json {
  {
    "provider": "openai",
    "model": "gpt-4o-mini",
    "input": "Give me top 3 benefits of daily exercise",
    "is_json_output": false,
    "json_schema": null,
    "max_output_tokens": 100,
    "is_byok_enabled": false,
    "credential_name": null,
    "temperature": "1.0",
    "top_p": "1.0",
    "stream": true,
    "ref_type": "Platform",
    "ref_id": "",
    "ref_name": "",
    "action": "imporve_prompt"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

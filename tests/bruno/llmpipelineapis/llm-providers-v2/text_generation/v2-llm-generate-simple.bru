meta {
  name: v2 llm generate - simple response
  type: http
  seq: 1
}

post {
  url: {{LLM_PIPELINE_APIS_BASE_URL}}/v2/llm/generate
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:json {
  {
    "provider": "openai",
    "model": "gpt-4o-mini",
    "input": "Give me top 3 benefits of daily exercise",
    "is_json_output": false,
    "json_schema": null,
    "max_output_tokens": 50,
    "is_byok_enabled": false,
    "credential_id": "",
    "temperature": "1.0",
    "top_p": "1.0",
    "stream": false,
    "ref_id": "1e26b863-7998-46b1-a217-20acd74277eb",
    "ref_name": "Test Notification",
    "ref_type": "Agent",
    "action": "AgentExecution"
  }
  
  
}

settings {
  encodeUrl: true
  timeout: 0
}

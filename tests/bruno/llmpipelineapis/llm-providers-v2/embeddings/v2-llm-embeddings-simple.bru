meta {
  name: v2 llm embeddings - simple
  type: http
  seq: 1
}

post {
  url: {{LLMPIPELINE_API_BASE_URL}}/v2/llm/embeddings
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:json {
  {
    "provider": "openai",
    "model": "text-embedding-3-small",
    "input": "This is a test sentence for embedding.",
    "is_byok_enabled": false,
    "credential_name": null,
    "dimensions": 1536,
    "encoding_format": "float",
    "reference_id": "",
    "reference_type": "Platform",
    "reference_name": "",
    "action": "imporve_prompt"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

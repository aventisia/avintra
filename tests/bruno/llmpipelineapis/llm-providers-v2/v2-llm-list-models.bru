meta {
  name: v2 llm list all models
  type: http
  seq: 7
}

get {
  url: {{LLM_PIPELINE_APIS_BASE_URL}}/v2/llm/models?provider=openai&capability=text
  body: none
  auth: bearer
}

params:query {
  provider: openai
  capability: text
  ~capability: text
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

settings {
  encodeUrl: true
  timeout: 0
}

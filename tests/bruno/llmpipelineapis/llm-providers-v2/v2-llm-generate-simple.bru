meta {
  name: v2 llm generate - simple response
  type: http
  seq: 1
}

post {
  url: {{LLM_PIPELINE_APIS_BASE_URL}}/v2/llm/generate
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:json {
  {
    "provider": "openai",
    "model": "gpt-4o-mini",
    "input": "Give me top 3 benefits of daily exercise",
    "is_json_output": false,
    "json_schema": null,
    "max_output_tokens": 50,
    "is_byok_enabled": true,
    "credential_id": "90600614-9adc-4bdc-8ddc-9ef285786294",
    "temperature": "1.0",
    "top_p": "1.0",
    "stream": false,
    "ref_type": "Platform",
    "ref_id": "",
    "ref_name": "",
    "action": "imporve_prompt"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

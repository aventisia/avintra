meta {
  name: pgvector - ingest text document
  type: http
  seq: 1
}

post {
  url: {{LLMPIPELINE_API_BASE_URL}}/vector-store/ingest
  body: json
  auth: inherit
}

body:json {
  {
    "vector_store": "pgvector",
    "embedding_provider": "openai",
    "embedding_model": "text-embedding-3-small",
    "input": "Vector stores help retrieve semantically relevant context for LLM prompts.",
    "chunk_size": 500,
    "chunk_overlap": 100,
    "credential_name": null,
    "embedding_credential_name": null,
    "metadata": {
      "kb_name": "pgvector_openai_3_small",
      "doc_name": "pgvector-sample-chunk-bruno-test.pdf"
    },
    "batch_size": 100,
    "dimensions": null,
    "ref_type": "Platform",
    "ref_id": "",
    "ref_name": "pgvector-vector-store-bruno-test-doc",
    "action": "vector_store_ingest",
    "agent_name": null
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

meta {
  name: qdrant - ingest text document
  type: http
  seq: 1
}

post {
  url: {{LLM_PIPELINE_APIS_BASE_URL}}/vector-store/ingest
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:json {
  {
    "vector_store": "qdrant",
    "embedding_provider": "openai",
    "embedding_model": "text-embedding-3-small",
    "input": "Vector stores help retrieve semantically relevant context for LLM prompts.",
    "chunk_size": 500,
    "chunk_overlap": 100,
    "store_credential_id": null,
    "embedding_credential_id": null,
    "metadata": {
      "kb_id": "b73a3dc2-c5b0-4059-b316-081ff27b398b",
      "kb_name": "qdrant_openai_3_small",
      "kb_file_id": "7846132a-7044-4f91-8be5-c9a75de39d6f",
      "kb_file_name": "qdrant-sample-chunk-bruno-test.pdf"
    },
    "batch_size": 100,
    "dimensions": null,
    "ref_type": "Platform",
    "ref_id": "",
    "ref_name": "qdrant-vector-store-bruno-test-doc",
    "action": "vector_store_ingest",
    "agent_name": null
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

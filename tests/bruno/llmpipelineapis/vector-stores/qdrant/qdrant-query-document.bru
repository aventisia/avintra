meta {
  name: qdrant - query document
  type: http
  seq: 2
}

post {
  url: {{LLM_PIPELINE_APIS_BASE_URL}}/vector-store/query
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:json {
  {
    "vector_store": "qdrant",
    "embedding_provider": "openai",
    "embedding_model": "text-embedding-3-small",
    "query": "What are vector stores used for in RAG pipelines?",
    "top_k": 5,
    "score_threshold": 0.1,
    "kb_names": ["qdrant_openai_3_small"],
    "doc_names": ["qdrant-sample-chunk-bruno-test.pdf"],
    "credential_name": null,
    "embedding_credential_name": null,
    "ref_type": "Platform",
    "ref_id": "",
    "ref_name": "qdrant-vector-store-bruno-test-doc",
    "action": "vector_store_query",
    "agent_name": null
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

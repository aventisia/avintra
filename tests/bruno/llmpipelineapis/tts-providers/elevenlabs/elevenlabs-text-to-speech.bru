meta {
  name: Elevenlab - Text to Speech
  type: http
  seq: 2
}

post {
  url: {{LLMPIPELINE_API_BASE_URL}}/tts/synthesize
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:json {
  {
    "provider": "elevenlabs",
    "input": "Hello! This is a sample text to speech conversion.",
    "model": "eleven_v3",
    "voice_id": "JBFqnCBsd6RMkjVDRZzb",
    "language": "en",
    "speed": 1.0,
    "pitch": 1.0,
    "stream": false,
    "credential_name": null,
    "is_byok_enabled": false,
    "ref_id": "req-12345",
    "ref_name": "Transcription Pipeline",
    "ref_type": "test",
    "action": "tts_generate"
  }
}

meta {
  name: Get active llm jobs
  type: http
  seq: 1
}

post {
  url: {{LLMPIPELINE_API_BASE_URL}}/llm/generate
  body: json
  auth: inherit
}

body:json {
  {
    "provider": "openai",
    "model": "gpt-4o-mini",
    "input": "Give me top 3 benefits of daily exercise",
    "is_json_output": false,
    "json_schema": null,
    "max_output_tokens": 50,
    "is_byok_enabled": false,
    "credential_name": null,
    "temperature": "1.0",
    "top_p": "1.0",
    "stream": true
  }
}

settings {
  encodeUrl: true
}

meta {
  name: openai - simple response with default options
  type: http
  seq: 2
}

post {
  url: {{LLMPIPELINE_API_BASE_URL}}/llm/generate
  body: json
  auth: inherit
}

body:json {
  {
    "provider": "openai",
    "model": "gpt-4o-mini",
    "input": "Give me top 3 benefits of daily exercise",
    "files": null,
    "is_json_output": false,
    "json_schema": null,
    "max_output_tokens": 50,
    "credential_name": null,
    "stream": false,
    "ref_type": "Platform",
    "ref_id": "",
    "ref_name": "",
    "action": "imporve_prompt"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

meta {
  name: ollama - json response
  type: http
  seq: 10
}

post {
  url: {{LLMPIPELINE_API_BASE_URL}}/llm/generate
  body: json
  auth: inherit
}

body:json {
  {
    "provider": "ollama",
    "model": "gemma3:12b",
    "input": [
      {
        "role": "system",
        "content": "Return only a valid JSON object, without any code block markers or extra text."
      },
      {
        "role": "user",
        "content": "Give me top 3 benefits of daily exercise"
      }
    ],
    "files": null,
    "is_json_output": true,
    "json_schema": null,
    "max_output_tokens": null,
    "is_byok_enabled": false,
    "credential_name": null,
    "temperature": "1.0",
    "top_p": "1.0",
    "stream": true
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

meta {
  name: ollama - simple response with default options
  type: http
  seq: 9
}

post {
  url: {{LLM_PIPELINE_APIS_BASE_URL}}/llm/generate
  body: json
  auth: inherit
}

body:json {
  {
    "provider": "ollama",
    "model": "gemma3:12b",
    "input": "Give me top 3 benefits of daily exercise",
    "files": null,
    "is_json_output": false,
    "json_schema": null,
    "max_output_tokens": 50,
    "is_byok_enabled": false,
    "credential_name": null,
    "temperature": "1.0",
    "top_p": "1.0",
    "stream": true
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

meta {
  name: openrouter - strict json schema response
  type: http
  seq: 4
}

post {
  url: {{LLMPIPELINE_API_BASE_URL}}/llm/generate
  body: json
  auth: inherit
}

body:json {
  {
    "provider": "openrouter",
    "model": "google/gemini-2.5-flash",
    "input": "Give me top 3 benefits of daily exercise",
    "files": null,
    "is_json_output": true,
    "json_schema": {
      "type": "object",
      "properties": {
          "document_type": {"type": "string"},
          "summary": {"type": "string"},
          "entities": {
              "type": "array",
              "items": {"type": "string"}
          },
          "confidence_score": {"type": "number"}
      },
      "required": ["document_type", "summary"]
    },
    "max_output_tokens": null,
    "is_byok_enabled": false,
    "credential_name": null,
    "temperature": "1.0",
    "top_p": "1.0",
    "stream": false,
    "ref_type": "Platform",
    "ref_id": "",
    "ref_name": "",
    "action": "imporve_prompt"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

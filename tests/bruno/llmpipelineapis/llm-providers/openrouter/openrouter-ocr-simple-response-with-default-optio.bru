meta {
  name: openrouter-ocr - simple response with default optio
  type: http
  seq: 4
}

post {
  url: {{LLMPIPELINE_API_BASE_URL}}/llm/generate
  body: json
  auth: inherit
}

body:json {
  {
    "provider": "openrouter",
    "model": "qwen/qwen3-vl-32b-instruct",
    "input": "Attached is one page of a document that you must process. Just return the plain text representation of this document as if you were reading it naturally. Convert equations to LateX and tables to HTML.\n If there are any figures or charts, label them with the following markdown syntax ![Alt text describing the contents of the figure](page_startx_starty_width_height.png)\n Return your output as markdown, with a front matter section on top specifying values for the primary_language, is_rotation_valid, rotation_correction, is_table, and is_diagram parameters.",
    "files": [
      {
        "mime_type": "application/pdf",
        "encoded_content": ""
      }
    ],
    "is_json_output": false,
    "json_schema": null,
    "max_output_tokens": null,
    "is_byok_enabled": false,
    "credential_name": null,
    "temperature": "1.0",
    "top_p": "1.0",
    "stream": false,
    "ref_type": "Platform",
    "ref_id": "",
    "ref_name": "",
    "action": "imporve_prompt"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

meta {
  name: openrouter - simple response with default options
  type: http
  seq: 1
}

post {
  url: {{LLM_PIPELINE_APIS_BASE_URL}}/llm/generate
  body: json
  auth: inherit
}

body:json {
  {
    "provider": "openrouter",
    "model": "google/gemini-2.5-flash",
    "input": "Give me top 3 benefits of daily exercise.",
    "files": null,
    "is_json_output": false,
    "json_schema": null,
    "max_output_tokens": null,
    "is_byok_enabled": false,
    "credential_name": null,
    "temperature": "1.0",
    "top_p": "1.0",
    "stream": false,
    "ref_type": "Platform",
    "ref_id": "",
    "ref_name": "",
    "action": "imporve_prompt"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

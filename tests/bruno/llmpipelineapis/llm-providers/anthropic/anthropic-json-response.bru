meta {
  name: anthropic - json response
  type: http
  seq: 3
}

post {
  url: {{LLMPIPELINE_API_BASE_URL}}/llm/generate
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:json {
  {
    "provider": "anthropic",
    "model": "claude-haiku-4-5-20251001",
    "input": [
      {
        "role": "system",
        "content": "Return only a valid JSON object, without any code block markers or extra text."
      },
      {
        "role": "user",
        "content": "Give me top 3 benefits of daily exercise"
      }
    ],
    "files": null,
    "is_json_output": false,
    "json_schema": null,
    "max_output_tokens": 100,
    "is_byok_enabled": false,
    "credential_name": null,
    "temperature": "1.0",
    "top_p": "1.0",
    "stream": false,
    "ref_type": "Platform",
    "ref_id": "",
    "ref_name": "",
    "action": "imporve_prompt"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

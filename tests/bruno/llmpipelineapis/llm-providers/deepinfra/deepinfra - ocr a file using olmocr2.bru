meta {
  name: deepinfra - ocr a file using olmocr2
  type: http
  seq: 8
}

post {
  url: {{LLM_PIPELINE_APIS_BASE_URL}}/llm/generate
  body: json
  auth: inherit
}

body:json {
  {
    "provider": "deepinfra",
    "model": "allenai/olmOCR-2-7B-1025",
    "input": "Extract all text from this image into markdown and keep the layout",
    "is_json_output": false,
    "json_schema": null,
    "max_output_tokens": null,
    "is_byok_enabled": false,
    "credential_name": null,
    "temperature": "1.0",
    "top_p": "1.0",
    "stream": false,
    "files": [""]
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

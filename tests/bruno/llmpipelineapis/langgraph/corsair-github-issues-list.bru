meta {
  name: Corsair GitHub issues list
  type: http
  seq: 2
}

post {
  url: {{LLM_PIPELINE_APIS_BASE_URL}}/chat/completions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:json {
  {
    "provider": "openai",
    "model": "gpt-4o-mini",
    "input": "List open issues in the appointment-dashborad repository owned by bvaibhav23",
    "files": null,
    "tool_config": [
      {
        "tool": "github",
        "credential_id": "73bd9857-bac7-4b97-8b7f-4ab261d39b7e",
        "actions": [
          {
            "approval": "auto",
            "action": "api.issues.list"
          }
        ]
      }
    ],
    "skill_names": [],
    "is_temp_chat": true,
    "is_json_output": false,
    "json_schema": null,
    "max_output_tokens": 500,
    "is_byok_enabled": false,
    "credential_id": null,
    "temperature": "0.2",
    "top_p": "1.0",
    "stream": false,
    "ref_type": "Agent",
    "ref_id": "corsair-github-test",
    "ref_name": "Corsair GitHub Test",
    "action": "AgentExecution",
    "is_chat_agent": true,
    "generate_followup_messages": false
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

meta {
  name: openai - simple response with tools
  type: http
  seq: 5
}

post {
  url: {{LLM_PIPELINE_APIS_BASE_URL}}/llm/generate
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:json {
  {
    "provider": "openai",
    "model": "gpt-4.1-mini",
    "input": "Send email to user@domain.com and from user@domain.com with subject Welcome and body Welcome aboard! We're excited to have you with us and look forward to working together",
    "files": null,
    "tool_config": [
      {
        "tool": "outlook",
        "credential_id": "DUMMY",
        "actions": [
          {
            "approval": "human", // "auto"
            "action": "send_email"
          }
        ]
      },
      {
          "tool": "github",
          "credential_id": "DUMMY",
          "actions": [
          {
            "approval": "human", // "auto"
            "action": "create_issue"
          }
        ]
      }
    ],
    "is_chat_agent": false,
    "generate_followup_messages": false,
    "is_json_output": false,
    "json_schema": null,
    "max_output_tokens": 500,
    "is_byok_enabled": false,
    "credential_id": null,
    "temperature": "1.0",
    "top_p": "1.0",
    "stream": false,
    "ref_type": "Platform",
    "ref_id": "",
    "ref_name": "",
    "action": "imporve_prompt"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

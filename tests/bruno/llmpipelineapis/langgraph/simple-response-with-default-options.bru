meta {
  name: simple response with default options
  type: http
  seq: 1
}

post {
  url: {{LLM_PIPELINE_APIS_BASE_URL}}/chat/completions
  body: json
  auth: none
}

body:json {
  {
    "provider": "openai",
    "model": "gpt-4o-mini",
    "input": "Give me top 3 benefits of daily exercise",
    "files": null,
    "tool_config": [
      {
        "tool": "translate_text",
        "credential_name": "DUMMY",
        "actions": [
          {
            "approval": "human", // "auto"
            "action": "send_email"
          }
        ]
      }
    ],
    "skill_names": ["sql_generator"],
    //"conversation_id": "123456789",
    "is_temp_chat": false,
    "is_json_output": false,
    "json_schema": null,
    "max_output_tokens": 500,
    "is_byok_enabled": false,
    "credential_name": null,
    "temperature": "1.0",
    "top_p": "1.0",
    "stream": true,
    "ref_type": "Platform",
    "ref_id": "",
    "ref_name": "",
    "action": "imporve_prompt",
    "is_chat_agent": false,
    "generate_followup_messages": false
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

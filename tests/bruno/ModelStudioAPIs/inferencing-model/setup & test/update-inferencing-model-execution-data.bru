meta {
  name: Update inferencing model execution data
  type: http
  seq: 6
}

put {
  url: {{AI_STUDIO_APIS_BASE_URL}}/inferencing-model/extracted-data
  body: json
  auth: none
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    id: bru.getGlobalEnvVar("MLMODEL_ID"),
    docId: bru.getGlobalEnvVar("DOC_ID"),
    summarization: {
      summary: "Update_content"
      },
    classification: [
          {
            name: "Invoice",
            value: "true",
            confidenceScore: "98",
            subcategories: null
          }
        ]
    });
  
}

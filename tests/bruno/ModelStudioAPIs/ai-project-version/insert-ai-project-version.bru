meta {
  name: Insert ai project version
  type: http
  seq: 2
}

post {
  url: {{AI_STUDIO_APIS_BASE_URL}}/ai-project-version
  body: json
  auth: none
}

body:json {
  {
    "name": "Test_Model",
    "aiProjectId": "{{AI_PROJECT_ID}}",
    "versionNumber": 1,
    "businessContext": ""
  }
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
          "AI_PROJECT_VERSION_ID",
          res.getBody().data.id
      );
  }
}

meta {
  name: Upload files
  type: http
  seq: 2
}

post {
  url: {{AI_STUDIO_APIS_BASE_URL}}/upload-doc
  body: multipartForm
  auth: none
}

body:multipart-form {
  files: @file(/home/rahmat/Gitea/Test/20250019 Singfuels PAC SHARON.pdf)
}

script:post-response {
  if(res.getStatus() == 200){
    bru.setGlobalEnvVar(
    "FILE_URL",
    res.getBody().data[0].path
    );
  }
}

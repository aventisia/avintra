meta {
  name: Update and execute generative model setup
  type: http
  seq: 5
}

put {
  url: {{AI_STUDIO_APIS_BASE_URL}}/generative-model/update-and-execute?cid={{CONVERSATION_ID}}
  body: json
  auth: none
}

params:query {
  cid: {{CONVERSATION_ID}}
}

body:json {
  {
    "id": "{{AI_PROJECT_ID}}",
    "aiProjectVersionId": "{{AI_PROJECT_VERSION_ID}}",
    "generativeModel": {
      "name": "PersonaResearch",
      "configurationType": "OnPrem",
      "llm": "gemma",
      "nodePrompt": "",  // Add prompt if needed
      "temperature": 0.3,
      "setupObject": {
        "personaName": "Virtual Assistant",
        "companyName": "Customer Support Agent",
        "links": [
          {
            "url":"test"
          }],  // Empty array if no links, or add URLs
        "purposeOfResearch": "Friendly, Professional",
        "desiredOutput": "Respond with empathy and provide accurate medical information, always defer to a healthcare professional when unsure."
      }
    }
  }
}

meta {
  name: Insert extracted data
  type: http
  seq: 3
}

post {
  url: {{AI_STUDIO_APIS_BASE_URL}}/extracted-data
  body: none
  auth: none
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    mlModelId: bru.getGlobalEnvVar("MLMODEL_ID"),
    docId: bru.getGlobalEnvVar("DOC_ID"),
    accuracy: 99.585616,
    type:"TestData",
    DataObject: faker.lorem.sentence()
  })
}

script:post-response {
  if(res.getStatus() == 200){
    bru.setGlobalEnvVar(
    "EDATA_ID",
    res.getBody().data.id
    );
  }
}

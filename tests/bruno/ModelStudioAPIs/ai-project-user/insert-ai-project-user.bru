meta {
  name: Insert  ai project user
  type: http
  seq: 3
}

post {
  url: {{AI_STUDIO_APIS_BASE_URL}}/ai-model-user
  body: json
  auth: none
}

body:json {
  {
    "mlModelId": "{{AI_PROJECT_ID}}",
    "userId": "0afbf579-88b3-40fd-af50-7ba0d1c12698",
    "accessType": "Edit"
  }
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
          "AI_PROJECT_USER_ID",
          res.getBody().data.id
      );
  }
}

meta {
  name: send - email via smtp
  type: http
  seq: 1
}

post {
  url: {{BASE_URL}}/connectors/mail
  body: json
  auth: none
}

body:json {
  {
    "connector": "mail",
    "operation": "send",
    "configuration": {
      "scheme": "smtp",
      "host": "{{SMTP_HOST}}",
      "port": "{{SMTP_PORT}}",
      "to": "{{MAIL_TO}}",
      "subject": "Test email",
      "contentType": "text/plain"
    },
    "auth": {
      "type": "basic",
      "username": "{{MAIL_USERNAME}}",
      "password": "{{MAIL_PASSWORD}}"
    },
    "payload": "Hello from Camel mail component"
  }
}

tests {
  test("status code is 200", function() {
    expect(res.status).to.equal(200);
  });

  test("response ok is true", function() {
    expect(res.body.ok).to.equal(true);
  });

  test("response identifies the connector", function() {
    expect(res.body.connector).to.equal('mail');
  });

  test("response includes targetUri", function() {
    expect(res.body.targetUri).to.be.a('string');
  });
}

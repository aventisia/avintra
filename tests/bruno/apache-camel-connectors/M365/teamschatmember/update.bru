meta {
  name: update - teams chat member
  type: http
  seq: 177
}

post {
  url: {{BASE_URL}}/connectors/m365
  body: json
  auth: none
}

body:json {
  {
    "connector": "m365",
    "operation": "teamschatmember.update",
    "configuration": {
      "baseUrl": "{{M365_BASE_URL}}",
      "chatId": "{{M365_CHAT_ID}}",
      "membershipId": "{{M365_MEMBERSHIP_ID}}"
    },
    "auth": {
      "type": "accessToken",
      "token": "{{M365_TOKEN}}"
    },
    "payload": {
      "roles": [
        "member"
      ]
    }
  }
}

tests {
  test("status code is 200", function() {
    expect(res.status).to.equal(200);
  });

  test("response ok is true", function() {
    expect(res.body.ok).to.equal(true);
  });

  test("response identifies the connector", function() {
    expect(res.body.connector).to.equal('m365');
  });

  test("response includes targetUri", function() {
    expect(res.body.targetUri).to.be.a('string');
  });
}

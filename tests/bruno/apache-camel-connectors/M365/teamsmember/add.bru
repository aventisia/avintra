meta {
  name: add - teams member
  type: http
  seq: 159
}

post {
  url: {{BASE_URL}}/connectors/m365
  body: json
  auth: none
}

body:json {
  {
    "connector": "m365",
    "operation": "teamsmember.add",
    "configuration": {
      "baseUrl": "{{M365_BASE_URL}}",
      "teamId": "{{M365_TEAM_ID}}"
    },
    "auth": {
      "type": "accessToken",
      "token": "{{M365_TOKEN}}"
    },
    "payload": {
      "@odata.type": "#microsoft.graph.aadUserConversationMember",
      "roles": [
        "member"
      ],
      "user@odata.bind": "https://graph.microsoft.com/v1.0/users/{{M365_USER_ID}}"
    }
  }
}

tests {
  test("status code is 200", function() {
    expect(res.status).to.equal(200);
  });

  test("response ok is true", function() {
    expect(res.body.ok).to.equal(true);
  });

  test("response identifies the connector", function() {
    expect(res.body.connector).to.equal('m365');
  });

  test("response includes targetUri", function() {
    expect(res.body.targetUri).to.be.a('string');
  });
}

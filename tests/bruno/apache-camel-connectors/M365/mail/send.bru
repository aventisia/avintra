meta {
  name: send - email
  type: http
  seq: 48
}

post {
  url: {{BASE_URL}}/connectors/m365
  body: json
  auth: none
}

body:json {
  {
    "connector": "m365",
    "operation": "mail.send",
    "configuration": {
      "baseUrl": "{{M365_BASE_URL}}",
      "userId": "{{M365_USER_ID}}"
    },
    "auth": {
      "type": "accessToken",
      "token": "{{M365_TOKEN}}"
    },
    "payload": {
      "message": {
        "subject": "Hello from harness",
        "body": {
          "contentType": "Text",
          "content": "Hi there"
        },
        "toRecipients": [
          {
            "emailAddress": {
              "address": "{{M365_USER_ID}}"
            }
          }
        ]
      },
      "saveToSentItems": true
    }
  }
}

tests {
  test("status code is 200", function() {
    expect(res.status).to.equal(200);
  });

  test("response ok is true", function() {
    expect(res.body.ok).to.equal(true);
  });

  test("response identifies the connector", function() {
    expect(res.body.connector).to.equal('m365');
  });

  test("response includes targetUri", function() {
    expect(res.body.targetUri).to.be.a('string');
  });
}

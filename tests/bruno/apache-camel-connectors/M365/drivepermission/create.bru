meta {
  name: create - drive permission
  type: http
  seq: 115
}

post {
  url: {{BASE_URL}}/connectors/m365
  body: json
  auth: none
}

body:json {
  {
    "connector": "m365",
    "operation": "drivepermission.create",
    "configuration": {
      "baseUrl": "{{M365_BASE_URL}}",
      "driveId": "root",
      "itemId": "{{M365_ITEM_ID}}"
    },
    "auth": {
      "type": "accessToken",
      "token": "{{M365_TOKEN}}"
    },
    "payload": {
      "roles": [
        "read"
      ],
      "grantedToIdentities": [
        {
          "email": "{{M365_USER_ID}}"
        }
      ]
    }
  }
}

tests {
  test("status code is 200", function() {
    expect(res.status).to.equal(200);
  });

  test("response ok is true", function() {
    expect(res.body.ok).to.equal(true);
  });

  test("response identifies the connector", function() {
    expect(res.body.connector).to.equal('m365');
  });

  test("response includes targetUri", function() {
    expect(res.body.targetUri).to.be.a('string');
  });
}

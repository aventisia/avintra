meta {
  name: on_behalf_of - get user
  type: http
  seq: 7
}

post {
  url: {{BASE_URL}}/connectors/m365
  body: json
  auth: none
}

body:json {
  {
    "connector": "m365",
    "operation": "user.get",
    "configuration": {
      "baseUrl": "{{M365_BASE_URL}}",
      "userId": "{{M365_USER_ID}}",
      "$select": "id,displayName,mail"
    },
    "auth": {
      "type": "on_behalf_of",
      "tenantId": "{{M365_TENANT_ID}}",
      "clientId": "{{M365_CLIENT_ID}}",
      "clientSecret": "{{M365_CLIENT_SECRET}}",
      "assertion": "{{M365_ASSERTION}}",
      "tokenUrl": "{{M365_TOKEN_URL}}",
      "scopes": "{{M365_SCOPES}}"
    },
    "payload": null
  }
}

tests {
  test("status code is 200", function() {
    expect(res.status).to.equal(200);
  });

  test("response ok is true", function() {
    expect(res.body.ok).to.equal(true);
  });

  test("response identifies the connector", function() {
    expect(res.body.connector).to.equal('m365');
  });
}

meta {
  name: search - messages
  type: http
  seq: 249
}

post {
  url: {{BASE_URL}}/connectors/m365
  body: json
  auth: none
}

body:json {
  {
    "connector": "m365",
    "operation": "search.messages",
    "configuration": {
      "baseUrl": "{{M365_BASE_URL}}"
    },
    "auth": {
      "type": "accessToken",
      "token": "{{M365_TOKEN}}"
    },
    "payload": {
      "requests": [
        {
          "entityTypes": [
            "message"
          ],
          "query": {
            "queryString": "{{M365_SEARCH_QUERY}}"
          },
          "from": 0,
          "size": 10
        }
      ]
    }
  }
}

tests {
  test("status code is 200", function() {
    expect(res.status).to.equal(200);
  });

  test("response ok is true", function() {
    expect(res.body.ok).to.equal(true);
  });

  test("response identifies the connector", function() {
    expect(res.body.connector).to.equal('m365');
  });

  test("response includes targetUri", function() {
    expect(res.body.targetUri).to.be.a('string');
  });
}

meta {
  name: create - pull request
  type: http
  seq: 32
}

post {
  url: {{BASE_URL}}/connectors/github
  body: json
  auth: none
}

body:json {
  {
    "connector": "github",
    "operation": "pullrequest.create",
    "configuration": {
      "baseUrl": "{{GITHUB_BASE_URL}}",
      "owner": "{{GITHUB_OWNER}}",
      "repo": "{{GITHUB_REPO}}"
    },
    "auth": {
      "type": "accessToken",
      "token": "{{GITHUB_TOKEN}}"
    },
    "payload": {
      "title": "Feature X",
      "head": "feature-x",
      "base": "main",
      "body": "Description"
    }
  }
}

tests {
  test("status code is 200", function() {
    expect(res.status).to.equal(200);
  });

  test("response ok is true", function() {
    expect(res.body.ok).to.equal(true);
  });

  test("response identifies the connector", function() {
    expect(res.body.connector).to.equal('github');
  });

  test("response includes targetUri", function() {
    expect(res.body.targetUri).to.be.a('string');
  });
}

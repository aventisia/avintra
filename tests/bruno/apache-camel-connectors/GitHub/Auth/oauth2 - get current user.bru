meta {
  name: oauth2 - get current user
  type: http
  seq: 2
}

post {
  url: {{BASE_URL}}/connectors/github
  body: json
  auth: none
}

body:json {
  {
    "connector": "github",
    "operation": "user.get-current",
    "configuration": {
      "baseUrl": "{{GITHUB_BASE_URL}}"
    },
    "auth": {
      "type": "oauth2",
      "clientId": "{{GITHUB_CLIENT_ID}}",
      "clientSecret": "{{GITHUB_CLIENT_SECRET}}",
      "refreshToken": "{{GITHUB_REFRESH_TOKEN}}",
      "tokenUrl": "{{GITHUB_TOKEN_URL}}",
      "scopes": "{{GITHUB_SCOPES}}"
    },
    "payload": null
  }
}

tests {
  test("status code is 200", function() {
    expect(res.status).to.equal(200);
  });

  test("response ok is true", function() {
    expect(res.body.ok).to.equal(true);
  });

  test("response identifies the connector", function() {
    expect(res.body.connector).to.equal('github');
  });
}

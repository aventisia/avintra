meta {
  name: Get queue transactions
  type: http
  seq: 6
}

post {
  url: {{WORC_APIS_BASE_URL}}/queue-transaction/list
  body: json
  auth: none
}

body:json {
  {
    "queueId": "{{QUEUE_ID}}",
    "queuePriority": [{
      "field": "Name",
      "OrderBy": "Desscending"
    }],
    "conditions": [
      {
        "field": "Id",
        "comparisonOperator": "GreaterThan",
        "value": "1"
      },
      {
        "field": "Location",
        "comparisonOperator": "NotEqualTo",
        "value": "Washington"
      }
    ]
  }
  
}

meta {
  name: Repeat -Insert queue transaction
  type: http
  seq: 9
}

post {
  url: {{WORKSPACE_APIS_BASE_URL}}/queue-transaction
  body: none
  auth: none
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    queueId: bru.getGlobalEnvVar("QUEUE_ID"),
    status: "Pending",
    payloadData: "[{}]"
  })
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
          "QUEUE_TRANSACTION_ID",
          res.getBody().data.id
      );
  }
}

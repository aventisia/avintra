meta {
  name: Insert queue transaction
  type: http
  seq: 2
}

post {
  url: {{WORKSPACE_APIS_BASE_URL}}/queue-transaction
  body: json
  auth: none
}

body:json {
  {
    "queueId": "{{QUEUE_ID}}",
    "status": "Pending",
    "payloadData": " {  \n      \"Id\": 1,  \n      \"Name\": \"Alice\",  \n      \"Date\": \"2025-08-01\",  \n      \"Location\": \"New York\"  \n    }"
  }
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
          "QUEUE_TRANSACTION_ID",
          res.getBody().data.id
      );
  }
}

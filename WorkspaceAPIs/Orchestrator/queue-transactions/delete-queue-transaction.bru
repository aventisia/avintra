meta {
  name: Delete queue transaction
  type: http
  seq: 8
}

delete {
  url: {{WORKSPACE_APIS_BASE_URL}}/queue-transaction/{{QUEUE_TRANSACTION_ID}}
  body: none
  auth: none
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
        "FLOW_ID", 
        "00000000-0000-0000-0000-000000000000"
      );
  }
}

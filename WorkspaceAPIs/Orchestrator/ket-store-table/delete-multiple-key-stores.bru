meta {
  name: Delete multiple key stores
  type: http
  seq: 9
}

post {
  url: {{WORKSPACE_APIS_BASE_URL}}/key-store/delete-multiple
  body: none
  auth: none
}

script:pre-request {
  // Set configItemIds in request body
  req.setBody(
    JSON.parse(`["${bru.getGlobalEnvVar("CONFIG_ITEM_ID")}"]`)
  )
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
        "CONFIG_ITEM_ID", 
        "00000000-0000-0000-0000-000000000000"
      );
  }
}

docs {
  > TODO: Implement functionality to delete multiple projects only if the user provides an OTP or password, especially when the projects are linked to other sub-content.
}

meta {
  name: Delete app secret
  type: http
  seq: 7
}

delete {
  url: {{WORKSPACE_APIS_BASE_URL}}/app-secret/{{APP_SECRET_ID}}
  body: none
  auth: none
}

body:json {
  {
    "name": "{{$randomCompanyName}}"
  }
}

script:post-response {
  if(res.getStatus() == 200)
  {
    bru.setGlobalEnvVar("APP_INTEGRATION_ID", "00000000-0000-0000-0000-000000000000");
  }
}

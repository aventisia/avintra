meta {
  name: Is machine name available
  type: http
  seq: 3
}

post {
  url: {{WORKSPACE_APIS_BASE_URL}}/machine/is-available
  body: json
  auth: none
}

body:json {
  {
    "userInput": "Test_Machine"
  }
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    userInput: faker.company.name(),
  })
}

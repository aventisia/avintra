meta {
  name: Update machine
  type: http
  seq: 6
}

put {
  url: {{WORKSPACE_APIS_BASE_URL}}/machine
  body: none
  auth: none
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    id: bru.getGlobalEnvVar("MACHINE_ID"),
    name: faker.lorem.lines(),
    ipAddress: faker.internet.ip(),
    hostname: faker.internet.displayName(),
    type: "Linux",
    status: "Running",
    environment: "Development",
    currentTask: "FlowActivity",
    lastCheckedIn: faker.date.anytime(), 
    isAvailable: false,
  })
}

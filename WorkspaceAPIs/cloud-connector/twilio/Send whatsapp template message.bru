meta {
  name: Send whatsapp template message
  type: http
  seq: 3
}

post {
  url: {{WORC_APIS_BASE_URL}}/cloud-connector/m365/twilio/invoke
  body: json
  auth: none
}

body:json {
  {
    "agentId": "00000000-0000-0000-0000-000000000000",
    "agentName": "Test",
    "provider": "Twilio",
    "action": "SendWhatsappTemplateMessage",
    "credentialId": "b1702907-6d5e-4034-b9f4-695570ead53d",
   "payload": {  
    "FromPhoneNumber": "+14155238886",
    "MessageBody": "Hello, Test the Whatsapp message from the twilio service ", 
       "ToNumber": "+919049107094",
      "TemplateName": "Welcome to Twilio",
      "TemplateParameters": "Hello, 123,Hi"     
     }
  }
}

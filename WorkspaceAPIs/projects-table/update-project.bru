meta {
  name: Update project
  type: http
  seq: 3
}

put {
  url: {{WORKSPACE_APIS_BASE_URL}}/project/
  body: none
  auth: none
}

body:json {
  {
      "id": "{{inserted-project-id}}",
      "type": "ProjectType2",
      "name": "{{$randomProductName}}",
      "description": "{{$randomLoremParagraph}}",
      "isDisabled": true
  }
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    id: bru.getGlobalEnvVar("PROJECT_ID"),
    type: "ProjectType2",
    name: faker.company.name(),
    description: faker.lorem.paragraph(),
    isDisabled: true
  })
}

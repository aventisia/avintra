meta {
  name: Is project name available
  type: http
  seq: 1
}

post {
  url: {{WORKSPACE_APIS_BASE_URL}}/project/is-available
  body: none
  auth: none
}

body:json {
  {
      "userInput": "Handmade Soft Gloves"
  }
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    userInput: faker.company.name(),
  })
}

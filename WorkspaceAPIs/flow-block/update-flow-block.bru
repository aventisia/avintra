meta {
  name: Update flow block
  type: http
  seq: 4
}

put {
  url: {{WORKSPACE_APIS_BASE_URL}}/block
  body: none
  auth: none
}

body:json {
  {
    
  }
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    id: bru.getGlobalEnvVar("FLOW_BLOCK_ID"),
    name: faker.commerce.product(),
    description: faker.lorem.paragraph(),
    reactFlowObject: "",
    flowVariablesObject: "",
    inputOutputObject: "",
    flowVersionId: bru.getGlobalEnvVar("FLOW_VERSION_ID"),
    type: "TenantLevel",
    isDisabled: false  
  })
}

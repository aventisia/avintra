meta {
  name: Update flow log
  type: http
  seq: 4
}

put {
  url: {{WORKSPACE_APIS_BASE_URL}}/Flow-log
  body: none
  auth: none
}

script:pre-request {
  const {faker} = require('@faker-js/faker');
  
  req.setBody({ 
    flowId: bru.getGlobalEnvVar("FLOW_ID"), 
    id: bru.getGlobalEnvVar("FLOW_LOG_ID"),
    startTime: new Date(),
    status: "Failed1",
    duration: 1234,
    remark: faker.commerce.product(),
    version: faker.number.float(),
    flowName: faker.commerce.product(),
  })
}

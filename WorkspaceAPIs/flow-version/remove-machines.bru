meta {
  name: Remove machines
  type: http
  seq: 9
}

post {
  url: {{WORKSPACE_APIS_BASE_URL}}/machine/{{MACHINE_ID}}/remove-machines
  body: none
  auth: none
}

script:pre-request {
  // Set machineId in request body
  req.setBody(
    JSON.parse(`["${bru.getGlobalEnvVar("MACHINE_ID")}"]`)
  )
}

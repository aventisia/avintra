meta {
  name: Update flow version
  type: http
  seq: 4
}

put {
  url: {{WORKSPACE_APIS_BASE_URL}}/flow-version/update
  body: none
  auth: none
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    id: bru.getGlobalEnvVar("FLOW_VERSION_ID"),
    flowId: bru.getGlobalEnvVar("FLOW_ID")
  })
}

meta {
  name: Delete workspace user
  type: http
  seq: 5
}

delete {
  url: {{WORKSPACE_APIS_BASE_URL}}/user/{{WORKSPACE_USER_ID}}
  body: none
  auth: none
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
        "WORKSPACE_USER_ID", 
        "00000000-0000-0000-0000-000000000000"
      );
  }
}

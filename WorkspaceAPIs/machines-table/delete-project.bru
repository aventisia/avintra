meta {
  name: Delete project
  type: http
  seq: 14
}

delete {
  url: {{WORKSPACE_APIS_BASE_URL}}/project/{{PROJECT_ID}}
  body: none
  auth: none
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
        "PROJECT_ID", 
        "00000000-0000-0000-0000-000000000000"
      );
  }
}

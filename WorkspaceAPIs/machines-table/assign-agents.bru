meta {
  name: Assign agents
  type: http
  seq: 8
}

post {
  url: {{WORKSPACE_APIS_BASE_URL}}/machine/{{MACHINE_ID}}/assign-agent
  body: none
  auth: none
}

script:pre-request {
  // Set flowVersionId in request body
  req.setBody(
    JSON.parse(`["${bru.getGlobalEnvVar("FLOW_VERSION_ID")}"]`)
  )
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
          "MACHINE_FLOW_ID",
          res.getBody().data.id
      );
  }
}

meta {
  name: Required - Insert global notification
  type: http
  seq: 1
}

post {
  url: {{WORKSPACE_APIS_BASE_URL}}/notification/global/
  body: none
  auth: none
}

body:json {
  {
      
  }
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    message: faker.lorem.paragraph(),
    type: "Information",
    actionUrl: faker.image.url()
  })
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
          "GLOBAL_NOTIFICATION_ID",
          res.getBody().data.id
      );
  }
}

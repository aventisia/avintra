meta {
  name: Update flow comment
  type: http
  seq: 4
}

put {
  url: {{WORKSPACE_APIS_BASE_URL}}/flow-comment/
  body: none
  auth: none
}

body:json {
  {
    
  }
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    flowId: bru.getGlobalEnvVar("FLOW_ID"),
    id: bru.getGlobalEnvVar("FLOW_COMMENT_ID"),
    comment: faker.lorem.paragraph(),
    isDisabled: false  
  })
}

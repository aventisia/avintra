meta {
  name: Update flow publish
  type: http
  seq: 4
}

put {
  url: {{WORKSPACE_APIS_BASE_URL}}/flow/publish
  body: none
  auth: none
}

body:json {
  {
    "id": "{{inserted-flow-id}}",
    "thumbnail": "string",
    "reactFlowObject": "{nodes: [], edges: [], viewport: {x: 0, y: 0,zoom: 1}}"
  }
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    id: bru.getGlobalEnvVar("FLOW_VERSION_ID"),
    flowId: bru.getGlobalEnvVar("FLOW_ID"),
    name: faker.company.name(),
    description: faker.lorem.paragraph(),
    reactFlowObject: faker.string.alphanumeric(255),
    accessType: "TenantLevel",
    type: "Agent",
    thumbnail: "none",
    isPublished: true  
  })
}

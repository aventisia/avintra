meta {
  name: Insert config item
  type: http
  seq: 2
}

post {
  url: {{WORKSPACE_APIS_BASE_URL}}/config-item
  body: none
  auth: none
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    name: faker.commerce.product(),
    type: "TEXT",
    value: faker.lorem.paragraph(),
    isEncrypted: true,
    accessLevel: "PUBLIC"
  })
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
          "CONFIG_ITEM_ID",
          res.getBody().data.id
      );
  }
}

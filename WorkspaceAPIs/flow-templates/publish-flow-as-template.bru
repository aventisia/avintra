meta {
  name: publish flow as template
  type: http
  seq: 6
}

post {
  url: {{WORKSPACE_APIS_BASE_URL}}/flow-template/publish-flow-template/{{FLOW_ID}}
  body: none
  auth: none
}

script:pre-request {
  const {faker} =require('@faker-js/faker');
  
  req.setBody({
    flowId: bru.getGlobalEnvVar("FLOW_ID"),
  })
}

meta {
  name: Update flow execution log
  type: http
  seq: 4
}

put {
  url: {{WORKSPACE_APIS_BASE_URL}}/flow-execution-log/update
  body: none
  auth: none
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    id: bru.getGlobalEnvVar("EXECUTION_LOG_ID"),
    flowId: bru.getGlobalEnvVar("FLOW_ID"),
    actionName: faker.system.commonFileName(),
    inputData: faker.lorem.sentence(),
    outputData: faker.lorem.sentence(),
    Duration:200,
    Status:"Succeeded",
    ErrorMessage:"No error"
  })
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
          "EXECUTION_LOG_ID",
          res.getBody().data.id
      );
  }
}

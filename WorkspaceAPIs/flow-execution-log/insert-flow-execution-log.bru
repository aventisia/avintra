meta {
  name: Insert flow execution log
  type: http
  seq: 3
}

post {
  url: {{WORKSPACE_APIS_BASE_URL}}/flow-execution-log/create
  body: none
  auth: bearer
}

auth:bearer {
  token: ***REMOVED***
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    flowId: bru.getGlobalEnvVar("FLOW_ID"),
    duration:200,
    status:"Succeeded",
    errorMessage:"No error",
    executionType: "Scheduler"
  })
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
          "EXECUTION_LOG_ID",
          res.getBody().data.id
      );
  }
}

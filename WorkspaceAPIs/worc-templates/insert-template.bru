meta {
  name: Insert template
  type: http
  seq: 3
}

post {
  url: {{WORKSPACE_APIS_BASE_URL}}/flow-template/create-template
  body: none
  auth: none
}

script:pre-request {
  const {faker} =require('@faker-js/faker');
  
  req.setBody({
    flowVersionId: bru.getGlobalEnvVar("FLOW_VERSION_ID"),
    name: faker.company.name(),
    description: faker.lorem.paragraph(),
    reactFlowObject: faker.string.alphanumeric(255),
    type: "CategoryType1",
    usageCount: 0,
  })
}

script:post-response {
  if(res.getStatus() == 200){
    bru.setGlobalEnvVar(
    "FLOW_TEMPLATE_ID",
    res.getBody().data.id
    );
  }
}

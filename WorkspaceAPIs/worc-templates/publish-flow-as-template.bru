meta {
  name: publish flow as template
  type: http
  seq: 7
}

post {
  url: {{WORKSPACE_APIS_BASE_URL}}/flow-template/publish
  body: none
  auth: none
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    name: "Manager",
    description: "",
    type: "AutomationAgent",
    accessType: "Public",
    tags: ["Test","Tata"],
    refId: "98f9f621-6f48-4510-a742-227c07f9ed85"//bru.getGlobalEnvVar("FLOW_VERSION_ID"),
    })
}

script:post-response {
  if(res.getStatus() == 200){
    bru.setGlobalEnvVar(
    "FLOW_TEMPLATE_ID",
    res.getBody().data.id
    );
  }
}

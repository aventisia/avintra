meta {
  name: Is flow name available
  type: http
  seq: 2
}

post {
  url: {{WORKSPACE_APIS_BASE_URL}}/flow/is-available
  body: json
  auth: none
}

body:json {
  {
      "userInput": "Ergonomic Cotton Mouse"
  }
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    userInput: faker.company.name(),
  })
}

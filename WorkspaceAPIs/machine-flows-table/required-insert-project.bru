meta {
  name: Required - Insert project
  type: http
  seq: 1
}

post {
  url: {{WORKSPACE_APIS_BASE_URL}}/project
  body: none
  auth: none
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    type: "Agents",
    name: faker.company.name(),
    description: faker.lorem.paragraph(),
  })
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
          "PROJECT_ID",
          res.getBody().data.id
      );
  }
}

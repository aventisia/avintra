{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "accounts",
      "type": "shell",
      "command": "npx turbo run dev --filter=accounts",
      "options": {
        "cwd": "${workspaceFolder}/clients/web-apps/apps/accounts"
      },
      "isBackground": true
    },
    {
      "label": "workspace",
      "type": "shell",
      "command": "npx turbo run dev --filter=workspace",
      "options": {
        "cwd": "${workspaceFolder}/clients/web-apps"
      },
      "isBackground": true
    },
    {
      "label": "studio",
      "type": "shell",
      "command": "npx turbo run dev --filter=studio",
      "options": {
        "cwd": "${workspaceFolder}/clients/web-apps"
      },
      "isBackground": true
    },
    {
      "label": "accounts_apis",
      "type": "shell",
      "command": "dotnet run",
      "options": {
        "cwd": "${workspaceFolder}/apis/WorcBackend-legacy/AccountsAPIs"
      },
      "isBackground": true
    },
    {
      "label": "workspace_apis",
      "type": "shell",
      "command": "dotnet run",
      "options": {
        "cwd": "${workspaceFolder}/apis/WorcBackend-legacy/WorkspaceAPIs"
      },
      "isBackground": true
    },
    {
      "label": "llmpipeline_apis",
      "type": "shell",
      "command": "./venv/bin/uvicorn",
      "args": ["app.main:app", "--port", "4003", "--reload"],
      "options": {
        "cwd": "${workspaceFolder}/apis/llmpipeline",
        "env": { "ENV": "local" }
      },
      "windows": {
        "command": "./venv/Scripts/uvicorn.exe",
        "options": {
          "env": { "ENV": "local" }
        }
      },
      "linux": {
        "command": "./venv/bin/uvicorn",
        "options": {
          "env": { "ENV": "local" }
        }
      },
      "osx": {
        "command": "./venv/bin/uvicorn",
        "options": {
          "env": { "ENV": "local" }
        }
      },
      "isBackground": true
    },
    {
      "label": "Run Frontends",
      "dependsOn": ["accounts", "workspace", "studio"]
    },
    {
      "label": "Run Backends",
      "dependsOn": ["accounts_apis", "workspace_apis", "llmpipeline_apis"]
    },
    {
      "label": "Run All",
      "dependsOn": ["Run Frontends", "Run Backends"],
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}

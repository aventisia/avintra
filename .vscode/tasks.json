{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "accounts",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/clients/worc-web-legacy/accounts"
      },
      "isBackground": true
    },
    {
      "label": "workspace",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/clients/worc-web-legacy/workspace"
      },
      "isBackground": true
    },
    {
      "label": "studio",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/clients/worc-web-legacy/studio"
      },
      "isBackground": true
    },
    {
      "label": "accounts_apis",
      "type": "shell",
      "command": "dotnet run",
      "options": {
        "cwd": "${workspaceFolder}/apis/WorcBackend-legacy/AccountsAPIs"
      },
      "isBackground": true
    },
    {
      "label": "workspace_apis",
      "type": "shell",
      "command": "dotnet run",
      "options": {
        "cwd": "${workspaceFolder}/apis/WorcBackend-legacy/WorkspaceAPIs"
      },
      "isBackground": true
    },
    {
      "label": "llmpipeline_apis",
      "type": "shell",
      "command": "ENV=local ./venv/bin/uvicorn app.main:app --port 4003 --reload",
      "options": { "cwd": "${workspaceFolder}/apis/llmpipeline" },
      "isBackground": true
    },
    {
      "label": "Run Frontends",
      "dependsOn": ["accounts", "workspace", "studio"]
    },
    {
      "label": "Run Backends",
      "dependsOn": [
        "accounts_apis",
        "workspace_apis",
        "llmpipeline_apis"
      ]
    },
    {
      "label": "Run All",
      "dependsOn": ["Run Frontends", "Run Backends"],
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}

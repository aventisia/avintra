{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "accounts",
      "type": "shell",
      "command": "npx turbo run dev --filter=accounts",
      "options": {
        "cwd": "${workspaceFolder}/clients/web-apps/apps/accounts"
      },
      "isBackground": true
    },
    {
      "label": "atlas",
      "type": "shell",
      "command": "npx turbo run dev --filter=atlas",
      "options": {
        "cwd": "${workspaceFolder}/clients/web-apps/apps/atlas"
      },
      "isBackground": true
    },
    {
      "label": "workspace",
      "type": "shell",
      "command": "npx turbo run dev --filter=workspace",
      "options": {
        "cwd": "${workspaceFolder}/clients/web-apps"
      },
      "isBackground": true
    },
    {
      "label": "studio",
      "type": "shell",
      "command": "npx turbo run dev --filter=studio",
      "options": {
        "cwd": "${workspaceFolder}/clients/web-apps"
      },
      "isBackground": true
    },
    {
      "label": "accounts_apis",
      "type": "shell",
      "command": "dotnet run",
      "options": {
        "cwd": "${workspaceFolder}/apis/WorcBackend-legacy/AccountsAPIs"
      },
      "isBackground": true
    },
    {
      "label": "workspace_apis",
      "type": "shell",
      "command": "dotnet run",
      "options": {
        "cwd": "${workspaceFolder}/apis/WorcBackend-legacy/WorkspaceAPIs"
      },
      "linux": {
        "options": {
          "env": {
            "OFFICE_PIA_PATH": "/mnt/c/Program Files/Microsoft Office/root/Office16/ADDINS/PowerPivot Excel Add-in/OFFICE.dll"
          }
        }
      },
      "isBackground": true
    },
    {
      "label": "llmpipeline_apis",
      "type": "shell",
      "command": "./venv/bin/python",
      "args": ["dev.py"],
      "options": {
        "cwd": "${workspaceFolder}/apis/llmpipeline",
        "env": { "ENV": "local" }
      },
      "windows": {
        "command": "./venv/Scripts/python.exe",
        "options": {
          "cwd": "${workspaceFolder}/apis/llmpipeline",
          "env": { "ENV": "local" }
        }
      },
      "linux": {
        "command": "./venv/bin/python",
        "options": {
          "cwd": "${workspaceFolder}/apis/llmpipeline",
          "env": { "ENV": "local" }
        }
      },
      "osx": {
        "command": "./venv/bin/python",
        "options": {
          "cwd": "${workspaceFolder}/apis/llmpipeline",
          "env": { "ENV": "local" }
        }
      },
      "isBackground": true
    },
    {
      "label": "apache_camel_apis",
      "type": "shell",
      "command": ".\\mvnw.cmd",
      "args": ["spring-boot:run"],
      "options": {
        "cwd": "${workspaceFolder}/apis/apache-camel"
      },
      "windows": {
        "command": ".\\mvnw.cmd",
        "options": {
          "cwd": "${workspaceFolder}/apis/apache-camel"
        }
      },
      "linux": {
        "command": "./mvnw",
        "options": {
          "cwd": "${workspaceFolder}/apis/apache-camel"
        }
      },
      "osx": {
        "command": "./mvnw",
        "options": {
          "cwd": "${workspaceFolder}/apis/apache-camel"
        }
      },
      "isBackground": true
    },
    {
      "label": "corsair",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/apis/corsair"
      },
      "isBackground": true
    },
    {
      "label": "Run Frontends",
      "dependsOn": ["accounts", "workspace", "studio", "atlas"]
    },
    {
      "label": "Run Backends",
      "dependsOn": ["accounts_apis", "workspace_apis", "llmpipeline_apis", "apache_camel_apis", "corsair"]
    },
    {
      "label": "Run All",
      "dependsOn": ["Run Frontends", "Run Backends"],
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}

# .env
# IMPORTANT NOTE: DO NOT STORE SENSITIVE INFORMATION IN THIS FILE.
# This file is intended for non-sensitive default values.
# Use .env.local (untracked) or system environment variables for sensitive data.

PROJECT_NAME=aistudioapis
PROJECT_VERSION=1.0.0

APP_DB_CONNECTION_STRING=env_var
TENANT_DB_CONNECTION_STRING=env_var

QDRANT_URL=env_var
QDRANT_API_KEY=env_var

JWT_ISSUER=https://aventisia.com
JWT_AUDIENCE=https://aventisia.com
JWT_SECRET_KEY=env_var

ALLOWED_ORIGINS=https://*.aventisia.com,https://aventisia.com
ALLOWED_HOSTS=*.aventisia.com,aventisia.com

OLLAMA_API_URL=https://llm.aventisia.com:8443/api
OLLAMA_API_KEY=env_var

OPENAI_API_URL=https://api.openai.com/v1/chat/completions
OPENAI_API_KEY=env_var

GEMINI_API_URL=https://gemini.api.openai.com/v1/chat/completions
GEMINI_API_KEY=env_var

ANTHROPIC_API_URL=https://api.anthropic.com/v1/complete
ANTHROPIC_API_KEY=env_var

ELEVENLABS_API_KEY=env_var
DEEPGRAM_API_KEY=env_var
meta {
  name: Insert extracted data
  type: http
  seq: 2
}

post {
  url: {{MLMODELBUILDER_APIS_BASE_URL}}/extracted-data/
  body: none
  auth: none
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    MLModelId: bru.getGlobalEnvVar("MLMODEL_ID"),
    docId: "01954c6c-58e5-7211-8c5e-152fdb1351ca",
    accuracy: 99.585616,
    type:"TestData",
    DataObject: faker.lorem.sentence()
  })
}

script:post-response {
  if(res.getStatus() == 200){
    bru.setGlobalEnvVar(
    "EDATA_ID",
    res.getBody().data.id
    );
  }
}

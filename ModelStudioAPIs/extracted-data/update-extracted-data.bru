meta {
  name: Update extracted data
  type: http
  seq: 4
}

put {
  url: {{AI_STUDIO_APIS_BASE_URL}}/extracted-data
  body: none
  auth: none
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    Id: bru.getGlobalEnvVar("EDATA_ID"),
    mlModelId: bru.getGlobalEnvVar("MLMODEL_ID"),
    docId: bru.getGlobalEnvVar("DOC_ID"),
    accuracy: 99.575648,
    type:"TestData",
    DataObject: faker.lorem.sentence()
  })
}

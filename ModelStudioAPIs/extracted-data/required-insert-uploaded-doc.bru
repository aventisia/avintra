meta {
  name: Required - Insert uploaded doc
  type: http
  seq: 2
}

post {
  url: {{MLMODELBUILDER_APIS_BASE_URL}}/upload-doc/insert-file
  body: none
  auth: none
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody(
    [{
      mlModelId: bru.getGlobalEnvVar("MLMODEL_ID"),
      name: faker.person.jobType(),
      extension: "PDF",
      size: 304889,
      type:"TestData",
      path: "/files/4bb3f813-4444-429e-badd-890b7b2b6503.pdf"
    }
    ])
}

script:post-response {
  if(res.getStatus() == 200){
    bru.setGlobalEnvVar(
    "DOC_ID",
    res.getBody().data[0].id
    );
  }
}

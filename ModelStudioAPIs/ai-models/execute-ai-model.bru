meta {
  name: Execute ai model
  type: http
  seq: 3
}

post {
  url: {{MLMODELBUILDER_APIS_BASE_URL}}/ai-models/execute
  body: none
  auth: none
}

headers {
  X-API-KEY: API_KEY
}

script:pre-request {
  req.setBody({
    modelId: bru.getGlobalEnvVar("MLMODEL_ID"),
    content: "file_content",
    modelTaskIds: null
  });
  
}

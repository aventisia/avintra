meta {
  name: Add document records
  type: http
  seq: 4
}

post {
  url: {{MLMODELBUILDER_APIS_BASE_URL}}/ai-models/documents
  body: none
  auth: none
}

headers {
  X-API-KEY: API_KEY
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    mlModelId: bru.getGlobalEnvVar("MLMODEL_ID"),
    fileIds: [bru.getGlobalEnvVar("DOC_ID")],
  });
  
}

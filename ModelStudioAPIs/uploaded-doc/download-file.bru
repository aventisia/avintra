meta {
  name: Download file
  type: http
  seq: 6
}

get {
  url: {{MLMODELBUILDER_APIS_BASE_URL}}/upload-doc?fileurl={{FILE_URL}}
  body: json
  auth: none
}

params:query {
  fileurl: {{FILE_URL}}
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    fileUrl: "/files/4bb3f813-4444-429e-badd-890b7b2b6503.pdf"
  })
}

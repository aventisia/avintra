meta {
  name: Insert uploaded doc
  type: http
  seq: 3
}

post {
  url: {{MLMODELBUILDER_APIS_BASE_URL}}/upload-doc/insert-file
  body: json
  auth: none
}

body:json {
  {
    "mlModelId": "{{MLMODEL_ID}}",
    "name": "test",
    "extension": "PDF",
    "size": 304889,
    "type":"TestData",
    "path": "{{FILE_URL}}"
  }
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody(
    [{
      mlModelId: bru.getGlobalEnvVar("MLMODEL_ID"),
      name: faker.person.jobType(),
      extension: "PDF",
      size: 304889,
      type:"TestData",
      path: "files/default-files/62f5a219-2e30-4968-8ab0-1f0eea88ad14.pdf"
    }
    ])
}

script:post-response {
  if(res.getStatus() == 200){
    bru.setGlobalEnvVar(
    "FILE_URL",
    res.getBody().data[0].path
    );
    bru.setGlobalEnvVar(
    "UPLOADED_DOC_ID",
    res.getBody().data[0].id
    );
  }
}

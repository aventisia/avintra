meta {
  name: Insert  ai model user
  type: http
  seq: 2
}

post {
  url: {{MLMODELBUILDER_APIS_BASE_URL}}/ai-model-user
  body: json
  auth: none
}

body:json {
  {
    "mlModelId": "{{FLOW_ID}}",
    "userId": "0afbf579-88b3-40fd-af50-7ba0d1c12698",// bru.getGlobalEnvVar("USER_ID"),
    "accessType": "Edit"
  }
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
          "AI_MODEL_USER_ID",
          res.getBody().data.id
      );
  }
}

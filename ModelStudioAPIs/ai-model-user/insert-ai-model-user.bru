meta {
  name: Insert  ai model user
  type: http
  seq: 2
}

post {
  url: {{MLMODELBUILDER_APIS_BASE_URL}}/ai-model-user
  body: none
  auth: none
}

body:json {
  {
      
  }
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    mlModelId: bru.getGlobalEnvVar("ML_MODEL_ID"),
    userId: bru.getGlobalEnvVar("USER_ID"),
    AccessType: "Edit"
  })
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
          "AI_MODEL_USER_ID",
          res.getBody().data.id
      );
  }
}

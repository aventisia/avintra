meta {
  name: Delete multiple ai project users
  type: http
  seq: 9
}

post {
  url: {{MLMODELBUILDER_APIS_BASE_URL}}/ai-model-user/delete-multiple
  body: json
  auth: none
}

body:json {
  ["{{AI_PROJECT_USER_ID}}"]
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
        "AI_PROJECT_USER_ID", 
        "00000000-0000-0000-0000-000000000000"
      );
  }
}

docs {

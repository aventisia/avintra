meta {
  name: Delete ai project user
  type: http
  seq: 7
}

delete {
  url: {{MLMODELBUILDER_APIS_BASE_URL}}/ai-model-user/{{AI_PROJECT_USER_ID}}
  body: none
  auth: none
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
        "FLOW_USER_ID", 
        "00000000-0000-0000-0000-000000000000"
      );
  }
}

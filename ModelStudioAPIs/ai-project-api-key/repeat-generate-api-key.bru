meta {
  name: Repeat - Generate api key
  type: http
  seq: 7
}

post {
  url: {{AI_STUDIO_APIS_BASE_URL}}/api-keys/generate
  body: json
  auth: none
}

body:json {
  {
    "name": "api-key",
    "description": "This is description",
    "mlModelId": "{{AI_PROJECT_ID}}"
  }
}

script:post-response {
  if(res.getStatus() == 200){
    bru.setGlobalEnvVar(
    "AI_PROJECT_API_KEY_ID",
    res.getBody().data.id
    );
  }
}

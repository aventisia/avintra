meta {
  name: Update model setup onprem speech config
  type: http
  seq: 3
}

put {
  url: {{MLMODELBUILDER_APIS_BASE_URL}}/conversation-model/setup
  body: json
  auth: none
}

body:json {
  {
    "id": "{{AI_PROJECT_ID}}",
    "aiProjectVersionId": "{{AI_PROJECT_VERSION_ID}}",
    "aiPersona": {
        "name": "AIPersona",
        "configurationType": "OnPrem",
        "llm": "gemma",
        "nodePrompt": "",
        "temperature": 0.3,
        "setupObject": {
          "name": "Virtual Assistant",
          "roleOrObjective": "Customer Support Agent",
          "categoryOrDomain": "Healthcare",
          "toneOfVoice": "Friendly, Professional",
          "instructions": "Respond with empathy and provide accurate medical information, always defer to a healthcare professional when unsure.",
          "exclusionsOrBoundaries": "Avoid providing specific medical diagnoses or prescriptions.",
          "documents": [
          {
            "filePath": "/path/to/document1.pdf",
            "id": "9e6c9a68-35ea-4a69-8692-8fe9f819cfae",
            "name": "Health Guidelines",
            "instructions": "Use this document as the primary source for general health advice."
          }],
        "contextMemoryTimeframe": "30 min",
        "speechConfiguration": {
          "configurationType": "OnPrem",
          "onPremConfig": {
            "language": "english",
            "voice": ""
          }
        }
      }
    }
  }
}

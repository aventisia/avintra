meta {
  name: contracts
  type: http
  seq: 5
}

post {
  url: {{MLMODELBUILDER_APIS_BASE_URL}}/ml-model/
  body: none
  auth: none
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    name: "Contracts",
    type: "Extraction",
    lLM: "gemma",
    description: "Contracts",
    status:"Annotation",
    trainedOn: faker.date.anytime(),
  })
}

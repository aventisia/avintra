meta {
  name: Delete multiple schedule fine tuning history
  type: http
  seq: 7
}

post {
  url: {{MLMODELBUILDER_APIS_BASE_URL}}/summarization/fine-tuning/histories/delete-multiple
  body: none
  auth: none
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    mlModelId: bru.getGlobalEnvVar("MLMODEL_ID"),
    fileIds: [bru.getGlobalEnvVar("DOC_ID")],
    timeZone: faker.location.timeZone() ,
    scheduleAt: faker.date.future()
  });
  
}

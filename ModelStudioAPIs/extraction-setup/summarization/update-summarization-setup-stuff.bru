meta {
  name: Update summarization setup (Stuff)
  type: http
  seq: 4
}

put {
  url: {{MLMODELBUILDER_APIS_BASE_URL}}/summarization/setup
  body: none
  auth: none
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    id: bru.getGlobalEnvVar("MLMODEL_ID"),
    setupObject: {
      context: faker.lorem.lines(),
      prompt: faker.lorem.lines(2),
      charactersPerChunk: 5,
      chunkOverlap: 5,
      totalMinimumWords: 1,
      totalMaximumWords: 5,
      summarizationMethod: "Stuff",
      stuffPrompt: faker.lorem.lines(2),
    }
  });
  
}

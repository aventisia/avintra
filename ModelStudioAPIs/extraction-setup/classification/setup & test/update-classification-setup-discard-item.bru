meta {
  name: Update classification setup (DiscardItem)
  type: http
  seq: 2
}

put {
  url: {{MLMODELBUILDER_APIS_BASE_URL}}/classification/setup
  body: none
  auth: none
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    id: bru.getGlobalEnvVar("MLMODEL_ID"),
    setupObject: {
      context: faker.lorem.lines(),
      prompt: faker.lorem.lines(2),
      allowMultipleClasses: true,
      uncertaintyAction: "DiscardItem",
      categories: [
        {
          name: faker.book.author(),
          instructions: faker.lorem.lines(2)
        }
      ]
    }
  });
  
}

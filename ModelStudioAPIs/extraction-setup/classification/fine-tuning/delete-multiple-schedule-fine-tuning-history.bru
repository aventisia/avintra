meta {
  name: Delete multiple schedule fine tuning history
  type: http
  seq: 7
}

post {
  url: FINE_TUNING_HISTORY_ID{{MLMODELBUILDER_APIS_BASE_URL}}/classification/fine-tuning/histories/delete-multiple
  body: none
  auth: none
}

script:pre-request {
  // Set fineTuningHistoryIds in request body
  req.setBody(
    JSON.parse(`["${bru.getGlobalEnvVar("FINE_TUNING_HISTORY_ID")}"]`)
  )
}

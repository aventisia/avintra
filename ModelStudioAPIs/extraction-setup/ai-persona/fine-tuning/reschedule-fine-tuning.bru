meta {
  name: Reschedule fine tuning
  type: http
  seq: 5
}

put {
  url: {{MLMODELBUILDER_APIS_BASE_URL}}/ai-persona/reschedule-fine-tuning
  body: none
  auth: none
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    id: bru.getGlobalEnvVar("FINE_TUNING_HISTORY_ID"),
    mlModelId: bru.getGlobalEnvVar("MLMODEL_ID"),
    timeZone: faker.location.timeZone() ,
    scheduledAt: faker.date.future()
  });
  
}

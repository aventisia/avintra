meta {
  name: Update review data by model
  type: http
  seq: 3
}

put {
  url: {{MLMODELBUILDER_APIS_BASE_URL}}/ai-persona/review-data
  body: none
  auth: none
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    id: bru.getGlobalEnvVar("EDATA_ID"),
    mlModelId: bru.getGlobalEnvVar("MLMODEL_ID"),
    type: "TestData",
    docId: bru.getGlobalEnvVar("DOC_ID"),
    extractedData:  {
          "data": "This invoice, numbered INV-3337, is from DEMO - Sliced Invoices and is addressed to Test Business."
        },
    accuracy: 90,
    submitForFineTuning: true
  });
}

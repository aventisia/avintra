meta {
  name: Update ai persona setup
  type: http
  seq: 4
}

put {
  url: {{MLMODELBUILDER_APIS_BASE_URL}}/ai-persona/setup
  body: none
  auth: none
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    id: bru.getGlobalEnvVar("MLMODEL_ID"),
    setupObject: {
      name: faker.company.catchPhrase(),
      roleOrObjective: faker.name.jobTitle(),
      categoryOrDomain: faker.commerce.department(), 
      toneOfVoices: [
        "Professional",
        "Casual",
        "Friendly",
        "Academic",
        "Witty"
      ],
      instructions: faker.lorem.paragraph(),
      exclusionsOrBoundaries: faker.lorem.sentence(), 
      contextMemoryTimeframes: [
        "Last 7 days",
        "Current session",
        "Indefinite",
        "Last 3 interactions"
      ],
      temperature: 0.1,
      documents: null,
      enableAudio: false,
      enableVideo: false,
      enableChat: false
    }
  });
}

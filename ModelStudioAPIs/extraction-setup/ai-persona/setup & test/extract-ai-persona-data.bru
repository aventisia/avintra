meta {
  name: Extract ai persona data
  type: http
  seq: 6
}

post {
  url: {{MLMODELBUILDER_APIS_BASE_URL}}/ai-persona/extract-via-llm
  body: none
  auth: none
}

script:pre-request {
  req.setBody({
    modelId: bru.getGlobalEnvVar("MLMODEL_ID"),
    fileIds: [bru.getGlobalEnvVar("DOC_ID")]
  });
  
}

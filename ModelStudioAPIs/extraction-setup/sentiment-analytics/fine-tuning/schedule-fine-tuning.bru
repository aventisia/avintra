meta {
  name: Schedule fine tuning
  type: http
  seq: 2
}

post {
  url: {{MLMODELBUILDER_APIS_BASE_URL}}/sentiment-analytics/schedule-fine-tuning
  body: none
  auth: none
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    mlModelId: "0196d86d-999d-7d09-8489-510642cb9fb7",
    fileIds: [bru.getGlobalEnvVar("DOC_ID")],
    timeZone: faker.location.timeZone() ,
    scheduledAt: faker.date.future()
  });
  
}

meta {
  name: Add review data
  type: http
  seq: 2
}

post {
  url: {{MLMODELBUILDER_APIS_BASE_URL}}/sentiment-analytics/review-data
  body: none
  auth: none
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    mlModelId: bru.getGlobalEnvVar("MLMODEL_ID"),
    type: "TestData",
    fileIds: [bru.getGlobalEnvVar("DOC_ID")],
    scheduleInfo:{
      timeZone: faker.location.timeZone() ,
      scheduledAt: faker.date.future()
    }
  });
  
}

meta {
  name: Get extraction setup data by ml model id
  type: http
  seq: 6
}

get {
  url: {{MLMODELBUILDER_APIS_BASE_URL}}/extraction-setup/ml-model/{{MLMODEL_ID}}
  body: none
  auth: none
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    MLModelId: bru.getGlobalEnvVar("MLMODEL_ID"),
  })
}

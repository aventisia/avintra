meta {
  name: Update extraction setup data
  type: http
  seq: 2
}

put {
  url: {{MLMODELBUILDER_APIS_BASE_URL}}/extraction/setup
  body: none
  auth: none
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    id: bru.getGlobalEnvVar("MLMODEL_ID"),
    setupObject: {
      documentContext: faker.lorem.lines(),
      nodePrompt: faker.lorem.lines(2),
      tableMetadata: [
        {
          context: faker.lorem.sentence(),
          name: faker.company.name(),
          tableHeaders: [
            {
              name: faker.book.author(),
              type: "text",
              instructions: faker.lorem.lines(2)
            }
          ]
        }
      ],
      fieldSetups: [
        {
          name: faker.book.author(),
          type: "text",
          instructions: faker.lorem.lines(2)
        }
      ]
    }
  });
  
}

meta {
  name: Update extraction setup data
  type: http
  seq: 2
}

put {
  url: {{MLMODELBUILDER_APIS_BASE_URL}}/extraction/setup
  body: none
  auth: none
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    id: bru.getGlobalEnvVar("MLMODEL_ID"),
    setupObject: {"Context":"extract it","Prompt":"You are a highly accurate information extraction assistant. Your task is to carefully analyse the provided text and extract specific pieces of information based on predefined fields or entities.\nOnly extract relevant, factual data as it appears in the input. Do not infer, assume, or create information that is not explicitly present in the text.\nReturn the output with clearly labeled fields as per the extraction schema.\nIf a field is not present in the input, return null or \u0022\u0022 without making assumptions.\nEnsure the extracted data is clean, free from noise, and maintains the original context.","TableMetadata":[{"Index":"0","Context":"Taxt invoice","Name":"Table 1","TableHeaders":[{"Index":"0","Name":"Item","Type":"text","Instructions":""},{"Index":"1","Name":"Metarial","Type":"text","Instructions":""},{"Index":"2","Name":"Unit","Type":"text","Instructions":""},{"Index":"3","Name":"amount ","Type":"text","Instructions":""},{"Index":"4","Name":"rate","Type":"text","Instructions":""}]}],"FieldSetups":[{"Index":"0","Name":"Invoice No","Type":"text","Instructions":""},{"Index":"1","Name":"Invoice Date","Type":"date","Instructions":""},{"Index":"2","Name":"supplier location","Type":"text","Instructions":""},{"Index":"3","Name":"Term Of Delivery","Type":"text","Instructions":""},{"Index":"4","Name":"Broker Detail","Type":"text","Instructions":""},{"Index":"5","Name":"IMO No","Type":"text","Instructions":""}],"Temperature":0.2,"LLM":"gemma"}
  });
  
}

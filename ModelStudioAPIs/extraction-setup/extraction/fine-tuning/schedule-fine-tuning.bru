meta {
  name: Schedule fine tuning
  type: http
  seq: 3
}

post {
  url: {{MLMODELBUILDER_APIS_BASE_URL}}/extraction/schedule-fine-tuning
  body: none
  auth: none
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    mlModelId: bru.getGlobalEnvVar("MLMODEL_ID"),
    fileIds: [bru.getGlobalEnvVar("DOC_ID")],
    timeZone: faker.location.timeZone() ,
    scheduledAt: faker.date.future()
  });
  
}

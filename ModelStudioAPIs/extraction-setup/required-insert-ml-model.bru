meta {
  name: Required - Insert ml model
  type: http
  seq: 1
}

post {
  url: {{MLMODELBUILDER_APIS_BASE_URL}}/ml-model
  body: none
  auth: none
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    name: faker.person.jobType(),
    type: "Extraction",
    lLM: "LLM1",
    description: faker.lorem.sentence(),
    status:"Annotation",
    trainedOn: faker.date.anytime(),
  })
}

script:post-response {
  if(res.getStatus() == 200){
    bru.setGlobalEnvVar(
    "MLMODEL_ID",
    res.getBody().data.id
    );
  }
}

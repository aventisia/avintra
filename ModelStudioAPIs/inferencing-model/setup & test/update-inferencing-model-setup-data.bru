meta {
  name: Update inferencing model setup data
  type: http
  seq: 2
}

put {
  url: {{MLMODELBUILDER_APIS_BASE_URL}}/inferencing-model/setup
  body: none
  auth: none
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    id: bru.getGlobalEnvVar("MLMODEL_ID"),
    businessContext:"test",
    summarization: {
        //id: bru.getGlobalEnvVar("MLMODEL_TASK_ID"),
        name: "Summarization",
        configurationType: "OnPrem",
        llm: "gemma",
        nodePrompt: "",
        temperature: 0.3,
        setupObject: {
          totalMinimumWords: 100,
          totalMaximumWords: 200,
        }
      },
    extraction: {
        //id: bru.getGlobalEnvVar("MLMODEL_TASK_ID"),
        name: "Extraction",
        configurationType: "OnPrem",
        llm: "gemma",
        nodePrompt: "",
        temperature: 0.3,
        setupObject: {
          tables: [],
          fields: [
            {
              name: "test",
              type: "Text",
              instruction:""
            }
          ]
        }
      },
    classification: {
        //id: bru.getGlobalEnvVar("MLMODEL_TASK_ID"),
        name: "Classification",
        configurationType: "OnPrem",
        llm: "gemma",
        nodePrompt: "",
        temperature: 0.3,
        setupObject: {
          allowMultipleClasses: false,
          categories: [
            {
              name: "test",
              instruction:"",
              subCategories: [
                {
                  name: "test",
                  instruction:"",
                  subSubcategories: [
                  {
                    name: "test",
                    instruction:""
                  }
              ]
                }
              ]
            },
            {
              name: "test1",
              instruction:""
            }
          ]
        }
      }
  });
  
}

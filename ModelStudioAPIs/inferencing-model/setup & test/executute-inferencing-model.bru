meta {
  name: Execute inferencing model
  type: http
  seq: 4
}

post {
  url: {{MLMODELBUILDER_APIS_BASE_URL}}/inferencing-model/execute
  body: none
  auth: none
}

script:pre-request {
  req.setBody({
    modelId: bru.getGlobalEnvVar("MLMODEL_ID"),
    fileIds: [bru.getGlobalEnvVar("UPLOADED_DOC_ID")],
    modelTaskIds: null
  });
  
}

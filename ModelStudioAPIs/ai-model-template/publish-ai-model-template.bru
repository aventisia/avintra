meta {
  name: Publish ai model template
  type: http
  seq: 6
}

post {
  url: {{MLMODELBUILDER_APIS_BASE_URL}}/ai-model-template/publish
  body: none
  auth: none
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    id: bru.getGlobalEnvVar("AI_MODEL_VERSION_ID"),
    name: "Manager",
    description: "",
    type: "Inferencing",
    accessType: "Public",
    tags: ["Test","Tata"]
  })
}

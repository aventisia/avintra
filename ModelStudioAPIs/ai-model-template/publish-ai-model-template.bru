meta {
  name: Publish ai model template
  type: http
  seq: 6
}

post {
  url: {{MLMODELBUILDER_APIS_BASE_URL}}/ai-model-template/publish
  body: none
  auth: none
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    name: "Manager",
    description: "",
    type: "Inferencing",
    accessType: "Public",
    tags: ["Test","Tata"],
    refId: bru.getGlobalEnvVar("MLMODEL_ID"),
    })
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
          "AI_MODEL_TEMPLATE_ID",
          res.getBody().data.id
      );
  }
}

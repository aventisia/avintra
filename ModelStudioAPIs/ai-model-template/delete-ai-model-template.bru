meta {
  name: Delete ai model template
  type: http
  seq: 7
}

delete {
  url: {{MLMODELBUILDER_APIS_BASE_URL}}/ai-model-template/{{AI_MODEL_TEMPLATE_ID}}
  body: none
  auth: none
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    id: bru.getGlobalEnvVar("FLOW_VERSION_ID"),
  })
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
        "AI_MODEL_VERSION_ID", 
        "00000000-0000-0000-0000-000000000000"
      );
  }
}

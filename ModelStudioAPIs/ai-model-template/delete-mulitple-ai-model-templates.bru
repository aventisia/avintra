meta {
  name: Delete mulitple ai model template
  type: http
  seq: 9
}

post {
  url: {{MLMODELBUILDER_APIS_BASE_URL}}/ai-model-template/delete-multiple
  body: none
  auth: none
}

script:pre-request {
  // Set aiModelTemplateId in request body
  req.setBody(
    JSON.parse(`["${bru.getGlobalEnvVar("AI_MODEL_TEMPLATE_ID")}"]`)
  )
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
        "AI_MODEL_TEMPLATE_ID", 
        "00000000-0000-0000-0000-000000000000"
      );
  }
}

}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    id: bru.getGlobalEnvVar("AI_MODEL_TEMPLATE_ID"),
    name: "Manager",
    description: "",
    type: "Inferencing",
    accessType: "Public",
    tags: ["Test"]
  })
}

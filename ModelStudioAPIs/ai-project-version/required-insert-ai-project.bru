meta {
  name: Required - Insert ai project
  type: http
  seq: 1
}

post {
  url: {{AI_STUDIO_APIS_BASE_URL}}/ml-model
  body: json
  auth: none
}

body:json {
  {
    "name": "Test_Model",
    "description": "This is test model"
  }
}

script:post-response {
  if(res.getStatus() == 200){
    bru.setGlobalEnvVar(
    "AI_PROJECT_ID",
    res.getBody().data.id
    );
  }
}

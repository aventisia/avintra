meta {
  name: Delete mulitple ai project version
  type: http
  seq: 9
}

post {
  url: {{MLMODELBUILDER_APIS_BASE_URL}}/ai-project-version/delete-multiple
  body: json
  auth: none
}

body:json {
  ["{{AI_PROJECT_VERSION_ID}}"]
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
        "AI_MODEL_VERSION_ID", 
        "00000000-0000-0000-0000-000000000000"
      );
  }
}

meta {
  name: Required - Insert ai model
  type: http
  seq: 1
}

post {
  url: {{MLMODELBUILDER_APIS_BASE_URL}}/ml-model
  body: none
  auth: none
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    name: faker.person.jobType(),
  })
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
          "ML_MODEL_ID",
          res.getBody().data.id
      );
  }
}

meta {
  name: Update ai model version
  type: http
  seq: 4
}

put {
  url: {{MLMODELBUILDER_APIS_BASE_URL}}/ai-model-version
  body: none
  auth: none
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    id: bru.getGlobalEnvVar("AI_MODEL_VERSION_ID"),
    mlModelId: bru.getGlobalEnvVar("ML_MODEL_ID")
  })
}

meta {
  name: Repeat - Insert ai model version
  type: http
  seq: 8
}

post {
  url: {{MLMODELBUILDER_APIS_BASE_URL}}/ai-model-version
  body: none
  auth: none
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    mlModelId: bru.getGlobalEnvVar("ML_MODEL_ID"),
    name: "Manager",
    type: "Inferencing",
    isLocked: faker.datatype.boolean(),
    isDraft: faker.datatype.boolean(),
  })
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
          "AI_MODEL_VERSION_ID",
          res.getBody().data.id
      );
  }
}

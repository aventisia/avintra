meta {
  name: Publish ai model version
  type: http
  seq: 6
}

post {
  url: {{MLMODELBUILDER_APIS_BASE_URL}}/ai-model-version/publish
  body: none
  auth: none
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    id: bru.getGlobalEnvVar("AI_MODEL_VERSION_ID"),
  })
}

meta {
  name: Insert data field
  type: http
  seq: 3
}

post {
  url: {{MLMODELBUILDER_APIS_BASE_URL}}/data-field
  body: none
  auth: none
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    mlModelId: bru.getGlobalEnvVar("MLMODEL_ID"),
    Name: faker.person.jobType(),
    Type: "Text",
    Color: faker.color.human(),
    Description: faker.lorem.sentence(),
  })
}

script:post-response {
  if(res.getStatus() == 200){
    bru.setGlobalEnvVar(
    "DATA_FIELD_ID",
    res.getBody().data.id
    );
  }
}

meta {
  name: Insert version resource
  type: http
  seq: 3
}

post {
  url: {{MLMODELBUILDER_APIS_BASE_URL}}/upload-doc/insert-file
  body: json
  auth: none
}

body:json {
  [
    {
      "aiProjectVersionId": "{{AI_PROJECT_VERSION_ID}}",
      "name": "20250019 Singfuels PAC SHARON.pdf",
      "extension": "PDF",
      "size": 2471356,
      "path": "/files/default-files/c23ff002-ae7a-46b3-be99-50348ccb726b.pdf"
    }
  ]
}

script:post-response {
  if(res.getStatus() == 200){
    bru.setGlobalEnvVar(
    "FILE_URL",
    res.getBody().data[0].path
    );
    bru.setGlobalEnvVar(
    "VERSION_RESOURCE_ID",
    res.getBody().data[0].id
    );
  }
}

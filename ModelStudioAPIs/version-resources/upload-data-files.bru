meta {
  name: Upload data files
  type: http
  seq: 5
}

post {
  url: {{MLMODELBUILDER_APIS_BASE_URL}}/upload-doc/upload-files
  body: multipartForm
  auth: none
}

body:multipart-form {
  files: @file(/home/rahmat/Gitea/Test/20250019 Singfuels PAC SHARON.pdf)
  aiProjectVersionId: {{AI_PROJECT_VERSION_ID}}
}

script:post-response {
  if(res.getStatus() == 200){
    bru.setGlobalEnvVar(
    "FILE_URL",
    res.getBody().data[0].path
    );
  }
}

meta {
  name: Delete multiple api keys
  type: http
  seq: 8
}

post {
  url: {{MLMODELBUILDER_APIS_BASE_URL}}/api-keys/delete-multiple
  body: none
  auth: none
}

script:pre-request {
  // Set modelAPIKeyId in request body
  req.setBody(
    JSON.parse(`["${bru.getGlobalEnvVar("MODEL_API_KEY_ID")}"]`)
  )
}

meta {
  name: Delete multiple api keys
  type: http
  seq: 8
}

post {
  url: {{MLMODELBUILDER_APIS_BASE_URL}}/api-keys/delete-multiple
  body: none
  auth: none
}

script:pre-request {
  // Set aiModelVersionId in request body
  req.setBody(
    JSON.parse(`["${bru.getGlobalEnvVar("AI_MODEL_VERSION_ID")}"]`)
  )
}

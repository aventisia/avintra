meta {
  name: Repeat - Generate api key
  type: http
  seq: 7
}

post {
  url: {{MLMODELBUILDER_APIS_BASE_URL}}/api-keys/generate
  body: none
  auth: none
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    mlModelId: bru.getGlobalEnvVar("MLMODEL_ID"),
  })
}

script:post-response {
  if(res.getStatus() == 200){
    bru.setGlobalEnvVar(
    "MODEL_API_KEY_ID",
    res.getBody().data.id
    );
  }
}

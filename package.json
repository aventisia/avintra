{
  "name": "worc-desktop-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 2999",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:testing": "npx cpy src-tauri/tauri.testing.conf.json . --rename=tauri.conf.json && tauri build && git checkout -- src-tauri/tauri.conf.json",
    "tauri:staging": "npx cpy src-tauri/tauri.staging.conf.json . --rename=tauri.conf.json && tauri build && git checkout -- src-tauri/tauri.conf.json"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tauri-apps/cli": "^2.9.6",
    "@types/node": "^20.14.11",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "globals": "^16.5.0",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.26.0",
    "vite": "^6.2.0",
    "vite-plugin-eslint2": "^5.0.3"
  }
}

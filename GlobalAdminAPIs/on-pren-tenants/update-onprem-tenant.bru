meta {
  name: Update onprem tenant
  type: http
  seq: 4
}

put {
  url: {{GLOBAL_ADMIN_BASE_URL}}/onprem-tenant
  body: json
  auth: inherit
}

body:json {
  {
    "id": "{{ON_PREM_TENANT_ID}}",
    "name": "tenant_name",
    "type": "Enterprise",
    "executionTimeAllowed": 1000,
    "contractStartDate": "2025-12-11",
    "contractRenewalDate": "2026-12-11",
    "isExecutionDisabled": false,
    "isLoginDisabled": false,
    "outEmails": "",
    "tenantEmails": "" 
  }
}

script:post-response {
  if(res.getStatus() == 200){
    bru.setGlobalEnvVar(
          "ON_PREM_TENANT_NAME",res.getBody().data.name
      );
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

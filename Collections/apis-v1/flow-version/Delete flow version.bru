meta {
  name: Delete flow version
  type: http
  seq: 6
}

delete {
  url: {{WORKSPACE_APIS_BASE_URL}}/flow-version/{{FLOW_VERSION_ID}}
  body: none
  auth: none
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
        "FLOW_VERSION_ID", 
        "00000000-0000-0000-0000-000000000000"
      );
  }
}

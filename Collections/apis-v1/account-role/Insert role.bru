meta {
  name: Insert role
  type: http
  seq: 1
}

post {
  url: {{ACCOUNTS_APIS_BASE_URL}}/role/
  body: none
  auth: none
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    FullName: faker.person.jobType(),
    Description: faker.lorem.sentence(),
    
  })
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
          "ROLE_ID",
          res.getBody().data.id
      );
  }
}

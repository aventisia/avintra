meta {
  name: Insert subscription
  type: http
  seq: 1
}

post {
  url: {{WORKSPACE_APIS_BASE_URL}}/subscription/
  body: none
  auth: none
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    startDate: new Date(),
    dueDate: new Date(),
    planId: bru.getGlobalEnvVar("PLAN_ID")
  })
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
          "SUBSCRIPTION_ID",
          res.getBody().data.id
      );
     bru.setGlobalEnvVar(
          "USER_ID", 
          res.getBody().data.createdByUserId)
  }
}

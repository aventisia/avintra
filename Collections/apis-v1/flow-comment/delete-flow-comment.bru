meta {
  name: Delete flow comment
  type: http
  seq: 6
}

delete {
  url: {{WORKSPACE_APIS_BASE_URL}}/flow-comment/{{FLOW_COMMENT_ID}}
  body: none
  auth: none
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
        "FLOW_COMMENT_ID", 
        "00000000-0000-0000-0000-000000000000"
      );
  }
}

meta {
  name: Delete multiple projects
  type: http
  seq: 7
}

post {
  url: {{WORKSPACE_APIS_BASE_URL}}/project/delete-multiple
  body: none
  auth: none
}

body:json {
  {
      
  }
}

script:pre-request {
  // Set projectIds in request body
  req.setBody(
    JSON.parse(`["${bru.getGlobalEnvVar("PROJECT_ID")}"]`)
  )
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
        "PROJECT_ID", 
        "00000000-0000-0000-0000-000000000000"
      );
  }
}

docs {

meta {
  name: Update tenant
  type: http
  seq: 3
}

put {
  url: {{ACCOUNTS_APIS_BASE_URL}}/tenant
  body: none
  auth: none
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  const moment = require('moment');
  
  req.setBody({
    id: bru.getGlobalEnvVar("RECORD_ID"),
    name: faker.company.name(),
    expiresOn: moment().add(1, 'years').toISOString(),
    isSSOEnabled: false,
    isPwdEnabled: true,
    isPwdNeverExpiresEnabled: true,
    daysBeforePwdExpires: 720,
    isIdleSessionTimeoutEnabled: true,
    idleSessionTimeoutMinutes: 20,
    isTwoFAEnabled: false,
    ssoConfigJson: "{}",
    dbOption: "Shared",
    dbUserId: "",
    dbPwd: "",
    dbHost: "",
    dbPort: 0,
    dbNamePrefix: "",
    isDisabled: true,
  })
}

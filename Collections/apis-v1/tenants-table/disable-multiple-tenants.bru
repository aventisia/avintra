meta {
  name: Disable multiple tenants
  type: http
  seq: 7
}

post {
  url: {{ACCOUNTS_APIS_BASE_URL}}/tenant/disable-multiple
  body: none
  auth: none
}

script:pre-request {
  // Set tenantIds in request body
  req.setBody(
    JSON.parse(`["${bru.getGlobalEnvVar("TENANT_ID")}"]`)
  )
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
        "TENANT_ID", 
        "00000000-0000-0000-0000-000000000000"
      );
  }
}

meta {
  name: Delete tenant
  type: http
  seq: 4
}

delete {
  url: {{ACCOUNTS_APIS_BASE_URL}}/tenant/{{RECORD_ID}}
  body: none
  auth: none
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
        "RECORD_ID", 
        "00000000-0000-0000-0000-000000000000"
      );
  }
}

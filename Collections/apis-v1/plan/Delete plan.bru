meta {
  name: Delete plan
  type: http
  seq: 4
}

delete {
  url: {{ACCOUNTS_APIS_BASE_URL}}/plan/delete/{{PLAN_ID}}
  body: none
  auth: none
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
        "PLAN_ID", 
        "00000000-0000-0000-0000-000000000000"
      );
  }
}

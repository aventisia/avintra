meta {
  name: Update plan
  type: http
  seq: 2
}

put {
  url: {{ACCOUNTS_APIS_BASE_URL}}/plan/update-plan
  body: none
  auth: none
}

script:pre-request {
  const {faker} = require('@faker-js/faker');
  
  req.setBody({
   id: bru.getGlobalEnvVar("PLAN_ID"),
   planName: faker.string.alpha,
   description: faker.lorem.paragraph(),
   monthlyPrice: 349,
   yearlyPrice: 2590,
   isDisabled: true  
  })
}

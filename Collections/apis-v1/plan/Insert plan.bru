meta {
  name: Insert plan
  type: http
  seq: 1
}

post {
  url: {{ACCOUNTS_APIS_BASE_URL}}/plan/insert-plan
  body: none
  auth: none
}

script:pre-request {
  const {faker} = require('@faker-js/faker');
  
  req.setBody({
   planName:"Plan A",
   description: faker.lorem.paragraph(),
   monthlyPrice: 349,
   yearlyPrice: 2540,
   features: "Create Ten flow; Create flow logs;",
   status: "Inactive",
   isDisabled: true  
  })
    
}

script:post-response {
  if(res.getStatus() == 200){
    bru.setGlobalEnvVar(
    "PLAN_ID",
    res.getBody().data.id
    );
  }
}

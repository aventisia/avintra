meta {
  name: Disable mutiple users
  type: http
  seq: 6
}

post {
  url: {{ACCOUNTS_APIS_BASE_URL}}/user/disable-multiple
  body: none
  auth: none
}

script:pre-request {
  // Set userIds in request body
  req.setBody(
    JSON.parse(bru.getGlobalEnvVar("ACCOUNT_USER_ID_LIST"))
  )
}

script:post-response {
  if(res.getStatus() == 200){
      bru.setGlobalEnvVar(
          "ACCOUNT_USER_ID_LIST",
          JSON.stringify([])
      );
  }
}

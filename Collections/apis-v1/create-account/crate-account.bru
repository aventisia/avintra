meta {
  name: Create account
  type: http
  seq: 1
}

post {
  url: {{ACCOUNTS_APIS_BASE_URL}}/auth/create-account
  body: none
  auth: none
}

body:json {
  {
      "email": "accounts@aventisia.com",
      "firstName": "Aventisia",
      "lastName": "Account",
      "pwd": "Password@13",
      "verificationCodeId": "{{VERIFICATION_CODE_ID}}",
      "secretCode": "432187",
      "isSocialSignUp": false
  }
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    email: faker.internet.email(),
    firstName: faker.person.firstName(),
    lastName: faker.person.lastName(),
    verificationCodeId: bru.getGlobalEnvVar("VERIFICATION_CODE_ID"),
    isSocialSignUp: false,
    pwd: "Password@01",
    secretCode: "000000",
  })
}

docs {
  To use the `create-account` endpoint, follow these steps:  
  
  1. Execute the Create OTP (VerifyEmailAddress) `create-code` endpoint. This must be done for the same email Id intended for account creation.
  2. The API will generate a verification code and update the Global environment variable `VERIFICATION_CODE_ID` accordingly.  
  3. Copy the OTP received in the email. Insert the OTP into the `secretCode` field within the payload.
  4. Submit the request to execute the `create-account` endpoint.  
}

meta {
  name: Update status
  type: http
  seq: 2
}

put {
  url: {{ACCOUNTS_APIS_BASE_URL}}/payment/update-status
  body: none
  auth: none
}

script:pre-request {
  const {faker} = require('@faker-js/faker');
  
  req.setBody({
    id: bru.getGlobalEnvVar("PAYMENT_ID"),
    paymentStatus: "success",
  })
}

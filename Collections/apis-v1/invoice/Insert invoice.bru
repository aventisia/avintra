meta {
  name: Insert invoice
  type: http
  seq: 1
}

post {
  url: {{ACCOUNTS_APIS_BASE_URL}}/invoice/insert-invoice
  body: none
  auth: none
}

script:pre-request {
  const {faker} = require('@faker-js/faker');
  
  req.setBody({
    subscriptionId: "5b6c99e4-008d-4ad7-9d0e-c77416e237d5",
    amount: 349,
    generatedDate: new Date(),
    isPaid: true  
  })
}

script:post-response {
  if(res.getStatus() == 200){
    bru.setGlobalEnvVar(
    "INVOICE_ID",
    res.getBody().data.id
    );
     bru.setGlobalEnvVar(
          "SUBSCRIPTION_ID", 
          res.getBody().data.subscriptionId)
  }
}

# Run globally or repo-level commands to ensure consistent line endings across all platforms:
# git config --global core.autocrlf false
# git config --global core.eol lf
# or for a specific repository:
# git config core.autocrlf false
# git config core.eol lf
# After setting these configurations, you can normalize the line endings in your repository by running:
# git add --renormalize .

# Normalize line endings to LF (Unix-style) for all text files
* text=auto eol=lf

# Explicitly declare text files
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.xml text eol=lf

# Windows-specific files must have CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary

{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "updater:default",
    "process:default",
    "store:default",
    "process:default",
    "process:default"
  ],
  "local": true,
  "remote": {
    "urls": [
      "http://localhost:*/**",
      "https://localhost:*/**",
      "https://*.aventisia.com/**"
    ]
  }
}
meta {
  name: Convert speech to text by url
  type: http
  seq: 1
}

post {
  url: {{LLM_PIPELINE_APIS_BASE_URL}}/transcriptions/from-url
  body: none
  auth: none
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  req.setBody({
    file_url: "/files/4bb3f813-4444-429e-badd-890b7b2b6503.mp3",
    download: false
  })
}
